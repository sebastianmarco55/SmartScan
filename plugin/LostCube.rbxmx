-- state -> where the default `Animate` LocalScript keeps it: character.Animate.<folder>.<names[variant]>
-- (the idle folder holds Animation1 / Animation2 / Animation3, each with a `Weight` NumberValue)
AnimLibrary.ANIMATE = {
