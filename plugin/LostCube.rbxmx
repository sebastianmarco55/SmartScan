<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="Script" referent="RBX1"><Properties><string name="Name">LostCube</string><ProtectedString name="Source"><![CDATA[-- LostCube - Roblox Studio plugin: game analysis, VFX editor with live preview, animations, modelling and Claude
-- (ReplicatedStorage.LostCube.Editor). Toolbar "LostCube" opens the panel.
local App = require(script.App)
local Theme = require(script.Theme)
local Icons = require(script.Icons)

-- the toolbar icon is Studio's own cube glyph (Icons.TOOLBAR), in the variant of the current Studio theme
local toolbar = plugin:CreateToolbar("LostCube")
local button = toolbar:CreateButton("LostCube", "Deschide LostCube: analiza jocului, efecte, animații, modelare, Claude",
	Icons.toolbar(), "LostCube")
button.ClickableWhenViewportHidden = true

local info = DockWidgetPluginGuiInfo.new(Enum.InitialDockState.Right, false, false, 360, 760, 300, 360)
-- CreateDockWidgetPluginGuiAsync replaces the deprecated CreateDockWidgetPluginGui (both wait for Studio); the old call
-- stays as the fallback for a Studio that does not have the new one
local okAsync, created = pcall(function()
	return plugin:CreateDockWidgetPluginGuiAsync("LostCubeMain", info)
end)
local widget = okAsync and created or plugin:CreateDockWidgetPluginGui("LostCubeMain", info)
widget.Title = "LostCube"
widget.Name = "LostCube"
widget.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

local app

local function open()
	if app then
		return
	end
	app = App.mount(widget, { plugin = plugin })
end

button.Click:Connect(function()
	widget.Enabled = not widget.Enabled
end)

-- shortcuts for the VFX preview; a key is bound in Studio: File > Advanced > Customize Shortcuts > "LostCube"
local playAction = plugin:CreatePluginAction("LostCube_PlayEffect", "LostCube: redă efectul",
	"Redă efectul ales în tab-ul Efecte", Icons.toolbar(), true)
local stopAction = plugin:CreatePluginAction("LostCube_StopPreview", "LostCube: oprește previzualizarea",
	"Oprește și scoate previzualizarea din scenă", Icons.toolbar(), true)
playAction.Triggered:Connect(function()
	if app then
		app:panel("VFX"):play()
	end
end)
stopAction.Triggered:Connect(function()
	if app then
		app:panel("VFX"):stopPreview()
	end
end)

-- the toolbar icon follows the Studio theme (the window re-skins itself through Theme)
Theme.watch()
local themeConn = Theme.onChanged(function()
	pcall(function()
		button.Icon = Icons.toolbar()
	end)
end)

widget:GetPropertyChangedSignal("Enabled"):Connect(function()
	button:SetActive(widget.Enabled)
	if widget.Enabled then
		open()
	end
end)

if widget.Enabled then
	button:SetActive(true)
	open()
end

plugin.Unloading:Connect(function()
	themeConn:Disconnect()
	if app then
		app:destroy()
		app = nil
	end
	Theme.unwatch()
end)
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX2"><Properties><string name="Name">UI</string><ProtectedString name="Source"><![CDATA[-- LostCube UI kit 2.1: the controls every panel is made of, in the style of Studio's own panels (theme colours from
-- Studio, Builder Sans, 4 px grid, flat sections, real switches, Studio glyphs, no emoji). Design rules and the
-- component catalogue: plugin/docs/design.md.
-- Everything is plain Roblox GUI, so the same panels run in the plugin's dock widget and in a ScreenGui.
local Theme = require(script.Parent.Theme)
local Icons = require(script.Parent.Icons)

local UI = {}
local T = Theme.tokens

-- Colour tokens. Live: the values are replaced in place when Studio changes theme (App then re-renders), so read
-- C.x when you paint, do not copy it into a long-lived upvalue. The last eight names are the 2.0 palette, kept so the
-- panels work before they migrate (section = bg, item = raised, hover = surfaceHover, input = field, dim = textDim,
-- accentDark = accentSoft, good = success, warn = warning).
UI.C = {
	bg = T.bg, header = T.header, surface = T.surface, surfaceHover = T.surfaceHover, surfacePressed = T.surfacePressed,
	raised = T.raised, raisedStrong = T.raisedStrong, field = T.field, fieldBorder = T.fieldBorder, fieldBorderHover = T.fieldBorderHover,
	focus = T.focus, border = T.border, divider = T.divider, button = T.button, buttonHover = T.buttonHover,
	buttonPressed = T.buttonPressed, buttonBorder = T.buttonBorder, buttonText = T.buttonText, text = T.text,
	textDim = T.textDim, textDisabled = T.textDisabled, textBright = T.textBright, accent = T.accent,
	accentHover = T.accentHover, accentPressed = T.accentPressed, accentText = T.accentText, accentSoft = T.accentSoft,
	accentSoftHover = T.accentSoftHover, link = T.link, danger = T.danger, dangerSoft = T.dangerSoft,
	warning = T.warning, warningSoft = T.warningSoft, success = T.success, successSoft = T.successSoft, info = T.info,
	scrollbar = T.scrollbar, tooltip = T.tooltip, switchOff = T.switchOff, knob = T.knob, scrim = T.scrim,
	-- 2.0 names
	section = T.bg, item = T.raised, hover = T.surfaceHover, input = T.field, dim = T.textDim, accentDark = T.accentSoft,
	good = T.success, warn = T.warning,
}
local LEGACY = { section = "bg", item = "raised", hover = "surfaceHover", input = "field", dim = "textDim",
	accentDark = "accentSoft", good = "success", warn = "warning" }
local C = UI.C

local function syncPalette()
	for key in C do
		local token = LEGACY[key] or key
		if T[token] ~= nil then
			C[key] = T[token]
		end
	end
end
Theme.onChanged(syncPalette)

-- 2.0 font enums (code that sets .Font itself); new code uses UI.textStyle(inst, role) / Theme.TYPE
UI.FONT = Enum.Font.BuilderSans
UI.FONT_MED = Enum.Font.BuilderSansMedium
UI.FONT_BOLD = Enum.Font.BuilderSansBold
UI.H = Theme.HEIGHT.compact -- control / row height (24)
UI.H_LARGE = Theme.HEIGHT.regular -- 28: primary actions, list rows
UI.LABEL_W = Theme.LABEL_W -- label column of UI.row (96)
UI.SPACE = Theme.SPACE
UI.RADIUS = Theme.RADIUS
UI.TYPE = Theme.TYPE
UI.Theme = Theme
UI.Icons = Icons

local order = 0
local root, overlay, tipLabel, toastHost, catcher
local tipToken
local popupState = nil -- { modal = bool, onCancel = fn } while something floats in the overlay
local dragging = false
local rootConns = {}
UI.collapsed = {} -- section key -> collapsed (survives re-renders; App saves it)
UI.recentColors = {} -- hex strings, newest first (App saves it)

function UI.make(class, props, children)
	local inst = Instance.new(class)
	local parent = props.Parent
	props.Parent = nil
	if inst:IsA("GuiObject") then
		order += 1
		inst.LayoutOrder = order
		inst.BorderSizePixel = 0
	end
	for k, v in props do
		inst[k] = v
	end
	for _, child in children or {} do
		child.Parent = inst
	end
	inst.Parent = parent
	return inst
end
local make = UI.make

-- paints from tokens now and after every theme change: UI.skin(inst, { BackgroundColor3 = "surface" })
UI.skin = Theme.bind
local skin = Theme.bind

-- font + size of a role of UI.TYPE ("caps", "meta", "body", "control", "emphasis", "title", "code") on an instance or
-- on a props table for UI.make; weight overrides ("Regular" / "Medium" / "Bold")
UI.textStyle = Theme.text
local textStyle = Theme.text

-- the token whose colour this is (so a colour passed by a panel still follows the theme), or nil
local function tokenOf(color)
	if color == nil then
		return nil
	end
	for name, value in T do
		if value == color then
			return name
		end
	end
	return nil
end

-- sets prop from a colour or a token name; colours that are tokens stay bound to the theme
local function paintWith(inst, prop, color, default, map)
	map = map or {}
	local token = type(color) == "string" and color or tokenOf(color)
	if token then
		map[prop] = token
	elseif color ~= nil then
		inst[prop] = color
	else
		map[prop] = default
	end
	return map
end

-- ---------------------------------------------------------------------------------------------
-- layout helpers (unchanged signatures)
-- ---------------------------------------------------------------------------------------------
function UI.corner(r)
	return make("UICorner", { CornerRadius = UDim.new(0, r or Theme.RADIUS.control) })
end

-- a 1 px border; color may be a Color3 or a token name ("border" by default), bound to the theme
function UI.stroke(color, thickness)
	local s = make("UIStroke", { Thickness = thickness or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
	local map = paintWith(s, "Color", color, "border")
	if next(map) then
		skin(s, map)
	end
	return s
end

function UI.pad(t, r, b, l)
	return make("UIPadding", { PaddingTop = UDim.new(0, t), PaddingRight = UDim.new(0, r or t),
		PaddingBottom = UDim.new(0, b or t), PaddingLeft = UDim.new(0, l or r or t) })
end

function UI.vlist(gap)
	return make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, gap or 4) })
end

function UI.hlist(gap, fill)
	return make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, gap or 4),
		FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center,
		HorizontalFlex = fill and Enum.UIFlexAlignment.Fill or Enum.UIFlexAlignment.None })
end

-- ---------------------------------------------------------------------------------------------
-- motion: short Quad Out tweens (instant where TweenService is missing, e.g. in tests)
-- ---------------------------------------------------------------------------------------------
local tweenService = nil
local function getTweenService()
	if tweenService == nil then
		local ok, s = pcall(function()
			return game:GetService("TweenService")
		end)
		tweenService = ok and s or false
	end
	return tweenService or nil
end

function UI.animate(inst, props, duration)
	local ts = getTweenService()
	if ts then
		local ok = pcall(function()
			ts:Create(inst, TweenInfo.new(duration or Theme.MOTION.base, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				props):Play()
		end)
		if ok then
			return
		end
	end
	for k, v in props do
		inst[k] = v
	end
end
local animate = UI.animate

-- re-binds the colours of a component for a state and tweens to them
local function restyle(inst, map, duration)
	Theme.bind(inst, map)
	local target = {}
	for prop, token in map do
		target[prop] = T[token]
	end
	animate(inst, target, duration or Theme.MOTION.fast)
end

-- ---------------------------------------------------------------------------------------------
-- icons
-- ---------------------------------------------------------------------------------------------
-- an ImageLabel with a Studio glyph (Icons.GLYPHS), a class icon (opts.class = true) or a drawn glyph.
-- opts: size (16), color (Color3 or token, default "textDim"), rotation, position, anchor
function UI.icon(parent, name, opts)
	opts = opts or {}
	local size = opts.size or Theme.ICON
	local icon = opts.class and Icons.class(name) or Icons.get(name)
	if not icon and Icons.drawable(name) then
		local glyph = Icons.draw(parent, name, size, C.textDim)
		glyph.Position = opts.position or glyph.Position
		return glyph
	end
	icon = icon or Icons.get("placeholder")
	local img = make("ImageLabel", { Name = "Icon", Parent = parent, BackgroundTransparency = 1,
		Size = UDim2.fromOffset(size, size), ScaleType = Enum.ScaleType.Fit, Rotation = opts.rotation or 0 })
	Icons.apply(img, icon)
	if opts.position then
		img.Position = opts.position
	end
	if opts.anchor then
		img.AnchorPoint = opts.anchor
	end
	if icon.tint then
		local map = paintWith(img, "ImageColor3", opts.color, "textDim")
		if next(map) then
			skin(img, map)
		end
	end
	return img
end

-- ---------------------------------------------------------------------------------------------
-- root, overlay (menus, pickers, dialogs float above everything), tooltip, toasts, drag catcher
-- ---------------------------------------------------------------------------------------------
local UserInputService = nil
pcall(function()
	UserInputService = game:GetService("UserInputService")
end)

local function isEscape(input)
	return input.KeyCode == Enum.KeyCode.Escape
end

local function cancelPopup()
	local state = popupState
	UI.closePopup()
	if state and state.onCancel then
		state.onCancel()
	end
end

-- frees what setRoot connected (App:destroy)
function UI.release()
	for _, c in rootConns do
		pcall(function()
			c:Disconnect()
		end)
	end
	rootConns = {}
	Theme.unwatch()
end

function UI.setRoot(frame)
	UI.release()
	root = frame
	popupState = nil
	Theme.watch()
	overlay = make("TextButton", { Name = "Overlay", Parent = frame, Size = UDim2.fromScale(1, 1), Text = "",
		AutoButtonColor = false, BackgroundTransparency = 1, Visible = false, ZIndex = 50 })
	overlay.MouseButton1Click:Connect(cancelPopup)
	overlay.InputBegan:Connect(function(input)
		if isEscape(input) then
			cancelPopup()
		end
	end)
	toastHost = make("Frame", { Name = "Toasts", Parent = frame, AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -Theme.PAD), Size = UDim2.new(1, -Theme.PAD * 2, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, ZIndex = 45 },
		{ make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8),
			VerticalAlignment = Enum.VerticalAlignment.Bottom }),
		make("UISizeConstraint", { MaxSize = Vector2.new(360, math.huge) }) })
	tipLabel = make("TextLabel", textStyle({ Name = "Tooltip", Parent = frame, Visible = false, ZIndex = 60, Text = "",
		TextWrapped = true, AutomaticSize = Enum.AutomaticSize.XY, Size = UDim2.fromOffset(0, 0) }, "meta"),
		{ UI.corner(Theme.RADIUS.control), UI.stroke("border"), UI.pad(4, 8, 4, 8),
		make("UISizeConstraint", { MaxSize = Vector2.new(260, math.huge) }) })
	skin(tipLabel, { BackgroundColor3 = "tooltip", TextColor3 = "text" })
	catcher = make("TextButton", { Name = "DragCatcher", Parent = frame, Size = UDim2.fromScale(1, 1), Text = "",
		AutoButtonColor = false, BackgroundTransparency = 1, Visible = false, ZIndex = 80 })
	if UserInputService then
		pcall(function()
			table.insert(rootConns, UserInputService.InputBegan:Connect(function(input)
				if overlay and overlay.Visible and isEscape(input) then
					cancelPopup()
				end
			end))
		end)
	end
end

local function raise(inst, z)
	for _, child in inst:GetChildren() do
		if child:IsA("GuiObject") then
			child.ZIndex = z
		end
		raise(child, z + 1)
	end
end

-- a hint next to a control after hovering it for a moment (opts.tip of buttons, fields, icon buttons)
function UI.tip(target, text)
	target.MouseEnter:Connect(function()
		local token = {}
		tipToken = token
		task.delay(0.45, function()
			if tipToken ~= token or not tipLabel or not root or not target.Parent then
				return
			end
			local rootPos, rootSize = root.AbsolutePosition, root.AbsoluteSize
			tipLabel.Text = text
			local x = target.AbsolutePosition.X - rootPos.X
			local y = target.AbsolutePosition.Y - rootPos.Y + target.AbsoluteSize.Y + 4
			if y > rootSize.Y - 28 then
				y = target.AbsolutePosition.Y - rootPos.Y - 28
			end
			tipLabel.Position = UDim2.fromOffset(math.max(8, x), y)
			tipLabel.Visible = true
			task.defer(function() -- keep it inside the window once its width is known
				local w = tipLabel.AbsoluteSize.X
				tipLabel.Position = UDim2.fromOffset(math.clamp(x, 8, math.max(8, rootSize.X - w - 8)), y)
			end)
		end)
	end)
	target.MouseLeave:Connect(function()
		tipToken = nil
		if tipLabel then
			tipLabel.Visible = false
		end
	end)
end

function UI.closePopup()
	tipToken = nil
	popupState = nil
	if tipLabel then
		tipLabel.Visible = false
	end
	if not overlay then
		return
	end
	for _, child in overlay:GetChildren() do
		child:Destroy()
	end
	overlay.Visible = false
end

-- a floating surface under (or above) anchor, always inside the window; returns frame, width, height
local function popup(anchor, width, height, state)
	UI.closePopup()
	popupState = state or { modal = false }
	overlay.Visible = true
	local margin = Theme.SPACE.sm
	local rootPos, rootSize = root.AbsolutePosition, root.AbsoluteSize
	width = math.max(80, math.min(width, rootSize.X - margin * 2))
	height = math.max(24, math.min(height, rootSize.Y - margin * 2))
	local ax, ay = anchor.AbsolutePosition.X - rootPos.X, anchor.AbsolutePosition.Y - rootPos.Y
	local y = ay + anchor.AbsoluteSize.Y + 4
	if y + height > rootSize.Y - margin then
		local above = ay - height - 4
		y = above >= margin and above or math.max(margin, rootSize.Y - margin - height)
	end
	local x = math.clamp(ax, margin, math.max(margin, rootSize.X - width - margin))
	local frame = make("Frame", { Name = "Popup", Parent = overlay, Active = true, Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(width, height), ZIndex = 51 }, { UI.corner(Theme.RADIUS.surface), UI.stroke("border") })
	skin(frame, { BackgroundColor3 = "surface" })
	return frame, width, height
end

-- a raw floating surface for custom content (closes on outside click / Escape)
function UI.popover(anchor, width, height)
	return popup(anchor, width, height)
end

-- drag: shows the full-window catcher, calls onMove(position) on every mouse move and onEnd(position) on release
local function beginDrag(onMove, onEnd)
	if not catcher then
		return
	end
	catcher.Visible = true
	dragging = true
	local conns = {}
	local finished = false
	local function finish(position)
		if finished then
			return
		end
		finished = true
		dragging = false
		catcher.Visible = false
		for _, c in conns do
			c:Disconnect()
		end
		onEnd(position)
	end
	table.insert(conns, catcher.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement then
			onMove(input.Position)
		end
	end))
	table.insert(conns, catcher.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			finish(input.Position)
		end
	end))
	table.insert(conns, catcher.MouseButton1Up:Connect(function()
		finish(nil)
	end))
end
UI.beginDrag = beginDrag

-- true while the user is in the middle of something a redraw would break: a drag, an open menu / picker / dialog
-- (App holds its redraws until then, like it does while a text box is focused)
function UI.busy()
	return dragging or (overlay ~= nil and overlay.Visible == true)
end

local function pressed(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
end

-- ---------------------------------------------------------------------------------------------
-- text
-- ---------------------------------------------------------------------------------------------
-- the width of a line of text in a role of UI.TYPE (TextService:GetTextSize; an estimate where it is missing)
local textService = nil
function UI.textWidth(text, role)
	local spec = Theme.TYPE[role or "body"] or Theme.TYPE.body
	if textService == nil then
		local ok, service = pcall(function()
			return game:GetService("TextService")
		end)
		textService = ok and service or false
	end
	if textService then
		local ok, width = pcall(function()
			return textService:GetTextSize(text, spec.size, Theme.enumFont(spec.weight), Vector2.new(10000, 1000)).X
		end)
		if ok and type(width) == "number" then
			return math.ceil(width)
		end
	end
	return math.ceil((utf8.len(text) or #text) * spec.size * 0.52)
end

local function escape(s)
	return (string.gsub(tostring(s), "[&<>\"]", { ["&"] = "&amp;", ["<"] = "&lt;", [">"] = "&gt;", ['"'] = "&quot;" }))
end
UI.escape = escape

-- opts: role (UI.TYPE key), size, bold / medium, dim, color (Color3 or token), wrap, rich, width, height, align
function UI.label(parent, text, opts)
	opts = opts or {}
	local role = opts.role or ((opts.size and opts.size <= 11) and "meta" or "body")
	local props = { Parent = parent, Text = text, BackgroundTransparency = 1,
		TextXAlignment = opts.align or Enum.TextXAlignment.Left, TextWrapped = opts.wrap or false, RichText = opts.rich or false,
		Size = opts.wrap and UDim2.new(1, 0, 0, 0) or (opts.width and UDim2.new(0, opts.width, 0, opts.height or UI.H)
			or UDim2.new(1, 0, 0, opts.height or UI.H)),
		AutomaticSize = opts.wrap and Enum.AutomaticSize.Y or Enum.AutomaticSize.None,
		TextTruncate = opts.wrap and Enum.TextTruncate.None or Enum.TextTruncate.AtEnd }
	textStyle(props, role, opts.bold and "Bold" or (opts.medium and "Medium" or nil))
	if opts.size then
		props.TextSize = opts.size
	end
	local l = make("TextLabel", props)
	local map = paintWith(l, "TextColor3", opts.color, opts.dim and "textDim" or "text")
	if next(map) then
		skin(l, map)
	end
	return l
end

-- ---------------------------------------------------------------------------------------------
-- buttons
-- ---------------------------------------------------------------------------------------------
-- token names per state; bg = nil: transparent until hovered
local BUTTON = {
	primary = { bg = "accent", hover = "accentHover", press = "accentPressed", text = "accentText" },
	normal = { bg = "button", hover = "buttonHover", press = "buttonPressed", text = "buttonText", border = "buttonBorder" },
	ghost = { hover = "surfaceHover", press = "surfacePressed", text = "textDim", hoverText = "text" },
	danger = { bg = "button", hover = "dangerSoft", press = "dangerSoft", text = "danger", border = "buttonBorder" },
	destructive = { bg = "danger", hover = "danger", press = "danger", text = "accentText" },
	selected = { bg = "accentSoft", hover = "accentSoftHover", press = "accentSoft", text = "text", border = "accent" },
	link = { hover = "surfaceHover", press = "surfacePressed", text = "accent" },
}
BUTTON.secondary = BUTTON.normal
UI.BUTTON_STYLES = BUTTON

-- opts: style (primary / normal / ghost / danger / destructive), selected, icon (glyph name), width, scale, height,
-- autoWidth, align, textSize, tip, disabled. bold is accepted and ignored (buttons are Medium).
function UI.button(parent, text, onClick, opts)
	opts = opts or {}
	local style = BUTTON[opts.selected and "selected" or (opts.style or "normal")] or BUTTON.normal
	local disabled = opts.disabled == true
	local height = opts.height or UI.H
	local hasIcon = opts.icon ~= nil and text ~= ""
	local props = { Parent = parent, Text = text, AutoButtonColor = false, TextTruncate = Enum.TextTruncate.AtEnd,
		TextXAlignment = opts.align or (hasIcon and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center),
		BackgroundTransparency = style.bg and 0 or 1,
		Size = opts.width and UDim2.new(0, opts.width, 0, height) or UDim2.new(opts.autoWidth and 0 or (opts.scale or 1), 0, 0, height),
		AutomaticSize = opts.autoWidth and Enum.AutomaticSize.X or Enum.AutomaticSize.None }
	textStyle(props, "control")
	if opts.textSize then
		props.TextSize = opts.textSize
	end
	local padLeft = hasIcon and 28 or (text == "" and 0 or 8)
	local b = make("TextButton", props, { UI.corner(Theme.RADIUS.control), UI.pad(0, text == "" and 0 or 8, 0, padLeft) })
	local textToken = disabled and "textDisabled" or style.text
	skin(b, { BackgroundColor3 = style.bg or style.hover, TextColor3 = textToken })
	if style.border then
		UI.stroke(style.border).Parent = b
	end
	local img
	if opts.icon then
		img = UI.icon(b, opts.icon, { color = textToken, anchor = Vector2.new(0, 0.5),
			position = text == "" and UDim2.new(0.5, -8, 0.5, 0) or UDim2.new(0, -21, 0.5, 0) })
	end
	b:SetAttribute("Disabled", disabled or nil)
	if not disabled then
		local function state(name)
			local bg = name == "press" and style.press or (name == "hover" and style.hover or style.bg)
			b.BackgroundTransparency = bg and 0 or 1
			local textColor = (name ~= "idle" and style.hoverText) or style.text
			restyle(b, { BackgroundColor3 = bg or style.hover, TextColor3 = textColor })
			if img and img:IsA("ImageLabel") then
				restyle(img, { ImageColor3 = textColor })
			end
		end
		b.MouseEnter:Connect(function()
			state("hover")
		end)
		b.MouseLeave:Connect(function()
			state("idle")
		end)
		b.MouseButton1Down:Connect(function()
			state("press")
		end)
		b.MouseButton1Up:Connect(function()
			state("hover")
		end)
		if onClick then
			b.MouseButton1Click:Connect(onClick)
		end
	end
	if opts.tip then
		UI.tip(b, opts.tip)
	end
	return b
end

-- a square button with one glyph. opts: size (24), iconSize (16), tip, active (pressed-in state, accent glyph),
-- danger (hover in the danger colour), color (glyph colour at rest, default textDim), disabled, name
function UI.iconButton(parent, icon, onClick, opts)
	opts = opts or {}
	local size = opts.size or UI.H
	local b = make("TextButton", { Name = opts.name or ("IconButton_" .. tostring(icon)), Parent = parent, Text = "",
		AutoButtonColor = false, BackgroundTransparency = opts.active and 0 or 1, Size = UDim2.fromOffset(size, size) },
		{ UI.corner(Theme.RADIUS.control) })
	local rest = opts.disabled and "textDisabled" or (opts.active and "accent"
		or ((type(opts.color) == "string" and opts.color) or tokenOf(opts.color) or "textDim"))
	skin(b, { BackgroundColor3 = opts.active and "accentSoft" or "surfaceHover" })
	local img = UI.icon(b, icon, { size = opts.iconSize or Theme.ICON, color = rest, anchor = Vector2.new(0.5, 0.5),
		position = UDim2.fromScale(0.5, 0.5) })
	local function glyph(token)
		if img:IsA("ImageLabel") then
			restyle(img, { ImageColor3 = token })
		end
	end
	b:SetAttribute("Active", opts.active or nil)
	if not opts.disabled then
		b.MouseEnter:Connect(function()
			b.BackgroundTransparency = 0
			glyph(opts.danger and "danger" or (opts.active and "accent" or "text"))
		end)
		b.MouseLeave:Connect(function()
			b.BackgroundTransparency = opts.active and 0 or 1
			glyph(rest)
		end)
		b.MouseButton1Down:Connect(function()
			restyle(b, { BackgroundColor3 = "surfacePressed" })
		end)
		b.MouseButton1Up:Connect(function()
			restyle(b, { BackgroundColor3 = opts.active and "accentSoft" or "surfaceHover" })
		end)
		if onClick then
			b.MouseButton1Click:Connect(onClick)
		end
	end
	if opts.tip then
		UI.tip(b, opts.tip)
	end
	return b
end

-- ---------------------------------------------------------------------------------------------
-- stacks and rows (unchanged signatures)
-- ---------------------------------------------------------------------------------------------
function UI.hstack(parent, opts)
	opts = opts or {}
	return make("Frame", { Parent = parent, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, opts.height or UI.H) },
		{ UI.hlist(opts.gap or Theme.SPACE.sm, opts.fill ~= false) })
end

function UI.vstack(parent, gap)
	return make("Frame", { Parent = parent, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y }, { UI.vlist(gap or Theme.SPACE.xs) })
end

-- a labelled row: returns the area where the controls go (they share the width)
function UI.row(parent, text, opts)
	opts = opts or {}
	local labelWidth = opts.labelWidth or UI.LABEL_W
	local row = make("Frame", { Parent = parent, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, opts.height or UI.H) },
		{ UI.hlist(Theme.SPACE.sm, false) })
	UI.label(row, text, { width = labelWidth, dim = true, height = opts.height })
	local area = make("Frame", { Parent = row, BackgroundTransparency = 1,
		Size = UDim2.new(1, -(labelWidth + Theme.SPACE.sm), 1, 0) }, { UI.hlist(Theme.SPACE.xs, true) })
	return area
end

function UI.divider(parent, opts)
	opts = opts or {}
	local d = make("Frame", { Name = "Divider", Parent = parent, Size = opts.vertical and UDim2.new(0, 1, 1, 0)
		or UDim2.new(1, -(opts.inset or 0) * 2, 0, 1) })
	skin(d, { BackgroundColor3 = "divider" })
	return d
end

function UI.spacer(parent, h)
	return make("Frame", { Parent = parent, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, h or 4) })
end

-- ---------------------------------------------------------------------------------------------
-- fields
-- ---------------------------------------------------------------------------------------------
local CTRL_KEYS = { Enum.KeyCode.LeftControl, Enum.KeyCode.RightControl }
local SHIFT_KEYS = { Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift }

local function modifierDown(input, modifier, keys)
	local ok, down = pcall(input.IsModifierKeyDown, input, modifier)
	if ok and down then
		return true
	end
	if UserInputService then
		for _, key in keys do
			local okKey, isDown = pcall(function()
				return UserInputService:IsKeyDown(key)
			end)
			if okKey and isDown then
				return true
			end
		end
	end
	return false
end

local function fmt(v, decimals)
	if decimals == 0 then
		return tostring(math.floor(v + 0.5))
	end
	local s = string.format("%." .. (decimals or 2) .. "f", v)
	s = s:gsub("0+$", ""):gsub("%.$", "")
	return s == "-0" and "0" or s
end
UI.fmt = fmt

-- the look shared by text boxes: field background, 1 px border that lights up on hover and focus
local function fieldBox(parent, props, opts)
	props.Parent = parent
	props.ClearTextOnFocus = false
	props.Size = props.Size or (opts.width and UDim2.new(0, opts.width, 0, opts.height or UI.H)
		or UDim2.new(opts.scale or 1, 0, 0, opts.height or UI.H))
	textStyle(props, opts.mono and "code" or "body")
	local border = UI.stroke("fieldBorder")
	local box = make("TextBox", props, { UI.corner(Theme.RADIUS.control), border,
		UI.pad(0, opts.padRight or 8, 0, opts.padLeft or 8) })
	skin(box, { BackgroundColor3 = "field", TextColor3 = "text", PlaceholderColor3 = "textDisabled" })
	box.MouseEnter:Connect(function()
		if not box:IsFocused() then
			restyle(border, { Color = "fieldBorderHover" })
		end
	end)
	box.MouseLeave:Connect(function()
		if not box:IsFocused() then
			restyle(border, { Color = "fieldBorder" })
		end
	end)
	box.Focused:Connect(function()
		restyle(border, { Color = "focus" })
	end)
	box.FocusLost:Connect(function()
		restyle(border, { Color = "fieldBorder" })
	end)
	return box, border
end

-- the number field behind UI.number and UI.scrub; returns the box and a controller
local function numberField(parent, value, onChange, opts)
	local box = fieldBox(parent, { Text = fmt(value, opts.decimals), TextXAlignment = Enum.TextXAlignment.Left },
		{ width = opts.width, padRight = opts.unit and 28 or 8 })
	if opts.unit then
		UI.label(box, opts.unit, { role = "meta", dim = true, width = 24, align = Enum.TextXAlignment.Right }).Position =
			UDim2.new(1, 0, 0, 0)
	end
	local field = { current = value, committed = value }
	local function clamp(v)
		if opts.min then
			v = math.max(opts.min, v)
		end
		if opts.max then
			v = math.min(opts.max, v)
		end
		return v
	end
	field.clamp = clamp
	function field.show(v)
		field.current = clamp(v)
		box.Text = fmt(field.current, opts.decimals)
	end
	function field.commit(v)
		v = clamp(v)
		field.current = v
		field.committed = v
		box.Text = fmt(v, opts.decimals)
		if onChange then
			onChange(v)
		end
	end
	box.FocusLost:Connect(function()
		local v = tonumber((box.Text:gsub(",", ".")))
		if v and v ~= field.current then
			field.commit(v)
		else
			box.Text = fmt(field.current, opts.decimals)
		end
	end)
	-- Ctrl + mouse wheel nudges the value (Shift = x10). A plain wheel only scrolls the panel. The new value is applied
	-- once the wheel stops (one Ctrl+Z per gesture and no redraw on every notch).
	local wheelGen = 0
	box.InputChanged:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseWheel or box:IsFocused()
			or not modifierDown(input, Enum.ModifierKey.Ctrl, CTRL_KEYS) then
			return
		end
		local step = (opts.step or 0.1) * (modifierDown(input, Enum.ModifierKey.Shift, SHIFT_KEYS) and 10 or 1)
		field.show(field.current + (input.Position.Z > 0 and 1 or -1) * step)
		wheelGen += 1
		local gen = wheelGen
		task.delay(0.35, function()
			if gen == wheelGen and field.current ~= field.committed then -- e.g. not when it was already at min / max
				field.commit(field.current)
			end
		end)
	end)
	return box, field
end

-- opts: min, max, step (0.1), decimals, width, unit ("s", "°", "studs"), tip
function UI.number(parent, value, onChange, opts)
	opts = opts or {}
	local box = numberField(parent, value, onChange, opts)
	UI.tip(box, (opts.tip and (opts.tip .. "  ·  ") or "") .. "Ctrl + rotiță: ±" .. fmt(opts.step or 0.1, 3)
		.. " (Shift ×10)")
	return box
end

-- a number field with a label you drag left / right to change the value (Shift = fine, step / 10); one onChange on
-- release (one Ctrl+Z). opts: min, max, step, decimals, unit, labelWidth, tip, onInput(v) while dragging.
-- Returns the row and the number box.
function UI.scrub(parent, label, value, onChange, opts)
	opts = opts or {}
	local labelWidth = opts.labelWidth or UI.LABEL_W
	local row = make("Frame", { Name = "Scrub", Parent = parent, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, UI.H) },
		{ UI.hlist(Theme.SPACE.sm, false) })
	local handleProps = { Name = "ScrubHandle", Parent = row, Text = label, AutoButtonColor = false, BackgroundTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Size = UDim2.new(0, labelWidth, 1, 0) }
	textStyle(handleProps, "body")
	local handle = make("TextButton", handleProps)
	skin(handle, { TextColor3 = "textDim" })
	local holder = make("Frame", { Parent = row, BackgroundTransparency = 1, Size = UDim2.new(1, -(labelWidth + Theme.SPACE.sm), 1, 0) },
		{ UI.hlist(0, true) })
	local box, field = numberField(holder, value, onChange, opts)
	local step = opts.step or 0.1
	UI.tip(handle, (opts.tip and (opts.tip .. "  ·  ") or "") .. "Trage stânga-dreapta: ±" .. fmt(step, 3)
		.. " pe pixel (Shift: fin)")
	UI.tip(box, "Ctrl + rotiță: ±" .. fmt(step, 3) .. " (Shift ×10)")
	local dragging = false
	handle.MouseEnter:Connect(function()
		restyle(handle, { TextColor3 = "text" })
	end)
	handle.MouseLeave:Connect(function()
		if not dragging then
			restyle(handle, { TextColor3 = "textDim" })
		end
	end)
	handle.InputBegan:Connect(function(input)
		if not pressed(input) then
			return
		end
		dragging = true
		local startX, startValue = input.Position.X, field.current
		restyle(handle, { TextColor3 = "accent" })
		beginDrag(function(position)
			local fine = modifierDown(input, Enum.ModifierKey.Shift, SHIFT_KEYS)
			local unit = fine and step / 10 or step
			local v = startValue + (position.X - startX) * unit
			v = math.floor(v / unit + 0.5) * unit
			field.show(v)
			if opts.onInput then
				opts.onInput(field.current)
			end
		end, function()
			dragging = false
			restyle(handle, { TextColor3 = "textDim" })
			if field.current ~= field.committed then
				field.commit(field.current)
			end
		end)
	end)
	return row, box
end

-- a horizontal slider with its value on the right. onChange(v) once on release (one Ctrl+Z); opts.onInput(v) while
-- dragging. opts: min (0), max (1), step (0.01), decimals (2), unit, field (an editable number field instead of the value
-- label), valueWidth (44), scale
function UI.slider(parent, value, onChange, opts)
	opts = opts or {}
	local min, max = opts.min or 0, opts.max or 1
	local step = opts.step or 0.01
	local decimals = opts.decimals or 2
	local valueW = opts.valueWidth or (opts.field and 56 or 44)
	local frame = make("Frame", { Name = "Slider", Parent = parent, BackgroundTransparency = 1,
		Size = UDim2.new(opts.scale or 1, 0, 0, UI.H) })
	local hit = make("TextButton", { Name = "Hit", Parent = frame, Text = "", AutoButtonColor = false, BackgroundTransparency = 1,
		Size = UDim2.new(1, -(valueW + Theme.SPACE.sm), 1, 0) })
	local track = make("Frame", { Name = "Track", Parent = hit, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 6, 0.5, 0),
		Size = UDim2.new(1, -12, 0, 4) }, { UI.corner(2) })
	skin(track, { BackgroundColor3 = "switchOff" })
	local fill = make("Frame", { Name = "Fill", Parent = track, Size = UDim2.fromScale(0, 1) }, { UI.corner(2) })
	skin(fill, { BackgroundColor3 = "accent" })
	local knob = make("Frame", { Name = "Knob", Parent = track, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(12, 12) },
		{ UI.corner(6), UI.stroke("border") })
	skin(knob, { BackgroundColor3 = "knob" })
	local current, committed = value, value
	local readout, field = nil, nil
	local function show(v)
		current = math.clamp(v, min, max)
		local f = max > min and (current - min) / (max - min) or 0
		fill.Size = UDim2.fromScale(f, 1)
		knob.Position = UDim2.fromScale(f, 0.5)
		if readout then
			readout.Text = fmt(current, decimals) .. (opts.unit and (" " .. opts.unit) or "")
		elseif field then
			field.show(current)
		end
	end
	if opts.field then
		local holder = make("Frame", { Parent = frame, BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.fromScale(1, 0), Size = UDim2.new(0, valueW, 1, 0) })
		local _, f = numberField(holder, value, function(v)
			show(v)
			committed = current
			onChange(current)
		end, { min = min, max = max, step = step, decimals = decimals, unit = opts.unit })
		field = f
	else
		readout = UI.label(frame, "", { role = "meta", dim = true, width = valueW, align = Enum.TextXAlignment.Right })
		readout.AnchorPoint = Vector2.new(1, 0)
		readout.Position = UDim2.fromScale(1, 0)
	end
	show(value)
	local function at(position)
		if not position then
			return
		end
		local p, size = track.AbsolutePosition, track.AbsoluteSize
		local f = math.clamp((position.X - p.X) / math.max(1, size.X), 0, 1)
		local v = min + math.floor(f * (max - min) / step + 0.5) * step
		show(v)
		if opts.onInput then
			opts.onInput(current)
		end
	end
	hit.InputBegan:Connect(function(input)
		if not pressed(input) then
			return
		end
		at(input.Position)
		beginDrag(at, function()
			if current ~= committed then
				committed = current
				onChange(current)
			end
		end)
	end)
	hit.MouseEnter:Connect(function()
		restyle(fill, { BackgroundColor3 = "accentHover" })
	end)
	hit.MouseLeave:Connect(function()
		restyle(fill, { BackgroundColor3 = "accent" })
	end)
	if opts.tip then
		UI.tip(hit, opts.tip)
	end
	return frame
end

-- opts: placeholder, width, scale, mono
function UI.textbox(parent, value, onChange, opts)
	opts = opts or {}
	local box = fieldBox(parent, { Text = value or "", PlaceholderText = opts.placeholder or "",
		TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd }, opts)
	box.FocusLost:Connect(function(enter)
		if onChange and box.Text ~= value then
			onChange(box.Text, enter)
		end
	end)
	return box
end

-- a search field: glyph, text, clear button. onChange(text) after a short pause (opts.delay, 0.15 s), at once on
-- Enter and on clear. opts: placeholder ("Caută"), width. Returns the frame and the TextBox.
function UI.search(parent, value, onChange, opts)
	opts = opts or {}
	local frame = make("Frame", { Name = "Search", Parent = parent,
		Size = opts.width and UDim2.new(0, opts.width, 0, UI.H) or UDim2.new(1, 0, 0, UI.H) }, { UI.corner(Theme.RADIUS.control) })
	skin(frame, { BackgroundColor3 = "field" })
	local border = UI.stroke("fieldBorder")
	border.Parent = frame
	UI.icon(frame, "search", { size = 14, anchor = Vector2.new(0, 0.5), position = UDim2.new(0, 8, 0.5, 0) })
	local props = { Parent = frame, Text = value or "", PlaceholderText = opts.placeholder or "Caută", ClearTextOnFocus = false,
		BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(28, 0), Size = UDim2.new(1, -52, 1, 0) }
	textStyle(props, "body")
	local box = make("TextBox", props)
	skin(box, { TextColor3 = "text", PlaceholderColor3 = "textDisabled" })
	local sent = value or ""
	local function send(text)
		if text ~= sent then
			sent = text
			onChange(text)
		end
	end
	local clear = UI.iconButton(frame, "close", function()
		box.Text = ""
		send("")
		box:CaptureFocus()
	end, { size = 20, iconSize = 14, tip = "Golește" })
	clear.AnchorPoint = Vector2.new(1, 0.5)
	clear.Position = UDim2.new(1, -2, 0.5, 0)
	clear.Visible = (value or "") ~= ""
	local gen = 0
	box:GetPropertyChangedSignal("Text"):Connect(function()
		clear.Visible = box.Text ~= ""
		gen += 1
		local mine = gen
		task.delay(opts.delay or 0.15, function()
			if mine == gen then
				send(box.Text)
			end
		end)
	end)
	box.FocusLost:Connect(function()
		send(box.Text)
		restyle(border, { Color = "fieldBorder" })
	end)
	box.Focused:Connect(function()
		restyle(border, { Color = "focus" })
	end)
	return frame, box
end

-- ---------------------------------------------------------------------------------------------
-- switch, toggle, segmented
-- ---------------------------------------------------------------------------------------------
local SWITCH_W, SWITCH_H, KNOB = 28, 16, 12

local function drawSwitch(parent, value)
	local track = make("Frame", { Name = "Switch", Parent = parent, Size = UDim2.fromOffset(SWITCH_W, SWITCH_H) },
		{ UI.corner(SWITCH_H // 2) })
	skin(track, { BackgroundColor3 = value and "accent" or "switchOff" })
	local knob = make("Frame", { Name = "Knob", Parent = track, AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, value and (SWITCH_W - KNOB - 2) or 2, 0.5, 0), Size = UDim2.fromOffset(KNOB, KNOB) },
		{ UI.corner(KNOB // 2) })
	skin(knob, { BackgroundColor3 = "knob" })
	local function set(on, instant)
		local position = UDim2.new(0, on and (SWITCH_W - KNOB - 2) or 2, 0.5, 0)
		if instant then
			knob.Position = position
			skin(track, { BackgroundColor3 = on and "accent" or "switchOff" })
		else
			animate(knob, { Position = position }, Theme.MOTION.base)
			restyle(track, { BackgroundColor3 = on and "accent" or "switchOff" }, Theme.MOTION.base)
		end
	end
	return track, set
end

-- a switch on its own (28 x 16). onChange(newValue). opts: disabled, tip. The "Checked" attribute holds the state.
function UI.switch(parent, value, onChange, opts)
	opts = opts or {}
	local b = make("TextButton", { Name = "SwitchButton", Parent = parent, Text = "", AutoButtonColor = false,
		BackgroundTransparency = 1, Size = UDim2.fromOffset(SWITCH_W, UI.H) })
	local track, set = drawSwitch(b, value == true)
	track.AnchorPoint = Vector2.new(0, 0.5)
	track.Position = UDim2.fromScale(0, 0.5)
	local state = value == true
	b:SetAttribute("Checked", state)
	if not opts.disabled then
		b.MouseButton1Click:Connect(function()
			state = not state
			b:SetAttribute("Checked", state)
			set(state)
			onChange(state)
		end)
	end
	if opts.tip then
		UI.tip(b, opts.tip)
	end
	return b
end

-- a switch with its label; the whole row is clickable. onChange(not value). Returns the TextButton (attribute
-- "Checked" = state). opts: width, scale, tip, disabled
function UI.toggle(parent, value, onChange, text, opts)
	opts = opts or {}
	local props = { Name = "Toggle", Parent = parent, Text = text, AutoButtonColor = false, BackgroundTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
		Size = opts.width and UDim2.new(0, opts.width, 0, UI.H) or UDim2.new(opts.scale or 1, 0, 0, UI.H) }
	textStyle(props, "body")
	local b = make("TextButton", props, { UI.pad(0, 0, 0, SWITCH_W + 8) })
	skin(b, { TextColor3 = opts.disabled and "textDisabled" or "text" })
	local track, set = drawSwitch(b, value == true)
	track.AnchorPoint = Vector2.new(0, 0.5)
	track.Position = UDim2.new(0, -(SWITCH_W + 8), 0.5, 0)
	b:SetAttribute("Checked", value == true)
	if not opts.disabled then
		b.MouseEnter:Connect(function()
			if not value then
				restyle(track, { BackgroundColor3 = "textDisabled" })
			end
		end)
		b.MouseLeave:Connect(function()
			if not value then
				restyle(track, { BackgroundColor3 = "switchOff" })
			end
		end)
		b.MouseButton1Click:Connect(function()
			set(not value)
			b:SetAttribute("Checked", not value)
			onChange(not value)
		end)
	end
	if opts.tip then
		UI.tip(b, opts.tip)
	end
	return b
end

-- items: { { value =, label =, tip = } }. One bordered control; the chosen segment is raised.
function UI.segmented(parent, items, value, onChange)
	local bar = make("Frame", { Name = "Segmented", Parent = parent, Size = UDim2.new(1, 0, 0, UI.H) },
		{ UI.corner(Theme.RADIUS.control), UI.stroke("fieldBorder"), UI.pad(2, 2, 2, 2), UI.hlist(2, true) })
	skin(bar, { BackgroundColor3 = "field" })
	for _, item in items do
		local on = item.value == value
		local props = { Parent = bar, Text = item.label, AutoButtonColor = false, BackgroundTransparency = on and 0 or 1,
			TextTruncate = Enum.TextTruncate.AtEnd, Size = UDim2.new(1, 0, 1, 0) }
		textStyle(props, "control", on and "Medium" or "Regular")
		local seg = make("TextButton", props, { UI.corner(3), UI.pad(0, 4, 0, 4) })
		skin(seg, { BackgroundColor3 = "raisedStrong", TextColor3 = on and "text" or "textDim" })
		seg:SetAttribute("Checked", on)
		if not on then
			seg.MouseEnter:Connect(function()
				restyle(seg, { TextColor3 = "text" })
			end)
			seg.MouseLeave:Connect(function()
				restyle(seg, { TextColor3 = "textDim" })
			end)
		end
		seg.MouseButton1Click:Connect(function()
			onChange(item.value)
		end)
		if item.tip then
			UI.tip(seg, item.tip)
		end
	end
	return bar
end

-- ---------------------------------------------------------------------------------------------
-- menus and dropdowns
-- ---------------------------------------------------------------------------------------------
local ROW_H = 24

local function menuHeight(items)
	local h = 0
	for _, item in items do
		h += item.separator and 9 or ROW_H
	end
	return h
end

-- rows of a menu into `list`. items: { label, value, icon, classIcon, hint, header, separator, danger, disabled,
-- onClick }. opts.value = the chosen value (check mark); opts.checks = leave room for the check column
local function menuRows(list, items, opts, onPick)
	for _, item in items do
		if item.separator then
			local holder = make("Frame", { Parent = list, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 9) })
			UI.divider(holder).Position = UDim2.fromOffset(0, 4)
		elseif item.header then
			local l = UI.label(list, "<uc>" .. escape(item.label) .. "</uc>", { role = "caps", dim = true, rich = true,
				height = ROW_H })
			UI.pad(0, 8, 0, 8).Parent = l
		else
			local chosen = opts.checks and item.value ~= nil and item.value == opts.value
			local props = { Parent = list, Text = item.label or "", AutoButtonColor = false, BackgroundTransparency = 1,
				TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Size = UDim2.new(1, 0, 0, ROW_H) }
			textStyle(props, "body", chosen and "Medium" or nil)
			local left = 8 + (opts.checks and 20 or 0) + ((item.icon or item.classIcon) and 22 or 0)
			local entry = make("TextButton", props, { UI.corner(Theme.RADIUS.control), UI.pad(0, item.hint and 56 or 8, 0, left) })
			local color = item.disabled and "textDisabled" or (item.danger and "danger" or "text")
			skin(entry, { BackgroundColor3 = "surfaceHover", TextColor3 = color })
			if chosen then
				UI.icon(entry, "check", { size = 14, color = "accent", anchor = Vector2.new(0, 0.5),
					position = UDim2.new(0, -left + 8, 0.5, 0) })
				entry:SetAttribute("Checked", true)
			end
			if item.icon or item.classIcon then
				UI.icon(entry, item.classIcon or item.icon, { class = item.classIcon ~= nil, color = color,
					anchor = Vector2.new(0, 0.5), position = UDim2.new(0, -22, 0.5, 0) })
			end
			if item.hint then
				local hint = UI.label(entry, item.hint, { role = "meta", dim = true, width = 48, align = Enum.TextXAlignment.Right,
					height = ROW_H })
				hint.Position = UDim2.new(1, 0, 0, 0)
			end
			if not item.disabled then
				entry.MouseEnter:Connect(function()
					entry.BackgroundTransparency = 0
				end)
				entry.MouseLeave:Connect(function()
					entry.BackgroundTransparency = 1
				end)
				entry.MouseButton1Click:Connect(function()
					UI.closePopup()
					onPick(item)
				end)
			end
		end
	end
end

-- a scrolling list inside a popup, with a filter box once there are many rows
local function menuPopup(anchor, items, opts, onPick)
	local count = 0
	for _, item in items do
		if not item.header and not item.separator then
			count += 1
		end
	end
	local searchable = count > 14
	local top = searchable and 32 or 0
	local frame = popup(anchor, math.max(anchor.AbsoluteSize.X, opts.menuWidth or 180), menuHeight(items) + 8 + top,
		{ modal = false, onCancel = opts.onClose })
	local list = make("ScrollingFrame", { Parent = frame, Position = UDim2.fromOffset(0, top), Size = UDim2.new(1, 0, 1, -top),
		BackgroundTransparency = 1, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 4,
		ScrollingDirection = Enum.ScrollingDirection.Y, VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar },
		{ UI.vlist(0), UI.pad(4, 4, 4, 4) })
	skin(list, { ScrollBarImageColor3 = "scrollbar" })
	menuRows(list, items, opts, onPick)
	if searchable then
		local holder = make("Frame", { Parent = frame, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, top) },
			{ UI.pad(6, 6, 2, 6) })
		local _, box = UI.search(holder, "", function(text)
			for _, child in list:GetChildren() do
				if child:IsA("GuiObject") then
					child:Destroy()
				end
			end
			local query = string.lower(text)
			local shown = {}
			for _, item in items do
				if not item.header and not item.separator and (query == ""
					or string.find(string.lower(item.label or ""), query, 1, true)) then
					table.insert(shown, item)
				end
			end
			menuRows(list, query == "" and items or shown, opts, onPick)
			raise(frame, 52)
		end, { placeholder = "Filtrează", delay = 0.1 })
		task.defer(function()
			if box.Parent then
				box:CaptureFocus()
			end
		end)
	end
	raise(frame, 52)
	return frame
end

-- a menu of actions under anchor. items: { label, icon, hint, danger, disabled, onClick } / { separator = true } /
-- { header = true, label }. opts: width
function UI.menu(anchor, items, opts)
	opts = opts or {}
	return menuPopup(anchor, items, { menuWidth = opts.width or 180 }, function(item)
		if item.onClick then
			item.onClick()
		end
	end)
end

-- items: { { value =, label =, icon = / classIcon =, hint =, header = bool, separator = bool } }.
-- opts: text (fixed label: an action menu), placeholder, style ("primary" for an action menu), width, scale, menuWidth,
-- tip. The chosen item has a check mark; more than 14 items get a filter box.
function UI.dropdown(parent, items, value, onChange, opts)
	opts = opts or {}
	local current, currentItem = opts.text, nil
	for _, item in items do
		if not item.header and not item.separator and item.value == value then
			currentItem = item
			current = current or item.label
		end
	end
	local action = opts.style == "primary" or opts.style == "normal" or opts.style == "ghost"
	local showIcon = not opts.text and currentItem and (currentItem.icon or currentItem.classIcon)
	local height = opts.height or UI.H
	local props = { Name = "Dropdown", Parent = parent, Text = current or opts.placeholder or "Alege", AutoButtonColor = false,
		TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
		Size = opts.width and UDim2.new(0, opts.width, 0, height) or UDim2.new(opts.scale or 1, 0, 0, height) }
	textStyle(props, action and "control" or "body")
	local b = make("TextButton", props, { UI.corner(Theme.RADIUS.control), UI.pad(0, 26, 0, showIcon and 30 or 8) })
	local style = action and BUTTON[opts.style] or nil
	local textToken = style and style.text or (current and "text" or "textDisabled")
	skin(b, { BackgroundColor3 = style and (style.bg or style.hover) or "field", TextColor3 = textToken })
	b.BackgroundTransparency = (style and not style.bg) and 1 or 0
	local border = nil
	if not style or style.border then
		border = UI.stroke(style and style.border or "fieldBorder")
		border.Parent = b
	end
	if showIcon then
		UI.icon(b, currentItem.classIcon or currentItem.icon, { class = currentItem.classIcon ~= nil, anchor = Vector2.new(0, 0.5),
			position = UDim2.new(0, -22, 0.5, 0) })
	end
	local chevron = UI.icon(b, "chevronDown", { size = 12, color = style and style.text or "textDim",
		anchor = Vector2.new(1, 0.5), position = UDim2.new(1, 18, 0.5, 0) })
	b.MouseEnter:Connect(function()
		if style then
			if style.hover then
				b.BackgroundTransparency = 0
				restyle(b, { BackgroundColor3 = style.hover, TextColor3 = style.hoverText or style.text })
			end
		elseif border then
			restyle(border, { Color = "fieldBorderHover" })
		end
	end)
	b.MouseLeave:Connect(function()
		if style then
			b.BackgroundTransparency = style.bg and 0 or 1
			restyle(b, { BackgroundColor3 = style.bg or style.hover, TextColor3 = style.text })
		elseif border then
			restyle(border, { Color = "fieldBorder" })
		end
	end)
	local function rest()
		if border and not style and b.Parent then
			restyle(border, { Color = "fieldBorder" })
		end
	end
	b.MouseButton1Click:Connect(function()
		menuPopup(b, items, { menuWidth = opts.menuWidth, value = value, checks = not opts.text, onClose = rest }, function(item)
			rest()
			onChange(item.value)
		end)
		if border and not style then
			restyle(border, { Color = "focus" })
		end
	end)
	if opts.tip then
		UI.tip(b, opts.tip)
	end
	b:SetAttribute("Value", type(value) == "string" and value or nil)
	return b, chevron
end

-- ---------------------------------------------------------------------------------------------
-- colour: a swatch field that opens the picker
-- ---------------------------------------------------------------------------------------------
local function hexOf(c)
	local ok, hex = pcall(function()
		return c:ToHex()
	end)
	return ok and string.upper(tostring(hex)) or "FFFFFF"
end

-- HSV in plain math (Color3.fromHSV / ToHSV are not in every environment the panels run in)
local function toHSV(c)
	local r, g, b = c.R, c.G, c.B
	local max, min = math.max(r, g, b), math.min(r, g, b)
	local d = max - min
	local h = 0
	if d > 0 then
		if max == r then
			h = ((g - b) / d) % 6
		elseif max == g then
			h = (b - r) / d + 2
		else
			h = (r - g) / d + 4
		end
		h /= 6
	end
	return h, max > 0 and d / max or 0, max
end

local function fromHSV(h, s, v)
	local i = math.floor(h * 6) % 6
	local f = h * 6 - math.floor(h * 6)
	local p, q, t = v * (1 - s), v * (1 - f * s), v * (1 - (1 - f) * s)
	local rgb = ({ { v, t, p }, { q, v, p }, { p, v, t }, { p, q, v }, { t, p, v }, { v, p, q } })[i + 1]
	return Color3.new(rgb[1], rgb[2], rgb[3])
end
UI.toHSV, UI.fromHSV = toHSV, fromHSV

local function rememberColor(c)
	local hex = hexOf(c)
	local i = table.find(UI.recentColors, hex)
	if i then
		table.remove(UI.recentColors, i)
	end
	table.insert(UI.recentColors, 1, hex)
	while #UI.recentColors > 8 do
		table.remove(UI.recentColors)
	end
	if UI.onRecentColors then
		UI.onRecentColors(UI.recentColors)
	end
end

local function gradient(parent, props)
	local ok = pcall(function()
		local g = Instance.new("UIGradient")
		for k, v in props do
			g[k] = v
		end
		g.Parent = parent
	end)
	return ok
end

-- the picker: saturation / value square, hue strip, hex field, recent colours. onChange(color) when a choice is made
-- (end of a drag, Enter in the hex field, a recent swatch: one Ctrl+Z each); opts.onInput(color) while dragging.
function UI.colorPicker(anchor, color, onChange, opts)
	opts = opts or {}
	local h, s, v = toHSV(color)
	local W = 216
	local frame = popup(anchor, W + 16, 236)
	local square = make("Frame", { Name = "SV", Parent = frame, Active = true, Position = UDim2.fromOffset(8, 8),
		Size = UDim2.fromOffset(W, 128), BackgroundColor3 = fromHSV(h, 1, 1) }, { UI.corner(3) })
	local white = make("Frame", { Parent = square, Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1) },
		{ UI.corner(3) })
	local black = make("Frame", { Parent = square, Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0) },
		{ UI.corner(3) })
	pcall(function()
		gradient(white, { Transparency = NumberSequence.new(0, 1) })
		gradient(black, { Rotation = 90, Transparency = NumberSequence.new(1, 0) })
	end)
	local cursor = make("Frame", { Name = "Cursor", Parent = square, AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1,
		Size = UDim2.fromOffset(10, 10) }, { UI.corner(5), make("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 2 }) })
	local hue = make("Frame", { Name = "Hue", Parent = frame, Active = true, Position = UDim2.fromOffset(8, 144),
		Size = UDim2.fromOffset(W, 10), BackgroundColor3 = Color3.new(1, 1, 1) }, { UI.corner(3) })
	pcall(function()
		local keys = {}
		for i = 0, 6 do
			table.insert(keys, ColorSequenceKeypoint.new(i / 6, fromHSV((i / 6) % 1, 1, 1)))
		end
		gradient(hue, { Color = ColorSequence.new(keys) })
	end)
	local hueKnob = make("Frame", { Name = "HueKnob", Parent = hue, AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(4, 14), BackgroundColor3 = Color3.new(1, 1, 1) }, { UI.corner(2), UI.stroke("border") })
	local row = make("Frame", { Parent = frame, BackgroundTransparency = 1, Position = UDim2.fromOffset(8, 162),
		Size = UDim2.fromOffset(W, UI.H) }, { UI.hlist(Theme.SPACE.sm, false) })
	local preview = make("Frame", { Name = "Preview", Parent = row, Size = UDim2.fromOffset(UI.H, UI.H), BackgroundColor3 = color },
		{ UI.corner(Theme.RADIUS.control), UI.stroke("border") })
	local hexBox = fieldBox(row, { Text = "#" .. hexOf(color), TextXAlignment = Enum.TextXAlignment.Left },
		{ width = W - UI.H - Theme.SPACE.sm })
	local function current()
		return fromHSV(h, s, v)
	end
	local function show()
		local c = current()
		square.BackgroundColor3 = fromHSV(h, 1, 1)
		cursor.Position = UDim2.fromScale(s, 1 - v)
		hueKnob.Position = UDim2.fromScale(h, 0.5)
		preview.BackgroundColor3 = c
		hexBox.Text = "#" .. hexOf(c)
	end
	local function choose()
		local c = current()
		rememberColor(c)
		onChange(c)
	end
	local function dragOn(target, apply)
		target.InputBegan:Connect(function(input)
			if not pressed(input) then
				return
			end
			local function at(position)
				if not position then
					return
				end
				local p, size = target.AbsolutePosition, target.AbsoluteSize
				apply(math.clamp((position.X - p.X) / math.max(1, size.X), 0, 1),
					math.clamp((position.Y - p.Y) / math.max(1, size.Y), 0, 1))
				show()
				if opts.onInput then
					opts.onInput(current())
				end
			end
			at(input.Position)
			beginDrag(at, function()
				choose()
			end)
		end)
	end
	dragOn(square, function(x, y)
		s, v = x, 1 - y
	end)
	dragOn(hue, function(x)
		h = math.min(x, 0.999)
	end)
	hexBox.FocusLost:Connect(function()
		local hex = hexBox.Text:gsub("#", ""):gsub("%s", "")
		local ok, c = pcall(Color3.fromHex, hex)
		if ok and c then
			h, s, v = toHSV(c)
			show()
			choose()
		else
			show()
		end
	end)
	if #UI.recentColors > 0 then
		UI.label(frame, "<uc>Recente</uc>", { role = "caps", dim = true, rich = true, height = 16 }).Position =
			UDim2.fromOffset(8, 194)
		local swatches = make("Frame", { Parent = frame, BackgroundTransparency = 1, Position = UDim2.fromOffset(8, 212),
			Size = UDim2.fromOffset(W, 16) }, { UI.hlist(6, false) })
		for _, hex in UI.recentColors do
			local ok, c = pcall(Color3.fromHex, hex)
			if ok and c then
				local sw = make("TextButton", { Parent = swatches, Text = "", AutoButtonColor = false, BackgroundColor3 = c,
					Size = UDim2.fromOffset(20, 16) }, { UI.corner(3), UI.stroke("border") })
				UI.tip(sw, "#" .. hex)
				sw.MouseButton1Click:Connect(function()
					h, s, v = toHSV(c)
					show()
					choose()
				end)
			end
		end
	else
		frame.Size = UDim2.fromOffset(frame.Size.X.Offset, 194)
	end
	show()
	raise(frame, 52)
	return frame
end

-- a colour field: swatch + hex; a click opens UI.colorPicker. opts: width, scale, onInput, tip
function UI.color(parent, color, onChange, opts)
	opts = opts or {}
	local props = { Name = "Color", Parent = parent, Text = "#" .. hexOf(color), AutoButtonColor = false,
		TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
		Size = opts.width and UDim2.new(0, opts.width, 0, UI.H) or UDim2.new(opts.scale or 1, 0, 0, UI.H) }
	textStyle(props, "body")
	local border = UI.stroke("fieldBorder")
	local b = make("TextButton", props, { UI.corner(Theme.RADIUS.control), border, UI.pad(0, 8, 0, 28) })
	skin(b, { BackgroundColor3 = "field", TextColor3 = "text" })
	make("Frame", { Name = "Swatch", Parent = b, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, -22, 0.5, 0),
		Size = UDim2.fromOffset(14, 14), BackgroundColor3 = color }, { UI.corner(3), UI.stroke("border") })
	b.MouseEnter:Connect(function()
		restyle(border, { Color = "fieldBorderHover" })
	end)
	b.MouseLeave:Connect(function()
		restyle(border, { Color = "fieldBorder" })
	end)
	b.MouseButton1Click:Connect(function()
		UI.colorPicker(b, color, onChange, opts)
	end)
	if opts.tip then
		UI.tip(b, opts.tip)
	end
	return b
end

-- ---------------------------------------------------------------------------------------------
-- structure: section, header, tabs
-- ---------------------------------------------------------------------------------------------
-- a flat collapsible group: chevron + small dim uppercase title, the body, a divider under it. Returns the body (a
-- vertical stack). opts: key (UI.collapsed key, default the title), collapsed (first time), collapsible (false = a
-- plain group header), right(frame) + rightWidth (controls on the right of the header), badge (text after the title),
-- onToggle(collapsed)
function UI.section(parent, title, opts)
	opts = opts or {}
	local key = opts.key or title
	local collapsible = opts.collapsible ~= false
	if UI.collapsed[key] == nil then
		UI.collapsed[key] = opts.collapsed or false
	end
	local collapsed = collapsible and UI.collapsed[key] or false
	local frame = make("Frame", { Name = "Section", Parent = parent, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y }, { UI.vlist(0) })
	local head = make("TextButton", { Name = "Header", Parent = frame, Text = "", AutoButtonColor = false,
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, UI.H_LARGE) })
	local left = collapsible and 16 or 0
	local arrow = nil
	if collapsible then
		arrow = UI.icon(head, "chevronRight", { size = 12, rotation = collapsed and 0 or 90, anchor = Vector2.new(0, 0.5),
			position = UDim2.new(0, 0, 0.5, 0) })
	end
	local rightWidth = opts.right and (opts.rightWidth or 60) or 0
	local t = UI.label(head, "<uc>" .. escape(title) .. "</uc>", { role = "caps", dim = true, rich = true, height = UI.H_LARGE })
	t.Position = UDim2.fromOffset(left, 0)
	t.Size = UDim2.new(1, -(left + rightWidth + 4), 1, 0)
	if opts.badge ~= nil then
		local badge = UI.badge(head, tostring(opts.badge))
		badge.AnchorPoint = Vector2.new(1, 0.5)
		badge.Position = UDim2.new(1, -(rightWidth + 4), 0.5, 0)
	end
	if opts.right then
		local right = make("Frame", { Name = "Right", Parent = head, BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.fromScale(1, 0), Size = UDim2.new(0, rightWidth, 1, 0) },
			{ make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4),
				FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right,
				VerticalAlignment = Enum.VerticalAlignment.Center }) })
		opts.right(right)
	end
	local body = make("Frame", { Name = "Body", Parent = frame, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y, Visible = not collapsed }, { UI.pad(0, 0, Theme.PAD, 0), UI.vlist(Theme.SPACE.xs) })
	UI.divider(frame)
	head:SetAttribute("Collapsed", collapsed)
	head.MouseEnter:Connect(function()
		restyle(t, { TextColor3 = "text" })
	end)
	head.MouseLeave:Connect(function()
		restyle(t, { TextColor3 = "textDim" })
	end)
	if collapsible then
		head.MouseButton1Click:Connect(function()
			-- applied right here (no redraw of the whole panel); the state survives re-renders in UI.collapsed
			collapsed = not collapsed
			UI.collapsed[key] = collapsed
			head:SetAttribute("Collapsed", collapsed)
			if arrow and arrow:IsA("ImageLabel") then
				animate(arrow, { Rotation = collapsed and 0 or 90 }, Theme.MOTION.base)
			end
			body.Visible = not collapsed
			if UI.onCollapse then
				UI.onCollapse()
			end
			if opts.onToggle then
				opts.onToggle(collapsed)
			end
		end)
	end
	return body
end

-- a panel title with an optional subtitle and icon buttons on the right.
-- opts: subtitle, actions = { { icon, tip, onClick, active, danger } }
function UI.header(parent, title, opts)
	opts = opts or {}
	local actions = opts.actions or {}
	local rightWidth = #actions * (UI.H + 4)
	local frame = make("Frame", { Name = "PanelHeader", Parent = parent, BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, opts.subtitle and 40 or 32) })
	local textCol = make("Frame", { Parent = frame, BackgroundTransparency = 1, Size = UDim2.new(1, -rightWidth, 1, 0) },
		{ make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Center }) })
	UI.label(textCol, title, { role = "title", color = "textBright", height = 20 })
	if opts.subtitle then
		UI.label(textCol, opts.subtitle, { role = "meta", dim = true, height = 16 })
	end
	if #actions > 0 then
		local right = make("Frame", { Parent = frame, BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.fromScale(1, 0), Size = UDim2.new(0, rightWidth, 1, 0) },
			{ make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4),
				FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right,
				VerticalAlignment = Enum.VerticalAlignment.Center }) })
		for _, a in actions do
			UI.iconButton(right, a.icon, a.onClick, { tip = a.tip, active = a.active, danger = a.danger })
		end
	end
	return frame
end

-- how many labels the tab bar can show at this width: "full" (all), "compact" (only the open tab), "icons"
local TAB_ICON_W, TAB_GAP = 32, 2
local function tabWidth(item)
	return 10 + Theme.ICON + 6 + UI.textWidth(item.label, "control") + 10
end

function UI.tabsMode(width, items)
	local full, compactWidest = 0, 0
	for _, item in items do
		full += tabWidth(item) + TAB_GAP
		compactWidest = math.max(compactWidest, tabWidth(item))
	end
	local room = width - Theme.SPACE.sm * 2
	if full <= room then
		return "full"
	elseif compactWidest + (#items - 1) * (TAB_ICON_W + TAB_GAP) <= room then
		return "compact"
	end
	return "icons"
end

-- the tab bar: items { key, label, icon, tip }. Icon + short label; when the window is narrow only the open tab keeps
-- its label ("compact") or none do ("icons"); labels that are hidden become tooltips. The open tab: text colour, accent
-- glyph and a 2 px accent line at the bottom. opts: mode ("full" / "compact" / "icons"; default from opts.width)
function UI.tabs(parent, items, value, onChange, opts)
	opts = opts or {}
	local mode = opts.mode or UI.tabsMode(opts.width or 360, items)
	local nav = make("Frame", { Name = "Tabs", Parent = parent, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) },
		{ UI.pad(0, Theme.SPACE.sm, 0, Theme.SPACE.sm), make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, TAB_GAP), FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center }) })
	nav:SetAttribute("Mode", mode)
	for _, item in items do
		local on = item.key == value
		local showLabel = mode == "full" or (mode == "compact" and on)
		local tab = make("TextButton", { Name = "Tab_" .. tostring(item.key), Parent = nav, Text = "", AutoButtonColor = false,
			BackgroundTransparency = 1, Size = UDim2.new(0, showLabel and tabWidth(item) or TAB_ICON_W, 1, 0) },
			{ UI.corner(Theme.RADIUS.control) })
		skin(tab, { BackgroundColor3 = "surfaceHover" })
		tab:SetAttribute("Selected", on)
		local content = make("Frame", { Parent = tab, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) },
			{ make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6),
				FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center,
				VerticalAlignment = Enum.VerticalAlignment.Center }) })
		local glyph = UI.icon(content, item.icon, { color = on and "accent" or "textDim" })
		local label = nil
		if showLabel then
			label = UI.label(content, item.label, { role = "control", color = on and "text" or "textDim", height = 20,
				width = UI.textWidth(item.label, "control") + 2 })
			label.TextTruncate = Enum.TextTruncate.None
		end
		if on then
			local line = make("Frame", { Name = "Indicator", Parent = tab, AnchorPoint = Vector2.new(0.5, 1),
				Position = UDim2.new(0.5, 0, 1, 0), Size = UDim2.new(1, -8, 0, 2) }, { UI.corner(1) })
			skin(line, { BackgroundColor3 = "accent" })
		else
			tab.MouseEnter:Connect(function()
				if glyph:IsA("ImageLabel") then
					restyle(glyph, { ImageColor3 = "text" })
				end
				if label then
					restyle(label, { TextColor3 = "text" })
				end
			end)
			tab.MouseLeave:Connect(function()
				if glyph:IsA("ImageLabel") then
					restyle(glyph, { ImageColor3 = "textDim" })
				end
				if label then
					restyle(label, { TextColor3 = "textDim" })
				end
			end)
		end
		if not showLabel or item.tip then
			UI.tip(tab, item.tip or item.label)
		end
		tab.MouseButton1Click:Connect(function()
			onChange(item.key)
		end)
	end
	return nav
end

-- ---------------------------------------------------------------------------------------------
-- lists
-- ---------------------------------------------------------------------------------------------
-- a selectable line in a list (effects, elements, clips, issues). opts: selected, onClick, muted, height (28),
-- classIcon (a class name: StudioService icon), icon (a glyph name; a 2.0 text glyph still works), note (dim text on
-- the right), noteWidth, actions = { { icon = glyph / text = 2.0 glyph, tip, color, danger, onClick } }
function UI.item(parent, text, opts)
	opts = opts or {}
	local selected = opts.selected
	local height = opts.height or UI.H_LARGE
	local frame = make("TextButton", { Name = "Item", Parent = parent, Text = "", AutoButtonColor = false,
		BackgroundTransparency = selected and 0 or 1, Size = UDim2.new(1, 0, 0, height) }, { UI.corner(Theme.RADIUS.control) })
	skin(frame, { BackgroundColor3 = selected and "accentSoft" or "surfaceHover" })
	frame:SetAttribute("Selected", selected == true)
	if selected then
		local bar = make("Frame", { Name = "Indicator", Parent = frame, AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.new(0, 2, 1, -8) }, { UI.corner(1) })
		skin(bar, { BackgroundColor3 = "accent" })
	end
	local content = make("Frame", { Parent = frame, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) },
		{ UI.pad(0, 4, 0, 8), UI.hlist(Theme.SPACE.sm, false) })
	local actions = opts.actions or {}
	local rightW = #actions * 24
	local iconW = 0
	local textToken = opts.muted and "textDim" or "text"
	if opts.classIcon then
		local img = UI.icon(content, opts.classIcon, { class = true })
		img.ImageTransparency = opts.muted and 0.5 or 0
		iconW = Theme.ICON + Theme.SPACE.sm
	elseif opts.icon and Icons.has(opts.icon) then
		UI.icon(content, opts.icon, { color = selected and "accent" or "textDim" })
		iconW = Theme.ICON + Theme.SPACE.sm
	elseif opts.icon then -- a 2.0 text glyph
		UI.label(content, opts.icon, { width = 16, color = selected and "accent" or "textDim" })
		iconW = Theme.ICON + Theme.SPACE.sm
	end
	local noteW = opts.note and (opts.noteWidth or 64) or 0
	local name = UI.label(content, text, { role = "body", medium = selected, color = textToken, height = height })
	name.Size = UDim2.new(1, -(rightW + iconW + (noteW > 0 and noteW + Theme.SPACE.sm or 0) + 4), 1, 0)
	if opts.note then
		UI.label(content, opts.note, { role = "meta", dim = true, width = noteW, align = Enum.TextXAlignment.Right, height = height })
	end
	if #actions > 0 then
		local holder = make("Frame", { Parent = content, BackgroundTransparency = 1, Size = UDim2.new(0, rightW, 1, 0) },
			{ UI.hlist(0, false) })
		for _, a in actions do
			if a.icon and Icons.has(a.icon) then
				UI.iconButton(holder, a.icon, a.onClick, { tip = a.tip, danger = a.danger or tokenOf(a.color) == "danger",
					active = a.active, color = a.color, size = 24 })
			else -- a 2.0 text action
				local ab = make("TextButton", textStyle({ Parent = holder, Text = a.text or "", AutoButtonColor = false,
					BackgroundTransparency = 1, Size = UDim2.fromOffset(24, 24) }, "control"), { UI.corner(Theme.RADIUS.control) })
				local map = paintWith(ab, "TextColor3", a.color, "textDim")
				map.BackgroundColor3 = "surfaceHover"
				skin(ab, map)
				ab.MouseEnter:Connect(function()
					ab.BackgroundTransparency = 0
				end)
				ab.MouseLeave:Connect(function()
					ab.BackgroundTransparency = 1
				end)
				ab.MouseButton1Click:Connect(a.onClick)
				if a.tip then
					UI.tip(ab, a.tip)
				end
			end
		end
	end
	frame.MouseEnter:Connect(function()
		if not selected then
			frame.BackgroundTransparency = 0
		end
	end)
	frame.MouseLeave:Connect(function()
		if not selected then
			frame.BackgroundTransparency = 1
		end
	end)
	if opts.onClick then
		frame.MouseButton1Click:Connect(opts.onClick)
	end
	return frame
end

-- a list that scrolls on its own once it gets taller than maxHeight
function UI.scrollList(parent, maxHeight)
	local sf = make("ScrollingFrame", { Parent = parent, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30),
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 4,
		ScrollingDirection = Enum.ScrollingDirection.Y, VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar })
	skin(sf, { ScrollBarImageColor3 = "scrollbar" })
	local layout = UI.vlist(2)
	layout.Parent = sf
	local function fit()
		sf.Size = UDim2.new(1, 0, 0, math.min(maxHeight, layout.AbsoluteContentSize.Y + 2))
	end
	layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(fit)
	task.defer(fit)
	return sf
end

-- ---------------------------------------------------------------------------------------------
-- feedback: note, badge, chip, progress, empty state, toast, confirm
-- ---------------------------------------------------------------------------------------------
local KIND_TOKEN = { info = "accent", success = "success", warning = "warning", danger = "danger", error = "danger" }
local KIND_ICON = { info = "infoColor", success = "successColor", warning = "warningColor", danger = "errorColor",
	error = "errorColor" }

local function kindOf(color)
	local token = tokenOf(color)
	if token == "warning" then
		return "warning"
	elseif token == "danger" then
		return "danger"
	elseif token == "success" then
		return "success"
	elseif token == "accent" or token == "accentHover" or token == "info" then
		return "info"
	end
	return nil
end

-- a quiet callout for a state that lasts (one-off results go to UI.toast). Rich text. color: C.warning / C.danger /
-- C.success / C.accent (or a kind name) -> a coloured bar on the left; nil -> neutral.
function UI.note(parent, text, color)
	local kind = KIND_TOKEN[color] and color or kindOf(color)
	local frame = make("Frame", { Name = "Note", Parent = parent, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y },
		{ UI.corner(Theme.RADIUS.control) })
	skin(frame, { BackgroundColor3 = "raised" })
	if kind then -- the bar takes the height of the note (scale only, so it does not feed the automatic size)
		local bar = make("Frame", { Name = "Bar", Parent = frame, Size = UDim2.new(0, 2, 1, 0) })
		skin(bar, { BackgroundColor3 = KIND_TOKEN[kind] })
	end
	local inner = make("Frame", { Parent = frame, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y }, { UI.pad(8, 10, 8, kind and 12 or 10) })
	local props = { Parent = inner, Text = text, BackgroundTransparency = 1, TextWrapped = true, RichText = true,
		TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }
	textStyle(props, "body")
	local l = make("TextLabel", props)
	skin(l, { TextColor3 = kind and "text" or "textDim" })
	return frame
end

-- a small count / status pill. kind: "neutral" (default), "accent", "success", "warning", "danger"
function UI.badge(parent, text, kind)
	kind = kind or "neutral"
	local props = { Name = "Badge", Parent = parent, Text = text, AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 16) }
	textStyle(props, "meta", "Medium")
	local b = make("TextLabel", props, { UI.corner(8), UI.pad(0, 6, 0, 6) })
	if kind == "accent" then
		skin(b, { BackgroundColor3 = "accent", TextColor3 = "accentText" })
	elseif KIND_TOKEN[kind] then
		skin(b, { BackgroundColor3 = KIND_TOKEN[kind] .. "Soft", TextColor3 = KIND_TOKEN[kind] })
	else
		skin(b, { BackgroundColor3 = "raised", TextColor3 = "textDim" })
	end
	return b
end

-- a pill you can select (filters) or remove. opts: selected, onClick, icon, onRemove, tip
function UI.chip(parent, text, opts)
	opts = opts or {}
	local selected = opts.selected
	local props = { Name = "Chip", Parent = parent, Text = text, AutoButtonColor = false, AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, UI.H) }
	textStyle(props, "control", selected and "Medium" or "Regular")
	local b = make("TextButton", props, { UI.corner(UI.H // 2),
		UI.pad(0, opts.onRemove and 26 or 10, 0, opts.icon and 28 or 10), UI.stroke(selected and "accent" or "border") })
	skin(b, { BackgroundColor3 = selected and "accentSoft" or "raised", TextColor3 = selected and "text" or "textDim" })
	b:SetAttribute("Selected", selected == true)
	if opts.icon then
		UI.icon(b, opts.icon, { size = 14, color = selected and "accent" or "textDim", anchor = Vector2.new(0, 0.5),
			position = UDim2.new(0, -20, 0.5, 0) })
	end
	if opts.onRemove then
		local x = UI.iconButton(b, "close", opts.onRemove, { size = 18, iconSize = 12, tip = "Scoate" })
		x.AnchorPoint = Vector2.new(0, 0.5)
		x.Position = UDim2.new(1, 4, 0.5, 0)
	end
	if not selected then
		b.MouseEnter:Connect(function()
			restyle(b, { TextColor3 = "text" })
		end)
		b.MouseLeave:Connect(function()
			restyle(b, { TextColor3 = "textDim" })
		end)
	end
	if opts.onClick then
		b.MouseButton1Click:Connect(opts.onClick)
	end
	if opts.tip then
		UI.tip(b, opts.tip)
	end
	return b
end

-- a thin progress bar. Returns the track and set(fraction). opts: height (4), color (token, default "accent")
function UI.progress(parent, fraction, opts)
	opts = opts or {}
	local track = make("Frame", { Name = "Progress", Parent = parent, Size = UDim2.new(1, 0, 0, opts.height or 4) },
		{ UI.corner(2) })
	skin(track, { BackgroundColor3 = "raised" })
	local fill = make("Frame", { Name = "Fill", Parent = track, Size = UDim2.new(math.clamp(fraction or 0, 0, 1), 0, 1, 0) },
		{ UI.corner(2) })
	skin(fill, { BackgroundColor3 = opts.color or "accent" })
	local function set(f)
		animate(fill, { Size = UDim2.new(math.clamp(f or 0, 0, 1), 0, 1, 0) }, Theme.MOTION.slow)
	end
	return track, set
end

-- an empty state: one short sentence and at most one primary action. opts: icon (glyph), title
function UI.empty(parent, text, actionText, onAction, opts)
	opts = opts or {}
	local frame = make("Frame", { Name = "Empty", Parent = parent, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y }, { UI.pad(Theme.SPACE.xl, Theme.PAD, Theme.SPACE.xl, Theme.PAD),
		make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, Theme.SPACE.sm),
			HorizontalAlignment = Enum.HorizontalAlignment.Center }) })
	if opts.icon then
		UI.icon(frame, opts.icon, { size = 24, color = "textDisabled" })
	end
	if opts.title then
		UI.label(frame, opts.title, { role = "emphasis", align = Enum.TextXAlignment.Center, height = 20 })
	end
	UI.label(frame, text, { dim = true, wrap = true, align = Enum.TextXAlignment.Center })
	if actionText and onAction then
		UI.spacer(frame, 2)
		UI.button(frame, actionText, onAction, { style = "primary", autoWidth = true, height = UI.H_LARGE })
	end
	return frame
end

-- a message at the bottom of the window that goes away by itself. kind: "info" (default) / "success" / "warning" /
-- "error". opts: duration (seconds; 4, errors 6; 0 = until closed), action = { text, onClick }.
-- Returns { dismiss = fn, frame = Frame } (nil before UI.setRoot).
local toasts = {}
function UI.toast(text, kind, opts)
	opts = opts or {}
	kind = KIND_ICON[kind or "info"] and (kind or "info") or "info"
	if not toastHost then
		return nil
	end
	local frame = make("Frame", { Name = "Toast", Parent = toastHost, Active = true, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y }, { UI.corner(Theme.RADIUS.surface), UI.stroke("border"), UI.pad(8, 4, 8, 10) })
	skin(frame, { BackgroundColor3 = "surface" })
	frame:SetAttribute("Kind", kind)
	local actionW = opts.action and (UI.textWidth(opts.action.text, "control") + 20) or 0
	UI.icon(frame, KIND_ICON[kind], { anchor = Vector2.new(0, 0.5), position = UDim2.new(0, 0, 0.5, 0) })
	local props = { Parent = frame, Text = text, BackgroundTransparency = 1, TextWrapped = true, RichText = true,
		TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(24, 0),
		Size = UDim2.new(1, -(24 + actionW + 28), 0, 0), AutomaticSize = Enum.AutomaticSize.Y }
	textStyle(props, "body")
	local message = make("TextLabel", props, { make("UISizeConstraint", { MinSize = Vector2.new(0, 20) }) })
	skin(message, { TextColor3 = "text" })
	local handle
	local function dismiss()
		local i = table.find(toasts, handle)
		if i then
			table.remove(toasts, i)
		end
		frame:Destroy()
	end
	handle = { dismiss = dismiss, frame = frame }
	if opts.action then
		local b = UI.button(frame, opts.action.text, function()
			dismiss()
			opts.action.onClick()
		end, { style = "link", width = actionW })
		b.AnchorPoint = Vector2.new(1, 0.5)
		b.Position = UDim2.new(1, -28, 0.5, 0)
	end
	local close = UI.iconButton(frame, "close", dismiss, { size = 20, iconSize = 12, tip = "Închide" })
	close.AnchorPoint = Vector2.new(1, 0.5)
	close.Position = UDim2.new(1, 0, 0.5, 0)
	raise(frame, 47)
	table.insert(toasts, handle)
	while #toasts > 3 do
		toasts[1].dismiss()
	end
	local duration = opts.duration or (kind == "error" and 6 or 4)
	if duration > 0 then
		task.delay(duration, function()
			if frame.Parent then
				dismiss()
			end
		end)
	end
	return handle
end

-- a small modal: title, one or two sentences, Cancel + the action. Escape or a click outside cancels.
-- opts: cancelText ("Anulează"), danger (the action destroys something: red button), onCancel
function UI.confirm(title, text, confirmText, onConfirm, opts)
	opts = opts or {}
	if not overlay then
		return nil
	end
	UI.closePopup()
	popupState = { modal = true, onCancel = opts.onCancel }
	overlay.Visible = true
	local scrim = make("Frame", { Name = "Scrim", Parent = overlay, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 0.5,
		ZIndex = 51 })
	skin(scrim, { BackgroundColor3 = "scrim" })
	local width = math.min(320, math.max(200, root.AbsoluteSize.X - Theme.SPACE.xl * 2))
	local dialog = make("Frame", { Name = "Dialog", Parent = overlay, Active = true, AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(width, 0), AutomaticSize = Enum.AutomaticSize.Y, ZIndex = 52 },
		{ UI.corner(Theme.RADIUS.surface), UI.stroke("border"), UI.pad(Theme.SPACE.lg, Theme.SPACE.lg, Theme.SPACE.lg, Theme.SPACE.lg), UI.vlist(Theme.SPACE.sm) })
	skin(dialog, { BackgroundColor3 = "surface" })
	UI.label(dialog, title, { role = "emphasis", color = "textBright", height = 20 })
	if text and text ~= "" then
		UI.label(dialog, text, { dim = true, wrap = true })
	end
	UI.spacer(dialog, 4)
	local buttons = make("Frame", { Parent = dialog, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, UI.H_LARGE) },
		{ make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, Theme.SPACE.sm),
			FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right,
			VerticalAlignment = Enum.VerticalAlignment.Center }) })
	UI.button(buttons, opts.cancelText or "Anulează", cancelPopup, { autoWidth = true, height = UI.H_LARGE })
	UI.button(buttons, confirmText, function()
		UI.closePopup()
		onConfirm()
	end, { style = opts.danger and "destructive" or "primary", autoWidth = true, height = UI.H_LARGE })
	raise(dialog, 53)
	return dialog
end

return UI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">App</string><ProtectedString name="Source"><![CDATA[-- LostCube window: a compact header, the tab bar, the current panel and the toasts; refreshes when effects change (also
-- when Claude edits) and re-skins when Studio changes theme.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UI = require(script.Parent.UI)
local Icons = require(script.Parent.Icons)
local Theme = require(script.Parent.Theme)
local C = UI.C

local App = {}
App.__index = App

-- key: saved in the plugin settings; label: short, shown in the tab bar; icon: Icons.GLYPHS; module: a panel module
-- next to App (a module that is not there yet shows a quiet "În lucru" state)
local TABS = {
	{ key = "Game", label = "Joc", icon = "game", module = "AnalysisPanel" },
	{ key = "VFX", label = "Efecte", icon = "effects", module = "VFXPanel" },
	{ key = "Anim", label = "Animații", icon = "animation", module = "AnimPanel" },
	{ key = "Library", label = "Bibliotecă", icon = "library", module = "LibraryPanel" },
	{ key = "Build", label = "Modelare", icon = "build", module = "BuildPanel" },
	{ key = "Claude", label = "Claude", icon = "chat", module = "ClaudePanel" },
}
App.TABS = TABS
local HEADER_H, TABS_H = Theme.HEIGHT.header, Theme.HEIGHT.tabs

local HELP = {
	"Trage de eticheta unui câmp numeric ca să schimbi valoarea; cu Shift pașii sunt fini.",
	"Ctrl + rotiță pe un câmp numeric: un pas (cu Shift, de 10 ori mai mult).",
	"Esc închide meniurile și dialogurile.",
	"Tastele pentru redare: File → Advanced → Customize Shortcuts, caută „LostCube”.",
}

function App.mount(container, ctx)
	ctx = ctx or {}
	ctx.Editor = ctx.Editor or require(script.Parent.Editor)
	local self = setmetatable({ ctx = ctx, tab = "VFX", conns = {}, panels = {} }, App)
	ctx.app = self
	-- remembered between Studio sessions: the open tab, the folded sections, the recent colours
	local savedTab = self:setting("tab")
	for _, t in TABS do
		if t.key == savedTab then
			self.tab = savedTab
		end
	end
	-- first time in this place: no analysis stored yet -> open on the game tab, which starts the analysis
	local okLoad, report = pcall(function()
		return require(script.Parent.Analyzer).load()
	end)
	if okLoad and report == nil then
		self.tab = "Game"
	end
	local folded = self:setting("collapsed")
	if type(folded) == "table" then
		for key, value in folded do
			if type(key) == "string" and type(value) == "boolean" then
				UI.collapsed[key] = value
			end
		end
	end
	UI.onCollapse = function()
		self:save("collapsed", UI.collapsed)
	end
	local recent = self:setting("recentColors")
	if type(recent) == "table" then
		table.clear(UI.recentColors)
		for _, hex in recent do
			if type(hex) == "string" and #UI.recentColors < 8 then
				table.insert(UI.recentColors, hex)
			end
		end
	end
	UI.onRecentColors = function(list)
		self:save("recentColors", list)
	end

	local root = UI.make("Frame", { Name = "LostCube", Parent = container, Size = UDim2.fromScale(1, 1), ClipsDescendants = true })
	UI.skin(root, { BackgroundColor3 = "bg" })
	self.root = root
	UI.setRoot(root)
	self:renderHeader()

	-- tabs (rebuilt only when the tab or the width class changes)
	self.tabBar = UI.make("Frame", { Name = "TabBar", Parent = root, Position = UDim2.fromOffset(0, HEADER_H),
		Size = UDim2.new(1, 0, 0, TABS_H), BackgroundTransparency = 1 })
	local line = UI.divider(root)
	line.Position = UDim2.fromOffset(0, HEADER_H + TABS_H)
	line.Size = UDim2.new(1, 0, 0, 1)

	-- content
	local top = HEADER_H + TABS_H + 1
	self.scroll = UI.make("ScrollingFrame", { Name = "Content", Parent = root, Position = UDim2.fromOffset(0, top),
		Size = UDim2.new(1, 0, 1, -top), BackgroundTransparency = 1, CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 6, ScrollingDirection = Enum.ScrollingDirection.Y,
		VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar })
	UI.skin(self.scroll, { ScrollBarImageColor3 = "scrollbar" })
	self.content = UI.make("Frame", { Parent = self.scroll, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y }, { UI.pad(4, Theme.PAD, 24, Theme.PAD), UI.vlist(Theme.SPACE.sm) })

	-- a theme switch in Studio: chrome re-skins itself, the panels are drawn again with the new colours
	self.themeConn = Theme.onChanged(function()
		if not self.dead then
			self.barTab = nil
			self:render()
		end
	end)
	-- the tab bar shows fewer labels when the window gets narrow
	table.insert(self.conns, root:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		if not self.dead and UI.tabsMode(root.AbsoluteSize.X, TABS) ~= self.barMode then
			self:renderTabs()
		end
	end))
	self:watch()
	self:render()
	return self
end

-- the header: the LostCube mark, the name, the version; help and settings on the right
function App:renderHeader()
	local header = UI.make("Frame", { Name = "Header", Parent = self.root, Size = UDim2.new(1, 0, 0, HEADER_H),
		BackgroundTransparency = 1 })
	local brand = UI.make("Frame", { Name = "Brand", Parent = header, BackgroundTransparency = 1, Size = UDim2.new(1, -72, 1, 0) },
		{ UI.pad(0, 0, 0, Theme.PAD), UI.hlist(Theme.SPACE.sm, false) })
	local mark = Icons.draw(brand, "cube", 16, C.text, 1.25)
	for _, part in mark:GetChildren() do
		UI.skin(part, { BackgroundColor3 = "textBright" })
	end
	local name = UI.label(brand, "LostCube", { role = "emphasis", bold = true, color = "textBright", height = HEADER_H })
	name.Size = UDim2.fromOffset(0, HEADER_H)
	name.AutomaticSize = Enum.AutomaticSize.X
	local version = UI.label(brand, tostring(self.ctx.Editor.VERSION or ""), { role = "meta", dim = true, height = HEADER_H })
	version.Size = UDim2.fromOffset(0, HEADER_H)
	version.AutomaticSize = Enum.AutomaticSize.X
	local actions = UI.make("Frame", { Name = "Actions", Parent = header, BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -Theme.SPACE.sm, 0, 0), Size = UDim2.new(0, 56, 1, 0) },
		{ UI.make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4),
			FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right,
			VerticalAlignment = Enum.VerticalAlignment.Center }) })
	local help
	help = UI.iconButton(actions, "help", function()
		self:showHelp(help)
	end, { tip = "Ajutor și scurtături" })
	local gear
	gear = UI.iconButton(actions, "gear", function()
		UI.menu(gear, {
			{ header = true, label = "LostCube " .. tostring(self.ctx.Editor.VERSION or "") },
			{ label = "Restrânge toate secțiunile", icon = "collapseAll", onClick = function()
				self:foldAll(true)
			end },
			{ label = "Extinde toate secțiunile", icon = "expandAll", onClick = function()
				self:foldAll(false)
			end },
		}, { width = 220 })
	end, { tip = "Setări" })
	return header
end

function App:showHelp(anchor)
	local frame = UI.popover(anchor, 280, 40 + #HELP * 44)
	local list = UI.make("Frame", { Parent = frame, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) },
		{ UI.pad(Theme.PAD, Theme.PAD, Theme.PAD, Theme.PAD), UI.vlist(Theme.SPACE.sm) })
	UI.label(list, "<uc>Scurtături</uc>", { role = "caps", dim = true, rich = true, height = 16 })
	for _, line in HELP do
		UI.label(list, line, { wrap = true })
	end
end

function App:foldAll(collapsed)
	for key in UI.collapsed do
		UI.collapsed[key] = collapsed
	end
	self:save("collapsed", UI.collapsed)
	self:render()
end

-- plugin settings (nothing is saved when the panels run outside a plugin, e.g. in a ScreenGui)
function App:setting(key)
	local plugin = self.ctx.plugin
	if not plugin then
		return nil
	end
	local ok, value = pcall(plugin.GetSetting, plugin, "LostCube." .. key)
	return ok and value or nil
end

function App:save(key, value)
	local plugin = self.ctx.plugin
	if plugin then
		pcall(plugin.SetSetting, plugin, "LostCube." .. key, value)
	end
end

-- a tab whose module is not in the plugin yet
local function placeholder(tab)
	return { render = function(_, parent)
		UI.empty(parent, "Apare într-o versiune următoare.", nil, nil, { icon = tab.icon, title = "În lucru" })
	end }
end

function App:panel(key)
	if not self.panels[key] then
		for _, t in TABS do
			if t.key == key then
				local source = script.Parent:FindFirstChild(t.module)
				self.panels[key] = source and require(source).new(self.ctx) or placeholder(t)
			end
		end
	end
	return self.panels[key]
end

-- the tab bar only changes when the tab (or the width class) does, not on every refresh
function App:renderTabs()
	local mode = UI.tabsMode(self.root.AbsoluteSize.X, TABS)
	if self.barTab == self.tab and self.barMode == mode then
		return
	end
	self.barTab, self.barMode = self.tab, mode
	for _, child in self.tabBar:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	UI.tabs(self.tabBar, TABS, self.tab, function(key)
		if self.tab ~= key then
			self.tab = key
			self:save("tab", key)
			self.scroll.CanvasPosition = Vector2.zero
			self:render()
		end
	end, { mode = mode })
end

function App:render()
	-- a redraw that was still waiting (for a text box, or for its turn) is not needed any more
	self.renderGen = (self.renderGen or 0) + 1
	self.pending, self.held = false, false
	local scrollY = self.scroll.CanvasPosition.Y
	self:renderTabs()
	for _, child in self.content:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	UI.closePopup()
	local ok, err = pcall(function()
		self:panel(self.tab):render(self.content)
	end)
	if not ok then
		UI.note(self.content, "Panoul nu s-a putut afișa: " .. UI.escape(tostring(err)), C.danger)
		warn("LostCube:", err)
	end
	task.defer(function()
		if self.scroll.Parent then
			self.scroll.CanvasPosition = Vector2.new(0, scrollY)
		end
	end)
end

-- the text box of the current tab that the user is typing in, if any
function App:typingBox()
	for _, d in self.content:GetDescendants() do
		if d.ClassName == "TextBox" and d:IsFocused() then
			return d
		end
	end
	return nil
end

-- coalesces many changes into one redraw
function App:refresh()
	if self.pending or self.dead then
		return
	end
	self.pending = true
	local gen = self.renderGen
	task.defer(function()
		self:flush(gen)
	end)
end

-- A redraw rebuilds every text box, so it would wipe what the user is typing and take the focus away: it waits until
-- the box is let go, plus one more beat (a click on a button took the focus; the button must still be there to be clicked).
-- It also waits while a drag, a menu, the colour picker or a dialog is open (UI.busy).
function App:flush(gen)
	if self.dead or gen ~= self.renderGen then
		return
	end
	if self:typingBox() or UI.busy() then
		self.held = true
	elseif self.held then
		self.held = false
	else
		self.pending = false
		if self.root.Parent then
			self:render()
		end
		return
	end
	task.delay(0.3, function()
		self:flush(gen)
	end)
end

-- redraw when effects change from anywhere (other windows, Claude, undo)
function App:watch()
	local function hook()
		if self.dead then
			return
		end
		for _, c in self.watchConns or {} do
			c:Disconnect()
		end
		self.watchConns = {}
		local conns = self.watchConns
		local root = ReplicatedStorage:FindFirstChild("LostCube")
		table.insert(conns, ReplicatedStorage.ChildAdded:Connect(function(child)
			if child.Name == "LostCube" then
				task.defer(hook)
			end
		end))
		if not root then
			return
		end
		table.insert(conns, root.DescendantAdded:Connect(function(d)
			if d.Name == "Effects" then
				task.defer(hook)
			end
			self:refresh()
		end))
		table.insert(conns, root.DescendantRemoving:Connect(function()
			self:refresh()
		end))
		local effects = root:FindFirstChild("Effects")
		if effects then
			table.insert(conns, effects:GetAttributeChangedSignal("LC_Rev"):Connect(function()
				self:refresh()
			end))
		end
	end
	hook()
	-- the activity log (Claude tab) lives in ServerStorage.LostCubeSession, created on the first edit
	local ok, storage = pcall(function()
		return game:GetService("ServerStorage")
	end)
	if ok then
		local function hookLog(folder)
			if folder.Name == "LostCubeSession" then
				-- the folder is recreated now and then: keep exactly one connection (to the live one)
				if self.logConn then
					self.logConn:Disconnect()
				end
				self.logConn = folder:GetAttributeChangedSignal("Log"):Connect(function()
					if self.tab == "Claude" then
						self:refresh()
					end
				end)
			end
		end
		local existing = storage:FindFirstChild("LostCubeSession")
		if existing then
			hookLog(existing)
		end
		table.insert(self.conns, storage.ChildAdded:Connect(hookLog))
	end
	table.insert(self.conns, game:GetService("ChangeHistoryService").OnUndo:Connect(function()
		self:refresh()
	end))
	table.insert(self.conns, game:GetService("ChangeHistoryService").OnRedo:Connect(function()
		self:refresh()
	end))
end

function App:destroy()
	self.dead = true -- no more redraws, no more re-hooking
	UI.onCollapse = nil
	UI.onRecentColors = nil
	UI.closePopup()
	UI.release()
	if self.themeConn then
		self.themeConn:Disconnect()
		self.themeConn = nil
	end
	for _, c in self.conns do
		c:Disconnect()
	end
	if self.logConn then
		self.logConn:Disconnect()
		self.logConn = nil
	end
	for _, c in self.watchConns or {} do
		c:Disconnect()
	end
	self.watchConns = nil
	for _, p in self.panels do
		if p.destroy then
			-- one panel failing to clean up must not leave the others running (Heartbeat loops, tasks)
			local ok, err = pcall(p.destroy, p)
			if not ok then
				warn("LostCube:", err)
			end
		end
	end
	self.root:Destroy()
end

return App
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">VFXPanel</string><ProtectedString name="Source"><![CDATA[-- LostCube > VFX tab: effects list, elements with presets, properties, timeline, live preview.
local Selection = game:GetService("Selection")

local UI = require(script.Parent.UI)
local C = UI.C

local Panel = {}
Panel.__index = Panel

local ORIENT = {
	{ value = "FacingCamera", label = "Spre cameră" },
	{ value = "FacingCameraWorldUp", label = "Spre cameră (vertical)" },
	{ value = "VelocityParallel", label = "Pe direcția mișcării (raze)" },
	{ value = "VelocityPerpendicular", label = "Culcat (cercuri pe sol)" },
}
local SHAPES = {
	{ value = "Point", label = "Punct" }, { value = "Box", label = "Cutie" }, { value = "Sphere", label = "Sferă" },
	{ value = "Cylinder", label = "Cilindru" }, { value = "Disc", label = "Disc" },
}
local DIRECTIONS = {
	{ value = "Top", label = "Sus" }, { value = "Bottom", label = "Jos" }, { value = "Front", label = "Față" },
	{ value = "Back", label = "Spate" }, { value = "Left", label = "Stânga" }, { value = "Right", label = "Dreapta" },
}
local KIND_ICON = { PARTICLES = "★", LIGHT = "☀", TRAIL = "≈", MESH = "■", SOUND = "♪", CAMERA = "◎", BEAM = "⚡" }
local KIND_LABEL = { PARTICLES = "Particule", LIGHT = "Lumină", TRAIL = "Trail", MESH = "Mesh 3D", SOUND = "Sunet", CAMERA = "Cameră",
	BEAM = "Rază (Beam)" }
local FLIPBOOK_LAYOUTS = {
	{ value = "None", label = "Fără (o singură imagine)" }, { value = "Grid2x2", label = "Grilă 2×2 (4 cadre)" },
	{ value = "Grid4x4", label = "Grilă 4×4 (16 cadre)" }, { value = "Grid8x8", label = "Grilă 8×8 (64 de cadre)" },
}
local FLIPBOOK_MODES = {
	{ value = "Loop", label = "Buclă" }, { value = "OneShot", label = "O dată (pe viața particulei)" },
	{ value = "PingPong", label = "Dus-întors" }, { value = "Random", label = "Cadre la întâmplare" },
}
local TEXTURE_MODES = { { value = "Stretch", label = "Întinsă" }, { value = "Wrap", label = "Repetată" }, { value = "Static", label = "Fixă" } }
-- timeline wording per kind: the window row, what the window does, without a window, one burst row, the burst legend
local TIMELINE_TEXT = {
	PARTICLES = { "Emisie (s)", "emite continuu %s → %s s (Rată / s)", "fără emisie continuă (doar burst-uri)", "Burst", "timp (s) · câte particule", "+ Burst" },
	MESH = { "Emisie (s)", "emite continuu %s → %s s (Rată / s)", "fără emisie continuă (doar burst-uri)", "Burst", "timp (s) · câte piese", "+ Burst" },
	TRAIL = { "Activ (s)", "desenează %s → %s s", "inactiv (adaugă o fereastră)" },
	SOUND = { "Buclă (s)", "se repetă în buclă %s → %s s", "fără buclă (doar redări)", "Redare", "timp (s) · câte suprapuse", "+ Redare" },
	CAMERA = { "Cutremur (s)", "tremură continuu %s → %s s", "fără cutremur continuu (doar lovituri)", "Lovitură", "timp (s)", "+ Lovitură" },
	BEAM = { "Vizibilă (s)", "vizibilă %s → %s s", "fără fereastră (doar flash-uri)", "Flash", "timp (s)", "+ Flash" },
}
local MESH_MODES = {
	{ value = "Ring", label = "Inel (se lărgește)" }, { value = "Crack", label = "Crăpături (radial)" },
	{ value = "Pulse", label = "Puls (crește și dispare)" }, { value = "Puff", label = "Fum 3D (bile)" },
	{ value = "Trail", label = "Urmă pe sol (rămâne)" }, { value = "Debris", label = "Debris (fizică reală)" },
}
local PART_SHAPES = { { value = "Block", label = "Cub" }, { value = "Ball", label = "Bilă" },
	{ value = "Cylinder", label = "Cilindru" }, { value = "Wedge", label = "Pană" } }
local MATERIALS = {}
for _, m in { "Neon", "ForceField", "SmoothPlastic", "Glass", "Ice", "Metal", "Slate", "Rock", "Concrete", "Plastic", "Sand" } do
	table.insert(MATERIALS, { value = m, label = m })
end

function Panel.new(ctx)
	return setmetatable({ ctx = ctx, Editor = ctx.Editor, effect = nil, element = nil, speed = 1, loop = false,
		confirm = nil, creating = false, handle = nil }, Panel)
end

function Panel:refresh()
	self.ctx.app:refresh()
end

-- "ReplicatedStorage.LostCube.Editor:123: LostCube: ..." -> "LostCube: ..."
local function clean(err)
	return (tostring(err):gsub("^.-:%d+: ", ""))
end

local function trim(text)
	return (text:gsub("^%s+", ""):gsub("%s+$", ""))
end

-- UI.note renders rich text: text that comes from outside (asset names, script names) must not be read as tags
local function plain(text)
	return (text:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
end

-- an effect name that is not taken yet ("Fulger", "Fulger 2", ...)
local function freeName(Editor, base)
	local taken = {}
	for _, fx in Editor.effects() do
		taken[fx.Name] = true
	end
	if not taken[base] then
		return base
	end
	local i = 2
	while taken[base .. " " .. i] do
		i += 1
	end
	return base .. " " .. i
end

-- dropdown items grouped under headers, in the order the groups first appear; `label` decides how an entry is written
local function groupedItems(entries, groupOf, valueOf, labelOf)
	local order, byGroup = {}, {}
	for _, entry in entries do
		local group = groupOf(entry)
		if not byGroup[group] then
			byGroup[group] = {}
			table.insert(order, group)
		end
		table.insert(byGroup[group], entry)
	end
	local items = {}
	for _, group in order do
		table.insert(items, { header = true, label = group })
		for _, entry in byGroup[group] do
			table.insert(items, { value = valueOf(entry), label = labelOf(entry) })
		end
	end
	return items
end

-- the asset id out of what people paste: "123", "rbxassetid://123" or a Creator Store address
local function assetIdOf(text)
	text = trim(text)
	return text:match("^(%d+)$") or text:match("rbxassetid://(%d+)") or text:match("/asset/(%d+)") or text:match("/store/asset/(%d+)")
end

-- every edit goes through the Editor (one undo step each); errors show up in the panel instead of breaking it
function Panel:try(fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		self.error = clean(err)
		warn("LostCube:", err)
	else
		self.error = nil
	end
	self:refresh()
end

function Panel:set(element, props)
	self:try(self.Editor.setProps, element, props)
end

-- ---------------------------------------------------------------------------------------------
-- preview
-- ---------------------------------------------------------------------------------------------
function Panel:play()
	if not self.effect then
		return
	end
	if self.handle and not self.handle.Done then
		self.handle:Destroy()
	end
	local wasPaused = self.paused
	self.paused = false
	local ok, h = pcall(self.Editor.preview, self.effect, { speed = self.speed })
	if ok then
		self.handle = h
	else
		self.error = clean(h)
	end
	if wasPaused or not ok then
		self:refresh()
	end
end

-- removes the preview from the scene (a paused one would otherwise stay frozen there) and ends the loop
function Panel:stopPreview()
	self.loop = false
	self.loopId = (self.loopId or 0) + 1
	self.paused = false
	if self.handle and not self.handle.Done then
		self.handle:Destroy()
	end
	self.handle = nil
	self:refresh()
end

function Panel:setLoop(on)
	self.loop = on
	self.loopId = (self.loopId or 0) + 1
	if on then
		local id = self.loopId
		local function running()
			return self.loop and self.loopId == id and self.effect and self.effect.Parent
		end
		task.spawn(function()
			while running() do
				self:play()
				-- wait one play; time spent paused does not count, so Pause works while repeating
				local ok, length = pcall(self.Editor.length, self.effect)
				local left = (ok and length or 1) + 0.35
				while left > 0 and running() do
					local dt = task.wait(0.05)
					if not self.paused then
						left -= dt * self.speed
					end
				end
			end
		end)
	end
	self:refresh()
end

function Panel:togglePause()
	local h = self.handle
	if not h or h.Done then
		if self.paused then -- the preview is gone: the button must not stay on "Continue"
			self.paused = false
			self:refresh()
		end
		return
	end
	if self.paused then
		h:Resume()
		self.paused = false
	else
		h:Pause()
		self.paused = true
	end
	self:refresh()
end

function Panel:destroy()
	self.loop = false
	self.loopId = (self.loopId or 0) + 1
	if self.handle and not self.handle.Done then
		self.handle:Destroy()
	end
end

-- ---------------------------------------------------------------------------------------------
-- render
-- ---------------------------------------------------------------------------------------------
function Panel:render(parent)
	local Editor = self.Editor
	if self.effect and not self.effect.Parent then
		self.effect, self.element = nil, nil
	end
	if self.element and (not self.element.Parent or (self.effect and not self.element:IsDescendantOf(self.effect))) then
		self.element = nil
	end
	if self.error then
		UI.note(parent, "⚠ " .. self.error, C.warn)
		self.error = nil -- shown once; the next action sets it again if it still fails
	end
	local status = require(script.Parent.Installer).status()
	if not status.ok then
		local banner = UI.vstack(parent, 6)
		UI.note(banner, status.vfx and "Modulele LostCube din joc sunt mai vechi decât pluginul."
			or "Jocul nu are încă modulele LostCube (<b>VFX</b> redă efectele în joc, <b>Editor</b> e pentru Claude).", C.warn)
		UI.button(UI.hstack(banner, { height = 28 }), "Instalează în joc (ReplicatedStorage.LostCube)", function()
			self:try(require(script.Parent.Installer).install)
		end, { style = "primary", bold = true, height = 28 })
	end

	-- effects ---------------------------------------------------------------------------------
	local effects = Editor.effects()
	local body = UI.section(parent, "Efecte  (" .. #effects .. ")", { key = "vfx.effects" })
	local bar = UI.hstack(body)
	UI.button(bar, "+ Efect nou", function()
		self.creating = true
		self.templating = false
		self:refresh()
	end, { style = "primary", bold = true })
	UI.button(bar, "+ Din șablon", function()
		self.templating = not self.templating
		self.creating = false
		self:refresh()
	end, { selected = self.templating, bold = true, tip = "efecte gata făcute (lovitură, fulger, vindecare, teleport...)" })
	if self.templating then
		self:renderTemplates(body)
	end
	if self.creating then
		local row = UI.hstack(body)
		local box = UI.textbox(row, "", nil, { placeholder = "Numele efectului (ex. Foc)" })
		UI.button(row, "Creează", function()
			local name = box.Text ~= "" and box.Text or "Efect"
			self.creating = false
			local ok, fx = pcall(Editor.newEffect, name, { duration = 1 })
			if ok then
				self.effect, self.element = fx, nil
			else
				self.error = clean(fx)
			end
			self:refresh()
		end, { width = 74, style = "primary" })
		UI.button(row, "×", function()
			self.creating = false
			self:refresh()
		end, { width = 26, style = "ghost" })
		task.defer(function()
			if box.Parent then
				box:CaptureFocus()
			end
		end)
	end
	if #effects == 0 then
		UI.note(body, "Niciun efect încă. Apasă <b>+ Efect nou</b>, apoi adaugă elemente din preseturi.")
	end
	local list = #effects > 0 and UI.scrollList(body, 236) or body
	for _, fx in effects do
		local n = #Editor.elements(fx)
		local confirm = self.confirm == fx
		UI.item(list, fx.Name, {
			icon = "◆", selected = fx == self.effect, note = n .. " el.",
			onClick = function()
				self.effect = fx
				self.element = nil
				self.confirm = nil
				self:refresh()
			end,
			actions = {
				{ text = "📋", onClick = function()
					self:try(function()
						self.effect = Editor.duplicateEffect(fx)
					end)
				end },
				{ text = confirm and "✓?" or "×", color = C.danger, onClick = function()
					if confirm then
						self.confirm = nil
						if self.effect == fx then
							self.effect, self.element = nil, nil
						end
						self:try(Editor.removeEffect, fx)
					else
						self.confirm = fx
						self:refresh()
					end
				end },
			},
		})
	end
	self:renderImport(parent)
	if not self.effect then
		return
	end

	-- the effect ------------------------------------------------------------------------------
	local fx = self.effect
	body = UI.section(parent, "Efect: " .. fx.Name, { key = "vfx.effect" })
	UI.textbox(UI.row(body, "Nume"), fx.Name, function(text)
		if text ~= "" then
			self:try(Editor.setEffect, fx, { name = text })
		end
	end)
	UI.number(UI.row(body, "Durată (s)"), fx:GetAttribute("LC_Duration") or 1, function(v)
		self:try(Editor.setEffect, fx, { duration = v })
	end, { min = 0.01, step = 0.05, decimals = 2 })
	local attachItems = {}
	for _, a in Editor.ATTACH do
		table.insert(attachItems, { value = a.key, label = a.label })
	end
	UI.dropdown(UI.row(body, "Prins de"), attachItems, fx:GetAttribute("LC_Attach") or "GROUND", function(v)
		self:try(Editor.setEffect, fx, { attach = v })
	end, { menuWidth = 200 })

	local play = UI.hstack(body, { height = 28 })
	UI.button(play, "▶  Redă", function()
		self:play()
	end, { style = "primary", bold = true, height = 28 })
	UI.button(play, self.loop and "🔁 Repetă: DA" or "🔁 Repetă", function()
		self:setLoop(not self.loop)
	end, { selected = self.loop, height = 28 })
	UI.button(play, self.paused and "▶ Continuă" or "⏸ Pauză", function()
		self:togglePause()
	end, { height = 28 })
	UI.button(play, "⏹", function()
		self:stopPreview()
	end, { width = 32, height = 28, tip = "oprește și scoate previzualizarea din scenă" })
	UI.segmented(UI.row(body, "Viteză"), {
		{ value = 0.1, label = "×0.1" }, { value = 0.25, label = "×0.25" }, { value = 0.5, label = "×0.5" },
		{ value = 1, label = "×1" },
	}, self.speed, function(v)
		self.speed = v
		self:refresh()
	end)
	local timeRow = UI.row(body, "Întinde timpul")
	for _, k in { 0.8, 1.15, 1.3 } do
		UI.button(timeRow, "×" .. k, function()
			self:try(Editor.retime, fx, k)
		end, { textSize = 12, tip = "durată, emisii, burst-uri, chei și vieți x" .. k })
	end
	UI.label(body, "Se redă pe selecție (personaj / part) sau pe sol, în fața camerei.", { dim = true, size = 11, wrap = true })

	-- elements --------------------------------------------------------------------------------
	local elements = Editor.elements(fx)
	body = UI.section(parent, "Elemente  (" .. #elements .. ")", { key = "vfx.elements" })
	for _, e in elements do
		local muted = e:GetAttribute("LC_Muted") == true
		local kind = Editor.kindOf(e)
		UI.item(body, e.Name, {
			icon = KIND_ICON[kind], selected = e == self.element, muted = muted,
			onClick = function()
				self.element = e
				self:refresh()
			end,
			actions = {
				{ text = muted and "○" or "●", color = muted and C.dim or C.good, onClick = function()
					self:set(e, { muted = not muted })
				end },
				{ text = "📋", onClick = function()
					self:try(function()
						self.element = Editor.duplicate(e)
					end)
				end },
				{ text = "×", color = C.danger, onClick = function()
					if self.element == e then
						self.element = nil
					end
					self:try(Editor.remove, e)
				end },
			},
		})
	end
	-- presets grouped by theme (Electricitate, Apă și gheață...); the icon tells the kind of element it adds
	local addItems = groupedItems(Editor.PRESETS, function(p)
		return p.group or KIND_LABEL[p.kind]
	end, function(p)
		return p.key
	end, function(p)
		return KIND_ICON[p.kind] .. "  " .. p.label
	end)
	table.insert(addItems, { header = true, label = "Gol" })
	for _, empty in { { "PARTICLES", "Particule (gol)" }, { "LIGHT", "Lumină (goală)" }, { "TRAIL", "Trail (gol)" },
		{ "MESH", "Mesh 3D (gol)" }, { "SOUND", "Sunet (gol)" }, { "CAMERA", "Cameră: tremur / zoom / flash (gol)" },
		{ "BEAM", "Rază între două puncte (goală)" } } do
		table.insert(addItems, { value = empty[1], label = KIND_ICON[empty[1]] .. "  " .. empty[2] })
	end
	UI.dropdown(UI.hstack(body), addItems, nil, function(key)
		self:try(function()
			self.element = Editor.addElement(fx, key)
		end)
	end, { text = "+ Adaugă element", style = "primary", menuWidth = 220 })

	if self.element then
		self:renderElement(parent, self.element)
	end
end

-- ---------------------------------------------------------------------------------------------
-- new effect from a template
-- ---------------------------------------------------------------------------------------------
function Panel:renderTemplates(body)
	local Editor = self.Editor
	local templates = Editor.TEMPLATES or {}
	local box = UI.vstack(body, 4)
	if #templates == 0 then
		UI.note(box, "Acest Editor nu are șabloane (versiune veche a modulului).", C.warn)
		return
	end
	local tpl
	for _, t in templates do
		if t.key == self.tplKey then
			tpl = t
		end
	end
	tpl = tpl or templates[1]
	self.tplKey = tpl.key

	local items = groupedItems(templates, function(t)
		return t.category
	end, function(t)
		return t.key
	end, function(t)
		return t.label
	end)
	UI.dropdown(UI.row(box, "Șablon"), items, tpl.key, function(key)
		self.tplKey = key
		self.tplName = nil
		self:refresh()
	end, { menuWidth = 230 })
	local attachLabel = tpl.attach
	for _, a in Editor.ATTACH do
		if a.key == tpl.attach then
			attachLabel = a.label
		end
	end
	UI.label(box, tpl.desc, { dim = true, size = 11, wrap = true })
	UI.label(box, string.format("%s s  ·  %d elemente  ·  prins de: %s", UI.fmt(tpl.duration), #tpl.elements, attachLabel),
		{ dim = true, size = 11, wrap = true })

	local colors = UI.row(box, "Culoare")
	UI.color(colors, self.tplColor or tpl.main, function(c)
		self.tplColor = c
		self:refresh()
	end)
	if self.tplColor then
		UI.button(colors, "↺", function()
			self.tplColor = nil
			self:refresh()
		end, { width = 28, style = "ghost", tip = "culorile originale ale șablonului" })
	end
	UI.number(UI.row(box, "Scară"), self.tplScale or 1, function(v)
		self.tplScale = v
		self:refresh()
	end, { min = 0.25, max = 4, step = 0.25, decimals = 2, tip = "mărește / micșorează tot efectul (mărimi, distanțe, viteze)" })

	local defaultName = freeName(Editor, tpl.label)
	local nameBox = UI.textbox(UI.row(box, "Nume"), self.tplName or defaultName, function(text)
		self.tplName = text
	end, { placeholder = "Numele efectului" })
	local row = UI.hstack(box)
	UI.button(row, "Creează și redă", function()
		local name = trim(nameBox.Text) ~= "" and nameBox.Text or defaultName
		local scale = self.tplScale or 1
		local ok, fx = pcall(Editor.newFromTemplate, name, tpl.key, { color = self.tplColor, scale = scale ~= 1 and scale or nil })
		if ok then
			self.effect, self.element = fx, nil
			self.templating, self.tplName = false, nil
			self.error = nil
			self:refresh()
			task.defer(function()
				if self.effect == fx and fx.Parent then
					self:play()
				end
			end)
		else
			self.error = clean(fx)
			self:refresh()
		end
	end, { style = "primary", bold = true })
	UI.button(row, "×", function()
		self.templating = false
		self:refresh()
	end, { width = 26, style = "ghost" })
	UI.spacer(box, 2)
end

-- ---------------------------------------------------------------------------------------------
-- free VFX from the Creator Store (scripts are deleted by the Editor before anything is copied)
-- ---------------------------------------------------------------------------------------------
local function importLines(result)
	local lines = {
		"✓ Importate în efectul ales: " .. result.particles .. " particule, " .. result.trails .. " trail-uri, " .. result.lights
			.. " lumini (scripturile nu se copiază).",
	}
	for _, note in result.notes do
		table.insert(lines, "• " .. note)
	end
	return lines
end

function Panel:renderImport(parent)
	local Editor = self.Editor
	local body = UI.section(parent, "Importă VFX gratuit (Creator Store)", { key = "vfx.import", collapsed = true })
	if not Editor.importAsset then
		UI.note(body, "Acest Editor nu poate importa (versiune veche a modulului).", C.warn)
		return
	end
	UI.label(body, "Lipește ID-ul (sau adresa) unui model VFX gratuit din Creator Store. Scripturile din model se șterg înainte de orice, "
		.. "apoi particulele, trail-urile și luminile devin un efect LostCube.", { dim = true, size = 11, wrap = true })
	local idBox = UI.textbox(UI.row(body, "ID asset"), self.importId or "", function(text)
		self.importId = text
	end, { placeholder = "ex. 123456789 sau adresa paginii" })
	local nameBox = UI.textbox(UI.row(body, "Nume efect"), self.importName or "", function(text)
		self.importName = text
	end, { placeholder = "gol = Import <ID>" })
	local row = UI.hstack(body)
	UI.button(row, self.importing and "Se importă…" or "Importă", function()
		if self.importing then
			return
		end
		local id = assetIdOf(idBox.Text)
		if not id then
			self.importReport = { ok = false, lines = { "✗ Scrie ID-ul asset-ului: numărul din adresa paginii (…/store/asset/NUMĂR)." } }
			self:refresh()
			return
		end
		local name = trim(nameBox.Text)
		self.importId, self.importName = idBox.Text, nameBox.Text
		self.importing, self.importReport = true, nil
		self:refresh()
		task.spawn(function()
			-- the download yields: the texts were read above, the boxes of this render are already gone
			local ok, fx, report = pcall(Editor.importAsset, tonumber(id), name ~= "" and name or nil)
			self.importing = false
			if ok and fx then
				self.effect, self.element = fx, nil
			end
			self.importReport = ok and report or { ok = false, lines = { "✗ " .. clean(fx) } }
			self:refresh()
		end)
	end, { style = "primary", bold = true, tip = "descarcă modelul, șterge scripturile și creează efectul" })
	UI.button(row, "Din selecție", function()
		if not self.effect then
			self.importReport = { ok = false, lines = { "✗ Alege mai întâi un efect (sau creează unul)." } }
			self:refresh()
			return
		end
		local picked = Selection:Get()[1]
		if not picked then
			self.importReport = { ok = false, lines = { "✗ Selectează în Explorer modelul cu particule (inserat din Toolbox)." } }
			self:refresh()
			return
		end
		local ok, result = pcall(Editor.importEmitters, self.effect, picked)
		self.importReport = ok and { ok = true, lines = importLines(result) } or { ok = false, lines = { "✗ " .. clean(result) } }
		self:refresh()
	end, { tip = "copiază emitoarele din obiectul selectat în efectul ales (nu copiază scripturi)" })
	local report = self.importReport
	if report then
		local color = report.ok and ((report.suspicious or 0) == 0 and C.good or C.warn) or C.warn
		local lines = {}
		for _, line in report.lines or {} do
			table.insert(lines, plain(line))
		end
		UI.note(body, table.concat(lines, "\n"), color)
	end
end

-- ---------------------------------------------------------------------------------------------
-- element properties
-- ---------------------------------------------------------------------------------------------
local function triple(self, body, label, values, element, key, opts)
	local area = UI.row(body, label)
	for i = 1, 3 do
		UI.number(area, values[i], function(v)
			local t = { values[1], values[2], values[3], mid = values.mid }
			t[i] = v
			self:set(element, { [key] = t })
		end, opts)
	end
end

local function pair(self, body, label, values, element, key, opts)
	local area = UI.row(body, label)
	for i = 1, 2 do
		UI.number(area, values[i], function(v)
			local t = { values[1], values[2] }
			t[i] = v
			self:set(element, { [key] = t })
		end, opts)
	end
end

local function vector(self, body, label, v, element, key, opts)
	local area = UI.row(body, label)
	for _, axis in { "X", "Y", "Z" } do
		UI.number(area, v[axis], function(x)
			local cur = (key == "position" and self.Editor.position(element)) or v
			local t = { X = cur.X, Y = cur.Y, Z = cur.Z }
			t[axis] = x
			self:set(element, { [key] = Vector3.new(t.X, t.Y, t.Z) })
		end, opts)
	end
end

local function single(self, body, label, value, element, key, opts)
	UI.number(UI.row(body, label), value, function(v)
		self:set(element, { [key] = v })
	end, opts)
end

function Panel:colorRow(body, data, element)
	local cols = data.color
	local mode = #cols
	UI.segmented(UI.row(body, "Culori"), {
		{ value = 1, label = "Una" }, { value = 2, label = "Două" }, { value = 3, label = "Trei" },
	}, mode, function(m)
		local a, b, c = cols[1], cols[2] or cols[1], cols[3] or cols[2] or cols[1]
		self:set(element, { color = m == 1 and a or (m == 2 and { a, b } or { a, b, c }) })
	end)
	local area = UI.row(body, mode == 1 and "Culoare" or "început → sfârșit")
	for i = 1, mode do
		UI.color(area, cols[i], function(c)
			local t = { cols[1], cols[2], cols[3], mid = cols.mid }
			t[i] = c
			self:set(element, { color = mode == 1 and c or (mode == 2 and { t[1], t[2] } or t) })
		end)
	end
end

function Panel:textureRow(body, data, element)
	local items = groupedItems(self.Editor.TEXTURES, function(t)
		return t.group or "Altele"
	end, function(t)
		return t.key
	end, function(t)
		return t.label
	end)
	table.insert(items, { header = true, label = "Proprii" })
	table.insert(items, { value = "CUSTOM", label = "ID propriu…" })
	UI.dropdown(UI.row(body, "Textură"), items, data.texture, function(v)
		if v == "CUSTOM" then
			self.customTexture = true
			self:refresh()
		else
			self.customTexture = false
			self:set(element, { texture = v })
		end
	end, { menuWidth = 200 })
	if data.texture == "CUSTOM" or self.customTexture then
		UI.textbox(UI.row(body, "ID textură"), data.textureId, function(text)
			local id = text:match("^%d+$") and ("rbxassetid://" .. text) or text
			self:set(element, { texture = id })
		end, { placeholder = "rbxassetid://123456" })
	end
end

function Panel:renderElement(parent, element)
	local Editor = self.Editor
	local data = Editor.read(element)
	local kind = data.kind
	local body = UI.section(parent, KIND_ICON[kind] .. "  " .. element.Name, { key = "vfx.element" })
	UI.textbox(UI.row(body, "Nume"), element.Name, function(text)
		if text ~= "" then
			self:set(element, { name = text })
		end
	end)
	local ofKind = {}
	for _, p in Editor.PRESETS do
		if p.kind == kind then
			table.insert(ofKind, p)
		end
	end
	local presetItems = groupedItems(ofKind, function(p)
		return p.group or KIND_LABEL[p.kind]
	end, function(p)
		return p.key
	end, function(p)
		return p.label
	end)
	UI.dropdown(UI.row(body, "Preset"), presetItems, data.preset, function(v)
		self:try(Editor.applyPreset, element, v)
	end, { placeholder = "alege…", menuWidth = 210 })
	vector(self, body, "Poziție", data.position, element, "position", { step = 0.25, decimals = 2 })
	UI.button(UI.hstack(body), "Selectează în Explorer", function()
		Selection:Set({ element })
	end, { style = "ghost" })

	if kind == "PARTICLES" then
		body = UI.section(parent, "Aspect", { key = "vfx.look" })
		self:textureRow(body, data, element)
		self:colorRow(body, data, element)
		triple(self, body, "Mărime", data.size, element, "size", { min = 0, step = 0.1, decimals = 2 })
		triple(self, body, "Transparență", data.transparency, element, "transparency", { min = 0, max = 1, step = 0.05, decimals = 2 })
		UI.number(UI.row(body, "Mijloc la (0-1)"), data.size.mid or 0.5, function(v)
			local s, tr = data.size, data.transparency
			self:set(element, { size = { s[1], s[2], s[3], mid = v }, transparency = { tr[1], tr[2], tr[3], mid = v } })
		end, { min = 0.01, max = 0.99, step = 0.05, decimals = 2 })
		single(self, body, "Strălucire", data.LightEmission, element, "LightEmission", { min = 0, max = 1, step = 0.1, decimals = 2 })
		single(self, body, "Influență lumină", data.LightInfluence, element, "LightInfluence", { min = 0, max = 1, step = 0.1, decimals = 2 })
		single(self, body, "Luminozitate", data.Brightness, element, "Brightness", { min = 0, step = 0.25, decimals = 2 })
		single(self, body, "Squash", data.squash, element, "squash", { min = -3, max = 3, step = 0.25, decimals = 2 })
		UI.dropdown(UI.row(body, "Orientare"), ORIENT, data.Orientation, function(v)
			self:set(element, { Orientation = v })
		end, { menuWidth = 220 })
		single(self, body, "ZOffset", data.ZOffset, element, "ZOffset", { step = 0.25, decimals = 2 })

		body = UI.section(parent, "Mișcare", { key = "vfx.motion" })
		pair(self, body, "Viață (s)", data.lifetime, element, "lifetime", { min = 0, step = 0.05, decimals = 2 })
		pair(self, body, "Viteză", data.speed, element, "speed", { step = 0.5, decimals = 2 })
		single(self, body, "Rată / s", data.Rate, element, "Rate", { min = 0, step = 5, decimals = 1 })
		pair(self, body, "Spread X / Y", data.spread, element, "spread", { min = 0, max = 180, step = 5, decimals = 0 })
		vector(self, body, "Accelerație", data.acceleration, element, "acceleration", { step = 1, decimals = 2 })
		single(self, body, "Drag", data.Drag, element, "Drag", { min = 0, step = 0.5, decimals = 2 })
		pair(self, body, "Rotație", data.rotation, element, "rotation", { step = 15, decimals = 0 })
		pair(self, body, "Rotire / s", data.rotSpeed, element, "rotSpeed", { step = 15, decimals = 0 })
		UI.toggle(UI.hstack(body), data.LockedToPart, function(v)
			self:set(element, { LockedToPart = v })
		end, "Lipit de efect (LockedToPart)")

		body = UI.section(parent, "Formă și direcție", { key = "vfx.shape", collapsed = true })
		UI.dropdown(UI.row(body, "Formă"), SHAPES, data.shape, function(v)
			self:set(element, { shape = v })
		end)
		if data.shape ~= "Point" and data.partSize then
			vector(self, body, "Mărime formă", data.partSize, element, "partSize", { min = 0.05, step = 0.25, decimals = 2 })
			UI.segmented(UI.row(body, "Din"), { { value = "Volume", label = "Volum" }, { value = "Surface", label = "Suprafață" } },
				data.ShapeStyle, function(v)
					self:set(element, { ShapeStyle = v })
				end)
			UI.segmented(UI.row(body, "Sens"), { { value = "Outward", label = "Afară" }, { value = "Inward", label = "Înăuntru" },
				{ value = "InAndOut", label = "Ambele" } }, data.ShapeInOut, function(v)
				self:set(element, { ShapeInOut = v })
			end)
		end
		UI.dropdown(UI.row(body, "Direcție"), DIRECTIONS, data.EmissionDirection, function(v)
			self:set(element, { EmissionDirection = v })
		end)
		if data.FlipbookLayout then
			self:renderFlipbook(parent, element, data)
		end
		self:renderTimeline(parent, element, data)
	elseif kind == "MESH" then
		self:renderMesh(parent, element, data)
		self:renderTimeline(parent, element, data)
	elseif kind == "LIGHT" then
		body = UI.section(parent, "Lumină", { key = "vfx.light" })
		UI.color(UI.row(body, "Culoare"), data.Color, function(c)
			self:set(element, { Color = c })
		end)
		single(self, body, "Luminozitate", data.Brightness, element, "Brightness", { min = 0, step = 0.5, decimals = 2 })
		single(self, body, "Rază", data.Range, element, "Range", { min = 0, max = 60, step = 1, decimals = 1 })
		UI.toggle(UI.hstack(body), data.Shadows, function(v)
			self:set(element, { Shadows = v })
		end, "Umbre")
		body = UI.section(parent, "Chei (luminozitate în timp)", { key = "vfx.keys" })
		local keys = data.keys
		if #keys == 0 then
			UI.label(body, "Fără chei: lumina stă constantă.", { dim = true, size = 12 })
		end
		for i, k in keys do
			local area = UI.row(body, "Cheia " .. i, { labelWidth = 52 })
			for j = 1, 3 do
				UI.number(area, k[j], function(v)
					local copy = table.clone(keys)
					copy[i] = table.clone(k)
					copy[i][j] = v
					self:set(element, { keys = copy })
				end, { min = 0, step = j == 1 and 0.05 or 0.5, decimals = 2, tip = ({ "timp (s)", "luminozitate", "rază" })[j] })
			end
			UI.button(area, "×", function()
				local copy = table.clone(keys)
				table.remove(copy, i)
				self:set(element, { keys = copy })
			end, { width = 24, style = "ghost" })
		end
		UI.label(body, "timp (s) · luminozitate · rază", { dim = true, size = 11 })
		UI.button(UI.hstack(body), "+ Cheie", function()
			local copy = table.clone(keys)
			local last = keys[#keys]
			table.insert(copy, { last and last[1] + 0.1 or 0, data.Brightness, data.Range })
			self:set(element, { keys = copy })
		end)
	elseif kind == "TRAIL" then
		body = UI.section(parent, "Trail", { key = "vfx.trail" })
		self:textureRow(body, data, element)
		self:colorRow(body, data, element)
		pair(self, body, "Transparență", { data.transparency[1], data.transparency[3] }, element, "transparency",
			{ min = 0, max = 1, step = 0.05, decimals = 2 })
		single(self, body, "Viață (s)", data.lifetime, element, "lifetime", { min = 0.01, step = 0.05, decimals = 2 })
		single(self, body, data.ground and "Lățime (pe sol)" or "Înălțime", data.height, element, "height",
			{ min = 0.05, step = 0.25, decimals = 2 })
		single(self, body, "Lățime la vârf", data.widthHead, element, "widthHead", { min = 0, max = 1, step = 0.05, decimals = 2 })
		single(self, body, "Lățime la coadă", data.widthEnd, element, "widthEnd", { min = 0, max = 1, step = 0.05, decimals = 2 })
		single(self, body, "Strălucire", data.LightEmission, element, "LightEmission", { min = 0, max = 1, step = 0.1, decimals = 2 })
		UI.toggle(UI.hstack(body), data.ground, function(v)
			self:set(element, { ground = v })
		end, "Urmă plată pe sol (urmează piciorul)")
		if data.ground then
			single(self, body, "Curgere (cicluri/s)", data.flow, element, "flow", { min = 0, max = 6, step = 0.1, decimals = 2 })
			single(self, body, "Ridicare (studs)", data.lift, element, "lift", { min = 0, max = 0.3, step = 0.005, decimals = 3 })
		end
		self:renderTimeline(parent, element, data)
	elseif kind == "SOUND" then
		self:renderSound(parent, element, data)
		self:renderTimeline(parent, element, data)
	elseif kind == "CAMERA" then
		self:renderCamera(parent, element, data)
		self:renderTimeline(parent, element, data)
	elseif kind == "BEAM" then
		self:renderBeam(parent, element, data)
		self:renderTimeline(parent, element, data)
	end
end

-- flipbooks: a texture made of a grid of frames, played as an animation on each particle
function Panel:renderFlipbook(parent, element, data)
	local body = UI.section(parent, "Flipbook (textură animată)", { key = "vfx.flipbook", collapsed = data.FlipbookLayout == "None" })
	local layouts = FLIPBOOK_LAYOUTS
	if data.FlipbookLayout == "Custom" then -- set outside LostCube (e.g. an imported emitter): shown, kept
		layouts = table.clone(FLIPBOOK_LAYOUTS)
		table.insert(layouts, { value = "Custom", label = "Personalizată (din import)" })
	end
	UI.dropdown(UI.row(body, "Cadre"), layouts, data.FlipbookLayout, function(v)
		self:set(element, { FlipbookLayout = v })
	end, { menuWidth = 210 })
	if data.FlipbookLayout ~= "None" then
		UI.dropdown(UI.row(body, "Redare"), FLIPBOOK_MODES, data.FlipbookMode, function(v)
			self:set(element, { FlipbookMode = v })
		end, { menuWidth = 210 })
		if data.FlipbookMode ~= "OneShot" then
			pair(self, body, "Cadre / s", data.FlipbookFramerate, element, "FlipbookFramerate",
				{ min = 0, step = 1, decimals = 1, tip = "câte cadre pe secundă (min, max)" })
		end
		UI.toggle(UI.hstack(body), data.FlipbookStartRandom, function(v)
			self:set(element, { FlipbookStartRandom = v })
		end, "Fiecare particulă începe de la alt cadru")
	end
	UI.label(body, "Textura trebuie să fie o grilă de cadre (2×2, 4×4 sau 8×8), ca o foaie de sprite-uri.",
		{ dim = true, size = 11, wrap = true })
end

function Panel:renderSound(parent, element, data)
	local Editor = self.Editor
	local body = UI.section(parent, "Sunet", { key = "vfx.sound" })
	local items = {}
	for _, snd in Editor.SOUNDS or {} do
		table.insert(items, { value = snd.key, label = snd.label })
	end
	table.insert(items, 1, { header = true, label = "Încorporate în Roblox (fără upload)" })
	table.insert(items, { header = true, label = "Proprii" })
	table.insert(items, { value = "CUSTOM", label = "ID propriu…" })
	local row = UI.row(body, "Sunet")
	UI.dropdown(row, items, data.sound, function(v)
		if v == "CUSTOM" then -- shows the id box (like "ID propriu…" for textures)
			self.customSound = true
			self:refresh()
		else
			self.customSound = false
			self:set(element, { soundId = v })
		end
	end, { menuWidth = 230 })
	UI.button(row, "▶", function()
		local ok, err = pcall(function()
			game:GetService("SoundService"):PlayLocalSound(element)
		end)
		if not ok then
			self.error = clean(err)
			self:refresh()
		end
	end, { width = 28, tip = "ascultă sunetul (o dată, fără efect)" })
	if data.sound == "CUSTOM" or self.customSound then
		UI.textbox(UI.row(body, "ID sunet"), data.soundId, function(text)
			local id = assetIdOf(text)
			self:set(element, { soundId = id and ("rbxassetid://" .. id) or trim(text) })
		end, { placeholder = "rbxassetid://123456 (din Creator Store → Audio)" })
	end
	single(self, body, "Volum", data.Volume, element, "Volume", { min = 0, max = 10, step = 0.1, decimals = 2 })
	pair(self, body, "Ton (min, max)", data.pitch, element, "pitch",
		{ min = 0.05, max = 4, step = 0.05, decimals = 2, tip = "viteza de redare, aleasă la întâmplare la fiecare redare (1 = normal)" })
	single(self, body, "Se aude până la", data.RollOffMaxDistance, element, "RollOffMaxDistance",
		{ min = 1, step = 10, decimals = 0, tip = "studs (RollOffMaxDistance): mai departe nu se mai aude" })
	if data.window then
		single(self, body, "Stingere (s)", data.fade, element, "fade", { min = 0, step = 0.05, decimals = 2, tip = "cât durează să se stingă bucla" })
	end
	UI.label(body, (data.length or 0) > 0 and string.format("Durata sunetului: %s s. Redările îl pornesc; o buclă îl repetă și îl stinge la final.",
		UI.fmt(data.length)) or "Redările îl pornesc; o buclă îl repetă și îl stinge la final. Sunetul e poziționat în efect.",
		{ dim = true, size = 11, wrap = true })
end

function Panel:renderCamera(parent, element, data)
	local body = UI.section(parent, "Cameră", { key = "vfx.camera" })
	single(self, body, "Tremur (grade)", data.shake, element, "shake",
		{ min = 0, max = 10, step = 0.1, decimals = 2, tip = "cât de tare se scutură camera (0 = fără)" })
	if data.shake > 0 then
		single(self, body, "Frecvență (Hz)", data.frequency, element, "frequency", { min = 1, max = 40, step = 1, decimals = 0 })
		single(self, body, "Durată tremur (s)", data.shakeTime, element, "shakeTime",
			{ min = 0.02, step = 0.05, decimals = 2, tip = "la fiecare lovitură; scade spre 0 în timpul ăsta" })
	end
	single(self, body, "Zoom FOV (grade)", data.fov, element, "fov",
		{ min = -40, max = 40, step = 1, decimals = 1, tip = "+ = zoom-out (impact), − = zoom-in, 0 = fără" })
	if data.fov ~= 0 then
		single(self, body, "Durată zoom (s)", data.fovTime, element, "fovTime", { min = 0.02, step = 0.05, decimals = 2 })
	end
	UI.toggle(UI.hstack(body), data.flash ~= nil, function(v)
		self:set(element, { flash = v and Color3.new(1, 1, 1) or false })
	end, "Flash pe ecran")
	if data.flash then
		UI.color(UI.row(body, "Culoare flash"), data.flash, function(c)
			self:set(element, { flash = c })
		end)
		single(self, body, "Intensitate", data.flashAlpha, element, "flashAlpha", { min = 0.05, max = 1, step = 0.05, decimals = 2 })
		single(self, body, "Durată flash (s)", data.flashTime, element, "flashTime", { min = 0.02, step = 0.05, decimals = 2 })
	end
	single(self, body, "Rază (studs)", data.radius, element, "radius",
		{ min = 1, step = 5, decimals = 0, tip = "mai departe de atât camera nu simte nimic; întreg în primele 30%" })
	UI.toggle(UI.hstack(body), data.studio, function(v)
		self:set(element, { studio = v })
	end, "Aplică și în previzualizarea din Studio")
	UI.label(body, "În joc: doar pe client, pe camera jucătorului din apropiere. În Studio camera revine exact unde era.",
		{ dim = true, size = 11, wrap = true })
end

function Panel:renderBeam(parent, element, data)
	local body = UI.section(parent, "Rază (Beam)", { key = "vfx.beam" })
	vector(self, body, "Început", data.start, element, "start", { step = 0.25, decimals = 2 })
	vector(self, body, "Sfârșit", data.finish, element, "finish", { step = 0.25, decimals = 2 })
	pair(self, body, "Lățime (început, sfârșit)", data.width, element, "width", { min = 0, step = 0.1, decimals = 2 })
	pair(self, body, "Curbură", data.curve, element, "curve", { step = 0.5, decimals = 2, tip = "îndoaie raza la capete (CurveSize0 / 1)" })
	single(self, body, "Segmente", data.Segments, element, "Segments", { min = 1, max = 100, step = 1, decimals = 0 })
	self:textureRow(body, data, element)
	if data.texture ~= "NONE" then
		UI.segmented(UI.row(body, "Textură"), TEXTURE_MODES, data.TextureMode, function(v)
			self:set(element, { TextureMode = v })
		end)
		single(self, body, "Lungime textură", data.TextureLength, element, "TextureLength", { min = 0.01, step = 0.5, decimals = 2 })
		single(self, body, "Curgere textură", data.TextureSpeed, element, "TextureSpeed", { step = 0.5, decimals = 2 })
	end
	self:colorRow(body, data, element)
	pair(self, body, "Transparență", { data.transparency[1], data.transparency[3] }, element, "transparency",
		{ min = 0, max = 1, step = 0.05, decimals = 2 })
	single(self, body, "Strălucire", data.LightEmission, element, "LightEmission", { min = 0, max = 1, step = 0.1, decimals = 2 })
	single(self, body, "Luminozitate", data.Brightness, element, "Brightness", { min = 0, step = 0.25, decimals = 2 })
	UI.toggle(UI.hstack(body), data.FaceCamera, function(v)
		self:set(element, { FaceCamera = v })
	end, "Întoarsă spre cameră")

	body = UI.section(parent, "Apariție", { key = "vfx.beamTiming" })
	single(self, body, "Flash (s)", data.flashTime, element, "flashTime",
		{ min = 0.02, step = 0.02, decimals = 2, tip = "cât stă aprinsă la fiecare flash din timeline" })
	single(self, body, "Apare / se stinge (s)", data.fade, element, "fade", { min = 0, step = 0.02, decimals = 2 })
	single(self, body, "Variație la flash (studs)", data.jitter, element, "jitter",
		{ min = 0, step = 0.25, decimals = 2, tip = "capătul și curbura se mută la întâmplare la fiecare flash (fulger)" })
end

function Panel:renderMesh(parent, element, data)
	local body = UI.section(parent, "Mesh 3D", { key = "vfx.mesh" })
	UI.dropdown(UI.row(body, "Mod"), MESH_MODES, data.mode, function(v)
		self:set(element, { mode = v })
	end, { menuWidth = 220 })
	local looks = UI.row(body, "Formă / material")
	UI.dropdown(looks, PART_SHAPES, data.shape, function(v)
		self:set(element, { shape = v })
	end)
	UI.dropdown(looks, MATERIALS, data.material, function(v)
		self:set(element, { material = v })
	end, { menuWidth = 150 })
	local colors = UI.row(body, "Culoare → final")
	UI.color(colors, data.color, function(c)
		self:set(element, { color = c })
	end)
	UI.color(colors, data.colorEnd or data.color, function(c)
		self:set(element, { colorEnd = c })
	end)
	vector(self, body, "Mărime", data.size, element, "size", { min = 0.02, step = 0.1, decimals = 2 })
	pair(self, body, "Creștere", data.grow, element, "grow", { min = 0, step = 0.1, decimals = 2 })
	pair(self, body, "Transparență", data.transparency, element, "transparency", { min = 0, max = 1, step = 0.05, decimals = 2 })
	pair(self, body, "Viață (s)", data.lifetime, element, "lifetime", { min = 0.02, step = 0.05, decimals = 2 })
	single(self, body, "Rată / s", data.Rate, element, "rate", { min = 0, step = 5, decimals = 1 })
	if data.mode == "Ring" or data.mode == "Crack" then
		single(self, body, "Segmente", data.count, element, "count", { min = 1, max = 64, step = 1, decimals = 0 })
		pair(self, body, data.mode == "Ring" and "Rază (început, final)" or "Lungime (min, max)", data.radius, element,
			"radius", { min = 0, step = 0.5, decimals = 2 })
	end
	if data.mode == "Puff" or data.mode == "Debris" then
		pair(self, body, "Viteză", data.speed, element, "speed", { min = 0, step = 1, decimals = 1 })
		pair(self, body, "Spread X / Y", data.spread, element, "spread", { min = 0, max = 180, step = 5, decimals = 0 })
		UI.dropdown(UI.row(body, "Direcție"), DIRECTIONS, data.direction, function(v)
			self:set(element, { direction = v })
		end)
	end
	if data.mode == "Puff" then
		single(self, body, "Urcare (studs)", data.rise, element, "rise", { step = 0.25, decimals = 2 })
	end
	if data.mode == "Debris" then
		single(self, body, "Rotire", data.spin, element, "spin", { min = 0, step = 2, decimals = 0 })
	end
	single(self, body, "Variație mărime", data.jitter, element, "jitter", { min = 0, max = 1, step = 0.05, decimals = 2 })
	UI.toggle(UI.hstack(body), data.ground, function(v)
		self:set(element, { ground = v })
	end, "Lipit de sol (găsește podeaua)")
	UI.label(body, "Piesele sunt 3D reale (Part): lumină, umbră și perspectivă adevărate.", { dim = true, size = 11, wrap = true })
end

function Panel:renderTimeline(parent, element, data)
	local body = UI.section(parent, "Timeline", { key = "vfx.timeline" })
	local text = TIMELINE_TEXT[data.kind] or TIMELINE_TEXT.PARTICLES
	local w = data.window
	local area = UI.row(body, text[1])
	UI.number(area, w and w[1] or 0, function(v)
		self:set(element, { window = { v, math.max(v + 0.01, w and w[2] or v + 0.3) } })
	end, { min = 0, step = 0.05, decimals = 2, tip = "de la" })
	UI.number(area, w and w[2] or 0, function(v)
		self:set(element, { window = { w and w[1] or 0, v } })
	end, { min = 0, step = 0.05, decimals = 2, tip = "până la" })
	UI.button(area, "×", function()
		self:set(element, { window = false })
	end, { width = 24, style = "ghost" })
	UI.label(body, w and string.format(text[2], UI.fmt(w[1]), UI.fmt(w[2])) or text[3], { dim = true, size = 11 })
	if not text[4] or not data.bursts then
		return
	end
	local counted = data.kind ~= "CAMERA" and data.kind ~= "BEAM" -- a kick / flash has no count
	local bursts = data.bursts
	for i, b in bursts do
		local row = UI.row(body, text[4] .. " " .. i, { labelWidth = 64 })
		UI.number(row, b[1], function(v)
			local copy = table.clone(bursts)
			copy[i] = { v, b[2] }
			self:set(element, { bursts = copy })
		end, { min = 0, step = 0.05, decimals = 2, tip = "timp (s)" })
		if counted then
			UI.number(row, b[2], function(v)
				local copy = table.clone(bursts)
				copy[i] = { b[1], math.max(1, math.floor(v)) }
				self:set(element, { bursts = copy })
			end, { min = 1, step = 1, decimals = 0, tip = data.kind == "SOUND" and "câte redări suprapuse" or "câte particule" })
		end
		UI.button(row, "×", function()
			local copy = table.clone(bursts)
			table.remove(copy, i)
			self:set(element, { bursts = copy })
		end, { width = 24, style = "ghost" })
	end
	if #bursts > 0 then
		UI.label(body, text[5], { dim = true, size = 11 })
	end
	UI.button(UI.hstack(body), text[6], function()
		local copy = table.clone(bursts)
		local last = bursts[#bursts]
		table.insert(copy, { last and last[1] + 0.1 or 0, last and last[2] or (counted and data.kind ~= "SOUND" and 20 or 1) })
		self:set(element, { bursts = copy })
	end)
end

return Panel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">AnimPanel</string><ProtectedString name="Source"><![CDATA[-- LostCube > Animations tab: preview any KeyframeSequence on a rig in Edit mode, Moon-style easing on
-- keyframes, effects played on animation markers, and animations generated by code (AnimGen) that the user owns.
local RunService = game:GetService("RunService")
local Selection = game:GetService("Selection")
local Players = game:GetService("Players")
local KeyframeSequenceProvider = game:GetService("KeyframeSequenceProvider")
local ChangeHistoryService = game:GetService("ChangeHistoryService")

local UI = require(script.Parent.UI)
local AnimGen = require(script.Parent.AnimGen)
local C = UI.C

local Panel = {}
Panel.__index = Panel

local STYLES = { "Linear", "Constant", "Cubic", "Bounce", "Elastic" }
local DIRECTIONS = { { value = "In", label = "In" }, { value = "Out", label = "Out" }, { value = "InOut", label = "InOut" } }
local SEARCH = { "Workspace", "ReplicatedStorage", "ServerStorage", "StarterPlayer", "StarterPack", "Lighting" }

function Panel.new(ctx)
	return setmetatable({ ctx = ctx, Editor = ctx.Editor, rig = nil, clip = nil, speed = 1, loop = true,
		picked = {}, style = "Cubic", direction = "Out", clips = nil,
		-- generator: category, chosen animation, options, rig type when no rig is chosen, unsaved preview clip
		genCat = AnimGen.CATEGORIES[1], genKey = nil, genIntensity = 1, genSpeed = 1, genMirror = false, genRig = "R15",
		genTemp = nil }, Panel)
end

function Panel:refresh()
	if not self.dead then
		self.ctx.app:refresh()
	end
end

-- fn must not yield: the recording stays open meanwhile (and every edit of the user lands in it)
local function record(name, fn)
	local ok, id = pcall(ChangeHistoryService.TryBeginRecording, ChangeHistoryService, "LostCube: " .. name)
	local done, err = pcall(fn)
	if ok and id then
		pcall(ChangeHistoryService.FinishRecording, ChangeHistoryService, id,
			done and Enum.FinishRecordingOperation.Commit or Enum.FinishRecordingOperation.Cancel)
	end
	if done then
		pcall(function()
			require(script.Parent.Editor).log(name)
		end)
	end
	return done, err
end

-- ---------------------------------------------------------------------------------------------
-- rig + clips
-- ---------------------------------------------------------------------------------------------
-- the effect played on a marker is kept on the clip as an attribute; attribute names only take letters, digits
-- and _ , so a marker called "Hit 1" or "Hit-1" would fail silently without this
local function fxAttr(marker)
	return "LC_FX_" .. (marker:gsub("[^%w_]", "_"))
end

-- the Animator of the rig; made when missing (the second value is true then: Panel:stop takes it away again)
local function animatorOf(rig)
	local owner = rig:FindFirstChildOfClass("Humanoid") or rig:FindFirstChildOfClass("AnimationController")
	if not owner then
		return nil
	end
	local animator = owner:FindFirstChildOfClass("Animator")
	if animator then
		return animator, false
	end
	animator = Instance.new("Animator")
	animator.Parent = owner
	return animator, true
end

local function rigType(rig)
	local h = rig and rig:FindFirstChildOfClass("Humanoid")
	if h then
		return h.RigType == Enum.HumanoidRigType.R15 and "R15" or "R6"
	end
	return rig and (rig:FindFirstChild("UpperTorso") and "R15" or "R6") or "-"
end

-- Every KeyframeSequence in the game. Walking a big game takes a while: with `slice` (a function that gives the frame
-- back when its time is used up) one child of a service is walked at a time, so Studio stays responsive.
function Panel:findClips(slice)
	local list = {}
	for _, name in SEARCH do
		local ok, service = pcall(game.GetService, game, name)
		if ok and service then
			local parts = slice and service:GetChildren() or { service }
			for _, part in parts do
				if part ~= service and part.ClassName == "KeyframeSequence" then
					table.insert(list, part)
				end
				for _, d in part:GetDescendants() do
					if d.ClassName == "KeyframeSequence" then -- (no subclasses; cheaper than IsA on every descendant)
						table.insert(list, d)
					end
				end
				if slice then
					slice()
				end
			end
		end
	end
	-- sort keys and what the list shows are computed once per clip (not in every comparison / on every redraw)
	local keys, info = {}, {}
	for i, clip in list do
		local parent = clip.Parent
		local path = parent and parent:GetFullName() or ""
		keys[clip] = { path, clip.Name:lower() }
		info[clip] = { group = (path:gsub("^Workspace%.", ""):gsub("^ReplicatedStorage%.", "")), length = self:clipLength(clip) }
		if slice and i % 100 == 0 then
			slice()
		end
	end
	table.sort(list, function(a, b)
		local ka, kb = keys[a], keys[b]
		if ka[1] ~= kb[1] then
			return ka[1] < kb[1]
		end
		return ka[2] < kb[2]
	end)
	self.clips, self.clipInfo = list, info
	return list
end

-- the first list of the clips is made in the background (the tab shows at once); the 🔁 button makes it again
function Panel:scanClips()
	if self.scanning then
		return
	end
	self.scanning = true
	local started = os.clock()
	task.spawn(function()
		local ok, err = pcall(self.findClips, self, function()
			if self.dead then
				error("stop", 0)
			elseif os.clock() - started > 0.008 then
				task.wait()
				started = os.clock()
			end
		end)
		self.scanning = false
		if not ok and not self.dead then
			warn("LostCube:", err)
			self.clips, self.clipInfo = self.clips or {}, self.clipInfo or {}
		end
		self:refresh()
	end)
end

function Panel:clipLength(clip)
	local length = 0
	for _, kf in clip:GetKeyframes() do
		length = math.max(length, kf.Time)
	end
	return length
end

-- A dummy rig, not in the place yet. Making it waits for the web (it yields), so it is built BEFORE anything is
-- recorded: a recording kept open across a yield would swallow whatever the user edits meanwhile.
function Panel:buildDummy(kind)
	local desc = Instance.new("HumanoidDescription")
	local light, dark = Color3.fromRGB(214, 216, 226), Color3.fromRGB(40, 40, 48)
	desc.HeadColor, desc.LeftArmColor, desc.RightArmColor = light, light, light
	desc.LeftLegColor, desc.RightLegColor, desc.TorsoColor = dark, dark, dark
	-- CreateHumanoidModelFromDescriptionAsync replaces the deprecated name
	local okMethod, method = pcall(function()
		return Players.CreateHumanoidModelFromDescriptionAsync
	end)
	local ok, result
	if okMethod and method then
		ok, result = pcall(method, Players, desc, Enum.HumanoidRigType[kind])
	else
		ok, result = pcall(Players.CreateHumanoidModelFromDescription, Players, desc, Enum.HumanoidRigType[kind])
	end
	desc:Destroy()
	if not (ok and result) then
		error("nu am putut crea dummy-ul: " .. tostring(result), 0)
	end
	local model = result
	model.Name = "LostCube Dummy " .. kind
	local spot = self.Editor.previewTarget()
	local cf = typeof(spot) == "CFrame" and spot or CFrame.new(0, 0, 0)
	local root = model:FindFirstChild("HumanoidRootPart")
	local drop = kind == "R15" and (model.Humanoid.HipHeight + root.Size.Y / 2) or 3
	model:PivotTo(cf * CFrame.new(0, drop, 0))
	root.Anchored = true
	return model
end

function Panel:makeDummy(kind)
	if self.making then
		return -- one is already on its way
	end
	self:stop()
	self.making = true
	local built, model = pcall(self.buildDummy, self, kind)
	self.making = false
	if built and self.dead then
		model:Destroy()
		return
	end
	if not built then
		self.error = tostring(model)
		self:refresh()
		return
	end
	local done, err = record("dummy " .. kind, function()
		model.Parent = workspace -- only this goes into the undo step
	end)
	if done then
		self.rig = model
	else
		model:Destroy()
		self.error = tostring(err)
	end
	self:refresh()
end

-- ---------------------------------------------------------------------------------------------
-- playback (Edit mode: Animator:StepAnimations)
-- ---------------------------------------------------------------------------------------------
function Panel:resetPose()
	if not self.rig then
		return
	end
	for _, m in self.rig:GetDescendants() do
		if m:IsA("Motor6D") then
			m.Transform = CFrame.new()
		end
	end
end

function Panel:stop()
	if self.conn then
		self.conn:Disconnect()
		self.conn = nil
	end
	for _, c in self.markerConns or {} do
		c:Disconnect()
	end
	self.markerConns = nil
	self.playing = false
	if self.track then
		pcall(function()
			self.track:Stop(0)
			self.track:Destroy()
		end)
		self.track = nil
	end
	if self.ownAnimator then -- the rig did not have one: leave it as it was
		pcall(self.ownAnimator.Destroy, self.ownAnimator)
		self.ownAnimator = nil
	end
	self:resetPose()
end

function Panel:load()
	if not (self.rig and self.clip) then
		self.error = not self.rig and "alege un rig (selecția sau un dummy)" or nil
		return nil
	end
	self:stop() -- (also takes away an Animator this panel made for the previous preview)
	local animator, created = animatorOf(self.rig)
	if not animator then
		self.error = "rig-ul nu are Humanoid sau AnimationController"
		return nil
	end
	self.ownAnimator = created and animator or nil
	-- a broken clip (or a rig it does not fit) shows a message in the panel instead of only an error in Output
	local okLoad, track = pcall(function()
		local anim = Instance.new("Animation")
		anim.AnimationId = KeyframeSequenceProvider:RegisterKeyframeSequence(self.clip) -- picks up the latest edits
		return animator:LoadAnimation(anim)
	end)
	if not okLoad or not track then
		self.error = "nu am putut încărca animația: " .. tostring(track):gsub("^.-:%d+: ", "")
		self:stop()
		return nil
	end
	track.Looped = self.loop
	self.track, self.animator = track, animator
	-- effects on markers
	self.markerConns = {}
	for _, marker in self:markers() do
		local fxName = self.clip:GetAttribute(fxAttr(marker.name))
		if fxName then
			table.insert(self.markerConns, track:GetMarkerReachedSignal(marker.name):Connect(function()
				pcall(self.Editor.preview, fxName, { target = self.rig, speed = self.speed })
			end))
		end
	end
	self.conn = RunService.Heartbeat:Connect(function(dt)
		if self.track then
			-- the rig was deleted (undo) or the animator no longer works: stop instead of failing on every frame
			if not (self.rig and self.rig.Parent) or not pcall(self.animator.StepAnimations, self.animator, dt) then
				self:stop()
				self:refresh()
				return
			end
			if self.timeLabel and self.timeLabel.Parent then
				self.timeLabel.Text = string.format("%.2f / %.2f s", self.track.TimePosition, self.track.Length)
			end
		end
	end)
	return track
end

function Panel:play()
	local track = self.track or self:load()
	if not track then
		self:refresh()
		return
	end
	if not track.IsPlaying then
		track:Play(0, 1, self.speed)
	end
	track:AdjustSpeed(self.speed)
	self.playing = true
	self:refresh()
end

function Panel:pause()
	if self.track then
		self.track:AdjustSpeed(0)
	end
	self.playing = false
	self:refresh()
end

function Panel:step(frames)
	local track = self.track or self:load()
	if not track then
		self:refresh()
		return
	end
	if not track.IsPlaying then
		track:Play(0, 1, 0)
	end
	track:AdjustSpeed(0)
	self.playing = false
	track.TimePosition = math.clamp(track.TimePosition + frames / 60, 0, math.max(track.Length - 1e-3, 0))
	self.animator:StepAnimations(0)
	self:refresh()
end

function Panel:destroy()
	self.dead = true
	self:stop() -- Heartbeat connection, marker connections, track, pose, the Animator made for the preview
end

-- ---------------------------------------------------------------------------------------------
-- generated animations (AnimGen): preview without saving, save into RBX_ANIMSAVES
-- ---------------------------------------------------------------------------------------------
function Panel:genItem()
	for _, item in AnimGen.LIST do
		if item.key == self.genKey then
			return item
		end
	end
	return nil
end

-- the rig type follows the chosen rig; without one (or for a rig without Humanoid) the R15/R6 choice
function Panel:genRigType()
	local kind = self.rig and rigType(self.rig)
	if kind == "R15" or kind == "R6" then
		return kind, true
	end
	return self.genRig, false
end

function Panel:genOptions()
	local opts = { speed = self.genSpeed, intensity = self.genIntensity, mirror = self.genMirror }
	if self.rig then
		-- hip height, leg lengths and root height of this rig: planted feet and lying poses fit it exactly
		for key, value in AnimGen.measure(self.rig) do
			opts[key] = value
		end
	end
	return opts
end

function Panel:genPreview()
	local item = self:genItem()
	if not item then
		self.error = "alege o animație din listă"
		self:refresh()
		return
	end
	if not self.rig then
		self:makeDummy(self.genRig)
		if not self.rig then
			return
		end
	end
	local kind = self:genRigType()
	local ok, kfs = pcall(AnimGen.generate, item.key, kind, self:genOptions())
	if not ok then
		self.error = "nu am putut genera animația: " .. tostring(kfs)
		self:refresh()
		return
	end
	kfs.Name = "Previzualizare: " .. kfs.Name
	self:stop()
	self.genTemp = kfs -- not parented anywhere: nothing to undo, nothing left in the place
	self.genTempRig = self.rig
	self.clip = kfs
	self.picked = {}
	local played, err = pcall(self.play, self)
	if not played then
		self.error = "previzualizarea nu a pornit: " .. tostring(err)
		self:refresh()
	end
end

-- options changed while a preview runs: show the new version right away
function Panel:genChanged()
	if self.genTemp and self.clip == self.genTemp and self.rig then
		self:genPreview()
	else
		self:refresh()
	end
end

function Panel:genSave()
	local item = self:genItem()
	if not item then
		self.error = "alege o animație din listă"
		self:refresh()
		return
	end
	local kind = self:genRigType()
	local ok, result = pcall(function()
		return AnimGen.save(AnimGen.generate(item.key, kind, self:genOptions()), self.rig)
	end)
	if not ok then
		self.error = "nu am putut salva: " .. tostring(result)
		self:refresh()
		return
	end
	pcall(function()
		self.Editor.log("animație generată: " .. result:GetFullName())
	end)
	self:stop()
	self.genTemp = nil
	self:findClips() -- the list is cached
	self.clip = result -- easing, markers and effects on markers apply to it right away
	self.picked = {}
	self.genSaved = result:GetFullName()
	self:refresh()
end

-- a labelled slider with a number box; onCommit runs once, when the drag ends or the box is edited
local function slider(parent, text, value, opts, onCommit)
	local min, max, step = opts.min, opts.max, opts.step
	local row = UI.make("Frame", { Parent = parent, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, UI.H) })
	UI.label(row, text, { width = UI.LABEL_W, dim = true, size = 12 })
	local boxW = 48
	local hit = UI.make("TextButton", { Parent = row, Text = "", AutoButtonColor = false, BackgroundTransparency = 1,
		Position = UDim2.fromOffset(UI.LABEL_W + 6, 0), Size = UDim2.new(1, -(UI.LABEL_W + 6 + boxW + 8), 1, 0) })
	local track = UI.make("Frame", { Parent = hit, BackgroundColor3 = C.input, AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.5), Size = UDim2.new(1, 0, 0, 6) }, { UI.corner(3), UI.stroke(C.border) })
	local fill = UI.make("Frame", { Parent = track, BackgroundColor3 = C.accent, Size = UDim2.fromScale(0, 1) }, { UI.corner(3) })
	local knob = UI.make("Frame", { Parent = track, BackgroundColor3 = C.text, AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(12, 12) }, { UI.corner(6) })
	local current = value
	local box
	local function show(v)
		local f = math.clamp((v - min) / (max - min), 0, 1)
		fill.Size = UDim2.fromScale(f, 1)
		knob.Position = UDim2.fromScale(f, 0.5)
		if box and not box:IsFocused() then
			box.Text = UI.fmt(v, 2)
		end
	end
	local function fromX(x)
		local f = math.clamp((x - hit.AbsolutePosition.X) / math.max(hit.AbsoluteSize.X, 1), 0, 1)
		current = math.clamp(math.floor((min + f * (max - min)) / step + 0.5) * step, min, max)
		show(current)
	end
	local dragging = false
	local function finish()
		if dragging then
			dragging = false
			if current ~= value then
				onCommit(current)
			end
		end
	end
	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			fromX(input.Position.X)
		end
	end)
	hit.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			fromX(input.Position.X)
		end
	end)
	hit.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			finish()
		end
	end)
	hit.MouseLeave:Connect(finish)
	box = UI.number(row, value, function(v)
		current = v
		show(v)
		onCommit(v)
	end, { min = min, max = max, step = step, decimals = 2, width = boxW, tip = opts.tip })
	box.Position = UDim2.new(1, -boxW, 0, 0)
	show(value)
	return row
end

-- ---------------------------------------------------------------------------------------------
-- keyframes / markers
-- ---------------------------------------------------------------------------------------------
function Panel:keyframes()
	local list = self.clip and self.clip:GetKeyframes() or {}
	table.sort(list, function(a, b)
		return a.Time < b.Time
	end)
	return list
end

function Panel:markers(kfs)
	local out = {}
	for _, kf in kfs or self:keyframes() do
		for _, m in kf:GetMarkers() do
			table.insert(out, { name = m.Name, time = kf.Time, marker = m })
		end
	end
	return out
end

local function firstPose(kf)
	for _, d in kf:GetDescendants() do
		if d:IsA("Pose") and d.Weight > 0 then
			return d
		end
	end
	return nil
end

function Panel:applyEasing()
	local picked = {}
	for kf in self.picked do
		if kf.Parent == self.clip then
			table.insert(picked, kf)
		end
	end
	if #picked == 0 then
		self.error = "alege întâi cadrele (click pe ele)"
		self:refresh()
		return
	end
	local style, direction = Enum.PoseEasingStyle[self.style], Enum.PoseEasingDirection[self.direction]
	local done, err = record(string.format("easing %s %s pe %d cadre (%s)", self.style, self.direction, #picked, self.clip.Name), function()
		for _, kf in picked do
			for _, pose in kf:GetDescendants() do
				if pose:IsA("Pose") then
					pose.EasingStyle = style
					pose.EasingDirection = direction
				end
			end
		end
	end)
	self.error = not done and tostring(err) or nil
	self:stop() -- the next play re-registers the clip with the new easing
	self:refresh()
end

function Panel:addMarker(name)
	if not (self.clip and self.track) then
		self.error = "pornește sau pune animația pe un cadru întâi"
		self:refresh()
		return
	end
	local t = self.track.TimePosition
	local done, err = record("marker " .. name .. " pe " .. self.clip.Name, function()
		local target
		for _, kf in self:keyframes() do
			if math.abs(kf.Time - t) < 1 / 120 then
				target = kf
			end
		end
		if not target then
			target = Instance.new("Keyframe")
			target.Name = name
			target.Time = math.floor(t * 60 + 0.5) / 60
			target.Parent = self.clip
		end
		local m = Instance.new("KeyframeMarker")
		m.Name = name
		target:AddMarker(m)
	end)
	self.error = not done and tostring(err) or nil
	self:stop()
	self:refresh()
end

-- ---------------------------------------------------------------------------------------------
-- render
-- ---------------------------------------------------------------------------------------------
function Panel:renderGenerator(parent)
	local body = UI.section(parent, "Generează animații (gratis, ale tale)", { key = "anim.gen" })
	UI.label(body, "Create din cod direct în joc, deci sunt ale tale și pornesc în jocul tău (animațiile urcate "
		.. "de alții nu pornesc). Le poți edita apoi în Animation Editor.", { dim = true, size = 11, wrap = true })
	if self.genSaved then
		UI.note(body, "✓ Salvată în " .. self.genSaved .. " și aleasă mai jos.", C.good)
		self.genSaved = nil
	end

	local cats = {}
	for _, c in AnimGen.CATEGORIES do
		table.insert(cats, { value = c, label = c })
	end
	UI.segmented(body, cats, self.genCat, function(v)
		self.genCat = v
		self:refresh()
	end)
	local list = UI.vstack(body, 3)
	for _, item in AnimGen.LIST do
		if item.category == self.genCat then
			local markers = #item.markers > 0 and ("  ◆" .. #item.markers) or ""
			UI.item(list, item.label, { icon = item.looped and "↻" or "✦", selected = item.key == self.genKey, height = 24,
				note = string.format("%.2fs%s", item.length / self.genSpeed, markers),
				onClick = function()
					self.genKey = item.key
					self:genChanged()
				end })
		end
	end
	local item = self:genItem()
	if item then
		local times = {}
		for _, m in item.markers do
			table.insert(times, string.format("%s %.2fs", m.name, m.time / self.genSpeed))
		end
		UI.label(body, item.hint .. (#times > 0 and ("\n◆ " .. table.concat(times, "  ·  ")) or "")
			.. (item.looped and "\n↻ în buclă" or ""), { dim = true, size = 11, wrap = true })
	end

	local kind, fromRig = self:genRigType()
	if fromRig then
		UI.label(UI.row(body, "Rig"), kind .. "  (" .. self.rig.Name .. ")", { size = 12 })
	else
		UI.segmented(UI.row(body, "Rig"), { { value = "R15", label = "R15" }, { value = "R6", label = "R6" } }, self.genRig,
			function(v)
				self.genRig = v
				self:refresh()
			end)
	end
	slider(body, "Intensitate", self.genIntensity, { min = 0.3, max = 1.6, step = 0.05,
		tip = "cât de ample sunt mișcările (1 = normal)" }, function(v)
		self.genIntensity = v
		self:genChanged()
	end)
	slider(body, "Viteză", self.genSpeed, { min = 0.5, max = 2, step = 0.05,
		tip = "durata: 2 = de două ori mai rapidă" }, function(v)
		self.genSpeed = v
		self:genChanged()
	end)
	UI.toggle(UI.hstack(body), self.genMirror, function(v)
		self.genMirror = v
		self:genChanged()
	end, "⇄ Oglindită (stânga ↔ dreapta)")
	UI.button(UI.hstack(body, { height = 28 }), "▶  Previzualizează", function()
		self:genPreview()
	end, { style = "primary", bold = true, height = 28,
		tip = self.rig and "o redă pe rig fără să o salveze" or "creează un dummy și o redă pe el, fără să o salveze" })
	UI.button(UI.hstack(body, { height = 28 }), "💾  Salvează în RBX_ANIMSAVES", function()
		self:genSave()
	end, { height = 28, tip = "ServerStorage.RBX_ANIMSAVES." .. (self.rig and self.rig.Name or "LostCube")
		.. ", unde o găsește Animation Editor" })
	UI.note(body, "<b>Ca s-o folosești în joc:</b> Avatar → Animation Editor, alege rig-ul, ⋯ → Load → animația, apoi "
		.. "⋯ → Publish to Roblox (pe contul sau grupul care deține jocul). Pune ID-ul primit în Animation.AnimationId.")
end

function Panel:render(parent)
	if self.rig and not self.rig.Parent then
		self:stop()
		self.rig = nil
	end
	if self.genTemp and self.clip == self.genTemp and self.genTempRig ~= self.rig then
		-- an unsaved preview was made for the previous rig (maybe another rig type)
		self:stop()
		self.clip, self.genTemp = nil, nil
	end
	if self.error then
		UI.note(parent, "⚠ " .. self.error, C.warn)
		self.error = nil
	end

	-- rig
	local body = UI.section(parent, "Rig de previzualizare", { key = "anim.rig" })
	UI.label(body, self.rig and (self.rig.Name .. "  (" .. rigType(self.rig) .. ")") or "Niciun rig ales", { medium = true })
	UI.button(UI.hstack(body), "Folosește personajul selectat", function()
		local sel = Selection:Get()[1]
		local model = sel and (sel:IsA("Model") and sel or sel:FindFirstAncestorWhichIsA("Model"))
		if model and (model:FindFirstChildOfClass("Humanoid") or model:FindFirstChildOfClass("AnimationController")) then
			self:stop()
			self.rig = model
		else
			self.error = "selectează un personaj (Model cu Humanoid)"
		end
		self:refresh()
	end)
	local bar = UI.hstack(body)
	UI.button(bar, "+ Dummy R6", function()
		self:makeDummy("R6")
	end)
	UI.button(bar, "+ Dummy R15", function()
		self:makeDummy("R15")
	end)

	self:renderGenerator(parent)

	-- clips
	local clips = self.clips
	if not clips then
		self:scanClips()
		clips = {}
	end
	body = UI.section(parent, "Animații  (" .. (self.scanning and "…" or #clips) .. ")", { key = "anim.clips", right = function(r)
		UI.button(r, "🔁", function()
			self:findClips()
			self:refresh()
		end, { width = 34, height = 22, style = "ghost" })
	end, rightWidth = 38 })
	local list = UI.scrollList(body, self.clip and 200 or 420)
	local lastGroup
	for _, clip in clips do
		if clip.Parent then
			-- group and length were read when the list was made (🔁 reads them again); the chosen clip is always fresh
			local info = self.clipInfo and self.clipInfo[clip]
			local group = info and info.group or clip.Parent:GetFullName()
			if group ~= lastGroup then
				UI.label(list, group, { dim = true, size = 11, height = 18 })
				lastGroup = group
			end
			local length = (info and clip ~= self.clip) and info.length or self:clipLength(clip)
			UI.item(list, clip.Name, { icon = "►", selected = clip == self.clip, note = string.format("%.2fs", length),
				onClick = function()
					self:stop()
					self.clip = clip
					self.picked = {}
					self:refresh()
				end })
		end
	end
	if self.scanning then
		UI.note(body, "Caut animațiile din joc…")
	elseif #clips == 0 then
		UI.note(body, "Nicio animație (KeyframeSequence) în joc.")
	end
	if not self.clip then
		return
	end
	local clip = self.clip

	-- playback
	body = UI.section(parent, "Redare: " .. clip.Name, { key = "anim.play" })
	if not self.rig then
		UI.note(body, "Alege un rig (selecția sau un dummy) ca să vezi animația.")
	end
	local controls = UI.hstack(body, { height = 28 })
	UI.button(controls, self.playing and "⏸ Pauză" or "▶  Redă", function()
		if self.playing then
			self:pause()
		else
			self:play()
		end
	end, { style = "primary", bold = true, height = 28 })
	UI.button(controls, "◀", function()
		self:step(-1)
	end, { width = 30, height = 28 })
	UI.button(controls, "▶", function()
		self:step(1)
	end, { width = 30, height = 28 })
	UI.button(controls, "⏹", function()
		self:stop()
		self.playing = false
		self:refresh()
	end, { width = 30, height = 28 })
	self.timeLabel = UI.label(body, self.track and string.format("%.2f / %.2f s", self.track.TimePosition, self.track.Length)
		or "-", { dim = true, size = 12 })
	UI.segmented(UI.row(body, "Viteză"), {
		{ value = 0.25, label = "×0.25" }, { value = 0.5, label = "×0.5" }, { value = 1, label = "×1" }, { value = 2, label = "×2" },
	}, self.speed, function(v)
		self.speed = v
		if self.track and self.playing then
			self.track:AdjustSpeed(v)
		end
		self:refresh()
	end)
	UI.toggle(UI.hstack(body), self.loop, function(v)
		self.loop = v
		if self.track then
			self.track.Looped = v
		end
		self:refresh()
	end, "Repetă")
	if clip == self.genTemp then
		UI.note(body, "Previzualizare nesalvată. Salveaz-o (secțiunea „Generează animații”) ca să-i poți schimba "
			.. "easing-ul și efectele pe markere.")
		return
	end

	-- keyframes + easing
	local kfs = self:keyframes()
	body = UI.section(parent, "Cadre și easing (ca în Moon)", { key = "anim.ease" })
	local count = 0
	for _ in self.picked do
		count += 1
	end
	local sel = UI.hstack(body)
	UI.button(sel, "Toate", function()
		for _, kf in kfs do
			self.picked[kf] = true
		end
		self:refresh()
	end)
	UI.button(sel, "Niciunul", function()
		self.picked = {}
		self:refresh()
	end)
	for _, kf in kfs do
		local pose = firstPose(kf)
		local easing = pose and (pose.EasingStyle.Name .. " " .. pose.EasingDirection.Name) or "-"
		local markers = #kf:GetMarkers() > 0 and ("  ◆ " .. kf:GetMarkers()[1].Name) or ""
		UI.item(body, string.format("%.2fs  %s%s", kf.Time, kf.Name, markers), {
			icon = self.picked[kf] and "■" or "□", selected = self.picked[kf] == true, note = easing, height = 24,
			onClick = function()
				self.picked[kf] = not self.picked[kf] or nil
				self:refresh()
			end })
	end
	local grid = UI.hstack(body)
	for i, style in STYLES do
		if i == 4 then
			grid = UI.hstack(body)
		end
		UI.button(grid, style, function()
			self.style = style
			self:refresh()
		end, { selected = self.style == style, textSize = 12 })
	end
	UI.segmented(UI.row(body, "Direcție"), DIRECTIONS, self.direction, function(v)
		self.direction = v
		self:refresh()
	end)
	UI.button(UI.hstack(body, { height = 28 }), string.format("Aplică pe %d cadre", count), function()
		self:applyEasing()
	end, { style = "primary", bold = true, height = 28 })
	UI.label(body, "Easing-ul unui cadru = mișcarea de la el spre următorul.", { dim = true, size = 11, wrap = true })

	-- effects on markers
	body = UI.section(parent, "Efecte pe markere", { key = "anim.fx" })
	local effectItems = { { value = "", label = "(niciun efect)" } }
	for _, fx in self.Editor.effects() do
		table.insert(effectItems, { value = fx.Name, label = fx.Name })
	end
	local markers = self:markers(kfs)
	if #markers == 0 then
		UI.label(body, "Animația nu are markere.", { dim = true, size = 12 })
	end
	for _, m in markers do
		UI.dropdown(UI.row(body, string.format("◆ %s (%.2fs)", m.name, m.time), { labelWidth = 130 }), effectItems,
			clip:GetAttribute(fxAttr(m.name)) or "", function(v)
				local done, err = record("efect " .. (v ~= "" and v or "-") .. " pe markerul " .. m.name, function()
					clip:SetAttribute(fxAttr(m.name), v ~= "" and v or nil)
				end)
				self.error = not done and tostring(err) or nil
				self:stop()
				self:refresh()
			end, { menuWidth = 180 })
	end
	local add = UI.hstack(body)
	local box = UI.textbox(add, "", nil, { placeholder = "nume marker (ex. Hit)" })
	box.Text = self.markerDraft or "" -- what was typed survives a redraw
	box:GetPropertyChangedSignal("Text"):Connect(function()
		self.markerDraft = box.Text
	end)
	UI.button(add, "+ Marker aici", function()
		if box.Text ~= "" then
			self.markerDraft = nil
			self:addMarker(box.Text)
		end
	end, { width = 110 })
	UI.label(body, "În joc: VFX.bindMarkers(track, personaj, { Hit = \"NumeEfect\" })", { dim = true, size = 11, wrap = true })
end

return Panel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">ClaudePanel</string><ProtectedString name="Source"><![CDATA[-- LostCube > Claude tab: chat with Claude about this game (Anthropic API, your own key), the key / model settings,
-- the modules Claude needs in the game, and what was done with LostCube.
-- Agent mode ("Mod agent"): Claude also gets tools (Tools.luau) and acts in Studio; every change waits for the
-- developer's click on its card in the chat (Permite / Refuză / Permite mereu), and "⏹ Oprește" ends the turn.
local UI = require(script.Parent.UI)
local Installer = require(script.Parent.Installer)
local AI = require(script.Parent.AI)
local Markdown = require(script.Parent.Markdown)
local C = UI.C

-- the agent tools (optional: without them the tab is the plain chat)
local Tools = (function()
	local ok, module = pcall(function()
		return require(script.Parent:FindFirstChild("Tools") :: any)
	end)
	return ok and type(module) == "table" and module or nil
end)()

local Panel = {}
Panel.__index = Panel

local CONTEXT_CHARS = 60000 -- game analysis sent with every question (cached by the API after the first one)
local CHAT_HEIGHT = 440

local QUICK = {
	{ label = "Ce efecte VFX i se potrivesc jocului?", prompt = "Ce efecte VFX i se potrivesc jocului? Ține cont de genul "
		.. "jocului, de paleta de culori a hărții și de lumini. Propune 3–5 efecte concrete (nume, când se declanșează, "
		.. "unde se prind, culori hex, ce preseturi LostCube combin) și dă-mi codul Luau cu Editor-ul LostCube pentru cel "
		.. "mai important." },
	{ label = "Ce animații lipsesc?", prompt = "Ce animații lipsesc din joc? Uită-te la personaje, NPC-uri, arme și "
		.. "animațiile existente și spune-mi ce să adaug, în ordinea priorității, cu timing și easing pentru fiecare "
		.. "(îl reglez în tab-ul 🎬 Anim din LostCube) și ce efecte să pun pe markerele lor." },
	{ label = "Găsește probleme de securitate", prompt = "Verifică securitatea jocului: posibile backdoor-uri (require "
		.. "cu ID de asset, getfenv / loadstring, cod ofuscat, scripturi din modele gratuite sau din locuri neobișnuite) și "
		.. "RemoteEvent-uri / RemoteFunction-uri care au încredere în client. Pentru fiecare: calea exactă, de ce e "
		.. "riscant și cum repar, cu cod pentru verificările pe server." },
	{ label = "Plan de upgrade în 10 pași", prompt = "Fă-mi un plan de upgrade în 10 pași pentru joc, ordonat după "
		.. "impact și efort. Pentru fiecare pas: ce schimb, unde (căi exacte), cu ce unealtă (inclusiv LostCube) și ce "
		.. "rezultat se vede în joc." },
}

-- agent mode: Claude reads the game by itself and asks before every change
local QUICK_AGENT = {
	{ label = "Creează un efect de lovitură potrivit jocului", prompt = "Creează un efect de lovitură potrivit jocului: "
		.. "uită-te la genul jocului, la paleta hărții și la efectele care există deja, alege șablonul și culoarea "
		.. "potrivite, creează efectul și arată-mi-l cu o previzualizare. La final spune-mi cum îl pornesc din cod "
		.. "când lovește personajul." },
	{ label = "Generează animațiile de luptă care lipsesc", prompt = "Verifică ce animații de luptă are jocul "
		.. "(scripturile de luptă, animațiile existente și cele din RBX_ANIMSAVES) și generează-le pe cele care lipsesc, "
		.. "pentru tipul de rig al jocului. La final spune-mi ce markere au și cum le leg de efecte." },
	{ label = "Verifică scriptele suspecte", prompt = "Verifică scriptele suspecte din joc: pornește de la problemele de "
		.. "securitate din analiză, caută require cu ID de asset, getfenv / setfenv, loadstring, cod ofuscat și "
		.. "scripturi din modele gratuite, citește-le și spune-mi pentru fiecare dacă e periculos și ce face. Nu "
		.. "modifica și nu șterge nimic fără să mă întrebi." },
	{ label = "Ce am selectat și ce pot îmbunătăți?", prompt = "Uită-te la ce am selectat în Explorer (citește și "
		.. "scripturile, dacă e cazul) și spune-mi ce pot îmbunătăți. Propune modificările, dar fă-le doar pe cele pe "
		.. "care le aprob." },
}

-- tool card status -> text, color
local STATUS = {
	pending = { "așteaptă aprobarea", C.warn },
	running = { "rulează…", C.accentHover },
	done = { "gata", C.good },
	error = { "eroare", C.danger },
	refused = { "refuzat", C.dim },
}
-- the same, in the text sent back to Claude in later turns
local STATUS_LOG = { done = "gata", error = "eroare", refused = "refuzat", pending = "neterminat", running = "neterminat" }

local CODE_BG = Color3.fromRGB(16, 16, 20)

local function trim(s: string): string
	return (string.gsub(s, "^%s+", ""):gsub("%s+$", ""))
end

-- the first lines of a tool result, for its card
local function preview(text: string, maxLines: number, maxChars: number): string
	local lines = {}
	for line in string.gmatch(text .. "\n", "(.-)\n") do
		if #lines >= maxLines then
			table.insert(lines, "…")
			break
		end
		table.insert(lines, line)
	end
	local out = table.concat(lines, "\n")
	if #out > maxChars then
		out = string.gsub(string.sub(out, 1, maxChars), "[\192-\255][\128-\191]*$", "") .. "…"
	end
	return out
end

-- a tool of an agent turn that actually ran (its effects may be in the place)
local function ranTools(m): boolean
	for _, step in m.steps or {} do
		if step.kind == "tool" and step.status == "done" then
			return true
		end
	end
	return false
end

-- what a finished agent turn leaves in the conversation for the next turns: the final text plus a short log of the
-- tools (old thinking / tool blocks are never replayed)
local function agentHistoryText(m): string
	if m.running then
		return ""
	end
	local parts = {}
	if m.error then
		if not ranTools(m) then
			return ""
		end
		table.insert(parts, "(Tura s-a întrerupt cu o eroare: " .. (string.match(m.error, "^[^\n]*") or "") .. ")")
	elseif type(m.content) == "string" and trim(m.content) ~= "" then
		table.insert(parts, trim(m.content))
	end
	local log = {}
	for _, step in m.steps or {} do
		if step.kind == "tool" and Tools then
			local summary = Tools.summary(step.name, step.input)
			table.insert(log, string.format("%s%s → %s", step.name, summary ~= "" and (" (" .. summary .. ")") or "",
				STATUS_LOG[step.status] or tostring(step.status)))
		end
	end
	if #log > 24 then
		log = { "…", table.unpack(log, #log - 23) }
	end
	if #log > 0 then
		table.insert(parts, "[Unelte folosite în tura asta: " .. table.concat(log, "; ") .. "]")
	end
	return table.concat(parts, "\n\n")
end

local function now(): number
	local ok, t = pcall(function()
		return DateTime.now().UnixTimestampMillis / 1000
	end)
	return ok and t or os.time()
end

-- the stored game analysis (Analyzer is optional: older builds / not scanned yet -> nil)
local function analyzer()
	local ok, module = pcall(function()
		return require(script.Parent:FindFirstChild("Analyzer"))
	end)
	return ok and type(module) == "table" and module or nil
end

local function storedReport()
	local Analyzer = analyzer()
	if not Analyzer or type(Analyzer.load) ~= "function" then
		return nil
	end
	local ok, report = pcall(Analyzer.load)
	return ok and report or nil
end

local function gameContext(): string?
	local Analyzer = analyzer()
	local report = storedReport()
	if not report or type(Analyzer.context) ~= "function" then
		return nil
	end
	local ok, text = pcall(Analyzer.context, report, CONTEXT_CHARS)
	return (ok and type(text) == "string" and text ~= "") and text or nil
end

-- what changes during a chat (sent after the cached part): the LostCube effects and the Studio selection
local function liveState(Editor): string
	local lines = {}
	local ok, effects = pcall(Editor.describe)
	if ok and type(effects) == "table" and #effects > 0 then
		table.insert(lines, "Efecte LostCube în ReplicatedStorage.LostCube.Effects:")
		for i, fx in effects do
			if i > 40 then
				table.insert(lines, string.format("- … încă %d", #effects - 40))
				break
			end
			local els = {}
			for _, e in fx.elements or {} do
				table.insert(els, string.format("%s [%s%s]", e.name, tostring(e.kind), e.preset and (", " .. e.preset) or ""))
			end
			table.insert(lines, string.format("- %s (%s s, %s): %s", fx.name, tostring(fx.duration or "?"),
				tostring(fx.attach or "?"), #els > 0 and table.concat(els, "; ") or "fără elemente"))
		end
	else
		table.insert(lines, "Nu există încă efecte LostCube în joc.")
	end
	local okSel, selection = pcall(function()
		return game:GetService("Selection"):Get()
	end)
	if okSel and type(selection) == "table" and #selection > 0 then
		local names = {}
		for i, inst in selection do
			if i > 10 then
				break
			end
			local okName, full = pcall(function()
				return inst:GetFullName() .. " (" .. inst.ClassName .. ")"
			end)
			table.insert(names, okName and full or "?")
		end
		table.insert(lines, "Selecția din Explorer: " .. table.concat(names, ", "))
	end
	local text = table.concat(lines, "\n")
	-- the cut drops a partial multi-byte character at the end (invalid UTF-8 would break the JSON of the request)
	return #text > 6000 and (string.gsub(string.sub(text, 1, 6000), "[\192-\255][\128-\191]*$", "") .. "\n…") or text
end

-- a growing multi-line text box (the UI kit only has single-line ones)
local function multiline(parent: Instance, text: string, placeholder: string)
	return UI.make("TextBox", { Parent = parent, Text = text or "", PlaceholderText = placeholder, Font = UI.FONT,
		TextSize = 13, TextColor3 = C.text, PlaceholderColor3 = C.dim, BackgroundColor3 = C.input, ClearTextOnFocus = false,
		MultiLine = true, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top, Size = UDim2.new(1, 0, 0, 60), AutomaticSize = Enum.AutomaticSize.Y },
		{ UI.corner(4), UI.stroke(C.border), UI.pad(6, 8, 6, 8) })
end

function Panel.new(ctx)
	return setmetatable({ ctx = ctx, Editor = ctx.Editor, plugin = ctx.plugin, messages = {}, draft = "", busy = false,
		gen = 0, allowAlways = {} }, Panel)
end

-- agent mode and "code without confirmation" (plugin settings; kept on the panel when settings are unavailable)
function Panel:isAgent(): boolean
	if not Tools then
		return false
	end
	if self.agentLocal ~= nil then
		return self.agentLocal
	end
	return AI.getAgentMode(self.plugin)
end

function Panel:setAgent(on: boolean)
	if not AI.setAgentMode(self.plugin, on) then
		self.agentLocal = on
	end
end

function Panel:allowCode(): boolean
	if self.allowCodeLocal ~= nil then
		return self.allowCodeLocal
	end
	return AI.getAllowCode(self.plugin)
end

function Panel:setAllowCode(on: boolean)
	if not AI.setAllowCode(self.plugin, on) then
		self.allowCodeLocal = on
	end
	if not on then
		self.allowAlways.run_luau = nil
	end
end

function Panel:refresh()
	self.ctx.app:refresh()
end

function Panel:render(parent)
	local key = AI.getKey(self.plugin)
	self:renderKey(parent, key)
	self:renderChat(parent, key ~= nil)
	self:renderModules(parent)
	self:renderLog(parent)
	self:renderAbout(parent)
end

-- ---------------------------------------------------------------------------------------------
-- API key, model, effort
-- ---------------------------------------------------------------------------------------------
function Panel:saveKey(text)
	local key = string.gsub(text or "", "%s", "")
	if key == "" or key == AI.getKey(self.plugin) then
		return
	end
	if not AI.setKey(self.plugin, key) then
		self.keyStatus = { "Nu am putut salva cheia (setările merg doar când LostCube rulează ca plugin).", C.danger }
	elseif AI.looksLikeKey(key) then
		self.keyStatus = { "Cheie salvată doar pe calculatorul tău.", C.good }
	else
		self.keyStatus = { "Cheie salvată, dar nu arată ca o cheie Anthropic (cheile încep cu „sk-ant-”).", C.warn }
	end
	self.editingKey = false
	self.testStatus = nil
	self:refresh()
end

function Panel:test()
	if self.testing then
		return
	end
	self.testing = true
	self.testStatus = { "Se testează… (prima dată Studio îți poate cere permisiunea pentru api.anthropic.com)", C.dim }
	self:refresh()
	task.spawn(function()
		local ok, message = AI.test(self.plugin)
		self.testing = false
		self.testStatus = { message, ok and C.good or C.danger }
		if not self.destroyed then
			self:refresh()
		end
	end)
end

function Panel:renderKey(parent, key: string?)
	local body = UI.section(parent, "Cheie API Anthropic", { key = "claude.key", collapsed = key ~= nil })
	if key and not self.editingKey then
		local area = UI.row(body, "Cheie salvată")
		UI.label(area, AI.mask(key), { size = 12, color = C.good })
		UI.button(area, "Schimbă", function()
			self.editingKey = true
			self:refresh()
		end, { width = 66 })
		UI.button(area, "Șterge", function()
			AI.setKey(self.plugin, nil)
			self.keyStatus = { "Cheia a fost ștearsă de pe acest calculator.", C.dim }
			self.testStatus = nil
			self:refresh()
		end, { width = 58, style = "danger" })
	else
		-- the key is never shown: the box text is hidden and a mask is drawn over it
		local area = UI.hstack(body, { height = UI.H })
		local box = UI.textbox(area, "", function(text)
			self:saveKey(text)
		end)
		box.TextTransparency = 1
		local mask = UI.make("TextLabel", { Parent = box, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1),
			Font = UI.FONT, TextSize = 13, TextColor3 = C.dim, TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd, Text = "lipește cheia aici (sk-ant-…)" })
		box:GetPropertyChangedSignal("Text"):Connect(function()
			local n = #box.Text
			mask.Text = n == 0 and "lipește cheia aici (sk-ant-…)" or (string.rep("•", math.min(n, 18)) .. "  " .. n .. " caractere")
			mask.TextColor3 = n == 0 and C.dim or C.text
		end)
		UI.button(area, "Salvează", function()
			self:saveKey(box.Text)
		end, { width = 72, style = "primary" })
		if key then
			UI.button(area, "×", function()
				self.editingKey = false
				self:refresh()
			end, { width = 26, style = "ghost", tip = "Păstrează cheia salvată" })
		end
	end
	if self.keyStatus then
		UI.label(body, self.keyStatus[1], { size = 12, wrap = true, color = self.keyStatus[2] })
	end

	local models = {}
	for _, m in AI.MODELS do
		table.insert(models, { value = m.id, label = m.label })
	end
	UI.dropdown(UI.row(body, "Model"), models, AI.getModel(self.plugin), function(id)
		AI.setModel(self.plugin, id)
		self:refresh()
	end, { menuWidth = 250 })
	UI.segmented(UI.row(body, "Efort"), AI.EFFORTS, AI.getEffort(self.plugin), function(value)
		AI.setEffort(self.plugin, value)
		self:refresh()
	end)
	UI.button(UI.hstack(body, { height = 26 }), self.testing and "Se testează…" or "Testează conexiunea", function()
		self:test()
	end, { height = 26, tip = "O cerere foarte mică: verifică cheia, modelul și permisiunea HTTP" })
	if self.testStatus then
		UI.label(body, self.testStatus[1], { size = 12, wrap = true, color = self.testStatus[2] })
	end
	UI.note(body, "Cheia o iei de pe <b>console.anthropic.com</b> → <b>API Keys</b>. Cererile se plătesc din contul tău "
		.. "Anthropic (Opus e cel mai scump, Haiku cel mai ieftin; efortul „Atent” folosește mai mulți tokeni). "
		.. "Cheia rămâne doar în setările pluginului pe acest calculator: nu se salvează în joc și nu ajunge la "
		.. "colaboratori.")
	UI.note(body, "La prima cerere Studio întreabă dacă LostCube are voie să acceseze <b>api.anthropic.com</b>: alege "
		.. "<b>Allow</b>. Dacă ai refuzat: Plugins → Manage Plugins → LostCube → permisiuni.")
end

-- ---------------------------------------------------------------------------------------------
-- chat
-- ---------------------------------------------------------------------------------------------
-- previous turns that got an answer (failed questions and errors are not sent back; an agent turn leaves its final
-- text and a log of its tools)
function Panel:history()
	local out = {}
	for _, m in self.messages do
		if m.agent then
			local text = agentHistoryText(m)
			if text ~= "" then
				table.insert(out, { role = "assistant", content = text })
			end
		elseif not m.error and not m.failed then
			table.insert(out, { role = m.role, content = m.content })
		end
	end
	return out
end

-- the line under the conversation while Claude works: "◆ Claude lucrează…  ·  pas 2/12  ·  14 s  ·  tokens"
function Panel:waitLine(): string
	local seconds = math.floor(now() - (self.startedAt or now()))
	local run = self.run
	if not run then
		return string.format("◆  %s  %d s", self.waitText or "Claude scrie…", seconds)
	end
	local parts = { "◆  " .. (self.waitText or "Claude lucrează…") }
	if (run.iteration or 0) > 0 then
		table.insert(parts, string.format("pas %d/%d", run.iteration, AI.MAX_ITERATIONS))
	end
	table.insert(parts, string.format("%d s", seconds))
	local info = run.info
	if info and (info.inputTokens or 0) > 0 then
		table.insert(parts, string.format("%s tokeni intrare · %s ieșire", AI.thousands(info.inputTokens),
			AI.thousands(info.outputTokens or 0)))
	end
	return table.concat(parts, "  ·  ")
end

-- keeps the wait line ticking while a turn runs
function Panel:startTicker(gen: number)
	task.spawn(function()
		while self.busy and self.gen == gen and not self.destroyed do
			local label = self.waitLabel
			if label and label.Parent then
				label.Text = self:waitLine()
			end
			task.wait(0.5)
		end
	end)
end

function Panel:send(text: string?, fromInput: boolean?)
	text = trim(text or "")
	if text == "" or self.busy then
		return
	end
	if not AI.getKey(self.plugin) then
		self.chatNote = { "Pune întâi cheia API în secțiunea „Cheie API Anthropic”.", C.warn }
		self:redrawChat()
		return
	end
	self.chatNote = nil
	local history = self:history()
	if fromInput then
		self.draft = ""
		if self.input and self.input.Parent then
			self.input.Text = ""
		end
	end
	if self:isAgent() then
		self:sendAgent(text, history)
		return
	end
	local question = { role = "user", content = text }
	table.insert(self.messages, question)
	self.busy = true
	self.gen += 1
	local gen = self.gen
	self.startedAt = now()
	self.waitText = "Claude scrie…"
	self:redrawChat()
	self:startTicker(gen)
	task.spawn(function()
		local ok, answer, info = AI.ask(self.plugin, text, history, gameContext(), {
			live = liveState(self.Editor),
			onStatus = function(status)
				if self.gen == gen then
					self.waitText = status
				end
			end,
		})
		if self.gen ~= gen or self.destroyed then -- cleared while waiting
			return
		end
		self.busy = false
		if ok then
			table.insert(self.messages, { role = "assistant", content = answer, info = info })
			self.lastInfo = info
		else
			question.failed = true
			table.insert(self.messages, { role = "assistant", content = answer, error = true, question = text })
		end
		self:redrawChat()
	end)
end

-- ---------------------------------------------------------------------------------------------
-- agent mode
-- ---------------------------------------------------------------------------------------------
function Panel:sendAgent(text: string, history)
	local question = { role = "user", content = text }
	table.insert(self.messages, question)
	local turn = { role = "assistant", agent = true, steps = {}, running = true, question = text }
	table.insert(self.messages, turn)
	self.busy = true
	self.gen += 1
	local gen = self.gen
	local run = { gen = gen, turn = turn, cancelled = false, iteration = 0 }
	self.run = run
	self.startedAt = now()
	self.waitText = "Claude lucrează…"
	self:redrawChat()
	self:startTicker(gen)
	task.spawn(function()
		local ok, answer, info = AI.runAgent(self.plugin, {
			question = text,
			history = history,
			context = gameContext(),
			live = liveState(self.Editor),
			tools = Tools.definitions(),
			isCancelled = function()
				return run.cancelled or self.gen ~= gen or self.destroyed == true
			end,
			runTool = function(block)
				return self:runTool(run, block)
			end,
			onStep = function(event)
				if self.gen ~= gen then
					return
				end
				if event.type == "request" then
					run.iteration = event.iteration
					if not run.cancelled then
						self.waitText = "Claude lucrează…"
					end
				elseif event.type == "response" then
					run.info = event.info
				elseif event.type == "text" then
					table.insert(turn.steps, { kind = "text", text = event.text })
					self:redrawChat()
				end
			end,
			onStatus = function(status)
				if self.gen == gen then
					self.waitText = status
				end
			end,
		})
		if self.gen ~= gen or self.destroyed then -- cleared while it ran
			return
		end
		self.busy = false
		self.run = nil
		turn.running = false
		turn.info = info
		if ok then
			turn.content = answer
			self.lastInfo = info
		else
			turn.error = answer
			if not ranTools(turn) then
				question.failed = true -- nothing happened: the question leaves the conversation, like in the plain chat
			end
		end
		self:redrawChat()
	end)
end

-- "Permite mereu" is offered for every change except code, unless the developer allowed code without confirmation
function Panel:canAlwaysAllow(name: string): boolean
	return name ~= "run_luau" or self:allowCode()
end

function Panel:autoApproved(name: string): boolean
	return self.allowAlways[name] == true and self:canAlwaysAllow(name)
end

-- runs one tool call of the agent (yields): read-only tools at once, changes after the developer's click
function Panel:runTool(run, block): (string, boolean)
	local name = tostring(block.name)
	local input = type(block.input) == "table" and block.input or {}
	local step = { kind = "tool", id = block.id, name = name, input = input, status = "running" }
	table.insert(run.turn.steps, step)
	local function alive(): boolean
		return not run.cancelled and self.gen == run.gen and not self.destroyed
	end
	local def = Tools.get(name)
	if not def then
		step.status, step.result = "error", "Unealtă necunoscută."
		self:redrawChat()
		return "Unknown tool: " .. name .. ". Use only the tools you were given.", true
	end
	if def.write and not self:autoApproved(name) then
		-- the decision lives in the step, so a redraw of the panel keeps the card and its buttons
		step.status = "pending"
		self.waitText = "așteaptă aprobarea ta"
		self:redrawChat()
		local app = self.ctx.app
		if app and app.tab and app.tab ~= "Claude" then
			print("LostCube: Claude așteaptă aprobarea ta în tab-ul ◆ Claude (" .. def.label .. ").")
		end
		while step.decision == nil do
			if not alive() then
				step.decision = "cancel"
				break
			end
			task.wait(0.1)
		end
		if step.decision == "always" and self:canAlwaysAllow(name) then
			self.allowAlways[name] = true
		end
		if step.decision == "deny" or step.decision == "cancel" then
			step.status = "refused"
			step.result = step.decision == "cancel" and "Oprit înainte să ruleze." or "Refuzat de tine."
			if self.gen == run.gen then
				self.waitText = "Claude lucrează…"
				self:redrawChat()
			end
			if step.decision == "cancel" then
				return "Not run: the developer stopped the agent.", true
			end
			return "The developer refused this change, so nothing was changed. Do not try to make it another way; "
				.. "ask what they would like instead.", true
		end
	end
	if not alive() then
		step.status, step.result = "refused", "Oprit înainte să ruleze."
		return "Not run: the developer stopped the agent.", true
	end
	step.status = "running"
	self.waitText = "rulează: " .. def.label
	self:redrawChat()
	local ok, text = Tools.run(name, input, { Editor = self.Editor, plugin = self.plugin })
	step.status = ok and "done" or "error"
	step.result = text
	if self.gen == run.gen then
		if not run.cancelled then
			self.waitText = "Claude lucrează…"
		end
		self:redrawChat()
	end
	return text, not ok
end

-- a click on a card: "allow" | "deny" | "always"
function Panel:decide(step, decision: string)
	if step.status ~= "pending" or step.decision ~= nil then
		return
	end
	step.decision = decision
	step.status = decision == "deny" and "refused" or "running"
	self:redrawChat()
end

-- "⏹ Oprește": no new request and no new tool; pending cards are refused; the current request finishes first
function Panel:stop()
	local run = self.run
	if not run or run.cancelled then
		return
	end
	run.cancelled = true
	self.waitText = "se oprește după răspunsul curent…"
	self:redrawChat()
end

-- sends a failed question again (the failed pair leaves the conversation; an agent turn that already changed
-- something stays, and the question is asked again in a new turn)
function Panel:retry(index: number)
	local m = self.messages[index]
	if not m or not m.error or self.busy then
		return
	end
	if m.agent and ranTools(m) then
		self:send(m.question)
		return
	end
	table.remove(self.messages, index)
	local prev = self.messages[index - 1]
	if prev and prev.failed then
		table.remove(self.messages, index - 1)
	end
	self:send(m.question)
end

function Panel:clear()
	if self.run then
		self.run.cancelled = true -- pending approvals are refused, the loop stops
	end
	self.run = nil
	self.gen += 1 -- an answer still on its way is dropped
	self.busy = false
	self.messages = {}
	self.allowAlways = {} -- "Permite mereu" lasts one conversation
	self.lastInfo = nil
	self.chatNote = nil
	self:redrawChat()
end

-- read-only, selectable monospace box (the code Claude wants to run, shown whole before it is approved)
local function codeBox(parent: Instance, code: string)
	local frame = UI.make("Frame", { Parent = parent, BackgroundColor3 = CODE_BG, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y }, { UI.corner(4), UI.stroke(C.border), UI.pad(4, 6, 5, 6) })
	UI.make("TextBox", { Parent = frame, Text = (string.gsub(code, "\t", "    ")), Font = Enum.Font.Code, TextSize = 12,
		TextColor3 = Color3.fromRGB(214, 220, 236), BackgroundTransparency = 1, ClearTextOnFocus = false, TextEditable = false,
		MultiLine = true, TextWrapped = true, RichText = false, TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
	return frame
end

-- one tool call of an agent turn: name, what it does, status; buttons while it waits for approval
function Panel:toolCard(parent: Instance, step)
	local def = Tools and Tools.get(step.name)
	local status = STATUS[step.status] or STATUS.running
	local pending = step.status == "pending"
	local card = UI.make("Frame", { Parent = parent, BackgroundColor3 = C.input, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y }, { UI.corner(4), UI.stroke(pending and C.warn or C.border), UI.pad(5, 8, 6, 8),
		UI.vlist(3) })
	local head = UI.make("Frame", { Parent = card, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 16) })
	UI.make("TextLabel", { Parent = head, Text = ((def and def.write) and "✎  " or "⌕  ") .. (def and def.label or step.name),
		Font = UI.FONT_MED, TextSize = 12, TextColor3 = C.text, BackgroundTransparency = 1, Size = UDim2.new(1, -120, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd })
	UI.make("TextLabel", { Parent = head, Text = status[1], Font = UI.FONT_MED, TextSize = 11, TextColor3 = status[2],
		BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0, 116, 1, 0), TextXAlignment = Enum.TextXAlignment.Right })
	local summary = Tools and Tools.summary(step.name, step.input) or ""
	if summary ~= "" then
		UI.label(card, summary, { size = 12, dim = true, wrap = true })
	end
	if step.name == "run_luau" and type(step.input.code) == "string" then
		codeBox(card, step.input.code)
	end
	if pending then
		local bar = UI.hstack(card, { height = 24 })
		UI.button(bar, "✓ Permite", function()
			self:decide(step, "allow")
		end, { style = "primary", bold = true, height = 24 })
		UI.button(bar, "✗ Refuză", function()
			self:decide(step, "deny")
		end, { style = "danger", height = 24 })
		if self:canAlwaysAllow(step.name) then
			UI.button(card, "Permite mereu „" .. (def and def.label or step.name) .. "” în conversația asta", function()
				self:decide(step, "always")
			end, { height = 22, textSize = 11, style = "ghost", align = Enum.TextXAlignment.Left })
		end
	elseif type(step.result) == "string" and step.result ~= "" and step.status ~= "running" then
		UI.label(card, preview(step.result, 3, 280), { size = 11, wrap = true,
			color = step.status == "error" and C.danger or C.dim })
	end
	return card
end

-- an agent turn: what Claude said and did, in order, then its final answer
function Panel:agentView(list: Instance, m, index: number)
	local frame = UI.make("Frame", { Parent = list, BackgroundColor3 = C.item, BackgroundTransparency = 0.4,
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, { UI.corner(6), UI.pad(6, 8, 8, 8), UI.vlist(4) })
	UI.label(frame, "◆  Claude · agent", { size = 11, bold = true, color = C.accent, height = 14 })
	for _, step in m.steps do
		if step.kind == "text" then
			Markdown.render(frame, step.text)
		else
			self:toolCard(frame, step)
		end
	end
	if type(m.content) == "string" and m.content ~= "" then
		Markdown.render(frame, m.content)
	end
	if m.error then
		UI.label(frame, "⚠  " .. Markdown.escape(m.error), { wrap = true, rich = true, size = 12, color = C.danger })
		UI.button(UI.hstack(frame, { height = 24, fill = false }), "Reîncearcă", function()
			self:retry(index)
		end, { width = 96 })
	end
	if m.info then
		UI.label(frame, AI.describeInfo(m.info), { size = 10, dim = true, wrap = true })
	end
end

function Panel:messageView(list: Instance, m, index: number)
	if m.agent then
		self:agentView(list, m, index)
		return
	end
	if m.role == "user" then
		local frame = UI.make("Frame", { Parent = list, BackgroundColor3 = C.accentDark, BackgroundTransparency = 0.25,
			Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, { UI.corner(6), UI.pad(6, 8, 7, 8), UI.vlist(2) })
		UI.label(frame, "Tu", { size = 11, bold = true, color = C.accentHover, height = 14 })
		UI.label(frame, Markdown.escape(m.content), { wrap = true, rich = true, size = 13 })
		return
	end
	if m.error then
		local frame = UI.make("Frame", { Parent = list, BackgroundColor3 = Color3.fromRGB(58, 30, 36),
			Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, { UI.corner(6), UI.pad(6, 8, 7, 8), UI.vlist(4) })
		UI.label(frame, "⚠  Nu a mers", { size = 11, bold = true, color = C.danger, height = 14 })
		UI.label(frame, Markdown.escape(m.content), { wrap = true, rich = true, size = 12 })
		UI.button(UI.hstack(frame, { height = 24, fill = false }), "Reîncearcă", function()
			self:retry(index)
		end, { width = 96 })
		return
	end
	local frame = UI.make("Frame", { Parent = list, BackgroundColor3 = C.item, BackgroundTransparency = 0.4,
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, { UI.corner(6), UI.pad(6, 8, 8, 8), UI.vlist(4) })
	UI.label(frame, "◆  Claude", { size = 11, bold = true, color = C.accent, height = 14 })
	Markdown.render(frame, m.content)
	if m.info then -- token usage of each reply (the newest is the last reply's)
		UI.label(frame, AI.describeInfo(m.info), { size = 10, dim = true, wrap = true })
	end
end

-- rebuilds only the conversation (the input box keeps its focus and text); falls back to a full redraw (only while
-- the ◆ Claude tab is the one shown: the agent keeps working, and its state is drawn when the tab opens)
function Panel:redrawChat()
	local list = self.chatList
	if not (list and list.Parent) then
		local app = self.ctx.app
		if not (app and app.tab and app.tab ~= "Claude") then
			self:refresh()
		end
		return
	end
	for _, child in list:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	if #self.messages == 0 and not self.busy then
		UI.label(list, self:isAgent() and ("Mod agent: cere-i lui Claude ce vrei să facă. Citește singur jocul (scripturi, "
			.. "instanțe, efecte, selecția) și îți cere voie înainte de fiecare modificare; fiecare modificare aprobată e un "
			.. "Ctrl+Z.") or ("Întreabă orice despre joc sau alege o întrebare de mai sus. Claude vede analiza jocului "
			.. "(tab-ul 🧠 Joc), efectele LostCube și selecția din Explorer."), { dim = true, size = 12, wrap = true })
	end
	for i, m in self.messages do
		self:messageView(list, m, i)
	end
	self.waitLabel = nil
	if self.busy then
		self.waitLabel = UI.label(list, self:waitLine(), { size = 12, color = C.accentHover, wrap = true })
	end
	if self.chatNote then
		UI.label(list, self.chatNote[1], { size = 12, wrap = true, color = self.chatNote[2] })
	end
	if self.sendButton and self.sendButton.Parent then
		self.sendButton.Text = self.busy and (self.run and "Claude lucrează…" or "Claude scrie…") or "Trimite"
	end
	if self.stopButton and self.stopButton.Parent then
		self.stopButton.Visible = self.run ~= nil
		self.stopButton.Text = (self.run and self.run.cancelled) and "Se oprește…" or "⏹ Oprește"
	end
	-- show the newest message
	for _, delay in { 0.05, 0.25 } do
		task.delay(delay, function()
			if list.Parent then
				list.CanvasPosition = Vector2.new(0, math.max(0, list.AbsoluteCanvasSize.Y - list.AbsoluteSize.Y))
			end
		end)
	end
end

function Panel:renderChat(parent, hasKey: boolean)
	local body = UI.section(parent, "Chat cu Claude", { key = "claude.chat" })
	local report = storedReport()
	UI.label(body, report and "✓ Claude primește analiza jocului salvată (tab-ul 🧠 Joc)."
		or "Fără analiză salvată: scanează jocul în tab-ul 🧠 Joc ca să-l cunoască Claude.",
		{ size = 12, wrap = true, color = report and C.good or C.warn })
	if not hasKey then
		UI.note(body, "Pune cheia API în secțiunea de mai sus ca să poți vorbi cu Claude.", C.warn)
	end
	local agent = self:isAgent()
	if Tools then
		UI.toggle(UI.hstack(body, { height = UI.H }), agent, function(on)
			self:setAgent(on)
			self:refresh()
		end, "Mod agent: Claude poate acționa în Studio", { tip = "Claude primește unelte: citește jocul singur și, cu "
			.. "acordul tău pentru fiecare modificare, creează efecte, generează animații, selectează și rulează cod" })
	end
	if agent then
		local allowCode = self:allowCode()
		UI.toggle(UI.hstack(body, { height = UI.H }), allowCode, function(on)
			self:setAllowCode(on)
			self:refresh()
		end, "Permite cod fără confirmare", { tip = "Pornit: la codul Luau apare și „Permite mereu” (doar în conversația "
			.. "curentă). Oprit: vezi și aprobi fiecare bucată de cod." })
		UI.note(body, "Claude citește singur jocul și îți cere voie înainte de fiecare modificare: <b>✓ Permite</b>, "
			.. "<b>✗ Refuză</b> sau <b>Permite mereu</b> (până golești conversația). Fiecare modificare aprobată e un "
			.. "<b>Ctrl+Z</b>; codul Luau îl vezi întreg înainte să ruleze." .. (allowCode
				and " <b>Atenție:</b> poți permite și codul fără confirmare." or ""), allowCode and C.warn or nil)
	end
	for _, q in (agent and QUICK_AGENT or QUICK) do
		UI.button(body, "›  " .. q.label, function()
			self:send(q.prompt)
		end, { height = 24, textSize = 12, align = Enum.TextXAlignment.Left })
	end

	self.chatList = UI.scrollList(body, CHAT_HEIGHT)

	local box = multiline(body, self.draft, "Întreabă ceva despre joc…  (Enter = rând nou; trimiți cu butonul)")
	box:GetPropertyChangedSignal("Text"):Connect(function()
		self.draft = box.Text
	end)
	self.input = box
	local bar = UI.hstack(body, { height = 28 })
	self.sendButton = UI.button(bar, "Trimite", function()
		self:send(box.Text, true)
	end, { style = "primary", bold = true, height = 28 })
	self.stopButton = UI.button(bar, "⏹ Oprește", function()
		self:stop()
	end, { height = 28, width = 96, style = "danger", tip = "Claude nu mai face niciun pas (cererea în curs se termină; "
		.. "ce așteaptă aprobarea e refuzat)" })
	UI.button(bar, "Golește", function()
		self:clear()
	end, { height = 28, width = 84, tip = "Începe o conversație nouă" })
	self:redrawChat()
end

-- ---------------------------------------------------------------------------------------------
-- modules in the game, activity log, Claude Code
-- ---------------------------------------------------------------------------------------------
function Panel:renderModules(parent)
	local status = Installer.status()
	local body = UI.section(parent, "Module în joc", { key = "claude.modules" })
	UI.label(body, string.format("LostCube %s", status.version), { medium = true })
	UI.label(body, "VFX (player în joc): " .. (status.vfx or "lipsește"), { dim = true, size = 12,
		color = status.vfx == status.version and C.good or C.warn })
	UI.label(body, "Editor (pentru Claude): " .. (status.editor or "lipsește"), { dim = true, size = 12,
		color = status.editor == status.version and C.good or C.warn })
	UI.button(UI.hstack(body, { height = 28 }), status.ok and "Reinstalează modulele" or "Instalează / actualizează modulele",
		function()
			local ok, err = pcall(Installer.install)
			if not ok then
				warn("LostCube:", err)
			end
			self.ctx.app:refresh()
		end, { style = status.ok and "normal" or "primary", bold = true, height = 28 })
end

function Panel:renderLog(parent)
	local history = self.Editor.history()
	local body = UI.section(parent, "Ce s-a făcut  (" .. #history .. ")", { key = "claude.log" })
	if #history == 0 then
		UI.label(body, "Nimic încă în sesiunea asta.", { dim = true, size = 12 })
	end
	for i = #history, math.max(1, #history - 24), -1 do
		local h = history[i]
		UI.label(body, h.t .. "   " .. h.a, { size = 12, color = i == #history and C.text or C.dim })
	end
end

local EXAMPLES = {
	"„fă-mi un efect de foc pe mână când lovește”",
	"„pune easing Bounce pe aterizare”",
	"„fă scânteile mai mari și mai albastre”",
	"„un cerc magic sub personaj la teleport”",
}

function Panel:renderAbout(parent)
	local body = UI.section(parent, "Claude Code în Studio", { key = "claude.about", collapsed = true })
	UI.label(body, "Dacă folosești Claude Code conectat la Studio, Claude folosește aceleași funcții ca panourile "
		.. "LostCube (modulul ReplicatedStorage.LostCube.Editor). Spune-i în chat ce vrei, de exemplu:", { wrap = true, size = 12 })
	for _, e in EXAMPLES do
		UI.label(body, "•  " .. e, { dim = true, size = 12, wrap = true })
	end
	UI.note(body, "Fiecare pas e un singur <b>Ctrl+Z</b>. Efectele apar în tab-ul VFX imediat ce Claude le face.")
end

function Panel:destroy()
	self.destroyed = true
	if self.run then
		self.run.cancelled = true
	end
	self.gen += 1
end

return Panel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX7"><Properties><string name="Name">Installer</string><ProtectedString name="Source"><![CDATA[-- Puts LostCube's two modules into the game (ReplicatedStorage.LostCube):
--   VFX    - plays the effects in the game (client)
--   Editor - the same editing functions the plugin uses; Claude calls it through Studio
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ChangeHistoryService = game:GetService("ChangeHistoryService")

local Installer = {}

local version -- the plugin's own version (Editor.VERSION): read once, status() runs on every redraw of two tabs

local function source()
	local editor = script.Parent.Editor
	version = require(editor).VERSION
	return editor, editor.VFX, version
end

local function v(inst)
	return inst and (inst:GetAttribute("LC_Version") or "?") or nil
end

function Installer.status()
	if not version then
		source()
	end
	local root = ReplicatedStorage:FindFirstChild("LostCube")
	local editor = root and root:FindFirstChild("Editor")
	local vfx = root and root:FindFirstChild("VFX")
	return {
		version = version,
		editor = v(editor),
		vfx = v(vfx),
		ok = v(editor) == version and v(vfx) == version,
	}
end

function Installer.install()
	local editorSource, vfxSource, installing = source()
	local ok, id = pcall(ChangeHistoryService.TryBeginRecording, ChangeHistoryService, "LostCube: instalare module")
	local done, err = pcall(function() -- (everything that edits the place is inside: an error cannot leave the recording open)
		local root = ReplicatedStorage:FindFirstChild("LostCube")
		if not root then
			root = Instance.new("Folder")
			root.Name = "LostCube"
			root.Parent = ReplicatedStorage
		end
		if not root:FindFirstChild("Effects") then
			local effects = Instance.new("Folder")
			effects.Name = "Effects"
			effects.Parent = root
		end
		for _, pair in { { "VFX", vfxSource }, { "Editor", editorSource } } do
			local old = root:FindFirstChild(pair[1])
			if old then
				old:Destroy()
			end
			local copy = pair[2]:Clone()
			for _, child in copy:GetChildren() do
				child:Destroy() -- the game's Editor uses the VFX next to it
			end
			copy.Name = pair[1]
			copy:SetAttribute("LC_Version", installing)
			copy.Parent = root
		end
	end)
	if ok and id then
		-- a failed install is rolled back instead of leaving a half-written LostCube folder (and an open recording)
		pcall(ChangeHistoryService.FinishRecording, ChangeHistoryService, id,
			done and Enum.FinishRecordingOperation.Commit or Enum.FinishRecordingOperation.Cancel)
	end
	if not done then
		error(err, 0)
	end
	return Installer.status()
end

return Installer
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">Editor</string><ProtectedString name="Source"><![CDATA[--[[ LostCube Editor - creates and edits Roblox effects (LostCube VFX format) in Studio.
Used by the LostCube plugin's panels and by Claude (through Studio):

	local Editor = require(game.ReplicatedStorage.LostCube.Editor)
	local fx = Editor.newEffect("Boom", { duration = 0.6, attach = "GROUND" })
	local s = Editor.addElement(fx, "SPARKLES", { position = Vector3.new(0, 3, 0), bursts = { { 0.1, 40 } } })
	Editor.setProps(s, { color = { Color3.new(1, 1, 1), Color3.fromRGB(158, 92, 255) }, speed = { 18, 30 } })
	Editor.preview(fx)  -- plays it in Studio, in front of the camera (or on the selection)
	Editor.newFromTemplate("Boom 2", "FIRE_EXPLOSION", { color = Color3.fromRGB(80, 160, 255), scale = 1.5 })  -- Editor.TEMPLATES
	Editor.importAsset(123456789, "Free VFX")  -- free Creator Store model -> effect (its scripts are deleted first)
	Editor.importEmitters(fx, workspace.SomeModel)  -- the emitters / trails / lights of a model -> elements of fx
	local code = Editor.exportEffect(fx)  -- "LC1:..." text to copy and send; Editor.importEffect(code, "Name") rebuilds it exactly
	Editor.exportAll() / Editor.importMany(code)  -- a whole library in one code
	Editor.recolorEffect(fx, Color3.fromRGB(80, 160, 255))  -- the whole effect to another colour (whites and greys stay)
	local color, why = Editor.matchPalette(fx, Editor.paletteOf(Analyzer.load()))  -- a colour that reads well on the map
	Editor.makeVariants(fx, { count = 3 })  -- copies in other colours (teams, rarities); Editor.scaleEffect(fx, 1.5) for size

Format (the same the Blender exporter writes; LostCube.VFX plays it in the game):
	Model <effect>  attributes LC_Duration (s), LC_Attach
	  Part Root
	    Attachment <element> > ParticleEmitter / PointLight      (point emitters, lights)
	    Attachment <element>_Top / _Bottom + Trail <element>      (trails)
	    Attachment <element> > Sound                              (sounds: LC_Pitch "min,max", LC_Fade)
	    Attachment <element> > Configuration, LC_Kind = "CAMERA"  (camera: LC_Shake, LC_Freq, LC_ShakeTime, LC_FOV,
	                                                               LC_FovTime, LC_Flash, LC_FlashAlpha, LC_FlashTime, LC_Radius, LC_Studio)
	    Attachment <element>_Start / _End + Beam <element>        (beams: LC_FlashTime, LC_Fade, LC_Jitter)
	  Part <element> > ParticleEmitter                            (shape emitters: the Part is the shape)
	  Part <element>, LC_Mode = Ring | Crack | ...                (3D mesh pieces)
Timeline attributes (seconds) on elements: LC_On "t0,t1", LC_Bursts "t:n;t:n", LC_Keys "t,b,r;..." (lights),
LC_Muted (skipped by the player). Sounds: bursts play them (n overlapping), a window loops them. Camera: bursts are kicks
(shake + FOV punch + flash), a window is a steady rumble. Beams: a window shows them, bursts flash them. VFX.luau's header
has the details.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
