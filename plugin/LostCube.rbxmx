	{ key = "emote_classic", label = "Emote clasice pe R15", folder = "Emote_Classic_R15", rig = "R15", source = CLASSIC,
		verified = "2-sources" },
}

-- group, name, label, id, looped. Dances come in three variants (A/B/C) that the Animate script picks at random.
local EMOTE_DATA = {
