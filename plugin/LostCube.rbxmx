<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="Script" referent="RBX1"><Properties><string name="Name">LostCube</string><ProtectedString name="Source"><![CDATA[-- LostCube - Roblox Studio plugin: VFX editor with live preview, animation preview + Moon-style easing,
-- and the same tools for Claude (ReplicatedStorage.LostCube.Editor). Toolbar "LostCube" opens the panel.
local App = require(script.App)

local toolbar = plugin:CreateToolbar("LostCube")
local button = toolbar:CreateButton("LostCube", "LostCube: VFX + animații (și Claude)", "rbxasset://textures/sparkle.png")
button.ClickableWhenViewportHidden = true

local info = DockWidgetPluginGuiInfo.new(Enum.InitialDockState.Right, false, false, 360, 760, 300, 360)
local widget = plugin:CreateDockWidgetPluginGui("LostCubeMain", info)
widget.Title = "LostCube"
widget.Name = "LostCube"
widget.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

local app

local function open()
	if app then
		return
	end
	app = App.mount(widget, { plugin = plugin })
end

button.Click:Connect(function()
	widget.Enabled = not widget.Enabled
end)

-- shortcuts for the VFX preview; a key is bound in Studio: File > Advanced > Customize Shortcuts > "LostCube"
local playAction = plugin:CreatePluginAction("LostCube_PlayEffect", "LostCube: redă efectul",
	"Redă efectul ales în tab-ul VFX", "rbxasset://textures/sparkle.png", true)
local stopAction = plugin:CreatePluginAction("LostCube_StopPreview", "LostCube: oprește previzualizarea",
	"Oprește și scoate previzualizarea din scenă", "rbxasset://textures/sparkle.png", true)
playAction.Triggered:Connect(function()
	if app then
		app:panel("VFX"):play()
	end
end)
stopAction.Triggered:Connect(function()
	if app then
		app:panel("VFX"):stopPreview()
	end
end)

widget:GetPropertyChangedSignal("Enabled"):Connect(function()
	button:SetActive(widget.Enabled)
	if widget.Enabled then
		open()
	end
end)

if widget.Enabled then
	button:SetActive(true)
	open()
end

plugin.Unloading:Connect(function()
	if app then
		app:destroy()
		app = nil
	end
end)
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX2"><Properties><string name="Name">UI</string><ProtectedString name="Source"><![CDATA[-- LostCube UI kit: the controls the panels are made of (dark theme, violet accent).
-- Everything is plain Roblox GUI, so the same panels run in the plugin's dock widget and in a ScreenGui.
local UI = {}

UI.C = {
	bg = Color3.fromRGB(28, 28, 32),
	section = Color3.fromRGB(36, 36, 42),
	header = Color3.fromRGB(44, 44, 52),
	item = Color3.fromRGB(52, 52, 61),
	hover = Color3.fromRGB(64, 64, 75),
	input = Color3.fromRGB(21, 21, 25),
	border = Color3.fromRGB(62, 62, 72),
	text = Color3.fromRGB(234, 234, 242),
	dim = Color3.fromRGB(150, 150, 166),
	accent = Color3.fromRGB(155, 92, 255),
	accentHover = Color3.fromRGB(172, 120, 255),
	accentDark = Color3.fromRGB(74, 50, 125),
	good = Color3.fromRGB(76, 195, 138),
	danger = Color3.fromRGB(229, 72, 77),
	warn = Color3.fromRGB(242, 169, 59),
}
UI.FONT = Enum.Font.BuilderSans
UI.FONT_MED = Enum.Font.BuilderSansMedium
UI.FONT_BOLD = Enum.Font.BuilderSansBold
UI.H = 24 -- row height
UI.LABEL_W = 104

local C = UI.C
local order = 0
local root, overlay, tipLabel
local tipToken
UI.collapsed = {} -- section title -> collapsed (survives re-renders)

function UI.make(class, props, children)
	local inst = Instance.new(class)
	local parent = props.Parent
	props.Parent = nil
	if inst:IsA("GuiObject") then
		order += 1
		inst.LayoutOrder = order
		inst.BorderSizePixel = 0
	end
	for k, v in props do
		inst[k] = v
	end
	for _, child in children or {} do
		child.Parent = inst
	end
	inst.Parent = parent
	return inst
end
local make = UI.make

function UI.corner(r)
	return make("UICorner", { CornerRadius = UDim.new(0, r or 4) })
end

function UI.stroke(color, thickness)
	return make("UIStroke", { Color = color or C.border, Thickness = thickness or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

function UI.pad(t, r, b, l)
	return make("UIPadding", { PaddingTop = UDim.new(0, t), PaddingRight = UDim.new(0, r or t),
		PaddingBottom = UDim.new(0, b or t), PaddingLeft = UDim.new(0, l or r or t) })
end

function UI.vlist(gap)
	return make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, gap or 4) })
end

function UI.hlist(gap, fill)
	return make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, gap or 4),
		FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center,
		HorizontalFlex = fill and Enum.UIFlexAlignment.Fill or Enum.UIFlexAlignment.None })
end

-- ---------------------------------------------------------------------------------------------
-- root + overlay (menus and pickers float above everything)
-- ---------------------------------------------------------------------------------------------
function UI.setRoot(frame)
	root = frame
	overlay = make("TextButton", { Name = "Overlay", Parent = frame, Size = UDim2.fromScale(1, 1), Text = "",
		AutoButtonColor = false, BackgroundTransparency = 1, Visible = false, ZIndex = 50 })
	overlay.MouseButton1Click:Connect(function()
		UI.closePopup()
	end)
	tipLabel = make("TextLabel", { Name = "Tooltip", Parent = frame, Visible = false, ZIndex = 60, Text = "", Font = UI.FONT,
		TextSize = 12, TextColor3 = C.text, BackgroundColor3 = C.input, AutomaticSize = Enum.AutomaticSize.XY,
		Size = UDim2.fromOffset(0, 0) }, { UI.corner(4), UI.stroke(C.accentDark), UI.pad(3, 6, 3, 6) })
end

-- a small hint under a control after hovering it for a moment (opts.tip of buttons and number boxes)
function UI.tip(target, text)
	target.MouseEnter:Connect(function()
		local token = {}
		tipToken = token
		task.delay(0.4, function()
			if tipToken ~= token or not tipLabel or not target.Parent then
				return
			end
			local rootPos, rootSize = root.AbsolutePosition, root.AbsoluteSize
			tipLabel.Text = text
			local x = target.AbsolutePosition.X - rootPos.X
			local y = target.AbsolutePosition.Y - rootPos.Y + target.AbsoluteSize.Y + 3
			if y > rootSize.Y - 24 then
				y = target.AbsolutePosition.Y - rootPos.Y - 24
			end
			tipLabel.Position = UDim2.fromOffset(math.max(4, x), y)
			tipLabel.Visible = true
			task.defer(function() -- keep it inside the panel once its width is known
				local w = tipLabel.AbsoluteSize.X
				tipLabel.Position = UDim2.fromOffset(math.clamp(x, 4, math.max(4, rootSize.X - w - 4)), y)
			end)
		end)
	end)
	target.MouseLeave:Connect(function()
		tipToken = nil
		if tipLabel then
			tipLabel.Visible = false
		end
	end)
end

function UI.closePopup()
	tipToken = nil
	if tipLabel then
		tipLabel.Visible = false
	end
	if not overlay then
		return
	end
	for _, child in overlay:GetChildren() do
		child:Destroy()
	end
	overlay.Visible = false
end

local function popup(anchor, width, height)
	UI.closePopup()
	overlay.Visible = true
	local rootPos = root.AbsolutePosition
	local x = anchor.AbsolutePosition.X - rootPos.X
	local y = anchor.AbsolutePosition.Y - rootPos.Y + anchor.AbsoluteSize.Y + 2
	local maxY = root.AbsoluteSize.Y - height - 6
	if y > maxY then
		y = math.max(6, anchor.AbsolutePosition.Y - rootPos.Y - height - 2)
	end
	x = math.clamp(x, 4, math.max(4, root.AbsoluteSize.X - width - 4))
	local frame = make("Frame", { Parent = overlay, Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(width, height),
		BackgroundColor3 = C.header, ZIndex = 51 }, { UI.corner(6), UI.stroke(C.accentDark) })
	return frame
end

-- ---------------------------------------------------------------------------------------------
-- basic controls
-- ---------------------------------------------------------------------------------------------
function UI.label(parent, text, opts)
	opts = opts or {}
	return make("TextLabel", { Parent = parent, Text = text, Font = opts.bold and UI.FONT_BOLD or (opts.medium and UI.FONT_MED or UI.FONT),
		TextSize = opts.size or 13, TextColor3 = opts.color or (opts.dim and C.dim or C.text), BackgroundTransparency = 1,
		TextXAlignment = opts.align or Enum.TextXAlignment.Left, TextWrapped = opts.wrap or false, RichText = opts.rich or false,
		Size = opts.wrap and UDim2.new(1, 0, 0, 0) or (opts.width and UDim2.new(0, opts.width, 0, UI.H) or UDim2.new(1, 0, 0, opts.height or UI.H)),
		AutomaticSize = opts.wrap and Enum.AutomaticSize.Y or Enum.AutomaticSize.None, TextTruncate = opts.wrap and Enum.TextTruncate.None
			or Enum.TextTruncate.AtEnd })
end

local STYLES = {
	primary = { bg = C.accent, hover = C.accentHover, text = Color3.new(1, 1, 1) },
	normal = { bg = C.item, hover = C.hover, text = C.text },
	ghost = { bg = C.section, hover = C.item, text = C.dim, transparent = true },
	danger = { bg = Color3.fromRGB(90, 36, 42), hover = C.danger, text = C.text },
	selected = { bg = C.accentDark, hover = Color3.fromRGB(92, 62, 150), text = Color3.new(1, 1, 1) },
}

function UI.button(parent, text, onClick, opts)
	opts = opts or {}
	local style = STYLES[opts.selected and "selected" or (opts.style or "normal")]
	local b = make("TextButton", { Parent = parent, Text = text, Font = opts.bold and UI.FONT_BOLD or UI.FONT_MED,
		TextSize = opts.textSize or 13, TextColor3 = style.text, AutoButtonColor = false, BackgroundColor3 = style.bg,
		BackgroundTransparency = style.transparent and 1 or 0,
		Size = opts.width and UDim2.new(0, opts.width, 0, opts.height or UI.H) or UDim2.new(opts.scale or 1, 0, 0, opts.height or UI.H),
		TextXAlignment = opts.align or Enum.TextXAlignment.Center, TextTruncate = Enum.TextTruncate.AtEnd },
		{ UI.corner(4), UI.pad(0, 8, 0, 8) })
	if opts.selected then
		UI.stroke(C.accent).Parent = b
	end
	b.MouseEnter:Connect(function()
		b.BackgroundColor3 = style.hover
		b.BackgroundTransparency = 0
	end)
	b.MouseLeave:Connect(function()
		b.BackgroundColor3 = style.bg
		b.BackgroundTransparency = style.transparent and 1 or 0
	end)
	if onClick then
		b.MouseButton1Click:Connect(onClick)
	end
	if opts.tip then
		UI.tip(b, opts.tip)
	end
	return b
end

function UI.hstack(parent, opts)
	opts = opts or {}
	local f = make("Frame", { Parent = parent, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, opts.height or UI.H) },
		{ UI.hlist(opts.gap or 4, opts.fill ~= false) })
	return f
end

function UI.vstack(parent, gap)
	return make("Frame", { Parent = parent, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y }, { UI.vlist(gap or 4) })
end

-- a labelled row: returns the area where the controls go (they share the width)
function UI.row(parent, text, opts)
	opts = opts or {}
	local row = make("Frame", { Parent = parent, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, UI.H) },
		{ UI.hlist(6, false) })
	UI.label(row, text, { width = opts.labelWidth or UI.LABEL_W, dim = true, size = 12 })
	local area = make("Frame", { Parent = row, BackgroundTransparency = 1,
		Size = UDim2.new(1, -((opts.labelWidth or UI.LABEL_W) + 6), 1, 0) }, { UI.hlist(4, true) })
	return area
end

local UserInputService = game:GetService("UserInputService")
local CTRL_KEYS = { Enum.KeyCode.LeftControl, Enum.KeyCode.RightControl }
local SHIFT_KEYS = { Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift }

local function modifierDown(input, modifier, keys)
	local ok, down = pcall(input.IsModifierKeyDown, input, modifier)
	if ok and down then
		return true
	end
	for _, key in keys do
		if UserInputService:IsKeyDown(key) then
			return true
		end
	end
	return false
end

local function fmt(v, decimals)
	if decimals == 0 then
		return tostring(math.floor(v + 0.5))
	end
	local s = string.format("%." .. (decimals or 2) .. "f", v)
	s = s:gsub("0+$", ""):gsub("%.$", "")
	return s == "-0" and "0" or s
end
UI.fmt = fmt

function UI.number(parent, value, onChange, opts)
	opts = opts or {}
	local box = make("TextBox", { Parent = parent, Text = fmt(value, opts.decimals), Font = UI.FONT, TextSize = 13,
		TextColor3 = C.text, PlaceholderColor3 = C.dim, BackgroundColor3 = C.input, ClearTextOnFocus = false,
		Size = opts.width and UDim2.new(0, opts.width, 0, UI.H) or UDim2.new(1, 0, 0, UI.H) },
		{ UI.corner(4), UI.stroke(C.border), UI.pad(0, 6, 0, 6) })
	local current = value
	local committed = value -- last value sent to onChange
	local function clamp(v)
		if opts.min then
			v = math.max(opts.min, v)
		end
		if opts.max then
			v = math.min(opts.max, v)
		end
		return v
	end
	local function commit(v)
		v = clamp(v)
		current = v
		committed = v
		box.Text = fmt(v, opts.decimals)
		if onChange then
			onChange(v)
		end
	end
	box.FocusLost:Connect(function()
		local v = tonumber((box.Text:gsub(",", ".")))
		if v and v ~= current then
			commit(v)
		else
			box.Text = fmt(current, opts.decimals)
		end
	end)
	-- Ctrl + mouse wheel nudges the value (Shift = x10). A plain wheel only scrolls the panel: before, scrolling
	-- the property list over a number box changed that value. The new value is applied once the wheel stops
	-- (one Ctrl+Z per gesture and no redraw on every notch).
	local wheelGen = 0
	box.InputChanged:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseWheel or box:IsFocused()
			or not modifierDown(input, Enum.ModifierKey.Ctrl, CTRL_KEYS) then
			return
		end
		local step = (opts.step or 0.1) * (modifierDown(input, Enum.ModifierKey.Shift, SHIFT_KEYS) and 10 or 1)
		current = clamp(current + (input.Position.Z > 0 and 1 or -1) * step)
		box.Text = fmt(current, opts.decimals)
		wheelGen += 1
		local gen = wheelGen
		task.delay(0.35, function()
			if gen == wheelGen and current ~= committed then -- e.g. not when it was already at min / max
				commit(current)
			end
		end)
	end)
	UI.tip(box, (opts.tip and (opts.tip .. "  ·  ") or "") .. "Ctrl + rotiță: ±" .. fmt(opts.step or 0.1, 3)
		.. " (Shift ×10)")
	return box
end

function UI.textbox(parent, value, onChange, opts)
	opts = opts or {}
	local box = make("TextBox", { Parent = parent, Text = value or "", PlaceholderText = opts.placeholder or "",
		Font = UI.FONT, TextSize = 13, TextColor3 = C.text, PlaceholderColor3 = C.dim, BackgroundColor3 = C.input,
		ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
		Size = opts.width and UDim2.new(0, opts.width, 0, UI.H) or UDim2.new(1, 0, 0, UI.H) },
		{ UI.corner(4), UI.stroke(C.border), UI.pad(0, 6, 0, 6) })
	box.FocusLost:Connect(function(enter)
		if onChange and box.Text ~= value then
			onChange(box.Text, enter)
		end
	end)
	return box
end

function UI.toggle(parent, value, onChange, text, opts)
	opts = opts or {}
	return UI.button(parent, (value and "✓ " or "") .. text, function()
		onChange(not value)
	end, { selected = value, width = opts.width, scale = opts.scale, tip = opts.tip })
end

function UI.segmented(parent, items, value, onChange)
	local bar = make("Frame", { Parent = parent, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, UI.H) },
		{ UI.hlist(2, true) })
	for _, item in items do
		UI.button(bar, item.label, function()
			onChange(item.value)
		end, { selected = item.value == value, textSize = 12 })
	end
	return bar
end

-- items: { { value =, label =, header = bool } }
function UI.dropdown(parent, items, value, onChange, opts)
	opts = opts or {}
	local current = opts.text
	for _, item in items do
		if not item.header and item.value == value then
			current = current or item.label
		end
	end
	local b
	b = UI.button(parent, (current or opts.placeholder or "-") .. "   ▼", function()
		local rows, height = 0, 0
		for _, item in items do
			rows += 1
			height += item.header and 20 or 22
		end
		local width = math.max(b.AbsoluteSize.X, opts.menuWidth or 170)
		local frame = popup(b, width, math.min(height + 8, 320))
		local scroll = make("ScrollingFrame", { Parent = frame, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
			CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 4, ZIndex = 52 },
			{ UI.vlist(0), UI.pad(4, 4, 4, 4) })
		for _, item in items do
			if item.header then
				make("TextLabel", { Parent = scroll, Text = item.label, Font = UI.FONT_BOLD, TextSize = 11, TextColor3 = C.accent,
					BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 20), TextXAlignment = Enum.TextXAlignment.Left,
					ZIndex = 53 }, { UI.pad(0, 6, 0, 6) })
			else
				local row = make("TextButton", { Parent = scroll, Text = item.label, Font = UI.FONT, TextSize = 13,
					TextColor3 = item.value == value and C.accentHover or C.text, AutoButtonColor = false,
					BackgroundColor3 = C.hover, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 22),
					TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 53 }, { UI.corner(3), UI.pad(0, 8, 0, 8) })
				row.MouseEnter:Connect(function()
					row.BackgroundTransparency = 0
				end)
				row.MouseLeave:Connect(function()
					row.BackgroundTransparency = 1
				end)
				row.MouseButton1Click:Connect(function()
					UI.closePopup()
					onChange(item.value)
				end)
			end
		end
	end, { align = Enum.TextXAlignment.Left, width = opts.width, scale = opts.scale, style = opts.style })
	return b
end

local PALETTE = {
	"FFFFFF", "D9D9E6", "8C8CA0", "3C3C48", "141418", "000000",
	"9B5CFF", "6A2EFF", "C9A6FF", "4B1FA0", "FF5CF0", "FF9BE8",
	"5CD9FF", "2E8CFF", "A6F0FF", "1F4BA0", "5CFFB4", "2EC46E",
	"FFE15C", "FFB02E", "FF6A2E", "FF2E2E", "A01F1F", "6E3A1F",
}

function UI.color(parent, color, onChange, opts)
	opts = opts or {}
	local b = make("TextButton", { Parent = parent, Text = "", AutoButtonColor = false, BackgroundColor3 = color,
		Size = opts.width and UDim2.new(0, opts.width, 0, UI.H) or UDim2.new(1, 0, 0, UI.H) },
		{ UI.corner(4), UI.stroke(C.border) })
	make("TextLabel", { Parent = b, Text = "#" .. color:ToHex():upper(), Font = UI.FONT, TextSize = 11, BackgroundTransparency = 1,
		TextColor3 = (color.R * 0.3 + color.G * 0.59 + color.B * 0.11) > 0.55 and Color3.new(0, 0, 0) or Color3.new(1, 1, 1),
		Size = UDim2.fromScale(1, 1) })
	b.MouseButton1Click:Connect(function()
		local frame = popup(b, 190, 186)
		make("Frame", { Parent = frame, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 128), Position = UDim2.fromOffset(0, 0),
			ZIndex = 52 }, { UI.pad(8, 8, 0, 8), make("UIGridLayout", { CellSize = UDim2.fromOffset(25, 25),
				CellPadding = UDim2.fromOffset(4, 4), SortOrder = Enum.SortOrder.LayoutOrder }) })
		local grid = frame:FindFirstChildOfClass("Frame")
		for _, hex in PALETTE do
			local sw = make("TextButton", { Parent = grid, Text = "", AutoButtonColor = false, BackgroundColor3 = Color3.fromHex(hex),
				ZIndex = 53 }, { UI.corner(4), UI.stroke(C.border) })
			sw.MouseButton1Click:Connect(function()
				UI.closePopup()
				onChange(Color3.fromHex(hex))
			end)
		end
		local box = make("TextBox", { Parent = frame, Text = color:ToHex():upper(), PlaceholderText = "hex (ex. 9B5CFF)",
			Font = UI.FONT, TextSize = 13, TextColor3 = C.text, BackgroundColor3 = C.input, ClearTextOnFocus = false,
			Position = UDim2.fromOffset(8, 146), Size = UDim2.new(1, -16, 0, 26), ZIndex = 53 },
			{ UI.corner(4), UI.stroke(C.border), UI.pad(0, 6, 0, 6) })
		box.FocusLost:Connect(function(enter)
			local hex = box.Text:gsub("#", ""):gsub("%s", "")
			local ok, c = pcall(Color3.fromHex, hex)
			if ok and c then
				UI.closePopup()
				onChange(c)
			end
		end)
	end)
	return b
end

-- collapsible section; returns its body (a vertical stack)
function UI.section(parent, title, opts)
	opts = opts or {}
	local key = opts.key or title
	if UI.collapsed[key] == nil then
		UI.collapsed[key] = opts.collapsed or false
	end
	local collapsed = UI.collapsed[key]
	local frame = make("Frame", { Parent = parent, BackgroundColor3 = C.section, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y }, { UI.corner(6), UI.vlist(0) })
	local head = make("TextButton", { Parent = frame, Text = "", AutoButtonColor = false, BackgroundColor3 = C.header,
		BackgroundTransparency = collapsed and 1 or 0, Size = UDim2.new(1, 0, 0, 28) }, { UI.corner(6), UI.pad(0, 8, 0, 8),
		UI.hlist(6, false) })
	local arrow = UI.label(head, collapsed and "►" or "▼", { width = 12, dim = true, size = 12 })
	local t = UI.label(head, title, { medium = true, size = 13, width = 220 })
	t.Size = UDim2.new(1, -18 - (opts.rightWidth or 0), 1, 0)
	if opts.right then
		local right = make("Frame", { Parent = head, BackgroundTransparency = 1, Size = UDim2.new(0, opts.rightWidth or 60, 1, 0) },
			{ UI.hlist(3, false) })
		opts.right(right)
	end
	local body = make("Frame", { Parent = frame, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y, Visible = not collapsed }, { UI.pad(6, 8, 8, 8), UI.vlist(4) })
	head.MouseButton1Click:Connect(function()
		-- applied right here (no redraw of the whole panel); the state survives re-renders in UI.collapsed
		collapsed = not collapsed
		UI.collapsed[key] = collapsed
		arrow.Text = collapsed and "►" or "▼"
		head.BackgroundTransparency = collapsed and 1 or 0
		body.Visible = not collapsed
		if UI.onCollapse then
			UI.onCollapse()
		end
		if opts.onToggle then
			opts.onToggle(collapsed)
		end
	end)
	return body
end

-- a selectable line in a list (effects, elements, clips)
function UI.item(parent, text, opts)
	opts = opts or {}
	local selected = opts.selected
	local frame = make("TextButton", { Parent = parent, Text = "", AutoButtonColor = false,
		BackgroundColor3 = selected and C.accentDark or C.item, BackgroundTransparency = selected and 0 or 0.35,
		Size = UDim2.new(1, 0, 0, opts.height or 26) }, { UI.corner(4), UI.pad(0, 4, 0, 8), UI.hlist(4, false) })
	if selected then
		UI.stroke(C.accent).Parent = frame
	end
	local actions = opts.actions or {}
	local rightW = #actions * 26
	if opts.icon then
		UI.label(frame, opts.icon, { width = 16, color = selected and Color3.new(1, 1, 1) or C.accent, size = 13 })
	end
	local name = UI.label(frame, text, { medium = selected, size = 13, color = opts.muted and C.dim or C.text })
	name.Size = UDim2.new(1, -(rightW + (opts.icon and 20 or 0) + (opts.note and 64 or 0) + 4), 1, 0)
	if opts.note then
		UI.label(frame, opts.note, { width = 60, dim = true, size = 11, align = Enum.TextXAlignment.Right })
	end
	for _, a in actions do
		local ab = make("TextButton", { Parent = frame, Text = a.text, Font = UI.FONT_MED, TextSize = 12,
			TextColor3 = a.color or C.dim, AutoButtonColor = false, BackgroundColor3 = C.hover, BackgroundTransparency = 1,
			Size = UDim2.fromOffset(22, 20) }, { UI.corner(3) })
		ab.MouseEnter:Connect(function()
			ab.BackgroundTransparency = 0
		end)
		ab.MouseLeave:Connect(function()
			ab.BackgroundTransparency = 1
		end)
		ab.MouseButton1Click:Connect(a.onClick)
	end
	frame.MouseEnter:Connect(function()
		if not selected then
			frame.BackgroundTransparency = 0
		end
	end)
	frame.MouseLeave:Connect(function()
		if not selected then
			frame.BackgroundTransparency = 0.35
		end
	end)
	if opts.onClick then
		frame.MouseButton1Click:Connect(opts.onClick)
	end
	return frame
end

-- a list that scrolls on its own once it gets taller than maxHeight
function UI.scrollList(parent, maxHeight)
	local sf = make("ScrollingFrame", { Parent = parent, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30),
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 4,
		ScrollBarImageColor3 = C.hover, ScrollingDirection = Enum.ScrollingDirection.Y,
		VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar })
	local layout = UI.vlist(3)
	layout.Parent = sf
	local function fit()
		sf.Size = UDim2.new(1, 0, 0, math.min(maxHeight, layout.AbsoluteContentSize.Y + 2))
	end
	layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(fit)
	task.defer(fit)
	return sf
end

function UI.note(parent, text, color)
	return make("Frame", { Parent = parent, BackgroundColor3 = C.input, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y }, { UI.corner(4), UI.pad(6, 8, 6, 8),
		make("TextLabel", { Text = text, Font = UI.FONT, TextSize = 12, TextColor3 = color or C.dim, BackgroundTransparency = 1,
			TextWrapped = true, RichText = true, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y }) })
end

function UI.spacer(parent, h)
	return make("Frame", { Parent = parent, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, h or 4) })
end

return UI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">App</string><ProtectedString name="Source"><![CDATA[-- LostCube window: header, tabs, the current panel; refreshes when effects change (also when Claude edits).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UI = require(script.Parent.UI)
local C = UI.C

local App = {}
App.__index = App

local TABS = {
	{ key = "Game", label = "🧠 Joc", module = "AnalysisPanel" },
	{ key = "VFX", label = "✨ VFX", module = "VFXPanel" },
	{ key = "Anim", label = "🎬 Anim", module = "AnimPanel" },
	{ key = "Library", label = "📚 Lib", module = "LibraryPanel" },
	{ key = "Claude", label = "◆ Claude", module = "ClaudePanel" },
}

function App.mount(container, ctx)
	ctx = ctx or {}
	ctx.Editor = ctx.Editor or require(script.Parent.Editor)
	local self = setmetatable({ ctx = ctx, tab = "VFX", conns = {}, panels = {} }, App)
	ctx.app = self
	-- remembered between Studio sessions: the open tab and the folded sections
	local savedTab = self:setting("tab")
	for _, t in TABS do
		if t.key == savedTab then
			self.tab = savedTab
		end
	end
	-- first time in this place: no analysis stored yet -> open on the game tab, which starts the analysis
	local okLoad, report = pcall(function()
		return require(script.Parent.Analyzer).load()
	end)
	if okLoad and report == nil then
		self.tab = "Game"
	end
	local folded = self:setting("collapsed")
	if type(folded) == "table" then
		for key, value in folded do
			if type(key) == "string" and type(value) == "boolean" then
				UI.collapsed[key] = value
			end
		end
	end
	UI.onCollapse = function()
		self:save("collapsed", UI.collapsed)
	end

	local root = UI.make("Frame", { Name = "LostCube", Parent = container, Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.bg,
		ClipsDescendants = true })
	self.root = root

	-- header
	local header = UI.make("Frame", { Parent = root, Size = UDim2.new(1, 0, 0, 42), BackgroundColor3 = C.section },
		{ UI.pad(0, 12, 0, 12) })
	UI.make("TextLabel", { Parent = header, Text = "◆", Font = UI.FONT_BOLD, TextSize = 20, TextColor3 = C.accent,
		BackgroundTransparency = 1, Size = UDim2.new(0, 20, 1, 0) })
	UI.make("TextLabel", { Parent = header, Text = "LostCube", Font = UI.FONT_BOLD, TextSize = 17, TextColor3 = C.text,
		BackgroundTransparency = 1, Position = UDim2.fromOffset(26, 0), Size = UDim2.new(0, 120, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Left })
	UI.make("TextLabel", { Parent = header, Text = "v" .. ctx.Editor.VERSION .. "  ·  Roblox VFX + animații", Font = UI.FONT,
		TextSize = 11, TextColor3 = C.dim, BackgroundTransparency = 1, Position = UDim2.new(0, 112, 0, 0),
		Size = UDim2.new(1, -112, 1, 0), TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd })

	-- tabs
	self.tabBar = UI.make("Frame", { Parent = root, Position = UDim2.fromOffset(0, 42), Size = UDim2.new(1, 0, 0, 34),
		BackgroundColor3 = C.section }, { UI.pad(4, 8, 6, 8), UI.hlist(4, true) })

	-- content
	self.scroll = UI.make("ScrollingFrame", { Parent = root, Position = UDim2.fromOffset(0, 76), Size = UDim2.new(1, 0, 1, -76),
		BackgroundTransparency = 1, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 6,
		ScrollBarImageColor3 = C.hover, ScrollingDirection = Enum.ScrollingDirection.Y, VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar })
	self.content = UI.make("Frame", { Parent = self.scroll, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y }, { UI.pad(8, 8, 16, 8), UI.vlist(8) })

	UI.setRoot(root)
	self:watch()
	self:render()
	return self
end

-- plugin settings (nothing is saved when the panels run outside a plugin, e.g. in a ScreenGui)
function App:setting(key)
	local plugin = self.ctx.plugin
	if not plugin then
		return nil
	end
	local ok, value = pcall(plugin.GetSetting, plugin, "LostCube." .. key)
	return ok and value or nil
end

function App:save(key, value)
	local plugin = self.ctx.plugin
	if plugin then
		pcall(plugin.SetSetting, plugin, "LostCube." .. key, value)
	end
end

function App:panel(key)
	if not self.panels[key] then
		for _, t in TABS do
			if t.key == key then
				self.panels[key] = require(script.Parent[t.module]).new(self.ctx)
			end
		end
	end
	return self.panels[key]
end

function App:render()
	local scrollY = self.scroll.CanvasPosition.Y
	for _, child in self.tabBar:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	for _, t in TABS do
		UI.button(self.tabBar, t.label, function()
			if self.tab ~= t.key then
				self.tab = t.key
				self:save("tab", t.key)
				self.scroll.CanvasPosition = Vector2.zero
				self:render()
			end
		end, { selected = self.tab == t.key, height = 24, bold = self.tab == t.key, textSize = 12 }) -- 5 tabs in ~360 px
	end
	for _, child in self.content:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	UI.closePopup()
	local ok, err = pcall(function()
		self:panel(self.tab):render(self.content)
	end)
	if not ok then
		UI.note(self.content, "⚠ Eroare în panou: " .. tostring(err), C.danger)
		warn("LostCube:", err)
	end
	task.defer(function()
		if self.scroll.Parent then
			self.scroll.CanvasPosition = Vector2.new(0, scrollY)
		end
	end)
end

-- coalesces many changes into one redraw
function App:refresh()
	if self.pending then
		return
	end
	self.pending = true
	task.defer(function()
		self.pending = false
		if self.root.Parent then
			self:render()
		end
	end)
end

-- redraw when effects change from anywhere (other windows, Claude, undo)
function App:watch()
	local function hook()
		for _, c in self.watchConns or {} do
			c:Disconnect()
		end
		self.watchConns = {}
		local conns = self.watchConns
		local root = ReplicatedStorage:FindFirstChild("LostCube")
		table.insert(conns, ReplicatedStorage.ChildAdded:Connect(function(child)
			if child.Name == "LostCube" then
				task.defer(hook)
			end
		end))
		if not root then
			return
		end
		table.insert(conns, root.DescendantAdded:Connect(function(d)
			if d.Name == "Effects" then
				task.defer(hook)
			end
			self:refresh()
		end))
		table.insert(conns, root.DescendantRemoving:Connect(function()
			self:refresh()
		end))
		local effects = root:FindFirstChild("Effects")
		if effects then
			table.insert(conns, effects:GetAttributeChangedSignal("LC_Rev"):Connect(function()
				self:refresh()
			end))
		end
	end
	hook()
	-- the activity log (Claude tab) lives in ServerStorage.LostCubeSession, created on the first edit
	local ok, storage = pcall(function()
		return game:GetService("ServerStorage")
	end)
	if ok then
		local function hookLog(folder)
			if folder.Name == "LostCubeSession" then
				table.insert(self.conns, folder:GetAttributeChangedSignal("Log"):Connect(function()
					if self.tab == "Claude" then
						self:refresh()
					end
				end))
			end
		end
		local existing = storage:FindFirstChild("LostCubeSession")
		if existing then
			hookLog(existing)
		end
		table.insert(self.conns, storage.ChildAdded:Connect(hookLog))
	end
	table.insert(self.conns, game:GetService("ChangeHistoryService").OnUndo:Connect(function()
		self:refresh()
	end))
	table.insert(self.conns, game:GetService("ChangeHistoryService").OnRedo:Connect(function()
		self:refresh()
	end))
end

function App:destroy()
	UI.onCollapse = nil
	for _, c in self.conns do
		c:Disconnect()
	end
	for _, c in self.watchConns or {} do
		c:Disconnect()
	end
	for _, p in self.panels do
		if p.destroy then
			p:destroy()
		end
	end
	self.root:Destroy()
end

return App
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">VFXPanel</string><ProtectedString name="Source"><![CDATA[-- LostCube > VFX tab: effects list, elements with presets, properties, timeline, live preview.
local Selection = game:GetService("Selection")

local UI = require(script.Parent.UI)
local C = UI.C

local Panel = {}
Panel.__index = Panel

local ORIENT = {
	{ value = "FacingCamera", label = "Spre cameră" },
	{ value = "FacingCameraWorldUp", label = "Spre cameră (vertical)" },
	{ value = "VelocityParallel", label = "Pe direcția mișcării (raze)" },
	{ value = "VelocityPerpendicular", label = "Culcat (cercuri pe sol)" },
}
local SHAPES = {
	{ value = "Point", label = "Punct" }, { value = "Box", label = "Cutie" }, { value = "Sphere", label = "Sferă" },
	{ value = "Cylinder", label = "Cilindru" }, { value = "Disc", label = "Disc" },
}
local DIRECTIONS = {
	{ value = "Top", label = "Sus" }, { value = "Bottom", label = "Jos" }, { value = "Front", label = "Față" },
	{ value = "Back", label = "Spate" }, { value = "Left", label = "Stânga" }, { value = "Right", label = "Dreapta" },
}
local KIND_ICON = { PARTICLES = "★", LIGHT = "☀", TRAIL = "≈", MESH = "■" }
local KIND_LABEL = { PARTICLES = "Particule", LIGHT = "Lumină", TRAIL = "Trail", MESH = "Mesh 3D" }
local MESH_MODES = {
	{ value = "Ring", label = "Inel (se lărgește)" }, { value = "Crack", label = "Crăpături (radial)" },
	{ value = "Pulse", label = "Puls (crește și dispare)" }, { value = "Puff", label = "Fum 3D (bile)" },
	{ value = "Trail", label = "Urmă pe sol (rămâne)" }, { value = "Debris", label = "Debris (fizică reală)" },
}
local PART_SHAPES = { { value = "Block", label = "Cub" }, { value = "Ball", label = "Bilă" },
	{ value = "Cylinder", label = "Cilindru" }, { value = "Wedge", label = "Pană" } }
local MATERIALS = {}
for _, m in { "Neon", "ForceField", "SmoothPlastic", "Glass", "Ice", "Metal", "Slate", "Rock", "Concrete", "Plastic", "Sand" } do
	table.insert(MATERIALS, { value = m, label = m })
end

function Panel.new(ctx)
	return setmetatable({ ctx = ctx, Editor = ctx.Editor, effect = nil, element = nil, speed = 1, loop = false,
		confirm = nil, creating = false, handle = nil }, Panel)
end

function Panel:refresh()
	self.ctx.app:refresh()
end

-- "ReplicatedStorage.LostCube.Editor:123: LostCube: ..." -> "LostCube: ..."
local function clean(err)
	return (tostring(err):gsub("^.-:%d+: ", ""))
end

local function trim(text)
	return (text:gsub("^%s+", ""):gsub("%s+$", ""))
end

-- UI.note renders rich text: text that comes from outside (asset names, script names) must not be read as tags
local function plain(text)
	return (text:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
end

-- an effect name that is not taken yet ("Fulger", "Fulger 2", ...)
local function freeName(Editor, base)
	local taken = {}
	for _, fx in Editor.effects() do
		taken[fx.Name] = true
	end
	if not taken[base] then
		return base
	end
	local i = 2
	while taken[base .. " " .. i] do
		i += 1
	end
	return base .. " " .. i
end

-- dropdown items grouped under headers, in the order the groups first appear; `label` decides how an entry is written
local function groupedItems(entries, groupOf, valueOf, labelOf)
	local order, byGroup = {}, {}
	for _, entry in entries do
		local group = groupOf(entry)
		if not byGroup[group] then
			byGroup[group] = {}
			table.insert(order, group)
		end
		table.insert(byGroup[group], entry)
	end
	local items = {}
	for _, group in order do
		table.insert(items, { header = true, label = group })
		for _, entry in byGroup[group] do
			table.insert(items, { value = valueOf(entry), label = labelOf(entry) })
		end
	end
	return items
end

-- the asset id out of what people paste: "123", "rbxassetid://123" or a Creator Store address
local function assetIdOf(text)
	text = trim(text)
	return text:match("^(%d+)$") or text:match("rbxassetid://(%d+)") or text:match("/asset/(%d+)") or text:match("/store/asset/(%d+)")
end

-- every edit goes through the Editor (one undo step each); errors show up in the panel instead of breaking it
function Panel:try(fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		self.error = clean(err)
		warn("LostCube:", err)
	else
		self.error = nil
	end
	self:refresh()
end

function Panel:set(element, props)
	self:try(self.Editor.setProps, element, props)
end

-- ---------------------------------------------------------------------------------------------
-- preview
-- ---------------------------------------------------------------------------------------------
function Panel:play()
	if not self.effect then
		return
	end
	if self.handle and not self.handle.Done then
		self.handle:Destroy()
	end
	local wasPaused = self.paused
	self.paused = false
	local ok, h = pcall(self.Editor.preview, self.effect, { speed = self.speed })
	if ok then
		self.handle = h
	else
		self.error = clean(h)
	end
	if wasPaused or not ok then
		self:refresh()
	end
end

-- removes the preview from the scene (a paused one would otherwise stay frozen there) and ends the loop
function Panel:stopPreview()
	self.loop = false
	self.loopId = (self.loopId or 0) + 1
	self.paused = false
	if self.handle and not self.handle.Done then
		self.handle:Destroy()
	end
	self.handle = nil
	self:refresh()
end

function Panel:setLoop(on)
	self.loop = on
	self.loopId = (self.loopId or 0) + 1
	if on then
		local id = self.loopId
		local function running()
			return self.loop and self.loopId == id and self.effect and self.effect.Parent
		end
		task.spawn(function()
			while running() do
				self:play()
				-- wait one play; time spent paused does not count, so Pause works while repeating
				local ok, length = pcall(self.Editor.length, self.effect)
				local left = (ok and length or 1) + 0.35
				while left > 0 and running() do
					local dt = task.wait(0.05)
					if not self.paused then
						left -= dt * self.speed
					end
				end
			end
		end)
	end
	self:refresh()
end

function Panel:togglePause()
	local h = self.handle
	if not h or h.Done then
		if self.paused then -- the preview is gone: the button must not stay on "Continue"
			self.paused = false
			self:refresh()
		end
		return
	end
	if self.paused then
		h:Resume()
		self.paused = false
	else
		h:Pause()
		self.paused = true
	end
	self:refresh()
end

function Panel:destroy()
	self.loop = false
	self.loopId = (self.loopId or 0) + 1
	if self.handle and not self.handle.Done then
		self.handle:Destroy()
	end
end

-- ---------------------------------------------------------------------------------------------
-- render
-- ---------------------------------------------------------------------------------------------
function Panel:render(parent)
	local Editor = self.Editor
	if self.effect and not self.effect.Parent then
		self.effect, self.element = nil, nil
	end
	if self.element and (not self.element.Parent or (self.effect and not self.element:IsDescendantOf(self.effect))) then
		self.element = nil
	end
	if self.error then
		UI.note(parent, "⚠ " .. self.error, C.warn)
		self.error = nil -- shown once; the next action sets it again if it still fails
	end
	local status = require(script.Parent.Installer).status()
	if not status.ok then
		local banner = UI.vstack(parent, 6)
		UI.note(banner, status.vfx and "Modulele LostCube din joc sunt mai vechi decât pluginul."
			or "Jocul nu are încă modulele LostCube (<b>VFX</b> redă efectele în joc, <b>Editor</b> e pentru Claude).", C.warn)
		UI.button(UI.hstack(banner, { height = 28 }), "Instalează în joc (ReplicatedStorage.LostCube)", function()
			self:try(require(script.Parent.Installer).install)
		end, { style = "primary", bold = true, height = 28 })
	end

	-- effects ---------------------------------------------------------------------------------
	local effects = Editor.effects()
	local body = UI.section(parent, "Efecte  (" .. #effects .. ")", { key = "vfx.effects" })
	local bar = UI.hstack(body)
	UI.button(bar, "+ Efect nou", function()
		self.creating = true
		self.templating = false
		self:refresh()
	end, { style = "primary", bold = true })
	UI.button(bar, "+ Din șablon", function()
		self.templating = not self.templating
		self.creating = false
		self:refresh()
	end, { selected = self.templating, bold = true, tip = "efecte gata făcute (lovitură, fulger, vindecare, teleport...)" })
	if self.templating then
		self:renderTemplates(body)
	end
	if self.creating then
		local row = UI.hstack(body)
		local box = UI.textbox(row, "", nil, { placeholder = "Numele efectului (ex. Foc)" })
		UI.button(row, "Creează", function()
			local name = box.Text ~= "" and box.Text or "Efect"
			self.creating = false
			local ok, fx = pcall(Editor.newEffect, name, { duration = 1 })
			if ok then
				self.effect, self.element = fx, nil
			else
				self.error = clean(fx)
			end
			self:refresh()
		end, { width = 74, style = "primary" })
		UI.button(row, "×", function()
			self.creating = false
			self:refresh()
		end, { width = 26, style = "ghost" })
		task.defer(function()
			if box.Parent then
				box:CaptureFocus()
			end
		end)
	end
	if #effects == 0 then
		UI.note(body, "Niciun efect încă. Apasă <b>+ Efect nou</b>, apoi adaugă elemente din preseturi.")
	end
	local list = #effects > 0 and UI.scrollList(body, 236) or body
	for _, fx in effects do
		local n = #Editor.elements(fx)
		local confirm = self.confirm == fx
		UI.item(list, fx.Name, {
			icon = "◆", selected = fx == self.effect, note = n .. " el.",
			onClick = function()
				self.effect = fx
				self.element = nil
				self.confirm = nil
				self:refresh()
			end,
			actions = {
				{ text = "📋", onClick = function()
					self:try(function()
						self.effect = Editor.duplicateEffect(fx)
					end)
				end },
				{ text = confirm and "✓?" or "×", color = C.danger, onClick = function()
					if confirm then
						self.confirm = nil
						if self.effect == fx then
							self.effect, self.element = nil, nil
						end
						self:try(Editor.removeEffect, fx)
					else
						self.confirm = fx
						self:refresh()
					end
				end },
			},
		})
	end
	self:renderImport(parent)
	if not self.effect then
		return
	end

	-- the effect ------------------------------------------------------------------------------
	local fx = self.effect
	body = UI.section(parent, "Efect: " .. fx.Name, { key = "vfx.effect" })
	UI.textbox(UI.row(body, "Nume"), fx.Name, function(text)
		if text ~= "" then
			self:try(Editor.setEffect, fx, { name = text })
		end
	end)
	UI.number(UI.row(body, "Durată (s)"), fx:GetAttribute("LC_Duration") or 1, function(v)
		self:try(Editor.setEffect, fx, { duration = v })
	end, { min = 0.01, step = 0.05, decimals = 2 })
	local attachItems = {}
	for _, a in Editor.ATTACH do
		table.insert(attachItems, { value = a.key, label = a.label })
	end
	UI.dropdown(UI.row(body, "Prins de"), attachItems, fx:GetAttribute("LC_Attach") or "GROUND", function(v)
		self:try(Editor.setEffect, fx, { attach = v })
	end, { menuWidth = 200 })

	local play = UI.hstack(body, { height = 28 })
	UI.button(play, "▶  Redă", function()
		self:play()
	end, { style = "primary", bold = true, height = 28 })
	UI.button(play, self.loop and "🔁 Repetă: DA" or "🔁 Repetă", function()
		self:setLoop(not self.loop)
	end, { selected = self.loop, height = 28 })
	UI.button(play, self.paused and "▶ Continuă" or "⏸ Pauză", function()
		self:togglePause()
	end, { height = 28 })
	UI.button(play, "⏹", function()
		self:stopPreview()
	end, { width = 32, height = 28, tip = "oprește și scoate previzualizarea din scenă" })
	UI.segmented(UI.row(body, "Viteză"), {
		{ value = 0.1, label = "×0.1" }, { value = 0.25, label = "×0.25" }, { value = 0.5, label = "×0.5" },
		{ value = 1, label = "×1" },
	}, self.speed, function(v)
		self.speed = v
		self:refresh()
	end)
	local timeRow = UI.row(body, "Întinde timpul")
	for _, k in { 0.8, 1.15, 1.3 } do
		UI.button(timeRow, "×" .. k, function()
			self:try(Editor.retime, fx, k)
		end, { textSize = 12, tip = "durată, emisii, burst-uri, chei și vieți x" .. k })
	end
	UI.label(body, "Se redă pe selecție (personaj / part) sau pe sol, în fața camerei.", { dim = true, size = 11, wrap = true })

	-- elements --------------------------------------------------------------------------------
	local elements = Editor.elements(fx)
	body = UI.section(parent, "Elemente  (" .. #elements .. ")", { key = "vfx.elements" })
	for _, e in elements do
		local muted = e:GetAttribute("LC_Muted") == true
		local kind = Editor.kindOf(e)
		UI.item(body, e.Name, {
			icon = KIND_ICON[kind], selected = e == self.element, muted = muted,
			onClick = function()
				self.element = e
				self:refresh()
			end,
			actions = {
				{ text = muted and "○" or "●", color = muted and C.dim or C.good, onClick = function()
					self:set(e, { muted = not muted })
				end },
				{ text = "📋", onClick = function()
					self:try(function()
						self.element = Editor.duplicate(e)
					end)
				end },
				{ text = "×", color = C.danger, onClick = function()
					if self.element == e then
						self.element = nil
					end
					self:try(Editor.remove, e)
				end },
			},
		})
	end
	-- presets grouped by theme (Electricitate, Apă și gheață...); the icon tells the kind of element it adds
	local addItems = groupedItems(Editor.PRESETS, function(p)
		return p.group or KIND_LABEL[p.kind]
	end, function(p)
		return p.key
	end, function(p)
		return KIND_ICON[p.kind] .. "  " .. p.label
	end)
	table.insert(addItems, { header = true, label = "Gol" })
	table.insert(addItems, { value = "PARTICLES", label = "Particule (gol)" })
	table.insert(addItems, { value = "LIGHT", label = "Lumină (goală)" })
	table.insert(addItems, { value = "TRAIL", label = "Trail (gol)" })
	table.insert(addItems, { value = "MESH", label = "Mesh 3D (gol)" })
	UI.dropdown(UI.hstack(body), addItems, nil, function(key)
		self:try(function()
			self.element = Editor.addElement(fx, key)
		end)
	end, { text = "+ Adaugă element", style = "primary", menuWidth = 220 })

	if self.element then
		self:renderElement(parent, self.element)
	end
end

-- ---------------------------------------------------------------------------------------------
-- new effect from a template
-- ---------------------------------------------------------------------------------------------
function Panel:renderTemplates(body)
	local Editor = self.Editor
	local templates = Editor.TEMPLATES or {}
	local box = UI.vstack(body, 4)
	if #templates == 0 then
		UI.note(box, "Acest Editor nu are șabloane (versiune veche a modulului).", C.warn)
		return
	end
	local tpl
	for _, t in templates do
		if t.key == self.tplKey then
			tpl = t
		end
	end
	tpl = tpl or templates[1]
	self.tplKey = tpl.key

	local items = groupedItems(templates, function(t)
		return t.category
	end, function(t)
		return t.key
	end, function(t)
		return t.label
	end)
	UI.dropdown(UI.row(box, "Șablon"), items, tpl.key, function(key)
		self.tplKey = key
		self.tplName = nil
		self:refresh()
	end, { menuWidth = 230 })
	local attachLabel = tpl.attach
	for _, a in Editor.ATTACH do
		if a.key == tpl.attach then
			attachLabel = a.label
		end
	end
	UI.label(box, tpl.desc, { dim = true, size = 11, wrap = true })
	UI.label(box, string.format("%s s  ·  %d elemente  ·  prins de: %s", UI.fmt(tpl.duration), #tpl.elements, attachLabel),
		{ dim = true, size = 11, wrap = true })

	local colors = UI.row(box, "Culoare")
	UI.color(colors, self.tplColor or tpl.main, function(c)
		self.tplColor = c
		self:refresh()
	end)
	if self.tplColor then
		UI.button(colors, "↺", function()
			self.tplColor = nil
			self:refresh()
		end, { width = 28, style = "ghost", tip = "culorile originale ale șablonului" })
	end
	UI.number(UI.row(box, "Scară"), self.tplScale or 1, function(v)
		self.tplScale = v
		self:refresh()
	end, { min = 0.25, max = 4, step = 0.25, decimals = 2, tip = "mărește / micșorează tot efectul (mărimi, distanțe, viteze)" })

	local defaultName = freeName(Editor, tpl.label)
	local nameBox = UI.textbox(UI.row(box, "Nume"), self.tplName or defaultName, function(text)
		self.tplName = text
	end, { placeholder = "Numele efectului" })
	local row = UI.hstack(box)
	UI.button(row, "Creează și redă", function()
		local name = trim(nameBox.Text) ~= "" and nameBox.Text or defaultName
		local scale = self.tplScale or 1
		local ok, fx = pcall(Editor.newFromTemplate, name, tpl.key, { color = self.tplColor, scale = scale ~= 1 and scale or nil })
		if ok then
			self.effect, self.element = fx, nil
			self.templating, self.tplName = false, nil
			self.error = nil
			self:refresh()
			task.defer(function()
				if self.effect == fx and fx.Parent then
					self:play()
				end
			end)
		else
			self.error = clean(fx)
			self:refresh()
		end
	end, { style = "primary", bold = true })
	UI.button(row, "×", function()
		self.templating = false
		self:refresh()
	end, { width = 26, style = "ghost" })
	UI.spacer(box, 2)
end

-- ---------------------------------------------------------------------------------------------
-- free VFX from the Creator Store (scripts are deleted by the Editor before anything is copied)
-- ---------------------------------------------------------------------------------------------
local function importLines(result)
	local lines = {
		"✓ Importate în efectul ales: " .. result.particles .. " particule, " .. result.trails .. " trail-uri, " .. result.lights
			.. " lumini (scripturile nu se copiază).",
	}
	for _, note in result.notes do
		table.insert(lines, "• " .. note)
	end
	return lines
end

function Panel:renderImport(parent)
	local Editor = self.Editor
	local body = UI.section(parent, "Importă VFX gratuit (Creator Store)", { key = "vfx.import", collapsed = true })
	if not Editor.importAsset then
		UI.note(body, "Acest Editor nu poate importa (versiune veche a modulului).", C.warn)
		return
	end
	UI.label(body, "Lipește ID-ul (sau adresa) unui model VFX gratuit din Creator Store. Scripturile din model se șterg înainte de orice, "
		.. "apoi particulele, trail-urile și luminile devin un efect LostCube.", { dim = true, size = 11, wrap = true })
	local idBox = UI.textbox(UI.row(body, "ID asset"), self.importId or "", function(text)
		self.importId = text
	end, { placeholder = "ex. 123456789 sau adresa paginii" })
	local nameBox = UI.textbox(UI.row(body, "Nume efect"), self.importName or "", function(text)
		self.importName = text
	end, { placeholder = "gol = Import <ID>" })
	local row = UI.hstack(body)
	UI.button(row, self.importing and "Se importă…" or "Importă", function()
		if self.importing then
			return
		end
		local id = assetIdOf(idBox.Text)
		if not id then
			self.importReport = { ok = false, lines = { "✗ Scrie ID-ul asset-ului: numărul din adresa paginii (…/store/asset/NUMĂR)." } }
			self:refresh()
			return
		end
		local name = trim(nameBox.Text)
		self.importId, self.importName = idBox.Text, nameBox.Text
		self.importing, self.importReport = true, nil
		self:refresh()
		task.spawn(function()
			-- the download yields: the texts were read above, the boxes of this render are already gone
			local ok, fx, report = pcall(Editor.importAsset, tonumber(id), name ~= "" and name or nil)
			self.importing = false
			if ok and fx then
				self.effect, self.element = fx, nil
			end
			self.importReport = ok and report or { ok = false, lines = { "✗ " .. clean(fx) } }
			self:refresh()
		end)
	end, { style = "primary", bold = true, tip = "descarcă modelul, șterge scripturile și creează efectul" })
	UI.button(row, "Din selecție", function()
		if not self.effect then
			self.importReport = { ok = false, lines = { "✗ Alege mai întâi un efect (sau creează unul)." } }
			self:refresh()
			return
		end
		local picked = Selection:Get()[1]
		if not picked then
			self.importReport = { ok = false, lines = { "✗ Selectează în Explorer modelul cu particule (inserat din Toolbox)." } }
			self:refresh()
			return
		end
		local ok, result = pcall(Editor.importEmitters, self.effect, picked)
		self.importReport = ok and { ok = true, lines = importLines(result) } or { ok = false, lines = { "✗ " .. clean(result) } }
		self:refresh()
	end, { tip = "copiază emitoarele din obiectul selectat în efectul ales (nu copiază scripturi)" })
	local report = self.importReport
	if report then
		local color = report.ok and ((report.suspicious or 0) == 0 and C.good or C.warn) or C.warn
		local lines = {}
		for _, line in report.lines or {} do
			table.insert(lines, plain(line))
		end
		UI.note(body, table.concat(lines, "\n"), color)
	end
end

-- ---------------------------------------------------------------------------------------------
-- element properties
-- ---------------------------------------------------------------------------------------------
local function triple(self, body, label, values, element, key, opts)
	local area = UI.row(body, label)
	for i = 1, 3 do
		UI.number(area, values[i], function(v)
			local t = { values[1], values[2], values[3], mid = values.mid }
			t[i] = v
			self:set(element, { [key] = t })
		end, opts)
	end
end

local function pair(self, body, label, values, element, key, opts)
	local area = UI.row(body, label)
	for i = 1, 2 do
		UI.number(area, values[i], function(v)
			local t = { values[1], values[2] }
			t[i] = v
			self:set(element, { [key] = t })
		end, opts)
	end
end

local function vector(self, body, label, v, element, key, opts)
	local area = UI.row(body, label)
	for _, axis in { "X", "Y", "Z" } do
		UI.number(area, v[axis], function(x)
			local cur = (key == "position" and self.Editor.position(element)) or v
			local t = { X = cur.X, Y = cur.Y, Z = cur.Z }
			t[axis] = x
			self:set(element, { [key] = Vector3.new(t.X, t.Y, t.Z) })
		end, opts)
	end
end

local function single(self, body, label, value, element, key, opts)
	UI.number(UI.row(body, label), value, function(v)
		self:set(element, { [key] = v })
	end, opts)
end

function Panel:colorRow(body, data, element)
	local cols = data.color
	local mode = #cols
	UI.segmented(UI.row(body, "Culori"), {
		{ value = 1, label = "Una" }, { value = 2, label = "Două" }, { value = 3, label = "Trei" },
	}, mode, function(m)
		local a, b, c = cols[1], cols[2] or cols[1], cols[3] or cols[2] or cols[1]
		self:set(element, { color = m == 1 and a or (m == 2 and { a, b } or { a, b, c }) })
	end)
	local area = UI.row(body, mode == 1 and "Culoare" or "început → sfârșit")
	for i = 1, mode do
		UI.color(area, cols[i], function(c)
			local t = { cols[1], cols[2], cols[3], mid = cols.mid }
			t[i] = c
			self:set(element, { color = mode == 1 and c or (mode == 2 and { t[1], t[2] } or t) })
		end)
	end
end

function Panel:textureRow(body, data, element)
	local items = groupedItems(self.Editor.TEXTURES, function(t)
		return t.group or "Altele"
	end, function(t)
		return t.key
	end, function(t)
		return t.label
	end)
	table.insert(items, { header = true, label = "Proprii" })
	table.insert(items, { value = "CUSTOM", label = "ID propriu…" })
	UI.dropdown(UI.row(body, "Textură"), items, data.texture, function(v)
		if v == "CUSTOM" then
			self.customTexture = true
			self:refresh()
		else
			self.customTexture = false
			self:set(element, { texture = v })
		end
	end, { menuWidth = 200 })
	if data.texture == "CUSTOM" or self.customTexture then
		UI.textbox(UI.row(body, "ID textură"), data.textureId, function(text)
			local id = text:match("^%d+$") and ("rbxassetid://" .. text) or text
			self:set(element, { texture = id })
		end, { placeholder = "rbxassetid://123456" })
	end
end

function Panel:renderElement(parent, element)
	local Editor = self.Editor
	local data = Editor.read(element)
	local kind = data.kind
	local body = UI.section(parent, KIND_ICON[kind] .. "  " .. element.Name, { key = "vfx.element" })
	UI.textbox(UI.row(body, "Nume"), element.Name, function(text)
		if text ~= "" then
			self:set(element, { name = text })
		end
	end)
	local ofKind = {}
	for _, p in Editor.PRESETS do
		if p.kind == kind then
			table.insert(ofKind, p)
		end
	end
	local presetItems = groupedItems(ofKind, function(p)
		return p.group or KIND_LABEL[p.kind]
	end, function(p)
		return p.key
	end, function(p)
		return p.label
	end)
	UI.dropdown(UI.row(body, "Preset"), presetItems, data.preset, function(v)
		self:try(Editor.applyPreset, element, v)
	end, { placeholder = "alege…", menuWidth = 210 })
	vector(self, body, "Poziție", data.position, element, "position", { step = 0.25, decimals = 2 })
	UI.button(UI.hstack(body), "Selectează în Explorer", function()
		Selection:Set({ element })
	end, { style = "ghost" })

	if kind == "PARTICLES" then
		body = UI.section(parent, "Aspect", { key = "vfx.look" })
		self:textureRow(body, data, element)
		self:colorRow(body, data, element)
		triple(self, body, "Mărime", data.size, element, "size", { min = 0, step = 0.1, decimals = 2 })
		triple(self, body, "Transparență", data.transparency, element, "transparency", { min = 0, max = 1, step = 0.05, decimals = 2 })
		UI.number(UI.row(body, "Mijloc la (0-1)"), data.size.mid or 0.5, function(v)
			local s, tr = data.size, data.transparency
			self:set(element, { size = { s[1], s[2], s[3], mid = v }, transparency = { tr[1], tr[2], tr[3], mid = v } })
		end, { min = 0.01, max = 0.99, step = 0.05, decimals = 2 })
		single(self, body, "Strălucire", data.LightEmission, element, "LightEmission", { min = 0, max = 1, step = 0.1, decimals = 2 })
		single(self, body, "Influență lumină", data.LightInfluence, element, "LightInfluence", { min = 0, max = 1, step = 0.1, decimals = 2 })
		single(self, body, "Luminozitate", data.Brightness, element, "Brightness", { min = 0, step = 0.25, decimals = 2 })
		single(self, body, "Squash", data.squash, element, "squash", { min = -3, max = 3, step = 0.25, decimals = 2 })
		UI.dropdown(UI.row(body, "Orientare"), ORIENT, data.Orientation, function(v)
			self:set(element, { Orientation = v })
		end, { menuWidth = 220 })
		single(self, body, "ZOffset", data.ZOffset, element, "ZOffset", { step = 0.25, decimals = 2 })

		body = UI.section(parent, "Mișcare", { key = "vfx.motion" })
		pair(self, body, "Viață (s)", data.lifetime, element, "lifetime", { min = 0, step = 0.05, decimals = 2 })
		pair(self, body, "Viteză", data.speed, element, "speed", { step = 0.5, decimals = 2 })
		single(self, body, "Rată / s", data.Rate, element, "Rate", { min = 0, step = 5, decimals = 1 })
		pair(self, body, "Spread X / Y", data.spread, element, "spread", { min = 0, max = 180, step = 5, decimals = 0 })
		vector(self, body, "Accelerație", data.acceleration, element, "acceleration", { step = 1, decimals = 2 })
		single(self, body, "Drag", data.Drag, element, "Drag", { min = 0, step = 0.5, decimals = 2 })
		pair(self, body, "Rotație", data.rotation, element, "rotation", { step = 15, decimals = 0 })
		pair(self, body, "Rotire / s", data.rotSpeed, element, "rotSpeed", { step = 15, decimals = 0 })
		UI.toggle(UI.hstack(body), data.LockedToPart, function(v)
			self:set(element, { LockedToPart = v })
		end, "Lipit de efect (LockedToPart)")

		body = UI.section(parent, "Formă și direcție", { key = "vfx.shape", collapsed = true })
		UI.dropdown(UI.row(body, "Formă"), SHAPES, data.shape, function(v)
			self:set(element, { shape = v })
		end)
		if data.shape ~= "Point" and data.partSize then
			vector(self, body, "Mărime formă", data.partSize, element, "partSize", { min = 0.05, step = 0.25, decimals = 2 })
			UI.segmented(UI.row(body, "Din"), { { value = "Volume", label = "Volum" }, { value = "Surface", label = "Suprafață" } },
				data.ShapeStyle, function(v)
					self:set(element, { ShapeStyle = v })
				end)
			UI.segmented(UI.row(body, "Sens"), { { value = "Outward", label = "Afară" }, { value = "Inward", label = "Înăuntru" },
				{ value = "InAndOut", label = "Ambele" } }, data.ShapeInOut, function(v)
				self:set(element, { ShapeInOut = v })
			end)
		end
		UI.dropdown(UI.row(body, "Direcție"), DIRECTIONS, data.EmissionDirection, function(v)
			self:set(element, { EmissionDirection = v })
		end)
		self:renderTimeline(parent, element, data)
	elseif kind == "MESH" then
		self:renderMesh(parent, element, data)
		self:renderTimeline(parent, element, data)
	elseif kind == "LIGHT" then
		body = UI.section(parent, "Lumină", { key = "vfx.light" })
		UI.color(UI.row(body, "Culoare"), data.Color, function(c)
			self:set(element, { Color = c })
		end)
		single(self, body, "Luminozitate", data.Brightness, element, "Brightness", { min = 0, step = 0.5, decimals = 2 })
		single(self, body, "Rază", data.Range, element, "Range", { min = 0, max = 60, step = 1, decimals = 1 })
		UI.toggle(UI.hstack(body), data.Shadows, function(v)
			self:set(element, { Shadows = v })
		end, "Umbre")
		body = UI.section(parent, "Chei (luminozitate în timp)", { key = "vfx.keys" })
		local keys = data.keys
		if #keys == 0 then
			UI.label(body, "Fără chei: lumina stă constantă.", { dim = true, size = 12 })
		end
		for i, k in keys do
			local area = UI.row(body, "Cheia " .. i, { labelWidth = 52 })
			for j = 1, 3 do
				UI.number(area, k[j], function(v)
					local copy = table.clone(keys)
					copy[i] = table.clone(k)
					copy[i][j] = v
					self:set(element, { keys = copy })
				end, { min = 0, step = j == 1 and 0.05 or 0.5, decimals = 2, tip = ({ "timp (s)", "luminozitate", "rază" })[j] })
			end
			UI.button(area, "×", function()
				local copy = table.clone(keys)
				table.remove(copy, i)
				self:set(element, { keys = copy })
			end, { width = 24, style = "ghost" })
		end
		UI.label(body, "timp (s) · luminozitate · rază", { dim = true, size = 11 })
		UI.button(UI.hstack(body), "+ Cheie", function()
			local copy = table.clone(keys)
			local last = keys[#keys]
			table.insert(copy, { last and last[1] + 0.1 or 0, data.Brightness, data.Range })
			self:set(element, { keys = copy })
		end)
	elseif kind == "TRAIL" then
		body = UI.section(parent, "Trail", { key = "vfx.trail" })
		self:textureRow(body, data, element)
		self:colorRow(body, data, element)
		pair(self, body, "Transparență", { data.transparency[1], data.transparency[3] }, element, "transparency",
			{ min = 0, max = 1, step = 0.05, decimals = 2 })
		single(self, body, "Viață (s)", data.lifetime, element, "lifetime", { min = 0.01, step = 0.05, decimals = 2 })
		single(self, body, data.ground and "Lățime (pe sol)" or "Înălțime", data.height, element, "height",
			{ min = 0.05, step = 0.25, decimals = 2 })
		single(self, body, "Lățime la vârf", data.widthHead, element, "widthHead", { min = 0, max = 1, step = 0.05, decimals = 2 })
		single(self, body, "Lățime la coadă", data.widthEnd, element, "widthEnd", { min = 0, max = 1, step = 0.05, decimals = 2 })
		single(self, body, "Strălucire", data.LightEmission, element, "LightEmission", { min = 0, max = 1, step = 0.1, decimals = 2 })
		UI.toggle(UI.hstack(body), data.ground, function(v)
			self:set(element, { ground = v })
		end, "Urmă plată pe sol (urmează piciorul)")
		if data.ground then
			single(self, body, "Curgere (cicluri/s)", data.flow, element, "flow", { min = 0, max = 6, step = 0.1, decimals = 2 })
			single(self, body, "Ridicare (studs)", data.lift, element, "lift", { min = 0, max = 0.3, step = 0.005, decimals = 3 })
		end
		self:renderTimeline(parent, element, data)
	end
end

function Panel:renderMesh(parent, element, data)
	local body = UI.section(parent, "Mesh 3D", { key = "vfx.mesh" })
	UI.dropdown(UI.row(body, "Mod"), MESH_MODES, data.mode, function(v)
		self:set(element, { mode = v })
	end, { menuWidth = 220 })
	local looks = UI.row(body, "Formă / material")
	UI.dropdown(looks, PART_SHAPES, data.shape, function(v)
		self:set(element, { shape = v })
	end)
	UI.dropdown(looks, MATERIALS, data.material, function(v)
		self:set(element, { material = v })
	end, { menuWidth = 150 })
	local colors = UI.row(body, "Culoare → final")
	UI.color(colors, data.color, function(c)
		self:set(element, { color = c })
	end)
	UI.color(colors, data.colorEnd or data.color, function(c)
		self:set(element, { colorEnd = c })
	end)
	vector(self, body, "Mărime", data.size, element, "size", { min = 0.02, step = 0.1, decimals = 2 })
	pair(self, body, "Creștere", data.grow, element, "grow", { min = 0, step = 0.1, decimals = 2 })
	pair(self, body, "Transparență", data.transparency, element, "transparency", { min = 0, max = 1, step = 0.05, decimals = 2 })
	pair(self, body, "Viață (s)", data.lifetime, element, "lifetime", { min = 0.02, step = 0.05, decimals = 2 })
	single(self, body, "Rată / s", data.Rate, element, "rate", { min = 0, step = 5, decimals = 1 })
	if data.mode == "Ring" or data.mode == "Crack" then
		single(self, body, "Segmente", data.count, element, "count", { min = 1, max = 64, step = 1, decimals = 0 })
		pair(self, body, data.mode == "Ring" and "Rază (început, final)" or "Lungime (min, max)", data.radius, element,
			"radius", { min = 0, step = 0.5, decimals = 2 })
	end
	if data.mode == "Puff" or data.mode == "Debris" then
		pair(self, body, "Viteză", data.speed, element, "speed", { min = 0, step = 1, decimals = 1 })
		pair(self, body, "Spread X / Y", data.spread, element, "spread", { min = 0, max = 180, step = 5, decimals = 0 })
		UI.dropdown(UI.row(body, "Direcție"), DIRECTIONS, data.direction, function(v)
			self:set(element, { direction = v })
		end)
	end
	if data.mode == "Puff" then
		single(self, body, "Urcare (studs)", data.rise, element, "rise", { step = 0.25, decimals = 2 })
	end
	if data.mode == "Debris" then
		single(self, body, "Rotire", data.spin, element, "spin", { min = 0, step = 2, decimals = 0 })
	end
	single(self, body, "Variație mărime", data.jitter, element, "jitter", { min = 0, max = 1, step = 0.05, decimals = 2 })
	UI.toggle(UI.hstack(body), data.ground, function(v)
		self:set(element, { ground = v })
	end, "Lipit de sol (găsește podeaua)")
	UI.label(body, "Piesele sunt 3D reale (Part): lumină, umbră și perspectivă adevărate.", { dim = true, size = 11, wrap = true })
end

function Panel:renderTimeline(parent, element, data)
	local body = UI.section(parent, "Timeline", { key = "vfx.timeline" })
	local w = data.window
	local area = UI.row(body, data.kind == "TRAIL" and "Activ (s)" or "Emisie (s)")
	UI.number(area, w and w[1] or 0, function(v)
		self:set(element, { window = { v, math.max(v + 0.01, w and w[2] or v + 0.3) } })
	end, { min = 0, step = 0.05, decimals = 2, tip = "de la" })
	UI.number(area, w and w[2] or 0, function(v)
		self:set(element, { window = { w and w[1] or 0, v } })
	end, { min = 0, step = 0.05, decimals = 2, tip = "până la" })
	UI.button(area, "×", function()
		self:set(element, { window = false })
	end, { width = 24, style = "ghost" })
	UI.label(body, w and string.format("emite continuu %s → %s s (Rată / s)", UI.fmt(w[1]), UI.fmt(w[2]))
		or "fără emisie continuă (doar burst-uri)", { dim = true, size = 11 })
	if data.kind ~= "PARTICLES" and data.kind ~= "MESH" then
		return
	end
	local bursts = data.bursts
	for i, b in bursts do
		local row = UI.row(body, "Burst " .. i, { labelWidth = 52 })
		UI.number(row, b[1], function(v)
			local copy = table.clone(bursts)
			copy[i] = { v, b[2] }
			self:set(element, { bursts = copy })
		end, { min = 0, step = 0.05, decimals = 2, tip = "timp (s)" })
		UI.number(row, b[2], function(v)
			local copy = table.clone(bursts)
			copy[i] = { b[1], math.max(1, math.floor(v)) }
			self:set(element, { bursts = copy })
		end, { min = 1, step = 1, decimals = 0, tip = "câte particule" })
		UI.button(row, "×", function()
			local copy = table.clone(bursts)
			table.remove(copy, i)
			self:set(element, { bursts = copy })
		end, { width = 24, style = "ghost" })
	end
	if #bursts > 0 then
		UI.label(body, "timp (s) · câte particule", { dim = true, size = 11 })
	end
	UI.button(UI.hstack(body), "+ Burst", function()
		local copy = table.clone(bursts)
		local last = bursts[#bursts]
		table.insert(copy, { last and last[1] + 0.1 or 0, last and last[2] or 20 })
		self:set(element, { bursts = copy })
	end)
end

return Panel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">AnimPanel</string><ProtectedString name="Source"><![CDATA[-- LostCube > Animations tab: preview any KeyframeSequence on a rig in Edit mode, Moon-style easing on
-- keyframes, effects played on animation markers, and animations generated by code (AnimGen) that the user owns.
local RunService = game:GetService("RunService")
local Selection = game:GetService("Selection")
local Players = game:GetService("Players")
local KeyframeSequenceProvider = game:GetService("KeyframeSequenceProvider")
local ChangeHistoryService = game:GetService("ChangeHistoryService")

local UI = require(script.Parent.UI)
local AnimGen = require(script.Parent.AnimGen)
local C = UI.C

local Panel = {}
Panel.__index = Panel

local STYLES = { "Linear", "Constant", "Cubic", "Bounce", "Elastic" }
local DIRECTIONS = { { value = "In", label = "In" }, { value = "Out", label = "Out" }, { value = "InOut", label = "InOut" } }
local SEARCH = { "Workspace", "ReplicatedStorage", "ServerStorage", "StarterPlayer", "StarterPack", "Lighting" }

function Panel.new(ctx)
	return setmetatable({ ctx = ctx, Editor = ctx.Editor, rig = nil, clip = nil, speed = 1, loop = true,
		picked = {}, style = "Cubic", direction = "Out", clips = nil,
		-- generator: category, chosen animation, options, rig type when no rig is chosen, unsaved preview clip
		genCat = AnimGen.CATEGORIES[1], genKey = nil, genIntensity = 1, genSpeed = 1, genMirror = false, genRig = "R15",
		genTemp = nil }, Panel)
end

function Panel:refresh()
	self.ctx.app:refresh()
end

local function record(name, fn)
	local ok, id = pcall(ChangeHistoryService.TryBeginRecording, ChangeHistoryService, "LostCube: " .. name)
	local done, err = pcall(fn)
	if ok and id then
		ChangeHistoryService:FinishRecording(id, done and Enum.FinishRecordingOperation.Commit or Enum.FinishRecordingOperation.Cancel)
	end
	if done then
		pcall(function()
			require(script.Parent.Editor).log(name)
		end)
	end
	return done, err
end

-- ---------------------------------------------------------------------------------------------
-- rig + clips
-- ---------------------------------------------------------------------------------------------
-- the effect played on a marker is kept on the clip as an attribute; attribute names only take letters, digits
-- and _ , so a marker called "Hit 1" or "Hit-1" would fail silently without this
local function fxAttr(marker)
	return "LC_FX_" .. (marker:gsub("[^%w_]", "_"))
end

local function animatorOf(rig)
	local owner = rig:FindFirstChildOfClass("Humanoid") or rig:FindFirstChildOfClass("AnimationController")
	if not owner then
		return nil
	end
	local animator = owner:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = owner
	end
	return animator
end

local function rigType(rig)
	local h = rig and rig:FindFirstChildOfClass("Humanoid")
	if h then
		return h.RigType == Enum.HumanoidRigType.R15 and "R15" or "R6"
	end
	return rig and (rig:FindFirstChild("UpperTorso") and "R15" or "R6") or "-"
end

function Panel:findClips()
	local list = {}
	for _, name in SEARCH do
		local ok, service = pcall(game.GetService, game, name)
		if ok and service then
			for _, d in service:GetDescendants() do
				if d:IsA("KeyframeSequence") then
					table.insert(list, d)
				end
			end
		end
	end
	table.sort(list, function(a, b)
		local pa, pb = a.Parent and a.Parent:GetFullName() or "", b.Parent and b.Parent:GetFullName() or ""
		if pa ~= pb then
			return pa < pb
		end
		return a.Name:lower() < b.Name:lower()
	end)
	self.clips = list
	return list
end

function Panel:makeDummy(kind)
	self:stop()
	local done, err = record("dummy " .. kind, function()
		local model
		local desc = Instance.new("HumanoidDescription")
		local light, dark = Color3.fromRGB(214, 216, 226), Color3.fromRGB(40, 40, 48)
		desc.HeadColor, desc.LeftArmColor, desc.RightArmColor = light, light, light
		desc.LeftLegColor, desc.RightLegColor, desc.TorsoColor = dark, dark, dark
		local ok, result = pcall(Players.CreateHumanoidModelFromDescription, Players, desc, Enum.HumanoidRigType[kind])
		if ok and result then
			model = result
		else
			error("nu am putut crea dummy-ul: " .. tostring(result))
		end
		model.Name = "LostCube Dummy " .. kind
		local spot = self.Editor.previewTarget()
		local cf = typeof(spot) == "CFrame" and spot or CFrame.new(0, 0, 0)
		local root = model:FindFirstChild("HumanoidRootPart")
		local drop = kind == "R15" and (model.Humanoid.HipHeight + root.Size.Y / 2) or 3
		model:PivotTo(cf * CFrame.new(0, drop, 0))
		root.Anchored = true
		model.Parent = workspace
		self.rig = model
	end)
	if not done then
		self.error = tostring(err)
	end
	self:refresh()
end

-- ---------------------------------------------------------------------------------------------
-- playback (Edit mode: Animator:StepAnimations)
-- ---------------------------------------------------------------------------------------------
function Panel:resetPose()
	if not self.rig then
		return
	end
	for _, m in self.rig:GetDescendants() do
		if m:IsA("Motor6D") then
			m.Transform = CFrame.new()
		end
	end
end

function Panel:stop()
	if self.conn then
		self.conn:Disconnect()
		self.conn = nil
	end
	for _, c in self.markerConns or {} do
		c:Disconnect()
	end
	self.markerConns = nil
	self.playing = false
	if self.track then
		pcall(function()
			self.track:Stop(0)
			self.track:Destroy()
		end)
		self.track = nil
	end
	self:resetPose()
end

function Panel:load()
	if not (self.rig and self.clip) then
		self.error = not self.rig and "alege un rig (selecția sau un dummy)" or nil
		return nil
	end
	local animator = animatorOf(self.rig)
	if not animator then
		self.error = "rig-ul nu are Humanoid sau AnimationController"
		return nil
	end
	self:stop()
	-- a broken clip (or a rig it does not fit) shows a message in the panel instead of only an error in Output
	local okLoad, track = pcall(function()
		local anim = Instance.new("Animation")
		anim.AnimationId = KeyframeSequenceProvider:RegisterKeyframeSequence(self.clip) -- picks up the latest edits
		return animator:LoadAnimation(anim)
	end)
	if not okLoad or not track then
		self.error = "nu am putut încărca animația: " .. tostring(track):gsub("^.-:%d+: ", "")
		return nil
	end
	track.Looped = self.loop
	self.track, self.animator = track, animator
	-- effects on markers
	self.markerConns = {}
	for _, marker in self:markers() do
		local fxName = self.clip:GetAttribute(fxAttr(marker.name))
		if fxName then
			table.insert(self.markerConns, track:GetMarkerReachedSignal(marker.name):Connect(function()
				pcall(self.Editor.preview, fxName, { target = self.rig, speed = self.speed })
			end))
		end
	end
	self.conn = RunService.Heartbeat:Connect(function(dt)
		if self.track then
			self.animator:StepAnimations(dt)
			if self.timeLabel and self.timeLabel.Parent then
				self.timeLabel.Text = string.format("%.2f / %.2f s", self.track.TimePosition, self.track.Length)
			end
		end
	end)
	return track
end

function Panel:play()
	local track = self.track or self:load()
	if not track then
		self:refresh()
		return
	end
	if not track.IsPlaying then
		track:Play(0, 1, self.speed)
	end
	track:AdjustSpeed(self.speed)
	self.playing = true
	self:refresh()
end

function Panel:pause()
	if self.track then
		self.track:AdjustSpeed(0)
	end
	self.playing = false
	self:refresh()
end

function Panel:step(frames)
	local track = self.track or self:load()
	if not track then
		self:refresh()
		return
	end
	if not track.IsPlaying then
		track:Play(0, 1, 0)
	end
	track:AdjustSpeed(0)
	self.playing = false
	track.TimePosition = math.clamp(track.TimePosition + frames / 60, 0, math.max(track.Length - 1e-3, 0))
	self.animator:StepAnimations(0)
	self:refresh()
end

function Panel:destroy()
	self:stop()
end

-- ---------------------------------------------------------------------------------------------
-- generated animations (AnimGen): preview without saving, save into RBX_ANIMSAVES
-- ---------------------------------------------------------------------------------------------
function Panel:genItem()
	for _, item in AnimGen.LIST do
		if item.key == self.genKey then
			return item
		end
	end
	return nil
end

-- the rig type follows the chosen rig; without one (or for a rig without Humanoid) the R15/R6 choice
function Panel:genRigType()
	local kind = self.rig and rigType(self.rig)
	if kind == "R15" or kind == "R6" then
		return kind, true
	end
	return self.genRig, false
end

function Panel:genOptions()
	local opts = { speed = self.genSpeed, intensity = self.genIntensity, mirror = self.genMirror }
	if self.rig then
		-- hip height, leg lengths and root height of this rig: planted feet and lying poses fit it exactly
		for key, value in AnimGen.measure(self.rig) do
			opts[key] = value
		end
	end
	return opts
end

function Panel:genPreview()
	local item = self:genItem()
	if not item then
		self.error = "alege o animație din listă"
		self:refresh()
		return
	end
	if not self.rig then
		self:makeDummy(self.genRig)
		if not self.rig then
			return
		end
	end
	local kind = self:genRigType()
	local ok, kfs = pcall(AnimGen.generate, item.key, kind, self:genOptions())
	if not ok then
		self.error = "nu am putut genera animația: " .. tostring(kfs)
		self:refresh()
		return
	end
	kfs.Name = "Previzualizare: " .. kfs.Name
	self:stop()
	self.genTemp = kfs -- not parented anywhere: nothing to undo, nothing left in the place
	self.genTempRig = self.rig
	self.clip = kfs
	self.picked = {}
	local played, err = pcall(self.play, self)
	if not played then
		self.error = "previzualizarea nu a pornit: " .. tostring(err)
		self:refresh()
	end
end

-- options changed while a preview runs: show the new version right away
function Panel:genChanged()
	if self.genTemp and self.clip == self.genTemp and self.rig then
		self:genPreview()
	else
		self:refresh()
	end
end

function Panel:genSave()
	local item = self:genItem()
	if not item then
		self.error = "alege o animație din listă"
		self:refresh()
		return
	end
	local kind = self:genRigType()
	local ok, result = pcall(function()
		return AnimGen.save(AnimGen.generate(item.key, kind, self:genOptions()), self.rig)
	end)
	if not ok then
		self.error = "nu am putut salva: " .. tostring(result)
		self:refresh()
		return
	end
	pcall(function()
		self.Editor.log("animație generată: " .. result:GetFullName())
	end)
	self:stop()
	self.genTemp = nil
	self:findClips() -- the list is cached
	self.clip = result -- easing, markers and effects on markers apply to it right away
	self.picked = {}
	self.genSaved = result:GetFullName()
	self:refresh()
end

-- a labelled slider with a number box; onCommit runs once, when the drag ends or the box is edited
local function slider(parent, text, value, opts, onCommit)
	local min, max, step = opts.min, opts.max, opts.step
	local row = UI.make("Frame", { Parent = parent, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, UI.H) })
	UI.label(row, text, { width = UI.LABEL_W, dim = true, size = 12 })
	local boxW = 48
	local hit = UI.make("TextButton", { Parent = row, Text = "", AutoButtonColor = false, BackgroundTransparency = 1,
		Position = UDim2.fromOffset(UI.LABEL_W + 6, 0), Size = UDim2.new(1, -(UI.LABEL_W + 6 + boxW + 8), 1, 0) })
	local track = UI.make("Frame", { Parent = hit, BackgroundColor3 = C.input, AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.5), Size = UDim2.new(1, 0, 0, 6) }, { UI.corner(3), UI.stroke(C.border) })
	local fill = UI.make("Frame", { Parent = track, BackgroundColor3 = C.accent, Size = UDim2.fromScale(0, 1) }, { UI.corner(3) })
	local knob = UI.make("Frame", { Parent = track, BackgroundColor3 = C.text, AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(12, 12) }, { UI.corner(6) })
	local current = value
	local box
	local function show(v)
		local f = math.clamp((v - min) / (max - min), 0, 1)
		fill.Size = UDim2.fromScale(f, 1)
		knob.Position = UDim2.fromScale(f, 0.5)
		if box and not box:IsFocused() then
			box.Text = UI.fmt(v, 2)
		end
	end
	local function fromX(x)
		local f = math.clamp((x - hit.AbsolutePosition.X) / math.max(hit.AbsoluteSize.X, 1), 0, 1)
		current = math.clamp(math.floor((min + f * (max - min)) / step + 0.5) * step, min, max)
		show(current)
	end
	local dragging = false
	local function finish()
		if dragging then
			dragging = false
			if current ~= value then
				onCommit(current)
			end
		end
	end
	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			fromX(input.Position.X)
		end
	end)
	hit.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			fromX(input.Position.X)
		end
	end)
	hit.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			finish()
		end
	end)
	hit.MouseLeave:Connect(finish)
	box = UI.number(row, value, function(v)
		current = v
		show(v)
		onCommit(v)
	end, { min = min, max = max, step = step, decimals = 2, width = boxW, tip = opts.tip })
	box.Position = UDim2.new(1, -boxW, 0, 0)
	show(value)
	return row
end

-- ---------------------------------------------------------------------------------------------
-- keyframes / markers
-- ---------------------------------------------------------------------------------------------
function Panel:keyframes()
	local list = self.clip and self.clip:GetKeyframes() or {}
	table.sort(list, function(a, b)
		return a.Time < b.Time
	end)
	return list
end

function Panel:markers()
	local out = {}
	for _, kf in self:keyframes() do
		for _, m in kf:GetMarkers() do
			table.insert(out, { name = m.Name, time = kf.Time, marker = m })
		end
	end
	return out
end

local function firstPose(kf)
	for _, d in kf:GetDescendants() do
		if d:IsA("Pose") and d.Weight > 0 then
			return d
		end
	end
	return nil
end

function Panel:applyEasing()
	local picked = {}
	for kf in self.picked do
		if kf.Parent == self.clip then
			table.insert(picked, kf)
		end
	end
	if #picked == 0 then
		self.error = "alege întâi cadrele (click pe ele)"
		self:refresh()
		return
	end
	local style, direction = Enum.PoseEasingStyle[self.style], Enum.PoseEasingDirection[self.direction]
	local done, err = record(string.format("easing %s %s pe %d cadre (%s)", self.style, self.direction, #picked, self.clip.Name), function()
		for _, kf in picked do
			for _, pose in kf:GetDescendants() do
				if pose:IsA("Pose") then
					pose.EasingStyle = style
					pose.EasingDirection = direction
				end
			end
		end
	end)
	self.error = not done and tostring(err) or nil
	self:stop() -- the next play re-registers the clip with the new easing
	self:refresh()
end

function Panel:addMarker(name)
	if not (self.clip and self.track) then
		self.error = "pornește sau pune animația pe un cadru întâi"
		self:refresh()
		return
	end
	local t = self.track.TimePosition
	local done, err = record("marker " .. name .. " pe " .. self.clip.Name, function()
		local target
		for _, kf in self:keyframes() do
			if math.abs(kf.Time - t) < 1 / 120 then
				target = kf
			end
		end
		if not target then
			target = Instance.new("Keyframe")
			target.Name = name
			target.Time = math.floor(t * 60 + 0.5) / 60
			target.Parent = self.clip
		end
		local m = Instance.new("KeyframeMarker")
		m.Name = name
		target:AddMarker(m)
	end)
	self.error = not done and tostring(err) or nil
	self:stop()
	self:refresh()
end

-- ---------------------------------------------------------------------------------------------
-- render
-- ---------------------------------------------------------------------------------------------
function Panel:renderGenerator(parent)
	local body = UI.section(parent, "Generează animații (gratis, ale tale)", { key = "anim.gen" })
	UI.label(body, "Create din cod direct în joc, deci sunt ale tale și pornesc în jocul tău (animațiile urcate "
		.. "de alții nu pornesc). Le poți edita apoi în Animation Editor.", { dim = true, size = 11, wrap = true })
	if self.genSaved then
		UI.note(body, "✓ Salvată în " .. self.genSaved .. " și aleasă mai jos.", C.good)
		self.genSaved = nil
	end

	local cats = {}
	for _, c in AnimGen.CATEGORIES do
		table.insert(cats, { value = c, label = c })
	end
	UI.segmented(body, cats, self.genCat, function(v)
		self.genCat = v
		self:refresh()
	end)
	local list = UI.vstack(body, 3)
	for _, item in AnimGen.LIST do
		if item.category == self.genCat then
			local markers = #item.markers > 0 and ("  ◆" .. #item.markers) or ""
			UI.item(list, item.label, { icon = item.looped and "↻" or "✦", selected = item.key == self.genKey, height = 24,
				note = string.format("%.2fs%s", item.length / self.genSpeed, markers),
				onClick = function()
					self.genKey = item.key
					self:genChanged()
				end })
		end
	end
	local item = self:genItem()
	if item then
		local times = {}
		for _, m in item.markers do
			table.insert(times, string.format("%s %.2fs", m.name, m.time / self.genSpeed))
		end
		UI.label(body, item.hint .. (#times > 0 and ("\n◆ " .. table.concat(times, "  ·  ")) or "")
			.. (item.looped and "\n↻ în buclă" or ""), { dim = true, size = 11, wrap = true })
	end

	local kind, fromRig = self:genRigType()
	if fromRig then
		UI.label(UI.row(body, "Rig"), kind .. "  (" .. self.rig.Name .. ")", { size = 12 })
	else
		UI.segmented(UI.row(body, "Rig"), { { value = "R15", label = "R15" }, { value = "R6", label = "R6" } }, self.genRig,
			function(v)
				self.genRig = v
				self:refresh()
			end)
	end
	slider(body, "Intensitate", self.genIntensity, { min = 0.3, max = 1.6, step = 0.05,
		tip = "cât de ample sunt mișcările (1 = normal)" }, function(v)
		self.genIntensity = v
		self:genChanged()
	end)
	slider(body, "Viteză", self.genSpeed, { min = 0.5, max = 2, step = 0.05,
		tip = "durata: 2 = de două ori mai rapidă" }, function(v)
		self.genSpeed = v
		self:genChanged()
	end)
	UI.toggle(UI.hstack(body), self.genMirror, function(v)
		self.genMirror = v
		self:genChanged()
	end, "⇄ Oglindită (stânga ↔ dreapta)")
	UI.button(UI.hstack(body, { height = 28 }), "▶  Previzualizează", function()
		self:genPreview()
	end, { style = "primary", bold = true, height = 28,
		tip = self.rig and "o redă pe rig fără să o salveze" or "creează un dummy și o redă pe el, fără să o salveze" })
	UI.button(UI.hstack(body, { height = 28 }), "💾  Salvează în RBX_ANIMSAVES", function()
		self:genSave()
	end, { height = 28, tip = "ServerStorage.RBX_ANIMSAVES." .. (self.rig and self.rig.Name or "LostCube")
		.. ", unde o găsește Animation Editor" })
	UI.note(body, "<b>Ca s-o folosești în joc:</b> Avatar → Animation Editor, alege rig-ul, ⋯ → Load → animația, apoi "
		.. "⋯ → Publish to Roblox (pe contul sau grupul care deține jocul). Pune ID-ul primit în Animation.AnimationId.")
end

function Panel:render(parent)
	if self.rig and not self.rig.Parent then
		self:stop()
		self.rig = nil
	end
	if self.genTemp and self.clip == self.genTemp and self.genTempRig ~= self.rig then
		-- an unsaved preview was made for the previous rig (maybe another rig type)
		self:stop()
		self.clip, self.genTemp = nil, nil
	end
	if self.error then
		UI.note(parent, "⚠ " .. self.error, C.warn)
		self.error = nil
	end

	-- rig
	local body = UI.section(parent, "Rig de previzualizare", { key = "anim.rig" })
	UI.label(body, self.rig and (self.rig.Name .. "  (" .. rigType(self.rig) .. ")") or "Niciun rig ales", { medium = true })
	UI.button(UI.hstack(body), "Folosește personajul selectat", function()
		local sel = Selection:Get()[1]
		local model = sel and (sel:IsA("Model") and sel or sel:FindFirstAncestorWhichIsA("Model"))
		if model and (model:FindFirstChildOfClass("Humanoid") or model:FindFirstChildOfClass("AnimationController")) then
			self:stop()
			self.rig = model
		else
			self.error = "selectează un personaj (Model cu Humanoid)"
		end
		self:refresh()
	end)
	local bar = UI.hstack(body)
	UI.button(bar, "+ Dummy R6", function()
		self:makeDummy("R6")
	end)
	UI.button(bar, "+ Dummy R15", function()
		self:makeDummy("R15")
	end)

	self:renderGenerator(parent)

	-- clips
	local clips = self.clips or self:findClips()
	body = UI.section(parent, "Animații  (" .. #clips .. ")", { key = "anim.clips", right = function(r)
		UI.button(r, "🔁", function()
			self:findClips()
			self:refresh()
		end, { width = 34, height = 22, style = "ghost" })
	end, rightWidth = 38 })
	local list = UI.scrollList(body, self.clip and 200 or 420)
	local lastGroup
	for _, clip in clips do
		if clip.Parent then
			local group = clip.Parent:GetFullName():gsub("^Workspace%.", ""):gsub("^ReplicatedStorage%.", "")
			if group ~= lastGroup then
				UI.label(list, group, { dim = true, size = 11, height = 18 })
				lastGroup = group
			end
			local kfs = clip:GetKeyframes()
			local length = 0
			for _, kf in kfs do
				length = math.max(length, kf.Time)
			end
			UI.item(list, clip.Name, { icon = "►", selected = clip == self.clip, note = string.format("%.2fs", length),
				onClick = function()
					self:stop()
					self.clip = clip
					self.picked = {}
					self:refresh()
				end })
		end
	end
	if #clips == 0 then
		UI.note(body, "Nicio animație (KeyframeSequence) în joc.")
	end
	if not self.clip then
		return
	end
	local clip = self.clip

	-- playback
	body = UI.section(parent, "Redare: " .. clip.Name, { key = "anim.play" })
	if not self.rig then
		UI.note(body, "Alege un rig (selecția sau un dummy) ca să vezi animația.")
	end
	local controls = UI.hstack(body, { height = 28 })
	UI.button(controls, self.playing and "⏸ Pauză" or "▶  Redă", function()
		if self.playing then
			self:pause()
		else
			self:play()
		end
	end, { style = "primary", bold = true, height = 28 })
	UI.button(controls, "◀", function()
		self:step(-1)
	end, { width = 30, height = 28 })
	UI.button(controls, "▶", function()
		self:step(1)
	end, { width = 30, height = 28 })
	UI.button(controls, "⏹", function()
		self:stop()
		self.playing = false
		self:refresh()
	end, { width = 30, height = 28 })
	self.timeLabel = UI.label(body, self.track and string.format("%.2f / %.2f s", self.track.TimePosition, self.track.Length)
		or "-", { dim = true, size = 12 })
	UI.segmented(UI.row(body, "Viteză"), {
		{ value = 0.25, label = "×0.25" }, { value = 0.5, label = "×0.5" }, { value = 1, label = "×1" }, { value = 2, label = "×2" },
	}, self.speed, function(v)
		self.speed = v
		if self.track and self.playing then
			self.track:AdjustSpeed(v)
		end
		self:refresh()
	end)
	UI.toggle(UI.hstack(body), self.loop, function(v)
		self.loop = v
		if self.track then
			self.track.Looped = v
		end
		self:refresh()
	end, "Repetă")
	if clip == self.genTemp then
		UI.note(body, "Previzualizare nesalvată. Salveaz-o (secțiunea „Generează animații”) ca să-i poți schimba "
			.. "easing-ul și efectele pe markere.")
		return
	end

	-- keyframes + easing
	local kfs = self:keyframes()
	body = UI.section(parent, "Cadre și easing (ca în Moon)", { key = "anim.ease" })
	local count = 0
	for _ in self.picked do
		count += 1
	end
	local sel = UI.hstack(body)
	UI.button(sel, "Toate", function()
		for _, kf in kfs do
			self.picked[kf] = true
		end
		self:refresh()
	end)
	UI.button(sel, "Niciunul", function()
		self.picked = {}
		self:refresh()
	end)
	for _, kf in kfs do
		local pose = firstPose(kf)
		local easing = pose and (pose.EasingStyle.Name .. " " .. pose.EasingDirection.Name) or "-"
		local markers = #kf:GetMarkers() > 0 and ("  ◆ " .. kf:GetMarkers()[1].Name) or ""
		UI.item(body, string.format("%.2fs  %s%s", kf.Time, kf.Name, markers), {
			icon = self.picked[kf] and "■" or "□", selected = self.picked[kf] == true, note = easing, height = 24,
			onClick = function()
				self.picked[kf] = not self.picked[kf] or nil
				self:refresh()
			end })
	end
	local grid = UI.hstack(body)
	for i, style in STYLES do
		if i == 4 then
			grid = UI.hstack(body)
		end
		UI.button(grid, style, function()
			self.style = style
			self:refresh()
		end, { selected = self.style == style, textSize = 12 })
	end
	UI.segmented(UI.row(body, "Direcție"), DIRECTIONS, self.direction, function(v)
		self.direction = v
		self:refresh()
	end)
	UI.button(UI.hstack(body, { height = 28 }), string.format("Aplică pe %d cadre", count), function()
		self:applyEasing()
	end, { style = "primary", bold = true, height = 28 })
	UI.label(body, "Easing-ul unui cadru = mișcarea de la el spre următorul.", { dim = true, size = 11, wrap = true })

	-- effects on markers
	body = UI.section(parent, "Efecte pe markere", { key = "anim.fx" })
	local effectItems = { { value = "", label = "(niciun efect)" } }
	for _, fx in self.Editor.effects() do
		table.insert(effectItems, { value = fx.Name, label = fx.Name })
	end
	local markers = self:markers()
	if #markers == 0 then
		UI.label(body, "Animația nu are markere.", { dim = true, size = 12 })
	end
	for _, m in markers do
		UI.dropdown(UI.row(body, string.format("◆ %s (%.2fs)", m.name, m.time), { labelWidth = 130 }), effectItems,
			clip:GetAttribute(fxAttr(m.name)) or "", function(v)
				local done, err = record("efect " .. (v ~= "" and v or "-") .. " pe markerul " .. m.name, function()
					clip:SetAttribute(fxAttr(m.name), v ~= "" and v or nil)
				end)
				self.error = not done and tostring(err) or nil
				self:stop()
				self:refresh()
			end, { menuWidth = 180 })
	end
	local add = UI.hstack(body)
	local box = UI.textbox(add, "", nil, { placeholder = "nume marker (ex. Hit)" })
	UI.button(add, "+ Marker aici", function()
		if box.Text ~= "" then
			self:addMarker(box.Text)
		end
	end, { width = 110 })
	UI.label(body, "În joc: VFX.bindMarkers(track, personaj, { Hit = \"NumeEfect\" })", { dim = true, size = 11, wrap = true })
end

return Panel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">ClaudePanel</string><ProtectedString name="Source"><![CDATA[-- LostCube > Claude tab: chat with Claude about this game (Anthropic API, your own key), the key / model settings,
-- the modules Claude needs in the game, and what was done with LostCube.
local UI = require(script.Parent.UI)
local Installer = require(script.Parent.Installer)
local AI = require(script.Parent.AI)
local Markdown = require(script.Parent.Markdown)
local C = UI.C

local Panel = {}
Panel.__index = Panel

local CONTEXT_CHARS = 60000 -- game analysis sent with every question (cached by the API after the first one)
local CHAT_HEIGHT = 440

local QUICK = {
	{ label = "Ce efecte VFX i se potrivesc jocului?", prompt = "Ce efecte VFX i se potrivesc jocului? Ține cont de genul "
		.. "jocului, de paleta de culori a hărții și de lumini. Propune 3–5 efecte concrete (nume, când se declanșează, "
		.. "unde se prind, culori hex, ce preseturi LostCube combin) și dă-mi codul Luau cu Editor-ul LostCube pentru cel "
		.. "mai important." },
	{ label = "Ce animații lipsesc?", prompt = "Ce animații lipsesc din joc? Uită-te la personaje, NPC-uri, arme și "
		.. "animațiile existente și spune-mi ce să adaug, în ordinea priorității, cu timing și easing pentru fiecare "
		.. "(îl reglez în tab-ul 🎬 Anim din LostCube) și ce efecte să pun pe markerele lor." },
	{ label = "Găsește probleme de securitate", prompt = "Verifică securitatea jocului: posibile backdoor-uri (require "
		.. "cu ID de asset, getfenv / loadstring, cod ofuscat, scripturi din modele gratuite sau din locuri neobișnuite) și "
		.. "RemoteEvent-uri / RemoteFunction-uri care au încredere în client. Pentru fiecare: calea exactă, de ce e "
		.. "riscant și cum repar, cu cod pentru verificările pe server." },
	{ label = "Plan de upgrade în 10 pași", prompt = "Fă-mi un plan de upgrade în 10 pași pentru joc, ordonat după "
		.. "impact și efort. Pentru fiecare pas: ce schimb, unde (căi exacte), cu ce unealtă (inclusiv LostCube) și ce "
		.. "rezultat se vede în joc." },
}

local function trim(s: string): string
	return (string.gsub(s, "^%s+", ""):gsub("%s+$", ""))
end

local function now(): number
	local ok, t = pcall(function()
		return DateTime.now().UnixTimestampMillis / 1000
	end)
	return ok and t or os.time()
end

-- the stored game analysis (Analyzer is optional: older builds / not scanned yet -> nil)
local function analyzer()
	local ok, module = pcall(function()
		return require(script.Parent:FindFirstChild("Analyzer"))
	end)
	return ok and type(module) == "table" and module or nil
end

local function storedReport()
	local Analyzer = analyzer()
	if not Analyzer or type(Analyzer.load) ~= "function" then
		return nil
	end
	local ok, report = pcall(Analyzer.load)
	return ok and report or nil
end

local function gameContext(): string?
	local Analyzer = analyzer()
	local report = storedReport()
	if not report or type(Analyzer.context) ~= "function" then
		return nil
	end
	local ok, text = pcall(Analyzer.context, report, CONTEXT_CHARS)
	return (ok and type(text) == "string" and text ~= "") and text or nil
end

-- what changes during a chat (sent after the cached part): the LostCube effects and the Studio selection
local function liveState(Editor): string
	local lines = {}
	local ok, effects = pcall(Editor.describe)
	if ok and type(effects) == "table" and #effects > 0 then
		table.insert(lines, "Efecte LostCube în ReplicatedStorage.LostCube.Effects:")
		for i, fx in effects do
			if i > 40 then
				table.insert(lines, string.format("- … încă %d", #effects - 40))
				break
			end
			local els = {}
			for _, e in fx.elements or {} do
				table.insert(els, string.format("%s [%s%s]", e.name, tostring(e.kind), e.preset and (", " .. e.preset) or ""))
			end
			table.insert(lines, string.format("- %s (%s s, %s): %s", fx.name, tostring(fx.duration or "?"),
				tostring(fx.attach or "?"), #els > 0 and table.concat(els, "; ") or "fără elemente"))
		end
	else
		table.insert(lines, "Nu există încă efecte LostCube în joc.")
	end
	local okSel, selection = pcall(function()
		return game:GetService("Selection"):Get()
	end)
	if okSel and type(selection) == "table" and #selection > 0 then
		local names = {}
		for i, inst in selection do
			if i > 10 then
				break
			end
			local okName, full = pcall(function()
				return inst:GetFullName() .. " (" .. inst.ClassName .. ")"
			end)
			table.insert(names, okName and full or "?")
		end
		table.insert(lines, "Selecția din Explorer: " .. table.concat(names, ", "))
	end
	local text = table.concat(lines, "\n")
	-- the cut drops a partial multi-byte character at the end (invalid UTF-8 would break the JSON of the request)
	return #text > 6000 and (string.gsub(string.sub(text, 1, 6000), "[\192-\255][\128-\191]*$", "") .. "\n…") or text
end

-- a growing multi-line text box (the UI kit only has single-line ones)
local function multiline(parent: Instance, text: string, placeholder: string)
	return UI.make("TextBox", { Parent = parent, Text = text or "", PlaceholderText = placeholder, Font = UI.FONT,
		TextSize = 13, TextColor3 = C.text, PlaceholderColor3 = C.dim, BackgroundColor3 = C.input, ClearTextOnFocus = false,
		MultiLine = true, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top, Size = UDim2.new(1, 0, 0, 60), AutomaticSize = Enum.AutomaticSize.Y },
		{ UI.corner(4), UI.stroke(C.border), UI.pad(6, 8, 6, 8) })
end

function Panel.new(ctx)
	return setmetatable({ ctx = ctx, Editor = ctx.Editor, plugin = ctx.plugin, messages = {}, draft = "", busy = false,
		gen = 0 }, Panel)
end

function Panel:refresh()
	self.ctx.app:refresh()
end

function Panel:render(parent)
	local key = AI.getKey(self.plugin)
	self:renderKey(parent, key)
	self:renderChat(parent, key ~= nil)
	self:renderModules(parent)
	self:renderLog(parent)
	self:renderAbout(parent)
end

-- ---------------------------------------------------------------------------------------------
-- API key, model, effort
-- ---------------------------------------------------------------------------------------------
function Panel:saveKey(text)
	local key = string.gsub(text or "", "%s", "")
	if key == "" or key == AI.getKey(self.plugin) then
		return
	end
	if not AI.setKey(self.plugin, key) then
		self.keyStatus = { "Nu am putut salva cheia (setările merg doar când LostCube rulează ca plugin).", C.danger }
	elseif AI.looksLikeKey(key) then
		self.keyStatus = { "Cheie salvată doar pe calculatorul tău.", C.good }
	else
		self.keyStatus = { "Cheie salvată, dar nu arată ca o cheie Anthropic (cheile încep cu „sk-ant-”).", C.warn }
	end
	self.editingKey = false
	self.testStatus = nil
	self:refresh()
end

function Panel:test()
	if self.testing then
		return
	end
	self.testing = true
	self.testStatus = { "Se testează… (prima dată Studio îți poate cere permisiunea pentru api.anthropic.com)", C.dim }
	self:refresh()
	task.spawn(function()
		local ok, message = AI.test(self.plugin)
		self.testing = false
		self.testStatus = { message, ok and C.good or C.danger }
		if not self.destroyed then
			self:refresh()
		end
	end)
end

function Panel:renderKey(parent, key: string?)
	local body = UI.section(parent, "Cheie API Anthropic", { key = "claude.key", collapsed = key ~= nil })
	if key and not self.editingKey then
		local area = UI.row(body, "Cheie salvată")
		UI.label(area, AI.mask(key), { size = 12, color = C.good })
		UI.button(area, "Schimbă", function()
			self.editingKey = true
			self:refresh()
		end, { width = 66 })
		UI.button(area, "Șterge", function()
			AI.setKey(self.plugin, nil)
			self.keyStatus = { "Cheia a fost ștearsă de pe acest calculator.", C.dim }
			self.testStatus = nil
			self:refresh()
		end, { width = 58, style = "danger" })
	else
		-- the key is never shown: the box text is hidden and a mask is drawn over it
		local area = UI.hstack(body, { height = UI.H })
		local box = UI.textbox(area, "", function(text)
			self:saveKey(text)
		end)
		box.TextTransparency = 1
		local mask = UI.make("TextLabel", { Parent = box, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1),
			Font = UI.FONT, TextSize = 13, TextColor3 = C.dim, TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd, Text = "lipește cheia aici (sk-ant-…)" })
		box:GetPropertyChangedSignal("Text"):Connect(function()
			local n = #box.Text
			mask.Text = n == 0 and "lipește cheia aici (sk-ant-…)" or (string.rep("•", math.min(n, 18)) .. "  " .. n .. " caractere")
			mask.TextColor3 = n == 0 and C.dim or C.text
		end)
		UI.button(area, "Salvează", function()
			self:saveKey(box.Text)
		end, { width = 72, style = "primary" })
		if key then
			UI.button(area, "×", function()
				self.editingKey = false
				self:refresh()
			end, { width = 26, style = "ghost", tip = "Păstrează cheia salvată" })
		end
	end
	if self.keyStatus then
		UI.label(body, self.keyStatus[1], { size = 12, wrap = true, color = self.keyStatus[2] })
	end

	local models = {}
	for _, m in AI.MODELS do
		table.insert(models, { value = m.id, label = m.label })
	end
	UI.dropdown(UI.row(body, "Model"), models, AI.getModel(self.plugin), function(id)
		AI.setModel(self.plugin, id)
		self:refresh()
	end, { menuWidth = 250 })
	UI.segmented(UI.row(body, "Efort"), AI.EFFORTS, AI.getEffort(self.plugin), function(value)
		AI.setEffort(self.plugin, value)
		self:refresh()
	end)
	UI.button(UI.hstack(body, { height = 26 }), self.testing and "Se testează…" or "Testează conexiunea", function()
		self:test()
	end, { height = 26, tip = "O cerere foarte mică: verifică cheia, modelul și permisiunea HTTP" })
	if self.testStatus then
		UI.label(body, self.testStatus[1], { size = 12, wrap = true, color = self.testStatus[2] })
	end
	UI.note(body, "Cheia o iei de pe <b>console.anthropic.com</b> → <b>API Keys</b>. Cererile se plătesc din contul tău "
		.. "Anthropic (Opus e cel mai scump, Haiku cel mai ieftin; efortul „Atent” folosește mai mulți tokeni). "
		.. "Cheia rămâne doar în setările pluginului pe acest calculator: nu se salvează în joc și nu ajunge la "
		.. "colaboratori.")
	UI.note(body, "La prima cerere Studio întreabă dacă LostCube are voie să acceseze <b>api.anthropic.com</b>: alege "
		.. "<b>Allow</b>. Dacă ai refuzat: Plugins → Manage Plugins → LostCube → permisiuni.")
end

-- ---------------------------------------------------------------------------------------------
-- chat
-- ---------------------------------------------------------------------------------------------
-- previous turns that got an answer (failed questions and errors are not sent back)
function Panel:history()
	local out = {}
	for _, m in self.messages do
		if not m.error and not m.failed then
			table.insert(out, { role = m.role, content = m.content })
		end
	end
	return out
end

function Panel:send(text: string?, fromInput: boolean?)
	text = trim(text or "")
	if text == "" or self.busy then
		return
	end
	if not AI.getKey(self.plugin) then
		self.chatNote = { "Pune întâi cheia API în secțiunea „Cheie API Anthropic”.", C.warn }
		self:redrawChat()
		return
	end
	self.chatNote = nil
	local history = self:history()
	local question = { role = "user", content = text }
	table.insert(self.messages, question)
	if fromInput then
		self.draft = ""
		if self.input and self.input.Parent then
			self.input.Text = ""
		end
	end
	self.busy = true
	self.gen += 1
	local gen = self.gen
	self.startedAt = now()
	self.waitText = "Claude scrie…"
	self:redrawChat()
	task.spawn(function() -- ticking "Claude scrie… 12 s"
		while self.busy and self.gen == gen and not self.destroyed do
			local label = self.waitLabel
			if label and label.Parent then
				label.Text = string.format("◆  %s  %d s", self.waitText or "Claude scrie…", math.floor(now() - self.startedAt))
			end
			task.wait(0.5)
		end
	end)
	task.spawn(function()
		local ok, answer, info = AI.ask(self.plugin, text, history, gameContext(), {
			live = liveState(self.Editor),
			onStatus = function(status)
				if self.gen == gen then
					self.waitText = status
				end
			end,
		})
		if self.gen ~= gen or self.destroyed then -- cleared while waiting
			return
		end
		self.busy = false
		if ok then
			table.insert(self.messages, { role = "assistant", content = answer, info = info })
			self.lastInfo = info
		else
			question.failed = true
			table.insert(self.messages, { role = "assistant", content = answer, error = true, question = text })
		end
		self:redrawChat()
	end)
end

-- sends a failed question again (the failed pair leaves the conversation)
function Panel:retry(index: number)
	local m = self.messages[index]
	if not m or not m.error or self.busy then
		return
	end
	table.remove(self.messages, index)
	local prev = self.messages[index - 1]
	if prev and prev.failed then
		table.remove(self.messages, index - 1)
	end
	self:send(m.question)
end

function Panel:clear()
	self.gen += 1 -- an answer still on its way is dropped
	self.busy = false
	self.messages = {}
	self.lastInfo = nil
	self.chatNote = nil
	self:redrawChat()
end

function Panel:messageView(list: Instance, m, index: number)
	if m.role == "user" then
		local frame = UI.make("Frame", { Parent = list, BackgroundColor3 = C.accentDark, BackgroundTransparency = 0.25,
			Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, { UI.corner(6), UI.pad(6, 8, 7, 8), UI.vlist(2) })
		UI.label(frame, "Tu", { size = 11, bold = true, color = C.accentHover, height = 14 })
		UI.label(frame, Markdown.escape(m.content), { wrap = true, rich = true, size = 13 })
		return
	end
	if m.error then
		local frame = UI.make("Frame", { Parent = list, BackgroundColor3 = Color3.fromRGB(58, 30, 36),
			Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, { UI.corner(6), UI.pad(6, 8, 7, 8), UI.vlist(4) })
		UI.label(frame, "⚠  Nu a mers", { size = 11, bold = true, color = C.danger, height = 14 })
		UI.label(frame, Markdown.escape(m.content), { wrap = true, rich = true, size = 12 })
		UI.button(UI.hstack(frame, { height = 24, fill = false }), "Reîncearcă", function()
			self:retry(index)
		end, { width = 96 })
		return
	end
	local frame = UI.make("Frame", { Parent = list, BackgroundColor3 = C.item, BackgroundTransparency = 0.4,
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, { UI.corner(6), UI.pad(6, 8, 8, 8), UI.vlist(4) })
	UI.label(frame, "◆  Claude", { size = 11, bold = true, color = C.accent, height = 14 })
	Markdown.render(frame, m.content)
	if m.info then -- token usage of each reply (the newest is the last reply's)
		UI.label(frame, AI.describeInfo(m.info), { size = 10, dim = true, wrap = true })
	end
end

-- rebuilds only the conversation (the input box keeps its focus and text); falls back to a full redraw
function Panel:redrawChat()
	local list = self.chatList
	if not (list and list.Parent) then
		self:refresh()
		return
	end
	for _, child in list:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	if #self.messages == 0 and not self.busy then
		UI.label(list, "Întreabă orice despre joc sau alege o întrebare de mai sus. Claude vede analiza jocului "
			.. "(tab-ul 🧠 Joc), efectele LostCube și selecția din Explorer.", { dim = true, size = 12, wrap = true })
	end
	for i, m in self.messages do
		self:messageView(list, m, i)
	end
	self.waitLabel = nil
	if self.busy then
		self.waitLabel = UI.label(list, string.format("◆  %s  %d s", self.waitText or "Claude scrie…",
			math.floor(now() - (self.startedAt or now()))), { size = 12, color = C.accentHover })
	end
	if self.chatNote then
		UI.label(list, self.chatNote[1], { size = 12, wrap = true, color = self.chatNote[2] })
	end
	if self.sendButton and self.sendButton.Parent then
		self.sendButton.Text = self.busy and "Claude scrie…" or "Trimite"
	end
	-- show the newest message
	for _, delay in { 0.05, 0.25 } do
		task.delay(delay, function()
			if list.Parent then
				list.CanvasPosition = Vector2.new(0, math.max(0, list.AbsoluteCanvasSize.Y - list.AbsoluteSize.Y))
			end
		end)
	end
end

function Panel:renderChat(parent, hasKey: boolean)
	local body = UI.section(parent, "Chat cu Claude", { key = "claude.chat" })
	local report = storedReport()
	UI.label(body, report and "✓ Claude primește analiza jocului salvată (tab-ul 🧠 Joc)."
		or "Fără analiză salvată: scanează jocul în tab-ul 🧠 Joc ca să-l cunoască Claude.",
		{ size = 12, wrap = true, color = report and C.good or C.warn })
	if not hasKey then
		UI.note(body, "Pune cheia API în secțiunea de mai sus ca să poți vorbi cu Claude.", C.warn)
	end
	for _, q in QUICK do
		UI.button(body, "›  " .. q.label, function()
			self:send(q.prompt)
		end, { height = 24, textSize = 12, align = Enum.TextXAlignment.Left })
	end

	self.chatList = UI.scrollList(body, CHAT_HEIGHT)

	local box = multiline(body, self.draft, "Întreabă ceva despre joc…  (Enter = rând nou; trimiți cu butonul)")
	box:GetPropertyChangedSignal("Text"):Connect(function()
		self.draft = box.Text
	end)
	self.input = box
	local bar = UI.hstack(body, { height = 28 })
	self.sendButton = UI.button(bar, "Trimite", function()
		self:send(box.Text, true)
	end, { style = "primary", bold = true, height = 28 })
	UI.button(bar, "Golește", function()
		self:clear()
	end, { height = 28, width = 84, tip = "Începe o conversație nouă" })
	self:redrawChat()
end

-- ---------------------------------------------------------------------------------------------
-- modules in the game, activity log, Claude Code
-- ---------------------------------------------------------------------------------------------
function Panel:renderModules(parent)
	local status = Installer.status()
	local body = UI.section(parent, "Module în joc", { key = "claude.modules" })
	UI.label(body, string.format("LostCube %s", status.version), { medium = true })
	UI.label(body, "VFX (player în joc): " .. (status.vfx or "lipsește"), { dim = true, size = 12,
		color = status.vfx == status.version and C.good or C.warn })
	UI.label(body, "Editor (pentru Claude): " .. (status.editor or "lipsește"), { dim = true, size = 12,
		color = status.editor == status.version and C.good or C.warn })
	UI.button(UI.hstack(body, { height = 28 }), status.ok and "Reinstalează modulele" or "Instalează / actualizează modulele",
		function()
			local ok, err = pcall(Installer.install)
			if not ok then
				warn("LostCube:", err)
			end
			self.ctx.app:refresh()
		end, { style = status.ok and "normal" or "primary", bold = true, height = 28 })
end

function Panel:renderLog(parent)
	local history = self.Editor.history()
	local body = UI.section(parent, "Ce s-a făcut  (" .. #history .. ")", { key = "claude.log" })
	if #history == 0 then
		UI.label(body, "Nimic încă în sesiunea asta.", { dim = true, size = 12 })
	end
	for i = #history, math.max(1, #history - 24), -1 do
		local h = history[i]
		UI.label(body, h.t .. "   " .. h.a, { size = 12, color = i == #history and C.text or C.dim })
	end
end

local EXAMPLES = {
	"„fă-mi un efect de foc pe mână când lovește”",
	"„pune easing Bounce pe aterizare”",
	"„fă scânteile mai mari și mai albastre”",
	"„un cerc magic sub personaj la teleport”",
}

function Panel:renderAbout(parent)
	local body = UI.section(parent, "Claude Code în Studio", { key = "claude.about", collapsed = true })
	UI.label(body, "Dacă folosești Claude Code conectat la Studio, Claude folosește aceleași funcții ca panourile "
		.. "LostCube (modulul ReplicatedStorage.LostCube.Editor). Spune-i în chat ce vrei, de exemplu:", { wrap = true, size = 12 })
	for _, e in EXAMPLES do
		UI.label(body, "•  " .. e, { dim = true, size = 12, wrap = true })
	end
	UI.note(body, "Fiecare pas e un singur <b>Ctrl+Z</b>. Efectele apar în tab-ul VFX imediat ce Claude le face.")
end

function Panel:destroy()
	self.destroyed = true
	self.gen += 1
end

return Panel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX7"><Properties><string name="Name">Installer</string><ProtectedString name="Source"><![CDATA[-- Puts LostCube's two modules into the game (ReplicatedStorage.LostCube):
--   VFX    - plays the effects in the game (client)
--   Editor - the same editing functions the plugin uses; Claude calls it through Studio
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ChangeHistoryService = game:GetService("ChangeHistoryService")

local Installer = {}

local function source()
	local editor = script.Parent.Editor
	return editor, editor.VFX, require(editor).VERSION
end

function Installer.status()
	local _, _, version = source()
	local root = ReplicatedStorage:FindFirstChild("LostCube")
	local editor = root and root:FindFirstChild("Editor")
	local vfx = root and root:FindFirstChild("VFX")
	local function v(inst)
		return inst and (inst:GetAttribute("LC_Version") or "?") or nil
	end
	return {
		version = version,
		editor = v(editor),
		vfx = v(vfx),
		ok = v(editor) == version and v(vfx) == version,
	}
end

function Installer.install()
	local editorSource, vfxSource, version = source()
	local ok, id = pcall(ChangeHistoryService.TryBeginRecording, ChangeHistoryService, "LostCube: instalare module")
	local root = ReplicatedStorage:FindFirstChild("LostCube")
	if not root then
		root = Instance.new("Folder")
		root.Name = "LostCube"
		root.Parent = ReplicatedStorage
	end
	if not root:FindFirstChild("Effects") then
		local effects = Instance.new("Folder")
		effects.Name = "Effects"
		effects.Parent = root
	end
	local done, err = pcall(function()
		for _, pair in { { "VFX", vfxSource }, { "Editor", editorSource } } do
			local old = root:FindFirstChild(pair[1])
			if old then
				old:Destroy()
			end
			local copy = pair[2]:Clone()
			for _, child in copy:GetChildren() do
				child:Destroy() -- the game's Editor uses the VFX next to it
			end
			copy.Name = pair[1]
			copy:SetAttribute("LC_Version", version)
			copy.Parent = root
		end
	end)
	if ok and id then
		-- a failed install is rolled back instead of leaving a half-written LostCube folder (and an open recording)
		ChangeHistoryService:FinishRecording(id, done and Enum.FinishRecordingOperation.Commit or Enum.FinishRecordingOperation.Cancel)
	end
	if not done then
		error(err, 0)
	end
	return Installer.status()
end

return Installer
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">Editor</string><ProtectedString name="Source"><![CDATA[--[[ LostCube Editor - creates and edits Roblox effects (LostCube VFX format) in Studio.
Used by the LostCube plugin's panels and by Claude (through Studio):

	local Editor = require(game.ReplicatedStorage.LostCube.Editor)
	local fx = Editor.newEffect("Boom", { duration = 0.6, attach = "GROUND" })
	local s = Editor.addElement(fx, "SPARKLES", { position = Vector3.new(0, 3, 0), bursts = { { 0.1, 40 } } })
	Editor.setProps(s, { color = { Color3.new(1, 1, 1), Color3.fromRGB(158, 92, 255) }, speed = { 18, 30 } })
	Editor.preview(fx)  -- plays it in Studio, in front of the camera (or on the selection)
	Editor.newFromTemplate("Boom 2", "FIRE_EXPLOSION", { color = Color3.fromRGB(80, 160, 255), scale = 1.5 })  -- Editor.TEMPLATES
	Editor.importAsset(123456789, "Free VFX")  -- free Creator Store model -> effect (its scripts are deleted first)
	Editor.importEmitters(fx, workspace.SomeModel)  -- the emitters / trails / lights of a model -> elements of fx

Format (the same the Blender exporter writes; LostCube.VFX plays it in the game):
	Model <effect>  attributes LC_Duration (s), LC_Attach
	  Part Root
	    Attachment <element> > ParticleEmitter / PointLight      (point emitters, lights)
	    Attachment <element>_Top / _Bottom + Trail <element>      (trails)
	  Part <element> > ParticleEmitter                            (shape emitters: the Part is the shape)
Timeline attributes (seconds) on elements: LC_On "t0,t1", LC_Bursts "t:n;t:n", LC_Keys "t,b,r;..." (lights),
LC_Muted (skipped by the player).
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local ChangeHistoryService = game:GetService("ChangeHistoryService")
local Selection = game:GetService("Selection")

local VFX = require(script:FindFirstChild("VFX") or script.Parent:WaitForChild("VFX"))

local Editor = {}
Editor.VERSION = "2.0.0"

local P = "rbxasset://textures/particles/"
-- the ground crack streak (Textures/ground_crack_trail.png), uploaded as one asset
Editor.GROUND_CRACK_URL = "rbxassetid://105887359860913" -- rotated 90 degrees: Trail maps image height along the length
-- Textures. Only paths that were checked (docs/vfx-sources.md): the particles folder of Roblox's own content (ships with every
-- client, no upload, no ownership) and the image ids Roblox itself publishes in its official VFX tutorials (creator-docs).
-- Keys stay stable (saved effects store the url, not the key); `group` is only used to organise the pickers.
local GROUP_BUILTIN = "Încorporate în Roblox (fără upload)"
local GROUP_DOCS = "Roblox oficial (ID-uri din tutoriale)"
local GROUP_OTHER = "Altele"
local function docs(id)
	return "rbxassetid://" .. id
end
Editor.TEXTURES = {
	{ key = "SPARKLES", label = "Scântei (stea)", url = P .. "sparkles_main.dds", group = GROUP_BUILTIN },
	{ key = "GLOW", label = "Glow (bilă moale)", url = P .. "explosion01_implosion_main.dds", group = GROUP_BUILTIN },
	{ key = "RING", label = "Inel (undă)", url = P .. "explosion01_shockwave_main.dds", group = GROUP_BUILTIN },
	{ key = "CIRCLE", label = "Cerc magic", url = P .. "forcefield_vortex_main.dds", group = GROUP_BUILTIN },
	{ key = "SMOKE", label = "Fum", url = P .. "smoke_main.dds", group = GROUP_BUILTIN },
	{ key = "SMOKE_SOFT", label = "Fum moale", url = P .. "explosion01_smoke_main.dds", group = GROUP_BUILTIN },
