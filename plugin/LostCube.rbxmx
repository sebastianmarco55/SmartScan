		lifetime = { 0.45, 0.8 }, speed = { 3, 7 }, spread = { 50, 40 }, direction = "Back", rise = 1.2, jitter = 0.3,
		position = Vector3.new(0, 0.3, 0), bursts = { { 0, 6 } } } },
	{ key = "GROOVE3D", label = "Șanț luminos (urmă)", kind = "MESH", props = {
