local function emoteGroup(key)
	for _, g in AnimLibrary.EMOTE_GROUPS do
		if g.key == key then
			return g
		end
	end
	return nil
end

AnimLibrary.EMOTES = {}
for _, row in EMOTE_DATA do
	local group = emoteGroup(row[1])
	table.insert(AnimLibrary.EMOTES, {
		key = row[1] .. "." .. row[2], name = row[2], label = row[3], id = row[4], looped = row[5], rig = group.rig,
		group = group.key, verified = group.verified,
	})
end

-- ---------------------------------------------------------------------------------------------
-- helpers
-- ---------------------------------------------------------------------------------------------
function AnimLibrary.url(id)
	return "rbxassetid://" .. tostring(id)
end

-- the animations of a pack in display order: { { name = "idle1", state = "idle", variant = 1, id = ... }, ... }
function AnimLibrary.statesOf(pack)
	local out = {}
	for _, state in AnimLibrary.STATES do
		local value = pack.anims[state]
		if type(value) == "table" then
			for variant, id in value do
				table.insert(out, { name = state .. variant, state = state, variant = variant, id = id })
			end
		elseif value then
			table.insert(out, { name = state, state = state, variant = 1, id = value })
		end
	end
	return out
end

local cachedGroups

-- every group (packs first, then emote sets) with its entries:
--   { key, label, folder, rig, kind = "pack" | "emote", source, verified, pack = <PACKS entry> | nil, entries = { entry } }
--   entry = { key, label, short, id, pack (group key), packLabel, state, variant, rig, kind, looped, verified, group, name }
-- The result is built once and shared: do not modify it.
function AnimLibrary.groups()
	if cachedGroups then
		return cachedGroups
	end
	local groups = {}
	for _, pack in AnimLibrary.PACKS do
		local group = { key = pack.key, label = pack.label, folder = pack.folder or pack.label, rig = pack.rig, kind = "pack",
			source = pack.source, verified = pack.verified, bundle = pack.bundle, pack = pack, entries = {} }
		for _, item in AnimLibrary.statesOf(pack) do
			local stateLabel = AnimLibrary.STATE_LABELS[item.state] or item.state
			local variants = type(pack.anims[item.state]) == "table" and #pack.anims[item.state] or 1
			local short = variants > 1 and (stateLabel .. " " .. item.variant) or stateLabel
			table.insert(group.entries, {
				key = pack.key .. "." .. item.name, label = pack.label .. " · " .. short, short = short, id = item.id,
				pack = pack.key, packLabel = pack.label, group = pack.key, state = item.state, variant = item.variant,
				name = item.name, rig = pack.rig, kind = "pack", looped = not ONE_SHOT[item.state], verified = pack.verified,
			})
		end
		table.insert(groups, group)
	end
	for _, eg in AnimLibrary.EMOTE_GROUPS do
		local group = { key = eg.key, label = eg.label, folder = eg.folder, rig = eg.rig, kind = "emote", source = eg.source,
			verified = eg.verified, entries = {} }
		for _, e in AnimLibrary.EMOTES do
			if e.group == eg.key then
				table.insert(group.entries, {
					key = e.key, label = eg.label .. " · " .. e.label, short = e.label, id = e.id, pack = eg.key,
					packLabel = eg.label, group = eg.key, state = e.name, variant = 1, name = e.name, rig = e.rig,
					kind = "emote", looped = e.looped, verified = e.verified,
				})
			end
		end
		table.insert(groups, group)
	end
	cachedGroups = groups
	return groups
end

local cachedAll

-- flat list of every animation: { key, label, id, pack, state, rig, ... } (same entries as in groups())
function AnimLibrary.all()
	if cachedAll then
		return cachedAll
	end
	local list = {}
	for _, group in AnimLibrary.groups() do
		for _, entry in group.entries do
			table.insert(list, entry)
		end
	end
	cachedAll = list
	return list
end

function AnimLibrary.find(key)
	for _, entry in AnimLibrary.all() do
		if entry.key == key then
			return entry
		end
	end
	return nil
end

function AnimLibrary.group(key)
	for _, group in AnimLibrary.groups() do
		if group.key == key then
			return group
		end
	end
	return nil
end

-- ---------------------------------------------------------------------------------------------
-- generated code (shown to / written for the user, so the comments inside it are in Romanian)
-- ---------------------------------------------------------------------------------------------
AnimLibrary.SCRIPT_NAME = "LostCubeAnimationPack"

-- A server Script that makes a pack the default animations of every character: on CharacterAdded it waits for the
-- character's `Animate` LocalScript and rewrites the AnimationId of its Animation children (the documented way:
-- Animate.<folder>.<child>, e.g. Animate.walk.WalkAnim - see AnimLibrary.ANIMATE). `pack` is an entry of PACKS.
function AnimLibrary.packScript(pack)
	local lines = {}
	local function add(text)
		table.insert(lines, text)
	end
	add("-- Generat de LostCube (tab-ul Bibliotecă): animațiile implicite ale personajelor = „" .. pack.label .. "”.")
	add("-- Toate id-urile sunt animații deținute de Roblox, deci merg în orice joc.")
	add("-- Șterge acest Script ca să revii la animațiile standard.")
	add("local Players = game:GetService(\"Players\")")
	add("")
	add("local RIG = \"" .. pack.rig .. "\" -- pachetul se aplică doar personajelor de acest tip")
	add("")
	add("-- dosarul din scriptul Animate -> { numele Animation-ului = id }")
	add("local PACK = {")
	for _, state in AnimLibrary.STATES do
		local value = pack.anims[state]
		local info = AnimLibrary.ANIMATE[state]
		if value then
			local parts = {}
			if type(value) == "table" then
				for i, id in value do
					table.insert(parts, info.names[i] .. " = " .. id)
				end
			else
				table.insert(parts, info.names[1] .. " = " .. value)
			end
			add("\t" .. info.folder .. " = { " .. table.concat(parts, ", ") .. " },")
		end
	end
	add("}")
	add("")
	add("-- cât de des se joacă fiecare idle (primul cel mai des)")
	add("local IDLE_WEIGHTS = { Animation1 = 9, Animation2 = 1, Animation3 = 1 }")
	add("")
	add("local function child(parent, name, class)")
	add("\tlocal found = parent:FindFirstChild(name)")
	add("\tif found and found:IsA(class) then")
	add("\t\treturn found")
	add("\tend")
	add("\tif found then")
	add("\t\tfound:Destroy()")
	add("\tend")
	add("\tfound = Instance.new(class)")
	add("\tfound.Name = name")
	add("\tfound.Parent = parent")
	add("\treturn found")
	add("end")
	add("")
	add("local function isApplied(animate)")
	add("\tfor folderName, anims in PACK do")
	add("\t\tlocal folder = animate:FindFirstChild(folderName)")
	add("\t\tif not folder then")
	add("\t\t\treturn false")
	add("\t\tend")
	add("\t\tfor animName, id in anims do")
	add("\t\t\tlocal anim = folder:FindFirstChild(animName)")
	add("\t\t\tif not (anim and anim:IsA(\"Animation\") and anim.AnimationId == \"rbxassetid://\" .. id) then")
	add("\t\t\t\treturn false")
	add("\t\t\tend")
	add("\t\tend")
	add("\tend")
	add("\treturn true")
	add("end")
	add("")
	add("local function apply(character)")
	add("\tlocal humanoid = character:WaitForChild(\"Humanoid\", 15)")
	add("\tlocal animate = character:WaitForChild(\"Animate\", 15)")
	add("\tif not humanoid or not animate or humanoid.RigType.Name ~= RIG or isApplied(animate) then")
	add("\t\treturn")
	add("\tend")
	add("")
	add("\t-- oprește animațiile care rulează, ca în documentația Roblox")
	add("\tlocal animator = humanoid:FindFirstChildOfClass(\"Animator\")")
	add("\tif animator then")
	add("\t\tfor _, track in animator:GetPlayingAnimationTracks() do")
	add("\t\t\ttrack:Stop(0)")
	add("\t\tend")
	add("\tend")
	add("")
	add("\tfor folderName, anims in PACK do")
	add("\t\tlocal folder = child(animate, folderName, \"StringValue\")")
	add("\t\tfor animName, id in anims do")
	add("\t\t\tlocal anim = child(folder, animName, \"Animation\")")
	add("\t\t\tanim.AnimationId = \"rbxassetid://\" .. id")
	add("\t\t\tif folderName == \"idle\" then")
	add("\t\t\t\tchild(anim, \"Weight\", \"NumberValue\").Value = IDLE_WEIGHTS[animName] or 1")
	add("\t\t\tend")
	add("\t\tend")
	add("\t\tif folderName == \"idle\" then")
	add("\t\t\tfor _, extra in folder:GetChildren() do -- variantele idle care nu sunt în pachet")
	add("\t\t\t\tif extra:IsA(\"Animation\") and not anims[extra.Name] then")
	add("\t\t\t\t\textra:Destroy()")
	add("\t\t\t\tend")
	add("\t\t\tend")
	add("\t\tend")
	add("\tend")
	add("end")
	add("")
	add("local function onPlayer(player)")
	add("\tif player.Character then")
	add("\t\ttask.spawn(apply, player.Character)")
	add("\tend")
	add("\tplayer.CharacterAdded:Connect(function(character)")
	add("\t\tapply(character)")
	add("\tend)")
	add("\tplayer.CharacterAppearanceLoaded:Connect(function(character)")
	add("\t\tapply(character)")
	add("\tend)")
	add("end")
	add("")
	add("Players.PlayerAdded:Connect(onPlayer)")
	add("for _, player in Players:GetPlayers() do")
	add("\ttask.spawn(onPlayer, player)")
	add("end")
	add("")
	return table.concat(lines, "\n")
end

-- the snippet that plays an entry on a character (`character` is any Model with a Humanoid)
function AnimLibrary.snippet(entry)
	local lines = {
		"-- " .. entry.label .. " (animație deținută de Roblox: merge în orice joc)",
		"local anim = Instance.new(\"Animation\")",
		"anim.AnimationId = \"" .. AnimLibrary.url(entry.id) .. "\"",
		"",
		"local humanoid = character:WaitForChild(\"Humanoid\")",
		"local track = humanoid:WaitForChild(\"Animator\"):LoadAnimation(anim)",
		"track.Looped = " .. tostring(entry.looped ~= false),
		"track:Play()",
		"-- track:Stop()",
	}
	return table.concat(lines, "\n")
end

return AnimLibrary
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX16"><Properties><string name="Name">LibraryPanel</string><ProtectedString name="Source"><![CDATA[-- LostCube > Library tab: free animations OWNED BY ROBLOX (default character animations, Roblox's catalog packs and
-- emotes). They play in any experience because Roblox owns them (see AnimLibrary for the data and where it comes from).
--   * browse / search / filter, preview on a rig in Edit mode (Animator:StepAnimations, like the Animations tab)
--   * add the animations to the game as Animation instances (ReplicatedStorage.LostCube.Animations.<Pack>.<state>)
--   * make a pack the default animation set of every character (a server Script that edits the Animate script)
--   * copy a Luau snippet that plays the animation
local RunService = game:GetService("RunService")
local Selection = game:GetService("Selection")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local ChangeHistoryService = game:GetService("ChangeHistoryService")
local KeyframeSequenceProvider = game:GetService("KeyframeSequenceProvider")
local MarketplaceService = game:GetService("MarketplaceService")

local UI = require(script.Parent.UI)
local AnimLibrary = require(script.Parent.AnimLibrary)
local C = UI.C

local Panel = {}
Panel.__index = Panel

local KINDS = {
	{ value = "pack", label = "Pachete" },
	{ value = "emote", label = "Emote" },
	{ value = "all", label = "Toate" },
}
local RIGS = {
	{ value = "all", label = "Toate" },
	{ value = "R15", label = "R15" },
	{ value = "R6", label = "R6" },
}
local SPEEDS = {
	{ value = 0.5, label = "×0.5" },
	{ value = 1, label = "×1" },
	{ value = 2, label = "×2" },
}
local VERIFIED = {
	api = "API Roblox",
	["2-sources"] = "2+ surse independente",
	custom = "neverificat",
}

local MAX_ROWS = 120 -- rows drawn in the list at once (a broad search stays fast)
local LOAD_TIMEOUT = 8 -- seconds to wait for an animation asset to arrive
local ANIMATION_TYPE, EMOTE_TYPE = 24, 61 -- AssetTypeId

function Panel.new(ctx)
	return setmetatable({
		ctx = ctx, Editor = ctx.Editor, query = "", kind = "all", rigFilter = "all", openGroup = nil, sel = nil,
		rig = nil, speed = 1, loop = true, gen = 0, owner = {}, codeMode = "play", listY = 0,
	}, Panel)
end

function Panel:refresh()
	if not self.dead then
		self.ctx.app:refresh()
	end
end

-- fn must not yield: the recording stays open meanwhile (and every edit of the user lands in it)
local function record(name, fn)
	local ok, id = pcall(ChangeHistoryService.TryBeginRecording, ChangeHistoryService, "LostCube: " .. name)
	local done, err = pcall(fn)
	if ok and id then
		pcall(ChangeHistoryService.FinishRecording, ChangeHistoryService, id,
			done and Enum.FinishRecordingOperation.Commit or Enum.FinishRecordingOperation.Cancel)
	end
	if done then
		pcall(function()
			require(script.Parent.Editor).log(name)
		end)
	end
	return done, err
end

-- error text without the "Plugin_123.LostCube.LibraryPanel:45:" prefix, kept short
local function friendly(err)
	local text = tostring(err):gsub("^[%w_%.%-%s]*:%d+:%s*", "")
	if #text > 180 then
		text = text:sub(1, 177) .. "..."
	end
	return text
end

function Panel:notify(text, color)
	self.notice = { text = text, color = color or C.warn }
end

function Panel:clearNotice()
	self.notice = nil
end

-- the child called `name`, created as a Folder when missing (an existing one is reused whatever its class)
local function ensureFolder(parent, name)
	local folder = parent:FindFirstChild(name)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = name
		folder.Parent = parent
	end
	return folder
end

-- ---------------------------------------------------------------------------------------------
-- rig
-- ---------------------------------------------------------------------------------------------
-- the Animator of the rig; made when missing (the second value is true then: Panel:stop takes it away again)
local function animatorOf(rig)
	local owner = rig:FindFirstChildOfClass("Humanoid") or rig:FindFirstChildOfClass("AnimationController")
	if not owner then
		return nil
	end
	local animator = owner:FindFirstChildOfClass("Animator")
	if animator then
		return animator, false
	end
	animator = Instance.new("Animator")
	animator.Parent = owner
	return animator, true
end

local function rigType(rig)
	local h = rig and rig:FindFirstChildOfClass("Humanoid")
	if h then
		return h.RigType == Enum.HumanoidRigType.R15 and "R15" or "R6"
	end
	return rig and (rig:FindFirstChild("UpperTorso") and "R15" or "R6") or "-"
end

local function selectedRig()
	local sel = Selection:Get()[1]
	local model = sel and (sel:IsA("Model") and sel or sel:FindFirstAncestorWhichIsA("Model"))
	if model and (model:FindFirstChildOfClass("Humanoid") or model:FindFirstChildOfClass("AnimationController")) then
		return model
	end
	return nil
end

function Panel:useSelection()
	local model = selectedRig()
	if model then
		self:stop()
		self.rig = model
		return true
	end
	return false
end

function Panel:makeDummy(kind)
	self:stop()
	self:clearNotice()
	local name = "LostCube Dummy " .. kind
	local existing = workspace:FindFirstChild(name) -- the Animations tab makes the same dummies: share them
	if existing and existing:IsA("Model") and existing:FindFirstChildOfClass("Humanoid") then
		self.rig = existing
		self:refresh()
		return
	end
	if self.making then
		return -- one is already on its way
	end
	-- The model is built first: it waits for the web (it yields), and a recording kept open across a yield would
	-- swallow whatever the user edits meanwhile. Only putting it into the place is recorded.
	self.making = true
	local built, model = pcall(function()
		local desc = Instance.new("HumanoidDescription")
		local light, dark = Color3.fromRGB(214, 216, 226), Color3.fromRGB(40, 40, 48)
		desc.HeadColor, desc.LeftArmColor, desc.RightArmColor = light, light, light
		desc.LeftLegColor, desc.RightLegColor, desc.TorsoColor = dark, dark, dark
		-- CreateHumanoidModelFromDescriptionAsync replaces the deprecated name
		local okMethod, method = pcall(function()
			return Players.CreateHumanoidModelFromDescriptionAsync
		end)
		local ok, result
		if okMethod and method then
			ok, result = pcall(method, Players, desc, Enum.HumanoidRigType[kind])
		else
			ok, result = pcall(Players.CreateHumanoidModelFromDescription, Players, desc, Enum.HumanoidRigType[kind])
		end
		desc:Destroy()
		if not (ok and result) then
			error("nu am putut crea dummy-ul: " .. friendly(result), 0)
		end
		result.Name = name
		local okSpot, spot = pcall(self.Editor.previewTarget)
		local cf = okSpot and typeof(spot) == "CFrame" and spot or CFrame.new(0, 0, 0)
		local root = result:FindFirstChild("HumanoidRootPart")
		local drop = kind == "R15" and (result.Humanoid.HipHeight + root.Size.Y / 2) or 3
		result:PivotTo(cf * CFrame.new(0, drop, 0))
		root.Anchored = true
		return result
	end)
	self.making = false
	if built and self.dead then
		model:Destroy()
		return
	end
	local done, err = built, model
	if built then
		done, err = record("dummy " .. kind, function()
			model.Parent = workspace -- only this goes into the undo step
		end)
		if done then
			self.rig = model
		else
			model:Destroy()
		end
	end
	if not done then
		self:notify("⚠ " .. friendly(err))
	end
	self:refresh()
end

-- ---------------------------------------------------------------------------------------------
-- playback (Edit mode: Animator:StepAnimations)
-- ---------------------------------------------------------------------------------------------
function Panel:resetPose()
	if not self.rig then
		return
	end
	for _, m in self.rig:GetDescendants() do
		if m:IsA("Motor6D") then
			m.Transform = CFrame.new()
		end
	end
end

function Panel:stop()
	self.gen += 1 -- cancels a load that is still waiting
	if self.conn then
		self.conn:Disconnect()
		self.conn = nil
	end
	local track = self.track
	self.track, self.animator = nil, nil
	if track then
		pcall(function()
			track:Stop(0)
			track:Destroy()
		end)
	end
	if self.seq then
		pcall(self.seq.Destroy, self.seq)
		self.seq = nil
	end
	if self.ownAnimator then -- the rig did not have one: leave it as it was
		pcall(self.ownAnimator.Destroy, self.ownAnimator)
		self.ownAnimator = nil
	end
	self.playing, self.loading = false, false
	self:resetPose()
end

-- loads `entry` on the animator and waits until the clip arrives (Length stays 0 until then); returns the track or nil, reason
function Panel:loadTrack(animator, entry, gen)
	local url = AnimLibrary.url(entry.id)
	local function attempt(animationId)
		local anim = Instance.new("Animation")
		anim.AnimationId = animationId
		local ok, track = pcall(animator.LoadAnimation, animator, anim)
		if not (ok and track) then
			return nil, friendly(track)
		end
		local t0 = os.clock()
		while track.Length == 0 and os.clock() - t0 < LOAD_TIMEOUT and self.gen == gen do
			task.wait(0.1)
		end
		if self.gen ~= gen or track.Length == 0 then
			pcall(track.Destroy, track)
			return nil, self.gen ~= gen and "anulat" or "nu a sosit în " .. LOAD_TIMEOUT .. " s"
		end
		return track
	end
	local track, why = attempt(url)
	if track or self.gen ~= gen then
		return track, why
	end
	-- fall back to fetching the KeyframeSequence ourselves: it also tells why an asset cannot be used
	local ok, seq = pcall(KeyframeSequenceProvider.GetKeyframeSequenceAsync, KeyframeSequenceProvider, url)
	if not (ok and seq) then
		return nil, friendly(seq)
	end
	local okReg, hash = pcall(KeyframeSequenceProvider.RegisterKeyframeSequence, KeyframeSequenceProvider, seq)
	if not (okReg and hash) then
		pcall(seq.Destroy, seq)
		return nil, friendly(hash)
	end
	if self.gen ~= gen then
		pcall(seq.Destroy, seq)
		return nil, "anulat"
	end
	self.seq = seq
	return attempt(hash)
end

function Panel:play()
	local entry = self.sel
	if not entry then
		return
	end
	self:clearNotice()
	if not self.rig and not self:useSelection() then
		self:notify("Alege un rig: selectează un personaj (Model cu Humanoid) sau creează un dummy mai jos.")
		self:refresh()
		return
	end
	local rig = self.rig
	self:stop() -- (also takes away an Animator this panel made for the previous preview)
	local animator, created = animatorOf(rig)
	if not animator then
		self:notify("⚠ Rig-ul nu are Humanoid sau AnimationController.")
		self:refresh()
		return
	end
	self.ownAnimator = created and animator or nil
	local gen = self.gen
	self.loading = true
	if rigType(rig) ~= entry.rig and entry.rig ~= "Both" then
		self:notify(string.format("Atenție: animația e pentru %s, iar rig-ul e %s. De obicei nu se mișcă pe un rig diferit.",
			entry.rig, rigType(rig)))
	end
	self:refresh()
	task.spawn(function()
		local track, why = self:loadTrack(animator, entry, gen)
		if self.gen ~= gen then
			if track then
				pcall(track.Destroy, track)
			end
			return
		end
		self.loading = false
		if not track then
			self:stop() -- (the Animator made for the attempt goes away too)
			self:notify(string.format("⚠ Nu am putut încărca animația %s (%s). Verifică conexiunea, că ID-ul e deținut de Roblox "
				.. "(butonul „Verifică proprietarul”) și că rig-ul (%s) se potrivește cu animația (%s).", tostring(entry.id),
				tostring(why or "?"), rigType(rig), entry.rig))
			self:refresh()
			return
		end
		track.Looped = self.loop
		track:Play(0, 1, self.speed)
		self.track, self.animator, self.playing = track, animator, true
		track.Stopped:Connect(function()
			if self.track == track then -- a clip that ended on its own (not Looped)
				self.playing = false
				self:refresh()
			end
		end)
		self.conn = RunService.Heartbeat:Connect(function(dt)
			if self.track and self.animator then
				if self.timeLabel and not self.timeLabel.Parent then
					self:stop() -- the tab was left: do not keep animating the rig behind another tab
					return
				end
				-- the rig was deleted (undo) or the animator no longer works: stop instead of failing on every frame
				if not (self.rig and self.rig.Parent) or not pcall(self.animator.StepAnimations, self.animator, dt) then
					self:stop()
					self:refresh()
					return
				end
				if self.timeLabel and self.timeLabel.Parent then
					self.timeLabel.Text = string.format("%.2f / %.2f s", self.track.TimePosition, self.track.Length)
				end
			end
		end)
		self:refresh()
	end)
end

function Panel:togglePlay()
	if self.playing then
		if self.track then
			self.track:AdjustSpeed(0)
		end
		self.playing = false
		self:refresh()
	elseif self.track and self.track.IsPlaying then -- paused: continue
		self.track:AdjustSpeed(self.speed)
		self.playing = true
		self:refresh()
	else
		self:play()
	end
end

-- ---------------------------------------------------------------------------------------------
-- library: selection, search
-- ---------------------------------------------------------------------------------------------
function Panel:select(entry, play)
	self:clearNotice()
	local running = self.playing or self.loading
	self:stop()
	self.sel = entry
	if entry.kind ~= "custom" then
		self.openGroup = entry.group
	end
	if play or running then
		self:play()
	else
		self:refresh()
	end
end

local function selGroup(entry)
	local group = AnimLibrary.group(entry.group)
	if group then
		return group
	end
	return { key = "custom", label = "ID personalizat", folder = "Custom", kind = "custom", rig = "Both", entries = { entry },
		source = "introdus de tine", verified = "custom" }
end

function Panel:setCustom(text)
	local id = tonumber(tostring(text):match("%d+") or "")
	if not id or id <= 0 then
		self:notify("⚠ Scrie un ID de animație (doar cifre, sau rbxassetid://123).")
		self:refresh()
		return
	end
	self:select({ key = "custom." .. id, label = "ID " .. id, short = "ID " .. id, id = id, pack = "custom", packLabel = "Personalizat",
		group = "custom", state = "custom", variant = 1, name = "anim" .. id, rig = "Both", kind = "custom", looped = true,
		verified = "custom" })
end

local haystacks = setmetatable({}, { __mode = "k" }) -- entry -> the text a search looks in (made once)
local function haystack(entry, group)
	local text = haystacks[entry]
	if not text then
		text = (group.label .. " " .. entry.key .. " " .. entry.short .. " " .. entry.state .. " " .. entry.rig .. " " .. entry.id
			.. " " .. (group.kind == "pack" and "pachet" or "emote")):lower()
		haystacks[entry] = text
	end
	return text
end

-- groups that pass the kind / rig filters and the search; returns { { group, entries } }, searching
function Panel:visibleGroups()
	local tokens = {}
	for token in self.query:lower():gmatch("%S+") do
		table.insert(tokens, token)
	end
	local out = {}
	for _, group in AnimLibrary.groups() do
		if (self.kind == "all" or self.kind == group.kind) and (self.rigFilter == "all" or group.rig == self.rigFilter) then
			local matched = {}
			for _, entry in group.entries do
				local text = #tokens > 0 and haystack(entry, group)
				local ok = true
				for _, token in tokens do
					if not text:find(token, 1, true) then
						ok = false
						break
					end
				end
				if ok then
					table.insert(matched, entry)
				end
			end
			if #matched > 0 then
				table.insert(out, { group = group, entries = matched })
			end
		end
	end
	return out, #tokens > 0
end

-- keeps the list where it was across the redraw that follows every click
function Panel:keepScroll(list)
	local function track()
		list:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
			self.listY = list.CanvasPosition.Y
		end)
	end
	if self.listY > 0 then
		local y = self.listY
		task.delay(0.05, function()
			if list.Parent then
				list.CanvasPosition = Vector2.new(0, y)
				track()
			end
		end)
	else
		track()
	end
end

-- ---------------------------------------------------------------------------------------------
-- ownership check (live, MarketplaceService)
-- ---------------------------------------------------------------------------------------------
function Panel:fetchOwner(id)
	local cached = self.owner[id]
	if cached then
		return cached
	end
	-- GetProductInfoAsync replaces the deprecated GetProductInfo
	local okMethod, method = pcall(function()
		return MarketplaceService.GetProductInfoAsync
	end)
	local ok, info
	if okMethod and method then
		ok, info = pcall(method, MarketplaceService, id, Enum.InfoType.Asset)
	else
		ok, info = pcall(MarketplaceService.GetProductInfo, MarketplaceService, id, Enum.InfoType.Asset)
	end
	local result
	if ok and type(info) == "table" then
		local creator = info.Creator or {}
		result = { ok = true, name = info.Name, creator = creator.Name or "?", assetType = info.AssetTypeId,
			roblox = creator.Name == "Roblox" or (creator.CreatorType == "User" and creator.CreatorTargetId == 1) }
	else
		result = { ok = false, err = friendly(info) }
	end
	self.owner[id] = result
	return result
end

function Panel:checkOwner(entry)
	self:clearNotice()
	self.owner[entry.id] = nil
	self.checking = "ID " .. entry.id
	self:refresh()
	task.spawn(function()
		self:fetchOwner(entry.id)
		self.checking = nil
		self:refresh()
	end)
end

function Panel:checkGroup(group)
	if self.checking then
		return
	end
	self:clearNotice()
	task.spawn(function()
		local total, good, other, failed = #group.entries, 0, {}, 0
		for i, entry in group.entries do
			if self.dead then
				return -- the plugin was unloaded: no more requests
			end
			self.checking = string.format("%s %d/%d", group.label, i, total)
			self:refresh()
			self.owner[entry.id] = nil
			local info = self:fetchOwner(entry.id)
			if not info.ok then
				failed += 1
			elseif info.roblox and info.assetType == ANIMATION_TYPE then
				good += 1
			else
				table.insert(other, entry.short)
			end
			task.wait(0.1)
		end
		self.checking = nil
		if good == total then
			self:notify(string.format("✓ %s: toate cele %d animații sunt deținute de Roblox (verificat live).", group.label, total), C.good)
		else
			self:notify(string.format("%s: %d din %d verificate OK; nu au putut fi verificate: %d; altceva decât animație Roblox: %s",
				group.label, good, total, failed, #other > 0 and table.concat(other, ", ") or "-"), C.warn)
		end
		self:refresh()
	end)
end

-- text + color of the ownership line for an entry
function Panel:ownerLine(entry)
	local info = self.owner[entry.id]
	if not info then
		return "Proprietar: neverificat live (apasă „Verifică proprietarul”)", C.dim
	end
	if not info.ok then
		return "⚠ Nu am putut verifica: " .. info.err, C.warn
	end
	local label = (info.name and ("„" .. info.name .. "” · ") or "") .. "creator " .. info.creator
	if not info.roblox then
		return "✗ " .. label .. ". Nu e al Roblox: merge în joc doar dacă e al creatorului jocului.", C.danger
	elseif info.assetType == EMOTE_TYPE then
		return "⚠ " .. label .. ", dar e un emote din catalog (tip 61), nu o animație: poate să nu meargă ca AnimationId.", C.warn
	elseif info.assetType ~= ANIMATION_TYPE then
		return "⚠ " .. label .. " · tip asset " .. tostring(info.assetType) .. " (nu e animație).", C.warn
	end
	return "✓ " .. label .. " · animație deținută de Roblox, merge în orice joc.", C.good
end

-- ---------------------------------------------------------------------------------------------
-- into the game
-- ---------------------------------------------------------------------------------------------
function Panel:addToGame(group, entries, what)
	self:clearNotice()
	local count = 0
	local done, err = record("animații din bibliotecă: " .. what, function()
		local root = ensureFolder(ReplicatedStorage, "LostCube")
		local folder = ensureFolder(ensureFolder(root, "Animations"), group.folder)
		for _, entry in entries do
			local inst = folder:FindFirstChild(entry.name)
			if inst and not inst:IsA("Animation") then
				inst:Destroy()
				inst = nil
			end
			if not inst then
				inst = Instance.new("Animation")
				inst.Name = entry.name
				inst.Parent = folder
			end
			inst.AnimationId = AnimLibrary.url(entry.id)
			inst:SetAttribute("LC_Pack", group.key)
			count += 1
		end
	end)
	if done then
		self:notify(string.format("✓ %d animații în ReplicatedStorage › LostCube › Animations › %s (un singur Ctrl+Z le scoate).",
			count, group.folder), C.good)
	else
		self:notify("⚠ " .. friendly(err))
	end
	self:refresh()
end

-- make a pack the default animation set of every character
function Panel:installDefault(group)
	self:clearNotice()
	local name = AnimLibrary.SCRIPT_NAME
	local source = AnimLibrary.packScript(group.pack)
	local done, err = record("animații implicite: " .. group.label, function()
		local existing = ServerScriptService:FindFirstChild(name)
		if existing and not existing:IsA("Script") then
			error("în ServerScriptService există deja un obiect „" .. name .. "” care nu e Script")
		end
		if existing then
			existing.Source = source
		else
			local created = Instance.new("Script")
			created.Name = name
			created.Source = source -- needs the plugin's script-injection permission; fails before anything is parented
			created.Parent = ServerScriptService
		end
	end)
	if done then
		self:notify(string.format("✓ Script „%s” în ServerScriptService: personajele noi folosesc pachetul „%s”. Șterge-l ca să "
			.. "revii la cele standard.", name, group.label), C.good)
	else
		self.codeMode = "pack"
		self:notify(string.format("⚠ Studio nu a lăsat pluginul să scrie codul scriptului (%s). Acceptă permisiunea „Script "
			.. "Injection” pentru LostCube (Plugins → Manage Plugins) și încearcă din nou, sau creează tu un Script în "
			.. "ServerScriptService și lipește codul din secțiunea „Cod” (l-am pus acolo).", friendly(err)))
	end
	self:refresh()
end

function Panel:removeDefault()
	self:clearNotice()
	local existing = ServerScriptService:FindFirstChild(AnimLibrary.SCRIPT_NAME)
	if existing then
		local done, err = record("scriptul de animații implicite scos", function()
			existing:Destroy()
		end)
		if done then
			self:notify("✓ Scriptul „" .. AnimLibrary.SCRIPT_NAME .. "” a fost șters: personajele folosesc iar animațiile standard.",
				C.good)
		else
			self:notify("⚠ " .. friendly(err))
		end
	end
	self:refresh()
end

-- ---------------------------------------------------------------------------------------------
-- render
-- ---------------------------------------------------------------------------------------------
-- a read-only, selectable code box (click inside, Ctrl+A, Ctrl+C)
local function codeBox(parent, text)
	local list = UI.scrollList(parent, 220)
	return UI.make("TextBox", { Parent = list, Text = text, Font = Enum.Font.Code, TextSize = 12, TextColor3 = C.text,
		BackgroundColor3 = C.input, ClearTextOnFocus = false, TextEditable = false, MultiLine = true, TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Size = UDim2.new(1, -6, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y }, { UI.corner(4), UI.stroke(C.border), UI.pad(4, 6, 4, 6) })
end

function Panel:renderRig(parent)
	local body = UI.section(parent, "Rig de previzualizare", { key = "lib.rig" })
	UI.label(body, self.rig and (self.rig.Name .. "  (" .. rigType(self.rig) .. ")") or "Niciun rig ales", { medium = true })
	UI.button(UI.hstack(body), "Folosește personajul selectat", function()
		self:clearNotice()
		if not self:useSelection() then
			self:notify("Selectează un personaj (Model cu Humanoid sau AnimationController).")
		end
		self:refresh()
	end)
	local bar = UI.hstack(body)
	UI.button(bar, "+ Dummy R6", function()
		self:makeDummy("R6")
	end)
	UI.button(bar, "+ Dummy R15", function()
		self:makeDummy("R15")
	end)
end

function Panel:renderList(parent)
	local groups, searching = self:visibleGroups()
	local packs, emotes = 0, 0
	for _, g in AnimLibrary.groups() do
		if g.kind == "pack" then
			packs += 1
		else
			emotes += #g.entries
		end
	end
	local body = UI.section(parent, string.format("Bibliotecă  (%d pachete · %d emote)", packs, emotes), { key = "lib.list" })

	local bar = UI.hstack(body)
	local searchBox = UI.textbox(bar, self.query, function(text)
		self.query = text
		self.queryDraft = nil
		self.listY = 0
		self:refresh()
	end, { placeholder = "caută: ninja, walk, wave, 656118852…" })
	if self.queryDraft then -- typed, not applied yet: a redraw must not wipe it (it is applied when the box loses focus)
		searchBox.Text = self.queryDraft
	end
	searchBox:GetPropertyChangedSignal("Text"):Connect(function()
		self.queryDraft = searchBox.Text
	end)
	if self.query ~= "" then
		UI.button(bar, "✕", function()
			self.query = ""
			self.queryDraft = nil
			self.listY = 0
			self:refresh()
		end, { width = 26 })
	end
	UI.segmented(UI.row(body, "Tip"), KINDS, self.kind, function(v)
		self.kind = v
		self.listY = 0
		self:refresh()
	end)
	UI.segmented(UI.row(body, "Rig"), RIGS, self.rigFilter, function(v)
		self.rigFilter = v
		self.listY = 0
		self:refresh()
	end)

	local list = UI.scrollList(body, 320)
	local shown, hidden = 0, 0
	for _, item in groups do
		local group = item.group
		local open = searching or self.openGroup == group.key
		if searching then
			UI.label(list, group.label .. "  ·  " .. group.rig, { dim = true, size = 11, height = 18 })
		else
			UI.item(list, group.label, { icon = open and "▼" or "►", selected = open, note = #group.entries .. " · " .. group.rig,
				onClick = function()
					self.openGroup = not open and group.key or nil
					self:refresh()
				end })
		end
		if open then
			for _, entry in item.entries do
				if shown >= MAX_ROWS then
					hidden += 1
				else
					shown += 1
					UI.item(list, entry.short, { icon = "•", height = 24, selected = self.sel ~= nil and self.sel.key == entry.key,
						note = tostring(entry.id), onClick = function()
							self:select(entry)
						end, actions = { { text = "▶", color = C.accent, onClick = function()
							self:select(entry, true)
						end } } })
				end
			end
		end
	end
	if #groups == 0 then
		UI.note(list, "Nicio animație nu se potrivește cu căutarea / filtrele.")
	elseif hidden > 0 then
		UI.note(list, string.format("… încă %d animații; scrie mai mult în căutare ca să le restrângi.", hidden))
	end
	self:keepScroll(list)
	if not self.sel then
		UI.label(body, "Alege o animație și apasă ▶ ca s-o vezi pe rig. Sunt animații Roblox: gratis în orice joc.",
			{ dim = true, size = 11, wrap = true })
	end
end

function Panel:renderSelection(parent)
	local entry = self.sel
	local group = selGroup(entry)
	local body = UI.section(parent, "Animația aleasă", { key = "lib.sel" })
	UI.label(body, entry.label, { medium = true })
	UI.label(body, string.format("%s  ·  %s  ·  %s", AnimLibrary.url(entry.id), entry.rig, entry.looped and "în buclă" or "o singură dată"),
		{ dim = true, size = 11 })
	UI.label(body, string.format("Sursă: %s  ·  verificat: %s", group.source or "-", VERIFIED[entry.verified] or tostring(entry.verified)),
		{ dim = true, size = 11, wrap = true })
	local text, color = self:ownerLine(entry)
	UI.label(body, text, { color = color, size = 12, wrap = true })

	-- playback
	local controls = UI.hstack(body, { height = 28 })
	UI.button(controls, self.loading and "Se încarcă…" or (self.playing and "⏸ Pauză" or "▶  Redă"), function()
		if not self.loading then
			self:togglePlay()
		end
	end, { style = "primary", bold = true, height = 28 })
	UI.button(controls, "⏹", function()
		self:clearNotice()
		self:stop()
		self:refresh()
	end, { width = 30, height = 28 })
	self.timeLabel = UI.label(body, self.track and string.format("%.2f / %.2f s", self.track.TimePosition, self.track.Length) or "-",
		{ dim = true, size = 12 })
	UI.segmented(UI.row(body, "Viteză"), SPEEDS, self.speed, function(v)
		self.speed = v
		if self.track and self.playing then
			self.track:AdjustSpeed(v)
		end
		self:refresh()
	end)
	UI.toggle(UI.hstack(body), self.loop, function(v)
		self.loop = v
		if self.track then
			self.track.Looped = v
		end
		self:refresh()
	end, "Repetă")

	-- ownership
	local check = UI.hstack(body)
	UI.button(check, self.checking and ("Se verifică " .. self.checking .. "…") or "Verifică proprietarul", function()
		if not self.checking then
			self:checkOwner(entry)
		end
	end, { tip = "Întreabă Roblox cine deține animația (MarketplaceService:GetProductInfo)" })
	if group.kind ~= "custom" and #group.entries > 1 then
		UI.button(check, "Verifică tot grupul", function()
			self:checkGroup(group)
		end, { tip = "Verifică live fiecare animație din „" .. group.label .. "”" })
	end

	-- into the game
	body = UI.section(parent, "Adaugă în joc", { key = "lib.add" })
	local add = UI.hstack(body)
	UI.button(add, "+ Animația aleasă", function()
		self:addToGame(group, { entry }, entry.label)
	end)
	if #group.entries > 1 then
		UI.button(add, "+ Tot grupul (" .. #group.entries .. ")", function()
			self:addToGame(group, group.entries, group.label)
		end)
	end
	UI.label(body, "Creează obiecte Animation în ReplicatedStorage › LostCube › Animations › " .. group.folder
		.. ". Un singur Ctrl+Z.", { dim = true, size = 11, wrap = true })

	-- default animations of the characters
	if group.kind == "pack" then
		body = UI.section(parent, "Animații implicite ale personajelor", { key = "lib.default" })
		local exists = ServerScriptService:FindFirstChild(AnimLibrary.SCRIPT_NAME) ~= nil
		local row = UI.hstack(body, { height = 28 })
		UI.button(row, "Folosește „" .. group.label .. "” ca animații implicite", function()
			self:installDefault(group)
		end, { style = "primary", bold = true, height = 28 })
		if exists then
			UI.button(row, "Elimină", function()
				self:removeDefault()
			end, { width = 70, height = 28, style = "danger" })
		end
		UI.label(body, string.format("Scrie un Script „%s” în ServerScriptService: când apare un personaj %s, înlocuiește animațiile "
			.. "din scriptul lui Animate (walk/WalkAnim, run/RunAnim, jump/JumpAnim, fall/FallAnim, climb/ClimbAnim, swim/Swim, "
			.. "swimidle/SwimIdle, idle/Animation1-3). Studio poate cere permisiunea de a scrie scripturi.",
			AnimLibrary.SCRIPT_NAME, group.rig), { dim = true, size = 11, wrap = true })
	end

	-- code
	body = UI.section(parent, "Cod", { key = "lib.code" })
	local mode = (self.codeMode == "pack" and group.kind == "pack") and "pack" or "play"
	if group.kind == "pack" then
		UI.segmented(body, { { value = "play", label = "Redă animația" }, { value = "pack", label = "Script animații implicite" } },
			mode, function(v)
				self.codeMode = v
				self:refresh()
			end)
	end
	local box = codeBox(body, mode == "pack" and AnimLibrary.packScript(group.pack) or AnimLibrary.snippet(entry))
	UI.button(UI.hstack(body), "Selectează tot", function()
		pcall(function()
			box:CaptureFocus()
			box.SelectionStart = 1
			box.CursorPosition = #box.Text + 1
		end)
	end, { tip = "Apoi Ctrl+C. Dacă nu merge: click în casetă, Ctrl+A, Ctrl+C" })
	UI.label(body, "Click în casetă, Ctrl+A, Ctrl+C. Animațiile Roblox merg în orice joc; atacuri personalizate faci în tab-ul Animații.",
		{ dim = true, size = 11, wrap = true })
end

function Panel:render(parent)
	if self.rig and not self.rig.Parent then
		self:stop()
		self.rig = nil
	end
	if self.notice then
		UI.note(parent, self.notice.text, self.notice.color)
	end

	local about = UI.section(parent, "Despre bibliotecă", { key = "lib.about", collapsed = true })
	UI.label(about, "O animație se poate reda într-un joc doar dacă aparține creatorului jocului sau Roblox. Cele de aici sunt "
		.. "făcute de Roblox (animațiile implicite, pachetele din catalog și emote-urile din Animate), deci merg gratis în orice joc. "
		.. "ID-urile au fost confirmate din cel puțin două surse; „Verifică proprietarul” întreabă Roblox live.",
		{ dim = true, size = 12, wrap = true })
	UI.label(about, "Atacuri și mișcări personalizate se generează în tab-ul Animații.", { dim = true, size = 12, wrap = true })

	self:renderRig(parent)
	self:renderList(parent)
	if self.sel then
		self:renderSelection(parent)
	end

	local body = UI.section(parent, "ID personalizat", { key = "lib.custom", collapsed = true })
	local row = UI.hstack(body)
	local box = UI.textbox(row, "", nil, { placeholder = "ID sau rbxassetid://…" })
	box.Text = self.customDraft or "" -- what was typed survives a redraw
	box:GetPropertyChangedSignal("Text"):Connect(function()
		self.customDraft = box.Text
	end)
	UI.button(row, "Alege", function()
		self.customDraft = nil
		self:setCustom(box.Text)
	end, { width = 60 })
	UI.label(body, "Încearcă orice animație (și vezi cine o deține) înainte s-o folosești.", { dim = true, size = 11, wrap = true })
end

function Panel:destroy()
	self.dead = true -- the ownership check loop and a dummy on its way stop
	self:stop()
end

return Panel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX17"><Properties><string name="Name">Icons</string><ProtectedString name="Source"><![CDATA[-- LostCube icons: Studio's own glyphs (content/studio_svg_textures, shipped with every Studio) and class icons from
-- StudioService:GetClassIcon. No emoji anywhere in the interface.
--
-- Every path below was checked against rbxManifest.txt of MaximumADHD/Roblox-Client-Tracker (branch `roblox`, commit
-- 41ab074bc29dd2a51a5bb17bc3498e0465842794, Studio 0.742.0.7421053), where they appear as
-- content\studio_svg_textures\<path> (the repo mirrors them under studio-svg-textures/). The same list is kept in
-- plugin/tests/suites/data/studio_icons.luau; the `ui` test suite fails on a path that is not in it.
--
-- Monochrome glyphs use the Dark variant (a light grey #E0E0E0 / #F0F0F0 shape) and are tinted with ImageColor3 from a
-- theme token, so one image works in both themes. Coloured glyphs (alerts) take the variant of the current theme and
-- are not tinted.
--
--   Icons.get(name)           -> { Image, ImageRectOffset, ImageRectSize, tint }   (nil for an unknown name)
--   Icons.class(className)    -> the same shape, never nil (StudioService, then a verified file, then a placeholder)
--   Icons.apply(image, icon)  sets Image / ImageRectOffset / ImageRectSize on an ImageLabel / ImageButton
--   Icons.has(name)           a glyph name (true) or something else, e.g. an old emoji label (false)
--   Icons.draw(parent, name, size, color)  a few glyphs drawn from frames (no image needed): chevron, plus, close,
--                                           check, minus, dot, cube (the LostCube mark)
local Theme = require(script.Parent.Theme)

local Icons = {}

Icons.BASE = "rbxasset://studio_svg_textures/"

-- name -> path under studio_svg_textures (Dark variant, tinted)
Icons.GLYPHS = {
	-- navigation
	chevronRight = "Shared/Ribbon/Dark/Standard/RibbonChevronRightSmall.png",
	chevronDown = "Shared/Navigation/Dark/Standard/DropdownArrow.png",
	chevronLeft = "Shared/Navigation/Dark/Standard/Back.png",
	caretRight = "Shared/Navigation/Dark/Standard/ArrowRight.png",
	caretDown = "Shared/Navigation/Dark/Standard/ArrowDown.png",
	collapseAll = "Shared/Navigation/Dark/Standard/Collapse.png",
	expandAll = "Shared/Navigation/Dark/Standard/Expand.png",
	more = "Shared/Navigation/Dark/Standard/More.png",
	moreVertical = "Shared/Ribbon/Dark/Standard/RibbonMoreSmall.png",
	close = "Shared/Navigation/Dark/Standard/CloseWidget.png",
	-- actions
	plus = "Shared/Navigation/Dark/Standard/AddNoBorder.png",
	search = "Lua/DeveloperFramework/Dark/Standard/Search.png",
	clear = "Lua/FindReplaceAll/Dark/Standard/ClearInput.png",
	copy = "Shared/Clipboard/Dark/Standard/Copy.png",
	duplicate = "Shared/Clipboard/Dark/Standard/Duplicate.png",
	paste = "Shared/Clipboard/Dark/Standard/Paste.png",
	undo = "Shared/Clipboard/Dark/Standard/Undo.png",
	redo = "Shared/Clipboard/Dark/Standard/Redo.png",
	refresh = "Lua/FileSync/Dark/Standard/Refresh.png",
	trash = "Shared/Ribbon/Dark/Standard/RibbonDeleteSmall.png",
	check = "Lua/Tutorials/Dark/Standard/Checkmark.png",
	filter = "Shared/Utility/Dark/Standard/Filter.png",
	history = "Shared/Utility/Dark/Standard/Recent.png",
	open = "Lua/FileSync/Dark/Standard/Open.png",
	import = "Lua/AssetManager/Dark/Standard/Import.png",
	locate = "Shared/Navigation/Dark/Standard/ZoomTo.png",
	grid = "Lua/MaterialPicker/Dark/Standard/Grid.png",
	list = "Lua/MaterialPicker/Dark/Standard/List.png",
	-- media
	play = "Lua/AnimationEditor/Dark/Standard/Preview.png",
	pause = "Shared/Ribbon/Dark/Standard/RibbonPauseSmall.png",
	stop = "Shared/Ribbon/Dark/Standard/RibbonStopInactiveSmall.png",
	toStart = "Lua/AnimationEditor/Dark/Standard/MoveToTheBeginning.png",
	toEnd = "Lua/AnimationEditor/Dark/Standard/MoveToTheEnd.png",
	-- state
	eye = "Lua/AvatarSettings/Dark/Standard/eye-fill-dark.png",
	eyeOff = "Lua/AvatarSettings/Dark/Standard/eye-slash-fill-dark.png",
	info = "Lua/FileSync/Dark/Standard/Info.png",
	help = "Shared/Navigation/Dark/Large/Help.png",
	gear = "Shared/Navigation/Dark/Standard/Settings.png",
	bookmark = "Shared/Utility/Dark/Standard/Bookmark.png",
	script = "Shared/InsertableObjects/Dark/Standard/Script.png",
	runScript = "Shared/WidgetIcons/Dark/Standard/RunScript.png",
	explorer = "Shared/WidgetIcons/Dark/Standard/Explorer.png",
	output = "Shared/WidgetIcons/Dark/Standard/Output.png",
	placeholder = "Shared/Placeholder/Dark/Standard/Placeholder.png",
	-- the tabs
	game = "Shared/WidgetIcons/Dark/Standard/ScriptAnalysis.png",
	effects = "Shared/InsertableObjects/Dark/Standard/SunRaysEffect.png",
	animation = "Shared/WidgetIcons/Dark/Standard/AnimationEditor.png",
	library = "Shared/WidgetIcons/Dark/Standard/Toolbox.png",
	build = "Shared/InsertableObjects/Dark/Standard/Part.png",
	chat = "Shared/WidgetIcons/Dark/Standard/Annotations.png",
}

-- name -> path with %s = "Dark" / "Light" (coloured: the theme's own variant, not tinted)
Icons.COLORED = {
	infoColor = "Shared/Alerts/%s/Standard/Information.png",
	successColor = "Shared/Alerts/%s/Standard/Success.png",
	warningColor = "Shared/Alerts/%s/Standard/Warning.png",
	errorColor = "Shared/Alerts/%s/Standard/Error.png",
}

-- class icons when StudioService cannot be asked (tests, a ScreenGui): Shared/InsertableObjects/<theme>/Standard/<file>
Icons.CLASSES = {
	ParticleEmitter = "ParticleEmitter", PointLight = "PointLight", SpotLight = "SpotLight", SurfaceLight = "SurfaceLight",
	Trail = "Trail", Beam = "Beam", Sound = "Sound", SoundGroup = "SoundGroup", Part = "Part", MeshPart = "MeshPart",
	WedgePart = "WedgePart", UnionOperation = "UnionOperation", SpecialMesh = "SpecialMesh", Model = "Model",
	Folder = "Folder", Script = "Script", LocalScript = "LocalScript", ModuleScript = "ModuleScript",
	Animation = "Animation", KeyframeSequence = "Animation", Keyframe = "Animation", Attachment = "Attachment",
	Humanoid = "Humanoid", Animator = "Animator", AnimationController = "AnimationController", Bone = "Bone",
	Motor6D = "Motor6D", Fire = "Fire", Smoke = "Smoke", Sparkles = "Sparkles", Explosion = "Explosion",
	Highlight = "Highlight", Camera = "Camera", Decal = "Decal", Texture = "Texture", RemoteEvent = "RemoteEvent",
	RemoteFunction = "RemoteFunction", BindableEvent = "BindableEvent", Tool = "Tool", ScreenGui = "ScreenGui",
	Configuration = "Configuration", StringValue = "Value", NumberValue = "Value", IntValue = "Value",
	BoolValue = "BoolValue", Workspace = "Workspace", ReplicatedStorage = "ReplicatedStorage",
	ServerStorage = "ServerStorage", ServerScriptService = "ServerScriptService", Lighting = "Lighting",
	StarterPlayer = "StarterPlayer",
}

-- the toolbar button / plugin actions (32 px, the variant of the current theme)
Icons.TOOLBAR = "Shared/InsertableObjects/%s/Standard/Part@2x.png"

local ZERO = Vector2.zero

-- a Vector2 from GetClassIcon (Roblox: typeof "Vector2"; mocks: anything with numeric X / Y), else (0, 0)
local function vector(v)
	if typeof(v) == "Vector2" then
		return v
	end
	local ok, numeric = pcall(function()
		return type(v.X) == "number" and type(v.Y) == "number"
	end)
	return (ok and numeric) and v or ZERO
end

local function entry(path, tint)
	return { Image = Icons.BASE .. path, ImageRectOffset = ZERO, ImageRectSize = ZERO, tint = tint }
end

function Icons.has(name)
	return type(name) == "string" and (Icons.GLYPHS[name] ~= nil or Icons.COLORED[name] ~= nil)
end

function Icons.get(name)
	local glyph = Icons.GLYPHS[name]
	if glyph then
		return entry(glyph, true)
	end
	local colored = Icons.COLORED[name]
	if colored then
		return entry(string.format(colored, Theme.name), false)
	end
	return nil
end

function Icons.toolbar()
	return Icons.BASE .. string.format(Icons.TOOLBAR, Theme.name)
end

-- StudioService:GetClassIcon returns a dictionary { Image, ImageRectOffset, ImageRectSize } (PluginSecurity)
local studioService = nil
local classCache = {}
local cacheTheme = nil

local function getStudioService()
	if studioService == nil then
		local ok, s = pcall(function()
			return game:GetService("StudioService")
		end)
		studioService = ok and s or false
	end
	return studioService or nil
end

function Icons.class(className)
	if cacheTheme ~= Theme.name then -- the icons of the other theme are other images
		classCache, cacheTheme = {}, Theme.name
	end
	local cached = classCache[className]
	if cached then
		return cached
	end
	local icon = nil
	local service = getStudioService()
	if service then
		local ok, info = pcall(function()
			return service:GetClassIcon(className)
		end)
		if ok and type(info) == "table" and type(info.Image) == "string" and info.Image ~= "" then
			icon = { Image = info.Image, ImageRectOffset = vector(info.ImageRectOffset), ImageRectSize = vector(info.ImageRectSize),
				tint = false }
		end
	end
	if not icon then
		local file = Icons.CLASSES[className]
		if file then
			icon = entry(string.format("Shared/InsertableObjects/%s/Standard/%s.png", Theme.name, file), false)
		else
			icon = entry(Icons.GLYPHS.placeholder, true)
		end
	end
	classCache[className] = icon
	return icon
end

function Icons.apply(image, icon)
	image.Image = icon.Image
	image.ImageRectOffset = icon.ImageRectOffset
	image.ImageRectSize = icon.ImageRectSize
	return image
end

-- ---------------------------------------------------------------------------------------------
-- glyphs drawn from frames: for places where an image cannot be used, and the LostCube mark
-- ---------------------------------------------------------------------------------------------
local function line(holder, x1, y1, x2, y2, width, color)
	local dx, dy = x2 - x1, y2 - y1
	local length = math.sqrt(dx * dx + dy * dy)
	local bar = Instance.new("Frame")
	bar.Name = "Line"
	bar.BorderSizePixel = 0
	bar.BackgroundColor3 = color
	bar.AnchorPoint = Vector2.new(0.5, 0.5)
	bar.Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2)
	bar.Size = UDim2.fromOffset(length + width * 0.5, width)
	bar.Rotation = math.deg(math.atan2(dy, dx))
	bar.Parent = holder
	return bar
end

-- shapes on a 16-unit grid (scaled to `size`)
local SHAPES = {
	chevron = { { 6, 4, 10, 8 }, { 10, 8, 6, 12 } },
	plus = { { 8, 3, 8, 13 }, { 3, 8, 13, 8 } },
	minus = { { 3, 8, 13, 8 } },
	close = { { 4, 4, 12, 12 }, { 12, 4, 4, 12 } },
	check = { { 3.5, 8.5, 6.5, 11.5 }, { 6.5, 11.5, 12.5, 4.5 } },
	-- a wireframe cube: front face, back face, the four edges between them
	cube = { { 2, 6, 11, 6 }, { 11, 6, 11, 15 }, { 11, 15, 2, 15 }, { 2, 15, 2, 6 },
		{ 5, 2, 14, 2 }, { 14, 2, 14, 11 }, { 2, 6, 5, 2 }, { 11, 6, 14, 2 }, { 11, 15, 14, 11 } },
}

function Icons.drawable(name)
	return SHAPES[name] ~= nil
end

-- a transparent Frame of size x size holding the shape; lines are `width` px (default 1.5 at 16 px)
function Icons.draw(parent, name, size, color, width)
	size = size or 16
	local holder = Instance.new("Frame")
	holder.Name = "Glyph"
	holder.BackgroundTransparency = 1
	holder.BorderSizePixel = 0
	holder.Size = UDim2.fromOffset(size, size)
	local k = size / 16
	local w = (width or 1.5) * math.max(1, k * 0.75)
	if name == "dot" then
		local dot = Instance.new("Frame")
		dot.BorderSizePixel = 0
		dot.BackgroundColor3 = color
		dot.AnchorPoint = Vector2.new(0.5, 0.5)
		dot.Position = UDim2.fromScale(0.5, 0.5)
		dot.Size = UDim2.fromOffset(math.floor(6 * k), math.floor(6 * k))
		local round = Instance.new("UICorner")
		round.CornerRadius = UDim.new(1, 0)
		round.Parent = dot
		dot.Parent = holder
	else
		for _, seg in SHAPES[name] or {} do
			line(holder, seg[1] * k, seg[2] * k, seg[3] * k, seg[4] * k, w, color)
		end
	end
	holder.Parent = parent
	return holder
end

return Icons
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX18"><Properties><string name="Name">Modeling</string><ProtectedString name="Source"><![CDATA[--[[ LostCube Modeling - fast 3D modeling in Studio (plugin-only engine; the panel and Claude's tools call this API).
Every operation that changes the place is ONE undo step (ChangeHistoryService) and returns what it created / changed.
Bad input raises an error with a Romanian message and changes nothing; engine failures that are not the caller's fault
(CSG, EditableMesh) return nil + message (the step is rolled back). `targets` = a BasePart / Model / Folder, a list of
them, or nil = the current Selection. Vectors may be Vector3 or { x, y, z }. The maths lives in Geometry (pure,
unit-tested), the procedural builders in Generators, meshes in Mesh, the build format in Spec (Spec.DOC).
Algorithms reimplemented from published ideas: triangle -> 2 wedges and GapFill / ResizeAlign (stravant, MIT),
Part -> Terrain (Quenty, MIT); see docs/modeling-research.md.

	local Modeling = require(LostCube.Modeling)
	-- fills (GapFill / triangle fill)
	Modeling.triangleFill(a, b, c, opts)         -> { WedgePart }  any 3D triangle as 1-2 wedges; opts: thickness (0.2),
	                                                align "center"|"front"|"back", color, material, source (a part whose
	                                                look is copied), parent
	Modeling.polygonFill(points, opts)           -> { WedgePart }  any simple polygon (ear clipping), opts as above
	Modeling.gapFill(edgeA, edgeB, opts)         -> { BasePart }   edges { Vector3, Vector3 }, or two parts (their facing
	                                                edges); parallel edges: one block + a wedge per end
	Modeling.partEdges(part), Modeling.closestEdges(partA, partB)
	-- arrays (count = TOTAL items, the original included)
	Modeling.linearArray(targets, { offset, count })                      -> copies
	Modeling.radialArray(targets, { count, center? | radius?, axis = Y, angle = 360 })
	Modeling.arcArray(targets, { count, angle = 15, axis = "Y", radius = 0, length?, pivot? })  Archimedes: each copy
	                                                continues the previous one and turns around the shared edge
	Modeling.pathArray(targets, points | spline, spacing, { align = true, tension = 0 })
	-- transforms
	Modeling.mirror(targets, plane, { copy = true }) -> { Instance }, warnings   plane "X"|"Y"|"Z" (through the group's
	                                                centre) or { point, normal }; wedges, corner wedges and attachments
	                                                are re-oriented so the result is a true mirror image
	Modeling.align(targets, axis, mode, target?)    mode "min"|"center"|"max"; target: number | Instance | "first"
	Modeling.distribute(targets, axis, mode?)       mode "gap" (equal spaces, default) | "center"
	Modeling.snapToGrid(targets, grid, { rotation? })
	Modeling.dropToSurface(targets, { alignToNormal, offset, maxDistance }) -> moved, missed
	Modeling.extendTo(part, face, target, { mode = "center"|"outer"|"inner", targetFace? }) -> part, distance  (ResizeAlign;
	                                                target: a part, { part, face } or { point, normal })
	Modeling.scatter(surfaces | { cframe, size }, templates, { count | density (per 10 000 stud^2), minDistance = 2,
	                 randomRotation, scaleRange, weights, alignToNormal, maxSlope = 30, sink, seed, parent })
	                                             -> Model, report   (Brushtool; deterministic for a seed)
	Modeling.toTerrain(targets, { material?, keep? }) -> fills       parts -> smooth terrain
	-- curves
	Modeling.spline(points, { tension, alpha = 0.5, segments, closed }) -> { at, tangent, atDistance, points(spacing),
	                                                cframes(spacing), length }   (centripetal Catmull-Rom)
	Modeling.alongSpline(kind | template, points, opts) -> Model, report   kind "rail"|"pipe"|"cable"|"road"|"wall"|"fence";
	                                                opts: spacing, width, thickness, height, diameter, color, material
	-- solids and hygiene
	Modeling.merge(targets, opts) -> UnionOperation | nil, err   (chunks of 150)   Modeling.subtract(base, cutters, opts)
	Modeling.optimize(root, opts) -> report         Modeling.weldAll(root, opts) -> welds   Modeling.group(targets, name)
	-- generators (Modeling.GENERATORS: keys, labels, parameter schemas; Modeling.SCALE: Roblox scale constants)
	Modeling.generate(kind, params, parent?, cframe?) -> Model?, report      Modeling.regenerate(model, params?)
	Modeling.generatorHelp(kind?) -> text           Modeling.placement(distance?) -> CFrame on the ground in front of the camera
	-- procedural meshes: parts (wedges) by default; mode "mesh" / "auto" uses EditableMesh -> MeshPart when the
	-- experience allows it (such a MeshPart may not survive saving the place without an upload)
	Modeling.mesh(kind, params, parent?, cframe?, { mode = "parts"|"auto"|"mesh" }) -> Instance, report
	                 kind "lathe" { profile, segments }, "extrude" { polygon, depth, bevel }, "rock" { seed, detail, size },
	                 "terrain" { heights | seed, size, resolution, amplitude }; params.color / params.material
	Modeling.rebuildMesh(instance, opts) -> Instance, report       Modeling.meshAvailable() -> bool, reason
	-- spec (the compact format for Claude: Modeling.SPEC_DOC) and readback
	Modeling.buildFromSpec(spec | json, parent?, cframe?) -> Model, report     Modeling.validateSpec(spec) -> ok, errors, parts
	Modeling.describe(instance | list, { maxParts = 500, budget? }) -> spec (+ bounds, count, summary)
	Modeling.summary(instance | list, { budget? }) -> text   (bbox, counts, materials, floating / default-gray / unanchored)
	Modeling.selfCheck() -> { wedge, cornerWedge, editableMesh, notes }   runtime check of the shape conventions
]]
local ChangeHistoryService = game:GetService("ChangeHistoryService")
local Selection = game:GetService("Selection")

local Geometry = require(script.Geometry)
local Generators = require(script.Generators)
local Mesh = require(script.Mesh)
local Spec = require(script.Spec)
local V, M, F = Geometry.V, Geometry.M, Geometry.F

local Modeling = {}
Modeling.VERSION = "2.1.0"
Modeling.Geometry = Geometry
Modeling.Generators = Generators
Modeling.Mesh = Mesh
Modeling.Spec = Spec
Modeling.SCALE = Generators.SCALE
Modeling.LIMITS = Spec.LIMITS
Modeling.GENERATORS = Generators.LIST
Modeling.SPEC_DOC = Spec.DOC

-- ---------------------------------------------------------------------------------------------
-- conversions (Roblox datatypes <-> Geometry's plain tables)
-- ---------------------------------------------------------------------------------------------
local function toV3(v)
	return Vector3.new(v[1], v[2], v[3])
end
local function fromV3(v)
	return { v.X, v.Y, v.Z }
end
local function toCF(f)
	local p, r = f.p, f.r
	return CFrame.new(p[1], p[2], p[3], r[1], r[2], r[3], r[4], r[5], r[6], r[7], r[8], r[9])
end
local function fromCF(cf)
	local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = cf:GetComponents()
	return { p = { x, y, z }, r = { r00, r01, r02, r10, r11, r12, r20, r21, r22 } }
end
Modeling.toVector3, Modeling.fromVector3, Modeling.toCFrame, Modeling.fromCFrame = toV3, fromV3, toCF, fromCF

-- Vector3 or { x, y, z } -> plain vector; `what` names the argument in the error
local function vecArg(v, what)
	if typeof(v) == "Vector3" then
		return fromV3(v)
	end
	local out = V.from(v)
	if not out then
		error("„" .. what .. "” trebuie să fie un Vector3 (sau { x, y, z }).", 0)
	end
	return out
end

local function cframeArg(cf, what)
	if cf == nil then
		return CFrame.new()
	end
	if typeof(cf) ~= "CFrame" then
		error("„" .. (what or "cframe") .. "” trebuie să fie un CFrame.", 0)
	end
	return cf
end

local function toColor3(c)
	if typeof(c) == "Color3" then
		return c
	end
	local hex = Spec.hexColor(c)
	if hex then
		return Color3.fromHex(hex)
	end
	return nil
end

local function materialItem(m)
	if typeof(m) == "EnumItem" then
		return m
	end
	if type(m) ~= "string" then
		return nil
	end
	local ok, item = pcall(function()
		return (Enum.Material :: any)[m]
	end)
	return ok and item or nil
end

-- part materials (Air and Water are terrain-only)
local function isPartMaterial(name)
	return name ~= "Air" and name ~= "Water" and materialItem(name) ~= nil
end
local function isTerrainMaterial(name)
	return materialItem(name) ~= nil
end
-- the checker Generators / Spec get: forTerrain = the value goes to Terrain:Fill*
local function materialCheck(name, forTerrain)
	if forTerrain then
		return isTerrainMaterial(name)
	end
	return isPartMaterial(name)
end
Modeling.isMaterial = materialCheck

-- ---------------------------------------------------------------------------------------------
-- undo: one recording per operation (nested calls join the outer one)
-- ---------------------------------------------------------------------------------------------
local depth = 0
local function record(name, fn, ...)
	if depth > 0 then
		return fn(...)
	end
	local okBegin, id = pcall(ChangeHistoryService.TryBeginRecording, ChangeHistoryService, "LostCube: " .. name)
	depth += 1
	local results = table.pack(pcall(fn, ...))
	depth -= 1
	if okBegin and id then
		-- a failed step is rolled back, a good one becomes one Ctrl+Z
		local op = results[1] and Enum.FinishRecordingOperation.Commit or Enum.FinishRecordingOperation.Cancel
		pcall(ChangeHistoryService.FinishRecording, ChangeHistoryService, id, op)
	end
	if not results[1] then
		error(results[2], 0)
	end
	return table.unpack(results, 2, results.n)
end

-- engine failures become nil + message (the step was rolled back)
local function soft(name, fn, ...)
	local results = table.pack(pcall(record, name, fn, ...))
	if not results[1] then
		-- drop a "Script.Path:12: " prefix (our own messages have none)
		return nil, (string.gsub(tostring(results[2]), "^[^%s:]+:%d+: ", ""))
	end
	return table.unpack(results, 2, results.n)
end

-- ---------------------------------------------------------------------------------------------
-- targets
-- ---------------------------------------------------------------------------------------------
local function isPart(x)
	return typeof(x) == "Instance" and x:IsA("BasePart") and not x:IsA("Terrain")
end
local function isObject(x)
	return isPart(x) or (typeof(x) == "Instance" and x:IsA("Model"))
end

-- top-level BaseParts / Models of the input (Folders expand to their children), no duplicates, no descendants of
-- another item of the list
local function objectsOf(input)
	if input == nil then
		input = Selection:Get()
	elseif typeof(input) == "Instance" then
		input = { input }
	end
	if type(input) ~= "table" then
		error("Țintele trebuie să fie o piesă, un model sau o listă de piese / modele.", 0)
	end
	local list, seen = {}, {}
	local function add(x)
		if isObject(x) then
			if not seen[x] then
				seen[x] = true
				table.insert(list, x)
			end
		elseif typeof(x) == "Instance" and (x:IsA("Folder") or x:IsA("WorldModel")) then
			for _, c in x:GetChildren() do
				add(c)
			end
		end
	end
	for _, x in input do
		add(x)
	end
	local out = {}
	for _, x in list do
		local nested = false
		local p = x.Parent
		while p do
			if seen[p] then
				nested = true
				break
			end
			p = p.Parent
		end
		if not nested then
			table.insert(out, x)
		end
	end
	return out
end

local function partsOf(input)
	local out, seen = {}, {}
	for _, obj in objectsOf(input) do
		if isPart(obj) then
			if not seen[obj] then
				seen[obj] = true
				table.insert(out, obj)
			end
		else
			for _, d in obj:GetDescendants() do
				if isPart(d) and not seen[d] then
					seen[d] = true
					table.insert(out, d)
				end
			end
		end
	end
	return out
end

local function requireObjects(input, minimum)
	local objs = objectsOf(input)
	if #objs < (minimum or 1) then
		if (minimum or 1) <= 1 then
			error("Selectează cel puțin o piesă sau un model.", 0)
		end
		error("Selectează cel puțin " .. minimum .. " piese sau modele.", 0)
	end
	return objs
end

function Modeling.selection()
	return objectsOf(nil)
end

-- the box of an object: frame + size (Models: GetBoundingBox)
local function boxOf(obj)
	if obj:IsA("Model") then
		local cf, size = obj:GetBoundingBox()
		return fromCF(cf), fromV3(size)
	end
	return fromCF(obj.CFrame), fromV3(obj.Size)
end

local function worldBounds(obj)
	local f, size = boxOf(obj)
	return Geometry.bounds(Geometry.boxCorners(f, size))
end

-- the shape name of a part ("Block", "Wedge", ...) or nil for meshes / unions / others
local function shapeOf(part)
	if part:IsA("WedgePart") then
		return "Wedge"
	elseif part:IsA("CornerWedgePart") then
		return "CornerWedge"
	elseif part:IsA("Part") then
		return part.Shape.Name
	end
	return nil
end
Modeling.shapeOf = shapeOf

-- ---------------------------------------------------------------------------------------------
-- pieces -> Instances
-- ---------------------------------------------------------------------------------------------
local CLASS = { Block = "Part", Cylinder = "Part", Ball = "Part", Wedge = "WedgePart", CornerWedge = "CornerWedgePart" }
local DEFAULT_COLOR = Spec.DEFAULT_COLOR

local function clampSize(size)
	local out = {}
	for i = 1, 3 do
		out[i] = math.max(Geometry.MIN_SIZE, math.min(Geometry.MAX_SIZE, size[i]))
	end
	return out
end

-- one piece (frame already in world space) -> a new, unparented part
local function makePart(pc, world)
	local className = (pc.class == "Seat") and "Seat" or CLASS[pc.shape] or "Part"
	local part = Instance.new(className)
	if (className == "Part" or className == "Seat") and pc.shape ~= "Block" then
		part.Shape = (Enum.PartType :: any)[pc.shape]
	end
	part.Name = pc.name or Spec.DEFAULT_NAME[pc.shape] or "Part"
	part.Anchored = pc.anchored ~= false
	part.Size = toV3(clampSize(pc.size))
	part.CFrame = toCF(world)
	part.Color = toColor3(pc.color) or (Color3.fromHex(DEFAULT_COLOR) :: any)
	part.Material = materialItem(pc.material) or Enum.Material.Plastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	if pc.transparency and pc.transparency > 0 then
		part.Transparency = pc.transparency
	end
	if pc.reflectance and pc.reflectance > 0 then
		part.Reflectance = pc.reflectance
	end
	if pc.canCollide == false then
		part.CanCollide = false
		part.CanTouch = false
	end
	if pc.castShadow == false then
		part.CastShadow = false
	end
	if pc.light then
		local light = Instance.new("PointLight")
		light.Range = pc.light.range or 16
		light.Brightness = pc.light.brightness or 1
		light.Color = toColor3(pc.light.color) or Color3.new(1, 1, 1)
		light.Parent = part
	end
	return part
end

-- pieces (local to `origin`, a frame) -> parts parented to `parent` (which is not in the workspace yet: one
-- replication / physics update for the whole model). Big builds yield now and then so Studio stays responsive.
local function buildPieces(pieces, parent, origin)
	local out = {}
	for i, pc in pieces do
		local part = makePart(pc, F.mul(origin, pc.cf))
		part.Parent = parent
		table.insert(out, part)
		if i % 500 == 0 then
			task.wait()
		end
	end
	return out
end

local function newModel(name, parent, origin)
	local model = Instance.new("Model")
	model.Name = name
	model:SetAttribute("LC_Tool", "LostCube")
	model.WorldPivot = toCF(origin)
	return model
end

-- the look of a fill: opts.color / opts.material, or copied from opts.source
local function lookFrom(opts)
	local look = {}
	local src = opts.source
	if isPart(src) then
		look.color = src.Color
		look.material = src.Material
		look.transparency = src.Transparency
		look.reflectance = src.Reflectance
	end
	if opts.color ~= nil then
		look.color = toColor3(opts.color) or error("Culoarea trebuie să fie un Color3 sau „#rrggbb”.", 0)
	end
	if opts.material ~= nil then
		look.material = materialItem(opts.material) or error("Material necunoscut: " .. tostring(opts.material), 0)
	end
	return look
end

local function withLook(pieces, look, name)
	for _, pc in pieces do
		for k, v in look do
			pc[k] = v
		end
		pc.name = pc.name or name
	end
	return pieces
end

local function defaultParent(opts, fallback)
	if opts.parent ~= nil then
		if typeof(opts.parent) ~= "Instance" then
			error("„parent” trebuie să fie un Instance.", 0)
		end
		return opts.parent
	end
	return fallback or workspace
end

-- ---------------------------------------------------------------------------------------------
-- 1. fills
-- ---------------------------------------------------------------------------------------------
function Modeling.triangleFill(a, b, c, opts)
	opts = opts or {}
	local wedges, err = Geometry.triangleWedges(vecArg(a, "a"), vecArg(b, "b"), vecArg(c, "c"), {
		thickness = opts.thickness, align = opts.align })
	if not wedges then
		error(err, 0)
	end
	withLook(wedges, lookFrom(opts), "Umplere")
	return record("umplere triunghi", function()
		return buildPieces(wedges, defaultParent(opts, opts.source and opts.source.Parent), F.IDENTITY)
	end)
end

function Modeling.polygonFill(points, opts)
	opts = opts or {}
	if type(points) ~= "table" then
		error("Poligonul trebuie să fie o listă de puncte (Vector3).", 0)
	end
	local pts = {}
	for i, p in points do
		pts[i] = vecArg(p, "points[" .. i .. "]")
	end
	local wedges, err = Geometry.polygonWedges(pts, { thickness = opts.thickness, align = opts.align })
	if not wedges then
		error(err, 0)
	end
	withLook(wedges, lookFrom(opts), "Umplere")
	return record("umplere poligon", function()
		return buildPieces(wedges, defaultParent(opts, opts.source and opts.source.Parent), F.IDENTITY)
	end)
end

-- the 12 edges of a part's box: { { Vector3, Vector3 } }
function Modeling.partEdges(part)
	if not isPart(part) then
		error("partEdges are nevoie de o piesă.", 0)
	end
	local f, size = fromCF(part.CFrame), fromV3(part.Size)
	local h = V.scale(size, 0.5)
	local edges = {}
	for axis = 1, 3 do
		local j, k = axis % 3 + 1, (axis + 1) % 3 + 1
		for _, sj in { -1, 1 } do
			for _, sk in { -1, 1 } do
				local a, b = { 0, 0, 0 }, { 0, 0, 0 }
				a[axis], b[axis] = -h[axis], h[axis]
				a[j], b[j] = sj * h[j], sj * h[j]
				a[k], b[k] = sk * h[k], sk * h[k]
				table.insert(edges, { toV3(F.point(f, a)), toV3(F.point(f, b)) })
			end
		end
	end
	return edges
end

-- the pair of edges (one per part) that face each other best: close and parallel, not touching; on a tie the longest
-- pair (two parallel parts: the long edges, not the short ones)
function Modeling.closestEdges(partA, partB)
	local best, bestScore, bestLen
	for _, ea in Modeling.partEdges(partA) do
		for _, eb in Modeling.partEdges(partB) do
			local a1, a2, b1, b2 = fromV3(ea[1]), fromV3(ea[2]), fromV3(eb[1]), fromV3(eb[2])
			local da, db = V.sub(a2, a1), V.sub(b2, b1)
			local la, lb = V.len(da), V.len(db)
			local parallel = math.abs(V.dot(da, db)) / math.max(1e-9, la * lb)
			local dist = V.dist(V.mid(a1, a2), V.mid(b1, b2))
			if dist > 1e-3 then
				local score = dist + (1 - parallel) * (la + lb)
				local length = math.min(la, lb)
				if not bestScore or score < bestScore - 1e-6 or (score < bestScore + 1e-6 and length > bestLen) then
					best, bestScore, bestLen = { ea, eb }, score, length
				end
			end
		end
	end
	return best[1], best[2]
end

function Modeling.gapFill(edgeA, edgeB, opts)
	opts = opts or {}
	if isPart(edgeA) and isPart(edgeB) then
		opts.source = opts.source or edgeA
		edgeA, edgeB = Modeling.closestEdges(edgeA, edgeB)
	end
	if type(edgeA) ~= "table" or type(edgeB) ~= "table" then
		error("gapFill are nevoie de două muchii { Vector3, Vector3 } (sau două piese).", 0)
	end
	local ea = { vecArg(edgeA[1], "edgeA[1]"), vecArg(edgeA[2], "edgeA[2]") }
	local eb = { vecArg(edgeB[1], "edgeB[1]"), vecArg(edgeB[2], "edgeB[2]") }
	local pieces, err = Geometry.gapFill(ea, eb, { thickness = opts.thickness, align = opts.align })
	if not pieces then
		error(err, 0)
	end
	withLook(pieces, lookFrom(opts), "Umplere")
	return record("umplere spațiu", function()
		return buildPieces(pieces, defaultParent(opts, opts.source and opts.source.Parent), F.IDENTITY)
	end)
end

-- ---------------------------------------------------------------------------------------------
-- 2. arrays
-- ---------------------------------------------------------------------------------------------
local function cloneMoved(objs, transforms)
	local out = {}
	for _, tf in transforms do
		local cf = toCF(tf)
		for _, obj in objs do
			local copy = obj:Clone()
			if not copy then
				error("„" .. obj.Name .. "” nu poate fi copiat (Archivable = false).", 0)
			end
			copy:PivotTo(cf * obj:GetPivot())
			copy.Parent = obj.Parent
			table.insert(out, copy)
		end
	end
	return out
end

-- the group's oriented box in the first object's pivot rotation
local function groupBox(objs)
	if #objs == 1 then
		local f, size = boxOf(objs[1])
		return { cf = f, size = size }
	end
	local rot = fromCF(objs[1]:GetPivot()).r
	local boxes = {}
	for _, obj in objs do
		local f, size = boxOf(obj)
		table.insert(boxes, { cf = f, size = size })
	end
	local cf, size = Geometry.orientedBounds(rot, boxes)
	return { cf = cf, size = size }
end

local function groupCenter(objs)
	local lo, hi
	for _, obj in objs do
		local b = worldBounds(obj)
		if not lo then
			lo, hi = b.min, b.max
		else
			lo = { math.min(lo[1], b.min[1]), math.min(lo[2], b.min[2]), math.min(lo[3], b.min[3]) }
			hi = { math.max(hi[1], b.max[1]), math.max(hi[2], b.max[2]), math.max(hi[3], b.max[3]) }
		end
	end
	return V.mid(lo, hi), lo, hi
end

function Modeling.linearArray(targets, opts)
	opts = opts or {}
	local objs = requireObjects(targets)
	local transforms, err = Geometry.linearTransforms(vecArg(opts.offset, "offset"), opts.count or 2)
	if not transforms then
		error(err, 0)
	end
	return record("matrice liniară", cloneMoved, objs, transforms)
end

function Modeling.radialArray(targets, opts)
	opts = opts or {}
	local objs = requireObjects(targets)
	local center
	if opts.center ~= nil then
		center = vecArg(opts.center, "center")
	else
		local pivot = objs[1]:GetPivot()
		center = fromV3(pivot.Position + pivot.LookVector * (opts.radius or 10))
	end
	local axis = opts.axis ~= nil and vecArg(opts.axis, "axis") or { 0, 1, 0 }
	local transforms, err = Geometry.radialTransforms(center, axis, opts.count or 8, opts.angle or 360)
	if not transforms then
		error(err, 0)
	end
	return record("matrice circulară", cloneMoved, objs, transforms)
end

function Modeling.arcArray(targets, opts)
	opts = opts or {}
	local objs = requireObjects(targets)
	local transforms, err = Geometry.arcTransforms(groupBox(objs), {
		axis = opts.axis, angle = opts.angle, count = opts.count, radius = opts.radius, length = opts.length,
		pivot = opts.pivot ~= nil and vecArg(opts.pivot, "pivot") or nil })
	if not transforms then
		error(err, 0)
	end
	return record("matrice în arc", cloneMoved, objs, transforms)
end

local function splineOf(curve, opts)
	if type(curve) == "table" and curve.raw and curve.raw.frames then
		return curve.raw
	end
	if type(curve) ~= "table" then
		error("Curba trebuie să fie o listă de puncte sau un Modeling.spline.", 0)
	end
	local pts = {}
	for i, p in curve do
		pts[i] = vecArg(p, "points[" .. i .. "]")
	end
	local sp, err = Geometry.spline(pts, { tension = opts and opts.tension, closed = opts and opts.closed })
	if not sp then
		error(err, 0)
	end
	return sp
end

function Modeling.pathArray(targets, curve, spacing, opts)
	opts = opts or {}
	local objs = requireObjects(targets)
	if type(spacing) ~= "number" or spacing <= 0 then
		error("Distanța dintre copii trebuie să fie un număr pozitiv.", 0)
	end
	local sp = splineOf(curve, opts)
	local transforms = Spec.pathTransforms(sp, spacing, fromCF(objs[1]:GetPivot()), opts.align ~= false)
	if #transforms * #objs > 2000 then
		error("Prea multe copii (" .. #transforms * #objs .. "; maxim 2000).", 0)
	end
	return record("copii pe traseu", cloneMoved, objs, transforms)
end

-- ---------------------------------------------------------------------------------------------
-- 3. transforms
-- ---------------------------------------------------------------------------------------------
local function planeArg(plane, objs)
	if plane == "X" or plane == "Y" or plane == "Z" then
		local n = Geometry.unitAxis(Geometry.AXIS[plane])
		return (groupCenter(objs)), n
	end
	if type(plane) == "table" and plane.normal ~= nil then
		local n = vecArg(plane.normal, "plane.normal")
		if V.len(n) < 1e-9 then
			error("Normala planului nu poate fi zero.", 0)
		end
		return plane.point ~= nil and vecArg(plane.point, "plane.point") or (groupCenter(objs)), V.unit(n) :: any
	end
	error("Planul trebuie să fie \"X\", \"Y\", \"Z\" sau { point = Vector3, normal = Vector3 }.", 0)
end

-- mirrors one part in place (and its attachments); returns false when the result is only approximate
local function mirrorPart(part, q, n)
	local shape = shapeOf(part)
	local before = fromCF(part.CFrame)
	local f, size, exact = Geometry.mirrorFrame(before, fromV3(part.Size), shape or "Mesh", q, n)
	-- new = reflect * old * fix, so the local reflection is fix = old^-1 * reflect * new (reflect^-1 = reflect)
	local fix = M.mul(M.transpose(before.r), M.mul(Geometry.reflection(n), f.r))
	part.Size = toV3(size)
	part.CFrame = toCF(f)
	for _, child in part:GetChildren() do
		if child:IsA("Attachment") then
			local a = fromCF(child.CFrame)
			-- world = old * a  ->  reflect(world) = new * (fix * a * fix)
			child.CFrame = toCF({ p = M.apply(fix, a.p), r = M.mul(fix, M.mul(a.r, fix)) })
		end
	end
	return exact
end

function Modeling.mirror(targets, plane, opts)
	opts = opts or {}
	local objs = requireObjects(targets)
	local q, n = planeArg(plane, objs)
	return record("oglindire", function()
		local out, warnings = {}, {}
		for _, obj in objs do
			local item = obj
			if opts.copy ~= false then
				item = obj:Clone()
				if not item then
					error("„" .. obj.Name .. "” nu poate fi copiat (Archivable = false).", 0)
				end
				item.Parent = obj.Parent
			end
			local parts = isPart(item) and { item } or {}
			local welds = {}
			if not isPart(item) then
				for _, d in item:GetDescendants() do
					if isPart(d) then
						table.insert(parts, d)
					elseif d:IsA("WeldConstraint") and d.Enabled then
						d.Enabled = false -- moving one welded part would drag the others
						table.insert(welds, d)
					elseif d:IsA("JointInstance") then
						table.insert(warnings, "„" .. d.Name .. "” (" .. d.ClassName .. "): C0 / C1 nu sunt oglindite; refă sudura.")
					end
				end
			end
			for _, part in parts do
				if not mirrorPart(part, q, n) then
					table.insert(warnings, "„" .. part.Name .. "” (" .. part.ClassName .. "): un mesh nu se poate inversa; e corect doar dacă e simetric.")
				end
			end
			for _, w in welds do
				w.Enabled = true
			end
			if item:IsA("Model") then
				local pivot = Geometry.mirrorFrame(fromCF(item.WorldPivot), { 1, 1, 1 }, "Block", q, n)
				item.WorldPivot = toCF(pivot)
			end
			table.insert(out, item)
		end
		return out, warnings
	end)
end

local function axisArg(axis)
	if axis ~= "X" and axis ~= "Y" and axis ~= "Z" then
		error("Axa trebuie să fie \"X\", \"Y\" sau \"Z\".", 0)
	end
	return axis
end

local function moveBy(obj, offset)
	if offset[1] ~= 0 or offset[2] ~= 0 or offset[3] ~= 0 then
		obj:PivotTo(obj:GetPivot() + toV3(offset))
	end
end

function Modeling.align(targets, axis, mode, target)
	local objs = requireObjects(targets)
	axisArg(axis)
	local boxes = {}
	for i, obj in objs do
		boxes[i] = worldBounds(obj)
	end
	local value = target
	if target == "first" then
		value = nil
		local only = Geometry.alignOffsets({ boxes[1] }, axis, mode)
		if not only then
			error("Modul trebuie să fie min, center sau max.", 0)
		end
		local i = Geometry.AXIS[axis]
		local b = boxes[1]
		value = (mode == "max" and b.max[i]) or (mode == "center" and (b.min[i] + b.max[i]) / 2) or b.min[i]
	elseif isObject(target) then
		local b = worldBounds(target)
		local i = Geometry.AXIS[axis]
		value = (mode == "max" and b.max[i]) or (mode == "center" and (b.min[i] + b.max[i]) / 2) or b.min[i]
	elseif target ~= nil and type(target) ~= "number" then
		error("Ținta alinierii: un număr, o piesă / un model sau \"first\".", 0)
	end
	local offsets, err = Geometry.alignOffsets(boxes, axis, mode, value)
	if not offsets then
		error(err, 0)
	end
	return record("aliniere " .. axis, function()
		for i, obj in objs do
			moveBy(obj, offsets[i])
		end
		return objs
	end)
end

function Modeling.distribute(targets, axis, mode)
	local objs = requireObjects(targets, 3)
	axisArg(axis)
	local boxes = {}
	for i, obj in objs do
		boxes[i] = worldBounds(obj)
	end
	local offsets, err = Geometry.distributeOffsets(boxes, axis, mode)
	if not offsets then
		error(err, 0)
	end
	return record("distribuire " .. axis, function()
		for i, obj in objs do
			moveBy(obj, offsets[i])
		end
		return objs
	end)
end

function Modeling.snapToGrid(targets, grid, opts)
	opts = opts or {}
	local objs = requireObjects(targets)
	if type(grid) ~= "number" or grid <= 0 then
		error("Pasul grilei trebuie să fie un număr pozitiv (studs).", 0)
	end
	if opts.rotation ~= nil and (type(opts.rotation) ~= "number" or opts.rotation <= 0) then
		error("Pasul de rotație trebuie să fie un număr pozitiv (grade).", 0)
	end
	return record("aliniere la grilă", function()
		for _, obj in objs do
			obj:PivotTo(toCF(Geometry.snapFrame(fromCF(obj:GetPivot()), grid, opts.rotation)))
		end
		return objs
	end)
end

-- the rotation that turns `from` onto `to` (unit vectors)
local function rotationBetween(from, to)
	local axis = V.cross(from, to)
	local s = V.len(axis)
	local c = V.dot(from, to)
	if s < 1e-9 then
		if c > 0 then
			return M.IDENTITY
		end
		return M.axisAngle(V.perpendicular(from), math.pi)
	end
	return M.axisAngle(V.scale(axis, 1 / s), math.atan2(s, c))
end

function Modeling.dropToSurface(targets, opts)
	opts = opts or {}
	local objs = requireObjects(targets)
	local maxDistance = opts.maxDistance or 512
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = objs
	-- the highest hit under the bottom face (centre + corners), cast from the top of the object
	local plans = {}
	for _, obj in objs do
		local b = worldBounds(obj)
		local cx, cz = (b.min[1] + b.max[1]) / 2, (b.min[3] + b.max[3]) / 2
		local hx, hz = (b.max[1] - b.min[1]) * 0.45, (b.max[3] - b.min[3]) * 0.45
		local best, centerHit
		for k, d in { { 0, 0 }, { -hx, -hz }, { hx, -hz }, { -hx, hz }, { hx, hz } } do
			local origin = Vector3.new(cx + d[1], b.max[2] + 0.01, cz + d[2])
			local hit = workspace:Raycast(origin, Vector3.new(0, -(b.max[2] - b.min[2] + maxDistance), 0), params)
			if hit then
				if k == 1 then
					centerHit = hit
				end
				if not best or hit.Position.Y > best.Position.Y then
					best = hit
				end
			end
		end
		if best then
			table.insert(plans, { obj = obj, y = best.Position.Y, bottom = { cx, b.min[2], cz }, normal = (centerHit or best).Normal })
		end
	end
	local missed = #objs - #plans
	if #plans == 0 then
		error("Nu am găsit nicio suprafață sub obiectele alese (în " .. maxDistance .. " studs).", 0)
	end
	return record("lăsat pe suprafață", function()
		local moved = {}
		for _, plan in plans do
			local obj = plan.obj
			local dy = plan.y - plan.bottom[2] + (opts.offset or 0)
			local pivot = obj:GetPivot()
			if opts.alignToNormal then
				-- lift onto the contact point, then turn the object's up onto the surface normal around that point
				local up = fromV3(pivot.UpVector)
				local r = rotationBetween(V.unit(up, { 0, 1, 0 }) :: any, V.unit(fromV3(plan.normal), { 0, 1, 0 }) :: any)
				local contact = { plan.bottom[1], plan.y, plan.bottom[3] }
				local turn = { p = V.sub(contact, M.apply(r, contact)), r = r }
				local lifted = F.translate(fromCF(pivot), { 0, dy, 0 })
				obj:PivotTo(toCF(F.mul(turn, lifted)))
			else
				obj:PivotTo(pivot + Vector3.new(0, dy, 0))
			end
			table.insert(moved, obj)
		end
		return moved, missed
	end)
end

local FACE_NAMES = { "Right", "Left", "Top", "Bottom", "Back", "Front" }
local function faceArg(face, what)
	if typeof(face) == "EnumItem" then
		face = face.Name
	end
	if not Geometry.FACES[face] then
		error("„" .. what .. "” trebuie să fie o față: " .. table.concat(FACE_NAMES, ", ") .. " (sau Enum.NormalId).", 0)
	end
	return face
end

-- target: BasePart (+ opts.targetFace, default: its face that looks back at ours), { part, face } or { point, normal }
function Modeling.extendTo(part, face, target, opts)
	opts = opts or {}
	if not isPart(part) then
		error("extendTo are nevoie de o piesă.", 0)
	end
	face = faceArg(face, "face")
	local f, size = fromCF(part.CFrame), fromV3(part.Size)
	local corners, n = Geometry.boxFace(f, size, face)
	local q, m
	local tpart, tface = target, opts.targetFace
	if type(target) == "table" and target.part ~= nil then
		tpart, tface = target.part, target.face
	end
	if isPart(tpart) then
		local tf, tsize = fromCF(tpart.CFrame), fromV3(tpart.Size)
		if tface == nil then
			local best
			for _, name in FACE_NAMES do
				local _, normal = Geometry.boxFace(tf, tsize, name)
				local d = V.dot(normal, n)
				if not best or d < best then
					best, tface = d, name
				end
			end
		end
		tface = faceArg(tface, "targetFace")
		local tc, tn = Geometry.boxFace(tf, tsize, tface)
		q = V.scale(V.add(V.add(tc[1], tc[2]), V.add(tc[3], tc[4])), 0.25)
		m = tn
	elseif type(target) == "table" and target.point ~= nil and target.normal ~= nil then
		q, m = vecArg(target.point, "target.point"), V.unit(vecArg(target.normal, "target.normal"), nil)
		if not m then
			error("Normala țintei nu poate fi zero.", 0)
		end
	else
		error("Ținta: o piesă, { part, face } sau { point, normal }.", 0)
	end
	local dist, err = Geometry.extendDistance(corners, n, q, m, opts.mode or "center")
	if not dist then
		error(err, 0)
	end
	local newFrame, newSize = Geometry.resizeFace(f, size, face, dist)
	if not newFrame then
		error(newSize, 0)
	end
	return record("extindere până la țintă", function()
		part.Size = toV3(newSize)
		part.CFrame = toCF(newFrame)
		return part, dist
	end)
end

-- ---------------------------------------------------------------------------------------------
-- 4. scatter (Brushtool)
-- ---------------------------------------------------------------------------------------------
-- opts: count (or density = items per 10 000 stud^2 of the area, default 50), minDistance (2), randomRotation (true =
-- any yaw, a number = +- that many degrees / 2, false = none), scaleRange ({ 1, 1 }; 0.8-1.25 looks natural),
-- weights ({ number } per template), alignToNormal (false), maxSlope (30 degrees), sink (0..1 of the template's
-- height pushed under the surface; 0.2-0.3 for rocks), seed (1), parent, name. Same seed + same surfaces = same result.
function Modeling.scatter(surfaces, templates, opts)
	opts = opts or {}
	local tmpl = objectsOf(templates)
	if #tmpl == 0 then
		error("Alege cel puțin un șablon (piesă sau model) de împrăștiat.", 0)
	end
	local seed = opts.seed or 1
	local rng = Geometry.rng(seed)
	local lo, hi
	local params = RaycastParams.new()
	local region = type(surfaces) == "table" and surfaces.cframe ~= nil and surfaces.size ~= nil
	if region then
		local f, size = fromCF(cframeArg(surfaces.cframe, "cframe")), vecArg(surfaces.size, "size")
		local b = Geometry.bounds(Geometry.boxCorners(f, size))
		lo, hi = b.min, b.max
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = tmpl
	else
		local surf = objectsOf(surfaces)
		if #surf == 0 then
			error("Alege suprafața (piese / modele) sau o regiune { cframe, size }.", 0)
		end
		local _, l, h = groupCenter(surf)
		lo, hi = l, h
		params.FilterType = Enum.RaycastFilterType.Include
		params.FilterDescendantsInstances = surf
	end
	local area = math.max(1, (hi[1] - lo[1]) * (hi[3] - lo[3]))
	local count = opts.count or math.floor(area / 10000 * (opts.density or 50) + 0.5)
	if type(count) ~= "number" or count < 1 or count > 5000 then
		error("Numărul de obiecte trebuie să fie între 1 și 5000 (zona e prea mică sau densitatea prea mare).", 0)
	end
	local weights = opts.weights
	local totalWeight = 0
	for i = 1, #tmpl do
		local w = weights and weights[i] or 1
		if type(w) ~= "number" or w < 0 then
			error("Greutățile șabloanelor trebuie să fie numere >= 0.", 0)
		end
		totalWeight += w
	end
	if totalWeight <= 0 then
		error("Cel puțin un șablon trebuie să aibă greutate > 0.", 0)
	end
	local function pick(r)
		local acc = r * totalWeight
		for i = 1, #tmpl do
			acc -= weights and weights[i] or 1
			if acc < 0 then
				return i
			end
		end
		return #tmpl
	end
	local minDistance = opts.minDistance or 2
	local scaleRange = opts.scaleRange or { 1, 1 }
	local minUp = math.cos(math.rad(opts.maxSlope or 30)) - 1e-6
	local points = Geometry.poissonSample(rng, lo[1], lo[3], hi[1], hi[3], count, minDistance)
	-- every template's bottom-centre relative to its pivot (world axes) and its height
	local bottoms, heights = {}, {}
	for i, t in tmpl do
		local b = worldBounds(t)
		local bottom = { (b.min[1] + b.max[1]) / 2, b.min[2], (b.min[3] + b.max[3]) / 2 }
		bottoms[i] = V.sub(fromV3(t:GetPivot().Position), bottom)
		heights[i] = b.max[2] - b.min[2]
	end
	local plans = {}
	for _, pt in points do
		-- the random choices are drawn for every point (hit or not), so a miss does not shift the next ones
		local which = pick(rng.next())
		local yaw = 0
		if opts.randomRotation ~= false then
			local maxYaw = type(opts.randomRotation) == "number" and opts.randomRotation or 360
			yaw = math.rad(rng.range(-maxYaw / 2, maxYaw / 2))
		end
		local s = rng.range(scaleRange[1], scaleRange[2])
		local origin = Vector3.new(pt[1], hi[2] + 1, pt[2])
		local hit = workspace:Raycast(origin, Vector3.new(0, -(hi[2] - lo[2] + 2), 0), params)
		if hit and hit.Normal.Y >= minUp then
			table.insert(plans, { which = which, yaw = yaw, scale = s, pos = fromV3(hit.Position), normal = fromV3(hit.Normal) })
		end
	end
	if #plans == 0 then
		error("Nicio poziție validă: razele nu au atins suprafața sau panta e peste " .. (opts.maxSlope or 30) .. "°.", 0)
	end
	return record("împrăștiere", function()
		local container = Instance.new("Model")
		container.Name = opts.name or "Împrăștiere"
		container:SetAttribute("LC_Tool", "LostCube")
		container:SetAttribute("LC_Seed", seed)
		local placed = {}
		for _, plan in plans do
			local t = tmpl[plan.which]
			local copy = t:Clone()
			if copy then
				local base = t:GetPivot()
				local rot = M.ry(plan.yaw)
				if opts.alignToNormal then
					rot = M.mul(rotationBetween({ 0, 1, 0 }, V.unit(plan.normal, { 0, 1, 0 }) :: any), rot)
				end
				if plan.scale ~= 1 then
					if copy:IsA("Model") then
						copy:ScaleTo(copy:GetScale() * plan.scale)
					else
						copy.Size = copy.Size * plan.scale
					end
				end
				local lift = V.scale(bottoms[plan.which], plan.scale)
				if opts.sink then
					lift = V.sub(lift, { 0, heights[plan.which] * plan.scale * opts.sink, 0 })
				end
				local target = { p = V.add(plan.pos, M.apply(rot, lift)), r = M.mul(rot, fromCF(base).r) }
				copy:PivotTo(toCF(target))
				copy.Parent = container
				table.insert(placed, copy)
			end
		end
		container.Parent = defaultParent(opts, workspace)
		return container, { placed = #placed, missed = #points - #plans, requested = count, seed = seed }
	end)
end

-- ---------------------------------------------------------------------------------------------
-- 5. splines
-- ---------------------------------------------------------------------------------------------
function Modeling.spline(points, opts)
	local sp = splineOf(points, opts)
	local s = { raw = sp, length = sp.length }
	function s.at(t)
		return toV3(sp.at(t))
	end
	function s.tangent(t)
		return toV3(sp.tangent(t))
	end
	function s.atDistance(d)
		return toV3(sp.atDistance(d))
	end
	function s.points(spacing)
		local out = {}
		for _, smp in sp.samples(spacing) do
			table.insert(out, toV3(smp.p))
		end
		return out
	end
	function s.cframes(spacing, up)
		local out = {}
		for _, fr in sp.frames(spacing, up and fromV3(up) or nil) do
			table.insert(out, toCF(fr))
		end
		return out
	end
	return s
end

local ALONG = {
	rail = { kind = "rod", diameter = 0.4, height = 3, caps = true, color = "#3a3a3a", material = "Metal", name = "Șină" },
	pipe = { kind = "rod", diameter = 2, height = 1, caps = true, color = "#8a8f95", material = "Metal", name = "Țeavă" },
	cable = { kind = "rod", diameter = 0.2, height = 0, caps = false, color = "#202020", material = "SmoothPlastic", name = "Cablu" },
	road = { kind = "strip", width = 16, thickness = 1, height = 0.5, color = "#3b3b3e", material = "Asphalt", name = "Drum" },
	wall = { kind = "strip", width = 1, thickness = 8, height = 4, color = "#8f8a80", material = "Cobblestone", name = "Zid" },
}

-- pieces along a curve (pure; used by alongSpline): rods with ball joints, or strips with wedge fills on the outside of
-- every turn so the edge stays continuous
local function alongPieces(sp, cfg, opts)
	local spacing = opts.spacing or 4
	local samples = sp.samples(spacing)
	local out = {}
	local look = { color = opts.color or cfg.color, material = opts.material or cfg.material }
	local up = { 0, opts.height or cfg.height, 0 }
	local pts = {}
	for i, smp in samples do
		pts[i] = V.add(smp.p, up)
	end
	if cfg.kind == "rod" then
		local d = opts.diameter or cfg.diameter
		for i = 1, #pts - 1 do
			local rod = Geometry.rod(pts[i], pts[i + 1], d)
			if rod then
				rod.size[1] += cfg.caps and 0 or d * 0.5
				table.insert(out, rod)
			end
		end
		if cfg.caps then
			for i = 2, #pts - 1 do
				table.insert(out, { shape = "Ball", size = { d, d, d }, cf = F.new(pts[i]) })
			end
		end
	else
		local w, h = opts.width or cfg.width, opts.thickness or cfg.thickness
		local dirs = {}
		for i = 1, #pts - 1 do
			local beam = Geometry.beam(pts[i], pts[i + 1], w, h)
			if beam then
				table.insert(out, beam)
			end
			dirs[i] = V.unit(V.sub(pts[i + 1], pts[i]), { 0, 0, -1 })
		end
		for i = 2, #pts - 1 do
			local d0, d1 = dirs[i - 1], dirs[i]
			if d0 and d1 then
				local turn = V.cross(d0, d1)
				local flat0 = V.unit({ d0[1], 0, d0[3] }, nil)
				local flat1 = V.unit({ d1[1], 0, d1[3] }, nil)
				if V.len(turn) > 1e-4 and flat0 and flat1 then
					-- the outside of the turn: a left turn ((d0 x d1).y > 0) opens its gap on the right (flat x up)
					local side = turn[2] > 0 and 1 or -1
					local r0 = V.scale(V.cross(flat0, { 0, 1, 0 }), side * w / 2)
					local r1 = V.scale(V.cross(flat1, { 0, 1, 0 }), side * w / 2)
					local wedges = Geometry.triangleWedges(pts[i], V.add(pts[i], r0), V.add(pts[i], r1), { thickness = h })
					for _, pc in (wedges or {}) do
						table.insert(out, pc)
					end
				end
			end
		end
	end
	return withLook(out, look, cfg.name)
end
Modeling.alongPieces = alongPieces

function Modeling.alongSpline(what, points, opts)
	opts = opts or {}
	local sp = splineOf(points, opts)
	if what == "fence" then
		local pts = {}
		for _, p in sp.samples(opts.spacing or 6) do
			table.insert(pts, p.p)
		end
		local params = table.clone(opts.params or {})
		params.points = pts
		return Modeling.generate("fence", params, opts.parent, CFrame.new())
	end
	if isObject(what) then
		local copies = Modeling.pathArray({ what }, { raw = sp }, opts.spacing or 4, opts)
		return copies, { parts = #copies }
	end
	local cfg = ALONG[what]
	if not cfg then
		error("Tip necunoscut „" .. tostring(what) .. "”: rail, pipe, cable, road, wall, fence sau o piesă / un model șablon.", 0)
	end
	local pieces = alongPieces(sp, cfg, opts)
	if #pieces > Spec.LIMITS.MAX_PARTS then
		error("Prea multe piese (" .. #pieces .. "); mărește distanța dintre puncte (spacing).", 0)
	end
	return record("construit pe traseu", function()
		local model = newModel(opts.name or cfg.name, nil, F.IDENTITY)
		buildPieces(pieces, model, F.IDENTITY)
		model.Parent = defaultParent(opts, workspace)
		return model, { parts = #pieces, length = sp.length }
	end)
end

-- ---------------------------------------------------------------------------------------------
-- 6. solids and hygiene
-- ---------------------------------------------------------------------------------------------
local CSG_CHUNK = 150
Modeling.CSG_CHUNK = CSG_CHUNK

local function fidelity(opts)
	local cf = opts.collisionFidelity and (Enum.CollisionFidelity :: any)[opts.collisionFidelity] or Enum.CollisionFidelity.Default
	local rf = opts.renderFidelity and (Enum.RenderFidelity :: any)[opts.renderFidelity] or Enum.RenderFidelity.Automatic
	return cf, rf
end

function Modeling.merge(targets, opts)
	opts = opts or {}
	local parts = partsOf(targets)
	if #parts < 2 then
		return nil, "Unirea are nevoie de cel puțin 2 piese."
	end
	local cf, rf = fidelity(opts)
	local function unite(list)
		local base = list[1]
		local others = table.move(list, 2, #list, 1, {})
		local ok, union = pcall(base.UnionAsync, base, others, cf, rf)
		if not ok or not union then
			error("Unirea (UnionAsync) a eșuat: " .. tostring(union), 0)
		end
		return union
	end
	return soft("unire piese", function()
		local base = parts[1]
		-- big selections are united in chunks of 150, then the chunks (one huge CSG call tends to fail)
		local level = parts
		local made = {}
		while #level > 1 do
			local nextLevel = {}
			for i = 1, #level, CSG_CHUNK do
				local chunk = table.move(level, i, math.min(#level, i + CSG_CHUNK - 1), 1, {})
				if #chunk == 1 then
					table.insert(nextLevel, chunk[1])
				else
					local union = unite(chunk)
					table.insert(made, union)
					table.insert(nextLevel, union)
				end
			end
			level = nextLevel
		end
		local union = level[1]
		for _, u in made do
			if u ~= union then
				u:Destroy()
			end
		end
		union.Name = opts.name or "Unire"
		union.Anchored = base.Anchored
		union.Parent = base.Parent
		if opts.decor then
			union.CollisionFidelity = Enum.CollisionFidelity.Box
		end
		if not opts.keep then
			for _, p in parts do
				p:Destroy()
			end
		end
		return union
	end)
end

function Modeling.subtract(base, cutters, opts)
	opts = opts or {}
	if not isPart(base) then
		return nil, "Scăderea are nevoie de o piesă de bază."
	end
	local cuts = partsOf(cutters)
	if #cuts == 0 then
		return nil, "Alege cel puțin o piesă care taie."
	end
	local cf, rf = fidelity(opts)
	return soft("scădere piese", function()
		local ok, union = pcall(base.SubtractAsync, base, cuts, cf, rf)
		if not ok or not union then
			error("Scăderea (SubtractAsync) a eșuat: " .. tostring(union), 0)
		end
		union.Name = base.Name
		union.Anchored = base.Anchored
		union.Parent = base.Parent
		base:Destroy()
		if not opts.keepCutters then
			for _, p in cuts do
				p:Destroy()
			end
		end
		return union
	end)
end

-- performance hygiene of a build. opts (defaults): anchorAll = true, decorSize = 1 (parts smaller than this on every
-- axis stop colliding / touching: canCollideDecor = true), shadowSize = 1.5 (smaller parts stop casting shadows:
-- castShadowSmall = true), renderFidelity = "Performance" (MeshParts / unions; false = keep), collisionFidelityBox = true
-- (non-colliding MeshParts / unions get Box collisions), dryRun = false (report only)
function Modeling.optimize(root, opts)
	opts = opts or {}
	local parts = partsOf(root)
	if #parts == 0 then
		error("Nu am găsit nicio piesă de optimizat.", 0)
	end
	local decor = opts.decorSize or 1
	local shadow = opts.shadowSize or 1.5
	local report = { parts = #parts, meshes = 0, unions = 0, anchored = 0, canCollide = 0, castShadow = 0,
		renderFidelity = 0, collisionFidelity = 0, suggestions = {} }
	local changes = {}
	local small = 0
	for _, p in parts do
		local size = p.Size
		local biggest = math.max(size.X, size.Y, size.Z)
		local isMesh = p:IsA("MeshPart")
		local isUnion = p:IsA("PartOperation")
		if isMesh then
			report.meshes += 1
		elseif isUnion then
			report.unions += 1
		end
		if opts.anchorAll ~= false and not p.Anchored then
			table.insert(changes, { p, "Anchored", true })
			report.anchored += 1
		end
		local isDecor = biggest < decor
		if isDecor then
			small += 1
		end
		if opts.canCollideDecor ~= false and isDecor and (p.CanCollide or p.CanTouch) then
			table.insert(changes, { p, "CanCollide", false })
			table.insert(changes, { p, "CanTouch", false })
			report.canCollide += 1
		end
		if opts.castShadowSmall ~= false and biggest < shadow and p.CastShadow then
			table.insert(changes, { p, "CastShadow", false })
			report.castShadow += 1
		end
		if isMesh or isUnion then
			local want = opts.renderFidelity == nil and "Performance" or opts.renderFidelity
			if want and p.RenderFidelity.Name ~= want then
				table.insert(changes, { p, "RenderFidelity", (Enum.RenderFidelity :: any)[want] })
				report.renderFidelity += 1
			end
			if opts.collisionFidelityBox ~= false and (not p.CanCollide or isDecor) and p.CollisionFidelity ~= Enum.CollisionFidelity.Box then
				table.insert(changes, { p, "CollisionFidelity", Enum.CollisionFidelity.Box })
				report.collisionFidelity += 1
			end
		end
	end
	if small > 50 then
		table.insert(report.suggestions, small .. " piese foarte mici: unește-le (Modeling.merge) sau fă-le un singur MeshPart.")
	end
	if #parts > 5000 then
		table.insert(report.suggestions, "Peste 5000 de piese: împarte construcția sau folosește StreamingEnabled / LevelOfDetail.")
	end
	if report.unions > 20 then
		table.insert(report.suggestions, report.unions .. " uniri (CSG): uniunile mari sunt scumpe; păstrează-le puține.")
	end
	report.changes = #changes
	if opts.dryRun or #changes == 0 then
		return report
	end
	return record("optimizare", function()
		for _, ch in changes do
			pcall(function()
				(ch[1] :: any)[ch[2]] = ch[3]
			end)
		end
		return report
	end)
end

function Modeling.weldAll(root, opts)
	opts = opts or {}
	local parts = partsOf(root)
	if #parts < 2 then
		error("Sudura are nevoie de cel puțin 2 piese.", 0)
	end
	local main = typeof(root) == "Instance" and root:IsA("Model") and root.PrimaryPart or nil
	if not main then
		local best = -1
		for _, p in parts do
			local s = p.Size
			local v = s.X * s.Y * s.Z
			if v > best then
				best, main = v, p
			end
		end
	end
	return record("sudură", function()
		local welds = {}
		local done = {}
		for _, w in main:GetChildren() do
			if w:IsA("WeldConstraint") and w.Name == "LostCubeWeld" and w.Part1 then
				done[w.Part1] = true
			end
		end
		for _, p in parts do
			if p ~= main and not done[p] then
				local w = Instance.new("WeldConstraint")
				w.Name = "LostCubeWeld"
				w.Part0 = main
				w.Part1 = p
				w.Parent = main
				table.insert(welds, w)
			end
			if opts.unanchor then
				p.Anchored = false
			end
		end
		return welds
	end)
end

function Modeling.group(targets, name)
	local objs = requireObjects(targets)
	return record("grupare", function()
		local model = Instance.new("Model")
		model.Name = name or "Grup"
		local parent = objs[1].Parent
		local biggest, primary = -1, nil
		for _, obj in objs do
			obj.Parent = model
			if isPart(obj) then
				local s = obj.Size
				if s.X * s.Y * s.Z > biggest then
					biggest, primary = s.X * s.Y * s.Z, obj
				end
			end
		end
		model.PrimaryPart = primary
		model.Parent = parent
		return model
	end)
end

-- materials smooth terrain can use
local TERRAIN_MATERIALS = {}
for _, name in { "Asphalt", "Basalt", "Brick", "Cobblestone", "Concrete", "CrackedLava", "Glacier", "Grass", "Ground",
	"Ice", "LeafyGrass", "Limestone", "Mud", "Pavement", "Rock", "Salt", "Sand", "Sandstone", "Slate", "Snow",
	"WoodPlanks", "Water", "Air" } do
	TERRAIN_MATERIALS[name] = true
end

local function applyTerrain(ops, origin)
	if #ops == 0 then
		return 0
	end
	local terrain = workspace.Terrain
	for _, op in ops do
		local mat = materialItem(op.material) or Enum.Material.Rock
		if op.op == "ball" then
			terrain:FillBall(toV3(F.point(origin, op.center)), op.radius, mat)
		elseif op.op == "block" then
			terrain:FillBlock(toCF(F.mul(origin, op.cf)), toV3(op.size), mat)
		elseif op.op == "wedge" then
			terrain:FillWedge(toCF(F.mul(origin, op.cf)), toV3(op.size), mat)
		elseif op.op == "cylinder" then
			terrain:FillCylinder(toCF(F.mul(origin, op.cf)), op.height, op.radius, mat)
		end
	end
	return #ops
end

-- parts -> smooth terrain (Block / Wedge / Ball / Cylinder; others as their box), opts: material (default: from the
-- part's material when terrain has it, else Rock), keep (false = the parts are deleted)
function Modeling.toTerrain(targets, opts)
	opts = opts or {}
	local parts = partsOf(targets)
	if #parts == 0 then
		error("Alege piesele de transformat în teren.", 0)
	end
	if opts.material ~= nil and not isTerrainMaterial(opts.material) then
		error("Material de teren necunoscut: " .. tostring(opts.material), 0)
	end
	local ops = {}
	for _, part in parts do
		local material = opts.material
		if not material then
			local name = part.Material.Name
			material = TERRAIN_MATERIALS[name] and name or "Rock"
		end
		local pc = { shape = shapeOf(part) or "Block", size = fromV3(part.Size), cf = fromCF(part.CFrame) }
		table.insert(ops, Geometry.terrainOp(pc, material))
	end
	return record("piese în teren", function()
		applyTerrain(ops, F.IDENTITY)
		if not opts.keep then
			for _, part in parts do
				part:Destroy()
			end
		end
		return #ops
	end)
end

-- Runtime check of the shape conventions the maths relies on (the tests run on a simulated Roblox): raycasts against a
-- temporary WedgePart / CornerWedgePart far above the map, inside an undo recording that is cancelled (nothing stays in
-- the place or in the history). Returns { wedge = bool, cornerWedge = bool, editableMesh = bool, notes = { text } }.
function Modeling.selfCheck()
	local report = { notes = {} }
	local okBegin, recording = pcall(ChangeHistoryService.TryBeginRecording, ChangeHistoryService, "LostCube: verificare")
	local function probe(className, size, rayXZ)
		local part = Instance.new(className)
		part.Anchored = true
		part.Archivable = false
		part.Size = size
		part.CFrame = CFrame.new(0, 10000, 0)
		part.Parent = workspace
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Include
		params.FilterDescendantsInstances = { part }
		local heights = {}
		for i, xz in rayXZ do
			local hit = workspace:Raycast(Vector3.new(xz[1], 10010, xz[2]), Vector3.new(0, -20, 0), params)
			heights[i] = hit and hit.Position.Y or nil
		end
		part:Destroy()
		return heights
	end
	local ok, err = pcall(function()
		-- WedgePart: the slope rises toward +Z
		local w = probe("WedgePart", Vector3.new(1, 4, 4), { { 0, 1.5 }, { 0, -1.5 } })
		report.wedge = w[1] ~= nil and w[2] ~= nil and w[1] > w[2]
		-- CornerWedgePart: the apex stands over the (+X, -Z) corner
		local a = Geometry.CORNER_APEX
		local c = probe("CornerWedgePart", Vector3.new(4, 4, 4), { { a[1] * 1.5, a[3] * 1.5 }, { -a[1] * 1.5, -a[3] * 1.5 } })
		report.cornerWedge = c[1] ~= nil and c[2] ~= nil and c[1] > c[2] + 1
	end)
	if okBegin and recording then
		pcall(ChangeHistoryService.FinishRecording, ChangeHistoryService, recording, Enum.FinishRecordingOperation.Cancel)
	end
	if not ok then
		table.insert(report.notes, "Testul cu raycast a eșuat: " .. tostring(err))
	end
	if report.wedge == false then
		table.insert(report.notes, "WedgePart are altă orientare decât se presupune: umplerile de triunghiuri vor ieși greșit.")
	end
	if report.cornerWedge == false then
		table.insert(report.notes, "CornerWedgePart are vârful în alt colț: acoperișurile în patru ape și oglindirea lor vor ieși greșit.")
	end
	local meshOk, why = Modeling.meshAvailable()
	report.editableMesh = meshOk
	if not meshOk then
		table.insert(report.notes, tostring(why))
	end
	return report
end

-- ---------------------------------------------------------------------------------------------
-- 7. generators
-- ---------------------------------------------------------------------------------------------
local function generatedModel(result, origin, name)
	local model = newModel(name, nil, origin)
	model:SetAttribute("LC_Generator", result.kind)
	model:SetAttribute("LC_Params", Spec.toJSON(result.params))
	model:SetAttribute("LC_Parts", #result.pieces)
	buildPieces(result.pieces, model, origin)
	return model
end

local function generateReport(result, origin)
	local b = Geometry.piecesBounds(result.pieces)
	return {
		kind = result.kind,
		parts = #result.pieces,
		terrainOps = #result.terrain,
		size = b and toV3(V.sub(b.max, b.min)) or Vector3.zero,
		center = b and toV3(F.point(origin, V.mid(b.min, b.max))) or toV3(origin.p),
		info = result.info,
		params = result.params,
	}
end

function Modeling.generate(kind, params, parent, cframe)
	local result, err = Generators.generate(kind, params, materialCheck)
	if not result then
		error(err, 0)
	end
	local origin = fromCF(cframeArg(cframe))
	local label = Generators.BY_KEY[kind].label
	if parent ~= nil and typeof(parent) ~= "Instance" then
		error("„parent” trebuie să fie un Instance.", 0)
	end
	return record("generat " .. label, function()
		local model
		if #result.pieces > 0 then
			model = generatedModel(result, origin, label)
			model.Parent = parent or workspace
		end
		applyTerrain(result.terrain, origin)
		return model, generateReport(result, origin)
	end)
end

-- rebuilds a generated model with changed parameters (same place, same parent); one undo step
function Modeling.regenerate(model, params)
	if typeof(model) ~= "Instance" or not model:IsA("Model") then
		error("regenerate are nevoie de un model generat de LostCube.", 0)
	end
	local kind = model:GetAttribute("LC_Generator")
	local saved = Spec.fromJSON(model:GetAttribute("LC_Params") or "")
	if type(kind) ~= "string" or type(saved) ~= "table" then
		error("„" .. model.Name .. "” nu e un model generat (lipsesc LC_Generator / LC_Params).", 0)
	end
	for k, v in params or {} do
		saved[k] = v
	end
	local result, err = Generators.generate(kind, saved, materialCheck)
	if not result then
		error(err, 0)
	end
	local origin = fromCF(model.WorldPivot)
	return record("regenerat " .. model.Name, function()
		local fresh = generatedModel(result, origin, model.Name)
		fresh.Parent = model.Parent
		model:Destroy()
		return fresh, generateReport(result, origin)
	end)
end

-- a spot in front of the camera, on whatever is under it (or y = 0)
function Modeling.placement(distance)
	distance = distance or 40
	local cam = workspace.CurrentCamera
	if not cam then
		return CFrame.new()
	end
	local look = cam.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 1e-3 then
		flat = Vector3.new(0, 0, -1)
	end
	flat = flat.Unit
	local spot = cam.CFrame.Position + flat * distance
	local hit = workspace:Raycast(spot + Vector3.new(0, 200, 0), Vector3.new(0, -1000, 0))
	local y = hit and hit.Position.Y or 0
	return CFrame.lookAt(Vector3.new(spot.X, y, spot.Z), Vector3.new(spot.X, y, spot.Z) + flat)
end

-- ---------------------------------------------------------------------------------------------
-- 8. procedural meshes
-- ---------------------------------------------------------------------------------------------
local function assetService()
	local ok, service = pcall(function()
		return game:GetService("AssetService")
	end)
	return ok and service or nil
end

local function editableMesh()
	local service = assetService()
	if not service then
		return nil, "AssetService nu e disponibil."
	end
	local ok, em = pcall(function()
		return service:CreateEditableMesh({})
	end)
	if not ok or not em then
		return nil, "EditableMesh nu e disponibil (" .. tostring(em) .. "). În Studio: Game Settings → Security → „Allow Mesh / Image APIs”."
	end
	return em, service
end

function Modeling.meshAvailable()
	local em, err = editableMesh()
	if not em then
		return false, err
	end
	pcall(function()
		em:Destroy()
	end)
	return true
end

-- mesh data (local to the mesh centre) -> MeshPart, or nil + reason
local function meshPartFrom(data)
	local em, service = editableMesh()
	if not em then
		return nil, service
	end
	local ok, result = pcall(function()
		local ids = {}
		for i, v in data.verts do
			ids[i] = em:AddVertex(toV3(v))
		end
		for _, t in data.tris do
			em:AddTriangle(ids[t[1]], ids[t[2]], ids[t[3]])
		end
		local content = Content.fromObject(em)
		local okHull, part = pcall(function()
			return (service :: any):CreateMeshPartAsync(content, { CollisionFidelity = Enum.CollisionFidelity.Hull })
		end)
		if okHull and part then
			return part
		end
		return (service :: any):CreateMeshPartAsync(content, {})
	end)
	if not ok or not result then
		pcall(function()
			em:Destroy()
		end)
		return nil, "Crearea MeshPart-ului a eșuat: " .. tostring(result)
	end
	return result
end

function Modeling.mesh(kind, params, parent, cframe, opts)
	opts = opts or {}
	local data, err = Mesh.make(kind, params)
	if not data then
		error(err, 0)
	end
	local problem = Mesh.check(data)
	if problem then
		error(problem, 0)
	end
	-- default "parts": a MeshPart from an EditableMesh does not survive saving the place without an upload
	local mode = opts.mode or "parts"
	if mode ~= "auto" and mode ~= "mesh" and mode ~= "parts" then
		error("Modul trebuie să fie auto, mesh sau parts.", 0)
	end
	local origin = fromCF(cframeArg(cframe))
	local center = Mesh.center(data)
	local look = { color = (params and params.color) or "#8a8580", material = (params and params.material) or "SmoothPlastic" }
	if not isPartMaterial(look.material) then
		error("Material necunoscut: " .. tostring(look.material), 0)
	end
	if not toColor3(look.color) then
		error("Culoarea trebuie să fie „#rrggbb”.", 0)
	end
	if parent ~= nil and typeof(parent) ~= "Instance" then
		error("„parent” trebuie să fie un Instance.", 0)
	end
	local report = { kind = kind, triangles = #data.tris, vertices = #data.verts }
	local recipe = Spec.toJSON(params or {})
	local meshPart, why
	if mode ~= "parts" then
		meshPart, why = meshPartFrom(data)
		if not meshPart and mode == "mesh" then
			return nil, why
		end
	end
	return record("mesh " .. kind, function()
		local frame = F.mul(origin, F.new(center))
		if meshPart then
			meshPart.Name = opts.name or ("Mesh " .. kind)
			meshPart.Anchored = true
			meshPart.CFrame = toCF(frame)
			meshPart.Color = toColor3(look.color) :: any
			meshPart.Material = materialItem(look.material) :: any
			meshPart:SetAttribute("LC_Mesh", kind)
			meshPart:SetAttribute("LC_Params", recipe)
			meshPart.Parent = parent or workspace
			report.mode = "mesh"
			report.parts = 1
			report.warning = "MeshPart din EditableMesh: conținutul e generat în memorie și poate să nu se salveze odată cu place-ul "
				.. "până nu e publicat ca asset; rețeta e păstrată în atributele LC_Mesh / LC_Params (Modeling.rebuildMesh)."
			return meshPart, report
		end
		local pieces, perr = Mesh.toPieces(data, { thickness = opts.thickness })
		if not pieces then
			error(perr, 0)
		end
		withLook(pieces, look, "Fațetă")
		local model = newModel(opts.name or ("Mesh " .. kind), nil, frame)
		model:SetAttribute("LC_Mesh", kind)
		model:SetAttribute("LC_Params", recipe)
		buildPieces(pieces, model, frame)
		model.Parent = parent or workspace
		report.mode = "parts"
		report.parts = #pieces
		report.fallback = why
		return model, report
	end)
end

-- rebuilds a mesh made by Modeling.mesh from its saved recipe (after reopening a place, or to switch mode)
function Modeling.rebuildMesh(inst, opts)
	if typeof(inst) ~= "Instance" or type(inst:GetAttribute("LC_Mesh")) ~= "string" then
		error("rebuildMesh are nevoie de un obiect creat de Modeling.mesh.", 0)
	end
	local params = Spec.fromJSON(inst:GetAttribute("LC_Params") or "{}") or {}
	local pivot = inst:GetPivot()
	return record("refăcut mesh", function()
		local data = Mesh.make(inst:GetAttribute("LC_Mesh"), params)
		local center = data and Mesh.center(data) or { 0, 0, 0 }
		local origin = fromCF(pivot) -- the pivot is the mesh centre: put the origin back where it was
		origin = F.mul(origin, F.new(V.neg(center)))
		local made, report = Modeling.mesh(inst:GetAttribute("LC_Mesh"), params, inst.Parent, toCF(origin), opts)
		if made then
			inst:Destroy()
		end
		return made, report
	end)
end

-- ---------------------------------------------------------------------------------------------
-- 9. readback (docs/modeling-research.md 4.3): a few lines that let Claude check a build without the whole tree
-- ---------------------------------------------------------------------------------------------
local DOOR_NAMES = { ["Ușă"] = true, Door = true, ["Poartă"] = true, Gate = true }
local DEFAULT_GRAY = Color3.fromRGB(163, 162, 165)

local function fmt(x)
	return Spec.toJSON(Spec.round(x, 1))
end

local function summaryOf(name, parts, origin, opts)
	opts = opts or {}
	local inv = F.inv(origin)
	local n = #parts
	local meshes, unions, tris, anchored, collide, gray = 0, 0, 0, 0, 0, 0
	local materials, pts = {}, {}
	local doors = {}
	for _, p in parts do
		if p:IsA("MeshPart") then
			meshes += 1
		elseif p:IsA("PartOperation") then
			unions += 1
			local ok, count = pcall(function()
				return (p :: any).TriangleCount
			end)
			if ok and type(count) == "number" then
				tris += count
			end
		end
		if p.Anchored then
			anchored += 1
		end
		if p.CanCollide then
			collide += 1
		end
		local mat = p.Material.Name
		materials[mat] = (materials[mat] or 0) + 1
		if mat == "Plastic" and p.Color == DEFAULT_GRAY then
			gray += 1
		end
		for _, c in Geometry.boxCorners(F.mul(inv, fromCF(p.CFrame)), fromV3(p.Size)) do
			table.insert(pts, c)
		end
		if DOOR_NAMES[p.Name] then
			table.insert(doors, p)
		end
	end
	local lines = {}
	local head = "Model " .. name
	if #pts > 0 then
		local b = Geometry.bounds(pts)
		head ..= string.format("  bbox %sx%sx%s (min %s,%s,%s)", fmt(b.max[1] - b.min[1]), fmt(b.max[2] - b.min[2]),
			fmt(b.max[3] - b.min[3]), fmt(b.min[1]), fmt(b.min[2]), fmt(b.min[3]))
	end
	head ..= string.format("  parts %d  meshparts %d  unions %d", n, meshes, unions)
	if tris > 0 then
		head ..= string.format("  tris~%.1fk", tris / 1000)
	end
	table.insert(lines, head)
	local mats = {}
	for k, v in materials do
		table.insert(mats, { k, v })
	end
	table.sort(mats, function(a, b)
		return a[2] > b[2] or (a[2] == b[2] and a[1] < b[1])
	end)
	local matText = {}
	for i = 1, math.min(6, #mats) do
		table.insert(matText, mats[i][1] .. " " .. mats[i][2])
	end
	if #mats > 6 then
		table.insert(matText, "+" .. (#mats - 6))
	end
	table.insert(lines, string.format("materials: %s | anchored %d/%d | collide %d/%d", table.concat(matText, ", "), anchored, n, collide, n))
	-- floating: nothing within 0.5 studs under the bottom (centre + 4 inset corners; up to 300 parts checked). The rays
	-- start at the top of the part's box, so a part sunk into another one counts as supported.
	local floating = {}
	local checked = math.min(n, opts.maxChecks or 300)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	for i = 1, checked do
		local p = parts[i]
		local b = Geometry.bounds(Geometry.boxCorners(fromCF(p.CFrame), fromV3(p.Size)))
		params.FilterDescendantsInstances = { p }
		local cx, cz = (b.min[1] + b.max[1]) / 2, (b.min[3] + b.max[3]) / 2
		local hx, hz = (b.max[1] - b.min[1]) * 0.4, (b.max[3] - b.min[3]) * 0.4
		local gap = math.huge
		for _, d in { { 0, 0 }, { -hx, -hz }, { hx, -hz }, { -hx, hz }, { hx, hz } } do
			local hit = workspace:Raycast(Vector3.new(cx + d[1], b.max[2] + 0.05, cz + d[2]), Vector3.new(0, -(b.max[2] - b.min[2] + 50), 0), params)
			if hit then
				gap = math.min(gap, b.min[2] - hit.Position.Y)
			end
		end
		if gap > 0.5 then
			table.insert(floating, { p, gap })
		end
	end
	table.sort(floating, function(x, y)
		return x[2] > y[2]
	end)
	local issues = { string.format("%d floating", #floating) }
	if #floating > 0 then
		local names = {}
		for i = 1, math.min(3, #floating) do
			local f = floating[i]
			table.insert(names, f[1].Name .. (f[2] < math.huge and (" y+" .. fmt(f[2])) or " (nimic dedesubt)"))
		end
		issues[1] ..= " (" .. table.concat(names, ", ") .. (#floating > 3 and ", ..." or "") .. ")"
	end
	table.insert(issues, string.format("%d default-gray", gray))
	table.insert(issues, string.format("%d unanchored", n - anchored))
	if checked < n then
		table.insert(issues, string.format("(verificate %d/%d)", checked, n))
	end
	table.insert(lines, "issues: " .. table.concat(issues, ", "))
	local checks = {}
	local minW, minH = Generators.SCALE.DOOR_MIN[1], Generators.SCALE.DOOR_MIN[2]
	for i = 1, math.min(4, #doors) do
		local d = doors[i]
		local w = math.max(d.Size.X, d.Size.Z)
		local h = d.Size.Y
		table.insert(checks, string.format("door %sx%s %s", fmt(w), fmt(h), (w >= minW - 0.3 and h >= minH - 0.3) and "ok" or "îngustă"))
	end
	if opts.budget then
		table.insert(checks, string.format("budget parts %d/%d%s", n, opts.budget, n > opts.budget and " DEPĂȘIT" or ""))
	end
	if #checks > 0 then
		table.insert(lines, "checks: " .. table.concat(checks, " | "))
	end
	return table.concat(lines, "\n")
end

-- the readback text of a model / part / list (opts: budget, maxChecks)
function Modeling.summary(target, opts)
	local parts = partsOf(target)
	local origin = F.IDENTITY
	if typeof(target) == "Instance" and (target:IsA("Model") or isPart(target)) then
		origin = fromCF(target:GetPivot())
	end
	local name = typeof(target) == "Instance" and target.Name or "Selecție"
	return summaryOf(name, parts, origin, opts)
end

-- ---------------------------------------------------------------------------------------------
-- 10. spec (Spec.DOC)
-- ---------------------------------------------------------------------------------------------
local function specErrors(errors)
	local shown = {}
	for i = 1, math.min(12, #errors) do
		table.insert(shown, errors[i])
	end
	if #errors > 12 then
		table.insert(shown, "(încă " .. (#errors - 12) .. " erori)")
	end
	return "Spec invalid:\n" .. table.concat(shown, "\n")
end

function Modeling.validateSpec(spec)
	local plan, errors = Spec.compile(spec, materialCheck)
	if not plan then
		return false, errors
	end
	return true, {}, plan.count
end

function Modeling.buildFromSpec(spec, parent, cframe, opts)
	opts = opts or {}
	local plan, errors = Spec.compile(spec, materialCheck)
	if not plan then
		error(specErrors(errors), 0)
	end
	local origin = fromCF(cframeArg(cframe))
	if parent ~= nil and typeof(parent) ~= "Instance" then
		error("„parent” trebuie să fie un Instance.", 0)
	end
	return record("construit „" .. plan.name .. "”", function()
		local model = newModel(plan.name, nil, origin)
		buildPieces(plan.pieces, model, origin)
		local terrainOps = 0
		for _, g in plan.generators do
			local frame = F.mul(origin, g.frame)
			local sub = generatedModel(g.result, frame, Generators.BY_KEY[g.kind].label)
			sub.Parent = model
			terrainOps += applyTerrain(g.result.terrain, frame)
		end
		model.Parent = parent or workspace
		return model, { parts = plan.count, generators = #plan.generators, terrainOps = terrainOps }
	end)
end

-- a part -> piece (frame relative to `inv` = origin^-1); nil for unsupported classes
local function pieceOf(part, inv)
	local shape = shapeOf(part)
	if not shape then
		return nil
	end
	return {
		shape = shape,
		size = fromV3(part.Size),
		cf = F.mul(inv, fromCF(part.CFrame)),
		color = "#" .. part.Color:ToHex(),
		material = part.Material.Name,
		transparency = part.Transparency,
		reflectance = part.Reflectance,
		anchored = part.Anchored,
		canCollide = part.CanCollide,
		castShadow = part.CastShadow,
		name = part.Name,
	}
end

function Modeling.describe(target, opts)
	opts = opts or {}
	local maxParts = opts.maxParts or 500
	local origin
	if opts.relativeTo ~= nil then
		origin = fromCF(cframeArg(opts.relativeTo, "relativeTo"))
	elseif typeof(target) == "Instance" and (target:IsA("Model") or isPart(target)) then
		origin = fromCF(target:GetPivot())
	else
		origin = F.IDENTITY
	end
	local inv = F.inv(origin)
	local spec = { name = typeof(target) == "Instance" and target.Name or "Selecție", parts = {} }
	local generators, unsupported = {}, {}
	local pts = {}
	local allParts = {}
	local total = 0
	local function addCorners(f, size)
		for _, c in Geometry.boxCorners(f, size) do
			table.insert(pts, c)
		end
	end
	local function visit(inst, isRoot)
		if isPart(inst) then
			total += 1
			table.insert(allParts, inst)
			local pc = pieceOf(inst, inv)
			if #spec.parts + #unsupported >= maxParts then
				return
			end
			if pc then
				table.insert(spec.parts, Spec.describePiece(pc))
				addCorners(pc.cf, pc.size)
			else
				local f = F.mul(inv, fromCF(inst.CFrame))
				table.insert(unsupported, { class = inst.ClassName, name = inst.Name,
					pos = { Spec.round(f.p[1], 3), Spec.round(f.p[2], 3), Spec.round(f.p[3], 3) },
					size = { Spec.round(inst.Size.X, 3), Spec.round(inst.Size.Y, 3), Spec.round(inst.Size.Z, 3) } })
				addCorners(f, fromV3(inst.Size))
			end
		elseif inst:IsA("Model") and not isRoot and type(inst:GetAttribute("LC_Generator")) == "string" then
			local params = Spec.fromJSON(inst:GetAttribute("LC_Params") or "")
			if type(params) == "table" then
				local f = F.mul(inv, fromCF(inst.WorldPivot))
				local o = F.orientation(f)
				table.insert(generators, { kind = inst:GetAttribute("LC_Generator"), params = params, at = {
					pos = { Spec.round(f.p[1], 3), Spec.round(f.p[2], 3), Spec.round(f.p[3], 3) },
					rot = { Spec.round(o[1], 2), Spec.round(o[2], 2), Spec.round(o[3], 2) } } })
				for _, d in inst:GetDescendants() do
					if isPart(d) then
						total += 1
						table.insert(allParts, d)
						addCorners(F.mul(inv, fromCF(d.CFrame)), fromV3(d.Size))
					end
				end
				return
			end
		end
		if not isPart(inst) or isRoot then
			for _, c in inst:GetChildren() do
				visit(c, false)
			end
		end
	end
	if type(target) == "table" then
		for _, x in target do
			if typeof(x) == "Instance" then
				visit(x, false)
			end
		end
	elseif typeof(target) == "Instance" then
		if isPart(target) then
			visit(target, false)
		else
			visit(target, true)
		end
	else
		error("describe are nevoie de un model, o piesă sau o listă.", 0)
	end
	if #generators > 0 then
		spec.generators = generators
	end
	if #unsupported > 0 then
		spec.unsupported = unsupported
	end
	if #pts > 0 then
		local b = Geometry.bounds(pts)
		spec.bounds = { Spec.round(b.max[1] - b.min[1], 2), Spec.round(b.max[2] - b.min[2], 2), Spec.round(b.max[3] - b.min[3], 2) }
	end
	spec.count = total
	local listed = #spec.parts + #unsupported
	if total > listed and listed >= maxParts then
		spec.truncated = total - listed
	end
	if opts.summary ~= false then
		spec.summary = summaryOf(spec.name, allParts, origin, opts)
	end
	return spec
end

-- help text for Claude / a panel: one generator's parameters (or the list of generators)
function Modeling.generatorHelp(kind)
	if kind == nil then
		local lines = {}
		for _, g in Generators.LIST do
			table.insert(lines, g.key .. " – " .. g.label)
		end
		return table.concat(lines, "\n")
	end
	local g = Generators.BY_KEY[kind]
	if not g then
		error("Generator necunoscut „" .. tostring(kind) .. "”.", 0)
	end
	local lines = { g.key .. " (" .. g.label .. "):" }
	for _, f in g.params do
		local range = ""
		if f.min then
			range = string.format(" %s..%s", tostring(f.min), tostring(f.max))
		elseif f.options then
			range = " " .. table.concat(f.options, "|")
		end
		local def = type(f.default) == "table" and Spec.toJSON(f.default) or tostring(f.default)
		table.insert(lines, string.format("  %s (%s%s, implicit %s) – %s", f.key, f.kind, range, def, f.label))
	end
	return table.concat(lines, "\n")
end

return Modeling
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX19"><Properties><string name="Name">Generators</string><ProtectedString name="Source"><![CDATA[-- LostCube > Modeling > Generators: procedural builders as pure functions. Each one takes validated parameters and
-- returns { pieces = { piece }, terrain = { op }?, info = {...} } in LOCAL coordinates: the origin is the centre of the
-- footprint on the ground (y = 0), -Z is the front (the LookVector of the CFrame the model is placed at). init.luau turns
-- the pieces into one Model (one undo step). Same seed + same parameters = the same model.
--
-- Every generator is described by Generators.LIST[i] = { key, label, params = { field } } so a panel can draw its
-- controls and Claude can read the allowed parameters: field = { key, label, kind, default, min?, max?, options? }
-- kind: "number" | "int" | "bool" | "choice" | "color" ("#rrggbb") | "material" (Enum.Material name) | "points"
-- ({ { x, y, z }, ... }, local studs).
local Geometry = require(script.Parent.Geometry)
local V, M = Geometry.V, Geometry.M

local Generators = {}

local pi, sin, cos, tan, sqrt, floor, max, min, abs, atan2 =
	math.pi, math.sin, math.cos, math.tan, math.sqrt, math.floor, math.max, math.min, math.abs, math.atan2

-- Roblox scale (studs; 1 stud = 28 cm). Sources: docs/modeling-research.md 3.1 / 5.2 (official tutorials, Humanoid
-- defaults, the Roqer building guide). Interactive things are bigger than real proportions (doors 1.4-1.6x a player).
Generators.SCALE = {
	STUD_CM = 28,
	CHARACTER_HEIGHT = 5, -- classic avatar ~5 (R15 4.75-5.1, Rthro 5.75-6.5)
	CHARACTER_WIDTH = 2,
	JUMP_HEIGHT = 7.2, -- Humanoid.JumpHeight default: a barrier must be >= 8 to stop players
	WALK_SPEED = 16,
	BARRIER_HEIGHT = 8,
	GRID = 4, -- structure grid (terrain voxel = 4, texture tile = 8); details on 2 / 1 / 0.5
	DOOR_WIDTH = 5, -- 5 x 8 for multiplayer games; 4 x 7 is the minimum
	DOOR_HEIGHT = 8,
	DOOR_MIN = { 4, 7 },
	HALLWAY_WIDTH = 10,
	PATH_WIDTH = 6,
	STEP_RISE = 1, -- 0.8-1.25
	STEP_RUN = 1.5,
	FLOOR_HEIGHT = 12, -- ceilings 10-14
	WALL_THICKNESS = 1,
	WINDOW_WIDTH = 4,
	WINDOW_HEIGHT = 5,
	WINDOW_SILL = 3,
	RAILING_HEIGHT = 3.5,
	TABLE_HEIGHT = 3.5,
	SEAT_HEIGHT = 1.5,
	BED = { 5, 1.8, 7 }, -- width, height, length
	ROAD_LANE = 12,
	ROAD_WIDTH = 24, -- two lanes
	SIDEWALK = 6,
	CURB = 0.5,
}
local S = Generators.SCALE

-- ---------------------------------------------------------------------------------------------
-- pieces
-- ---------------------------------------------------------------------------------------------
local function piece(shape, size, cf, style, name)
	local pc = { shape = shape, size = size, cf = cf }
	if style then
		for k, v in style do
			pc[k] = v
		end
	end
	if name then
		pc.name = name
	end
	return pc
end

local function at(x, y, z, r)
	return { p = { x, y, z }, r = r or M.IDENTITY }
end

local function push(list, items)
	for _, it in items do
		table.insert(list, it)
	end
end

local function moved(pieces, frame)
	return Geometry.transformPieces(pieces, frame)
end

-- a vertical cylinder (Roblox cylinders run along X: rotate X to Y)
local ROT_UP = M.rz(pi / 2)
local function column(x, y0, z, height, diameter, style, name)
	return piece("Cylinder", { height, diameter, diameter }, at(x, y0 + height / 2, z, ROT_UP), style, name)
end

-- rectangle [x0, x1] x [y0, y1] minus rectangular holes -> rectangles (the better of a vertical and a horizontal sweep)
local function subtractRects(x0, x1, y0, y1, holes)
	local function sweep(a0, a1, b0, b1, hs)
		local xs = { a0, a1 }
		for _, h in hs do
			table.insert(xs, max(a0, min(a1, h[1])))
			table.insert(xs, max(a0, min(a1, h[2])))
		end
		table.sort(xs)
		local cuts = {}
		for _, x in xs do
			if #cuts == 0 or x - cuts[#cuts] > 1e-6 then
				table.insert(cuts, x)
			end
		end
		local rects, open = {}, {}
		for i = 1, #cuts - 1 do
			local s0, s1 = cuts[i], cuts[i + 1]
			local cover = {}
			for _, h in hs do
				if h[1] <= s0 + 1e-6 and h[2] >= s1 - 1e-6 then
					table.insert(cover, { max(b0, h[3]), min(b1, h[4]) })
				end
			end
			table.sort(cover, function(p, q)
				return p[1] < q[1]
			end)
			local free, cursor = {}, b0
			for _, cv in cover do
				if cv[1] - cursor > 1e-6 then
					table.insert(free, { cursor, cv[1] })
				end
				cursor = max(cursor, cv[2])
			end
			if b1 - cursor > 1e-6 then
				table.insert(free, { cursor, b1 })
			end
			local nextOpen = {}
			for _, fr in free do
				local key = string.format("%.5f:%.5f", fr[1], fr[2])
				local r = open[key]
				if r and abs(r[2] - s0) < 1e-6 then
					r[2] = s1
				else
					r = { s0, s1, fr[1], fr[2] }
					table.insert(rects, r)
				end
				nextOpen[key] = r
			end
			open = nextOpen
		end
		return rects
	end
	local vertical = sweep(x0, x1, y0, y1, holes)
	local flipped = {}
	for _, h in holes do
		table.insert(flipped, { h[3], h[4], h[1], h[2] })
	end
	local horizontal = sweep(y0, y1, x0, x1, flipped)
	if #horizontal < #vertical then
		local out = {}
		for _, r in horizontal do
			table.insert(out, { r[3], r[4], r[1], r[2] })
		end
		return out
	end
	return vertical
end
Generators.subtractRects = subtractRects

-- wall pieces in the wall's own frame: x along the wall (centred), y up from 0, thickness along z
local function wallPieces(length, height, thickness, holes, style, name)
	local out = {}
	for _, r in subtractRects(-length / 2, length / 2, 0, height, holes) do
		local w, h = r[2] - r[1], r[4] - r[3]
		if w >= Geometry.MIN_SIZE and h >= Geometry.MIN_SIZE then
			table.insert(out, piece("Block", { w, h, thickness }, at((r[1] + r[2]) / 2, (r[3] + r[4]) / 2, 0), style, name))
		end
	end
	return out
end

-- glass + trims inside an opening (x0, x1, y0, y1) of a wall `thickness` thick; frames: "none" | "sill" (one sill
-- standing out of the wall) | "full" (4 trims)
local function windowPieces(x0, x1, y0, y1, thickness, frames, glassStyle, trimStyle)
	local out = {}
	local w, h = x1 - x0, y1 - y0
	local cx, cy = (x0 + x1) / 2, (y0 + y1) / 2
	local frame = 0.3
	table.insert(out, piece("Block", { w, h, 0.2 }, at(cx, cy, 0), glassStyle, "Geam"))
	if frames == "sill" then
		table.insert(out, piece("Block", { w + 0.6, 0.3, thickness + 0.6 }, at(cx, y0 - 0.15, 0), trimStyle, "Pervaz"))
	elseif frames == "full" and w > 2 * frame and h > 2 * frame then
		local d = thickness + 0.2
		table.insert(out, piece("Block", { w, frame, d }, at(cx, y1 - frame / 2, 0), trimStyle, "Ramă"))
		table.insert(out, piece("Block", { w, frame, d }, at(cx, y0 + frame / 2, 0), trimStyle, "Pervaz"))
		table.insert(out, piece("Block", { frame, h - 2 * frame, d }, at(x0 + frame / 2, cy, 0), trimStyle, "Ramă"))
		table.insert(out, piece("Block", { frame, h - 2 * frame, d }, at(x1 - frame / 2, cy, 0), trimStyle, "Ramă"))
	end
	return out
end

local function style(color, material, extra)
	local s = { color = color, material = material }
	if extra then
		for k, v in extra do
			s[k] = v
		end
	end
	return s
end

-- ---------------------------------------------------------------------------------------------
-- roofs (base rectangle w x d centred at the origin, from y = 0 up to h; ridge along X)
-- ---------------------------------------------------------------------------------------------
local function gableRoof(w, d, h, overhang, infillStyle, roofStyle)
	local out = {}
	-- the triangular prism: two wedges whose high side meets at the ridge
	table.insert(out, piece("Wedge", { w, h, d / 2 }, at(0, h / 2, -d / 4), infillStyle, "Fronton"))
	table.insert(out, piece("Wedge", { w, h, d / 2 }, at(0, h / 2, d / 4, M.ry(pi)), infillStyle, "Fronton"))
	-- the roof panels, overhanging the walls
	local thick = 0.4
	local run = d / 2 + overhang
	local slope = atan2(h, d / 2)
	local length = run / cos(slope)
	for _, side in { -1, 1 } do
		local ridge = { 0, h, 0 }
		local eave = { 0, h - run * tan(slope), side * run }
		local down = V.sub(eave, ridge)
		local r = M.lookAlong(down, { 0, 1, 0 })
		local up = M.column(r, 2)
		local center = V.add(V.mid(ridge, eave), V.scale(up, thick / 2))
		table.insert(out, piece("Block", { w + 2 * overhang, thick, length }, { p = center, r = r }, roofStyle, "Acoperiș"))
	end
	return out
end

local function hipRoof(w, d, h, roofStyle)
	local out = {}
	local ridge = w - d
	if ridge > Geometry.MIN_SIZE then
		table.insert(out, piece("Wedge", { ridge, h, d / 2 }, at(0, h / 2, -d / 4), roofStyle, "Acoperiș"))
		table.insert(out, piece("Wedge", { ridge, h, d / 2 }, at(0, h / 2, d / 4, M.ry(pi)), roofStyle, "Acoperiș"))
	end
	local half = max(ridge, 0) / 2
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			-- quarter of the hip end: footprint d/2 x d/2, apex over its corner at the ridge end
			local c = { sx * (half + d / 4), h / 2, sz * d / 4 }
			table.insert(out, Geometry.cornerWedge(c, d / 2, h, d / 2, -sx, -sz, table.clone(roofStyle)))
			out[#out].name = "Acoperiș"
		end
	end
	return out
end

-- a roof on a w x d rectangle, ridge along the longer side
local function roof(kind, w, d, h, overhang, infillStyle, roofStyle)
	local alongZ = d > w
	local lw, ld = alongZ and d or w, alongZ and w or d
	local out
	if kind == "gable" then
		out = gableRoof(lw, ld, h, overhang, infillStyle, roofStyle)
	elseif kind == "hip" then
		out = hipRoof(lw + 2 * overhang, ld + 2 * overhang, h, roofStyle)
	else
		return {}
	end
	if alongZ then
		out = moved(out, { p = { 0, 0, 0 }, r = M.ry(pi / 2) })
	end
	return out
end

-- ---------------------------------------------------------------------------------------------
-- building
-- ---------------------------------------------------------------------------------------------
local function building(p)
	local W, D, floors, FH, T, slab = p.width, p.depth, p.floors, p.floorHeight, p.wall, p.slab
	local H = floors * FH
	local wallStyle = style(p.wallColor, p.wallMaterial)
	local trimStyle = style(p.trimColor, "SmoothPlastic")
	local glassStyle = style(p.glassColor, "Glass", { transparency = 0.45, castShadow = false })
	local floorStyle = style(p.floorColor, "WoodPlanks")
	local roofStyle = style(p.roofColor, p.roofMaterial)
	local out = {}
	local windows, doors = 0, 0
	local walls = {
		{ name = "Perete față", L = W, cf = at(0, 0, -D / 2 + T / 2), front = true },
		{ name = "Perete spate", L = W, cf = at(0, 0, D / 2 - T / 2, M.ry(pi)) },
		{ name = "Perete stânga", L = D - 2 * T, cf = at(-W / 2 + T / 2, 0, 0, M.ry(-pi / 2)) },
		{ name = "Perete dreapta", L = D - 2 * T, cf = at(W / 2 - T / 2, 0, 0, M.ry(pi / 2)) },
	}
	for _, wall in walls do
		local L = wall.L
		local holes, extras = {}, {}
		local n = 0
		if p.windows and p.windowSpacing > 0 then
			n = floor(L / p.windowSpacing)
			while n > 0 and n * p.windowWidth + (n + 1) * 1 > L do
				n -= 1
			end
		end
		local doorX0, doorX1
		if wall.front and p.door then
			doorX0, doorX1 = -p.doorWidth / 2, p.doorWidth / 2
			local top = slab + p.doorHeight
			table.insert(holes, { doorX0, doorX1, 0, top })
			table.insert(extras, piece("Block", { p.doorWidth - 0.2, p.doorHeight, 0.4 }, at(0, slab + p.doorHeight / 2, 0),
				style(p.doorColor, "Wood"), "Ușă"))
			doors += 1
		end
		for f = 0, floors - 1 do
			for i = 1, n do
				local cx = -L / 2 + L * (i - 0.5) / n
				local x0, x1 = cx - p.windowWidth / 2, cx + p.windowWidth / 2
				local y0 = f * FH + slab + p.sill
				local y1 = min(y0 + p.windowHeight, (f + 1) * FH - 0.5)
				local blocked = doorX0 and f == 0 and x1 > doorX0 - 1 and x0 < doorX1 + 1
				if y1 - y0 > 0.5 and not blocked then
					table.insert(holes, { x0, x1, y0, y1 })
					push(extras, windowPieces(x0, x1, y0, y1, T, p.frames, glassStyle, trimStyle))
					windows += 1
				end
			end
		end
		push(out, moved(wallPieces(L, H, T, holes, wallStyle, wall.name), wall.cf))
		push(out, moved(extras, wall.cf))
	end
	-- slabs: ground, interior floors (inside the walls), ceiling / roof base
	table.insert(out, piece("Block", { W, slab, D }, at(0, slab / 2, 0), floorStyle, "Podea"))
	if p.slabs then
		for f = 1, floors - 1 do
			table.insert(out, piece("Block", { W - 2 * T, slab, D - 2 * T }, at(0, f * FH + slab / 2, 0), floorStyle, "Planșeu"))
		end
	end
	table.insert(out, piece("Block", { W, slab, D }, at(0, H + slab / 2, 0), p.roof == "flat" and roofStyle or floorStyle, "Tavan"))
	local top = H + slab
	-- roof height from the pitch over the shorter span
	local roofHeight = math.min(W, D) / 2 * tan(math.rad(p.roofPitch))
	if p.roof == "flat" then
		local ph = 1.5
		table.insert(out, piece("Block", { W, ph, T }, at(0, top + ph / 2, -D / 2 + T / 2), wallStyle, "Parapet"))
		table.insert(out, piece("Block", { W, ph, T }, at(0, top + ph / 2, D / 2 - T / 2), wallStyle, "Parapet"))
		table.insert(out, piece("Block", { T, ph, D - 2 * T }, at(-W / 2 + T / 2, top + ph / 2, 0), wallStyle, "Parapet"))
		table.insert(out, piece("Block", { T, ph, D - 2 * T }, at(W / 2 - T / 2, top + ph / 2, 0), wallStyle, "Parapet"))
	else
		push(out, moved(roof(p.roof, W, D, roofHeight, p.overhang, wallStyle, roofStyle), at(0, top, 0)))
	end
	return { pieces = out, info = { windows = windows, doors = doors, height = top + (p.roof == "flat" and 1.5 or roofHeight) } }
end

-- ---------------------------------------------------------------------------------------------
-- stairs
-- ---------------------------------------------------------------------------------------------
-- one straight flight in its own frame: starts at z = 0, climbs toward -z; steps first..last (1-based), each `h` high
local function flight(firstStep, count, h, run, width, solid, baseY, st, thickness)
	local out = {}
	for k = 1, count do
		local i = firstStep + k - 1
		local topY = baseY + i * h
		local z = -(k - 0.5) * run
		if solid then
			table.insert(out, piece("Block", { width, topY, run }, at(0, topY / 2, z), st, "Treaptă"))
		else
			table.insert(out, piece("Block", { width, thickness, run }, at(0, topY - thickness / 2, z), st, "Treaptă"))
		end
	end
	return out
end

-- posts every `every` steps + one sloped handrail, on the side x = sideX of a flight (same frame as `flight`)
local function flightRailing(firstStep, count, h, run, sideX, railH, every, st)
	local out = {}
	local tops = {}
	for k = 1, count, every do
		local i = firstStep + k - 1
		local z = -(k - 0.5) * run
		local y = i * h
		table.insert(out, piece("Block", { 0.3, railH, 0.3 }, at(sideX, y + railH / 2, z), st, "Stâlp"))
		table.insert(tops, { sideX, y + railH, z })
	end
	if (count - 1) % every ~= 0 then
		local i = firstStep + count - 1
		local z = -(count - 0.5) * run
		table.insert(out, piece("Block", { 0.3, railH, 0.3 }, at(sideX, i * h + railH / 2, z), st, "Stâlp"))
		table.insert(tops, { sideX, i * h + railH, z })
	end
	if #tops >= 2 then
		local rail = Geometry.beam(tops[1], tops[#tops], 0.35, 0.25)
		if rail then
			rail.size[3] += 0.3
			push(out, { piece(rail.shape, rail.size, rail.cf, st, "Mână curentă") })
		end
	end
	return out
end

local function stairs(p)
	local n = math.ceil(p.height / p.rise - 1e-9)
	local h = p.height / n
	local st = style(p.color, p.material)
	local railSt = style(p.railColor, "Metal")
	local out = {}
	local solid = p.style == "solid"
	local turn = p.turn == "left" and -1 or 1
	if p.kind == "straight" then
		push(out, flight(1, n, h, p.run, p.width, solid, 0, st, 0.4))
		if p.railings then
			for _, sx in { -1, 1 } do
				push(out, flightRailing(1, n, h, p.run, sx * (p.width / 2 - 0.2), p.railHeight, 2, railSt))
			end
		end
	elseif p.kind == "L" then
		local n1 = max(1, floor(n / 2))
		local n2 = n - n1
		push(out, flight(1, n1, h, p.run, p.width, solid, 0, st, 0.4))
		local landY = n1 * h
		local landZ = -n1 * p.run - p.width / 2
		if solid then
			table.insert(out, piece("Block", { p.width, landY, p.width }, at(0, landY / 2, landZ), st, "Podest"))
		else
			table.insert(out, piece("Block", { p.width, 0.4, p.width }, at(0, landY - 0.2, landZ), st, "Podest"))
		end
		-- second flight: leaves the landing sideways (turn = 1: toward +x)
		local frame2 = at(turn * p.width / 2, 0, landZ, M.ry(-turn * pi / 2))
		if n2 > 0 then
			push(out, moved(flight(n1 + 1, n2, h, p.run, p.width, solid, 0, st, 0.4), frame2))
		end
		if p.railings then
			push(out, flightRailing(1, n1, h, p.run, -turn * (p.width / 2 - 0.2), p.railHeight, 2, railSt))
			if n2 > 0 then
				push(out, moved(flightRailing(n1 + 1, n2, h, p.run, turn * (p.width / 2 - 0.2), p.railHeight, 2, railSt), frame2))
			end
		end
	else -- spiral
		local R, c = p.radius, p.column
		local stepAngle = 2 * pi / p.stepsPerTurn
		table.insert(out, column(0, 0, 0, p.height + (p.railings and p.railHeight or 0), 2 * c, st, "Coloană"))
		local treadLen = R - c * 0.5
		local treadW = 2 * R * tan(stepAngle / 2) * 1.08
		local thick = solid and h or 0.4
		local tops = {}
		for i = 1, n do
			local a = turn * stepAngle * (i - 1)
			local r = M.ry(-a)
			local mid = c * 0.5 + treadLen / 2
			local pos = M.apply(r, { mid, i * h - thick / 2, 0 })
			table.insert(out, piece("Block", { treadLen, thick, treadW }, { p = pos, r = r }, st, "Treaptă"))
			if p.railings and (i % 2 == 1 or i == n) then
				local post = M.apply(r, { R - 0.3, 0, 0 })
				table.insert(out, piece("Block", { 0.3, p.railHeight, 0.3 }, at(post[1], i * h + p.railHeight / 2, post[3]), railSt, "Stâlp"))
				table.insert(tops, { post[1], i * h + p.railHeight, post[3] })
			end
		end
		for i = 1, #tops - 1 do
			local rail = Geometry.beam(tops[i], tops[i + 1], 0.35, 0.25)
			if rail then
				rail.size[3] += 0.3
				table.insert(out, piece(rail.shape, rail.size, rail.cf, railSt, "Mână curentă"))
			end
		end
	end
	return { pieces = out, info = { steps = n, rise = h } }
end

-- ---------------------------------------------------------------------------------------------
-- fence / railing along a path
-- ---------------------------------------------------------------------------------------------
local function pathPoints(p)
	local pts = {}
	for _, v in p.points do
		table.insert(pts, V.from(v))
	end
	if p.smooth and #pts >= 3 then
		local sp = Geometry.spline(pts, { tension = 0, segments = 12 })
		if sp then
			local out = {}
			for _, smp in sp.samples(max(1, p.postSpacing / 2)) do
				table.insert(out, smp.p)
			end
			return out
		end
	end
	return pts
end

local function fence(p)
	local st = style(p.color, p.material)
	local metal = p.style == "metal"
	local out = {}
	local pts = pathPoints(p)
	-- post positions: every vertex + even subdivisions of each segment
	local posts = {}
	for i = 1, #pts - 1 do
		local a, b = pts[i], pts[i + 1]
		local d = V.dist(a, b)
		local k = max(1, math.ceil(d / p.postSpacing - 1e-9))
		for j = 0, k - 1 do
			table.insert(posts, V.lerp(a, b, j / k))
		end
	end
	table.insert(posts, pts[#pts])
	for _, q in posts do
		if metal then
			table.insert(out, column(q[1], q[2], q[3], p.height, p.postSize * 0.6, st, "Stâlp"))
		else
			table.insert(out, piece("Block", { p.postSize, p.height, p.postSize }, at(q[1], q[2] + p.height / 2, q[3]), st, "Stâlp"))
		end
	end
	local rails = max(1, p.rails)
	for i = 1, #posts - 1 do
		local a, b = posts[i], posts[i + 1]
		for r = 1, rails do
			local y = rails == 1 and p.height * 0.8 or (p.height * (0.35 + 0.45 * (r - 1) / (rails - 1)))
			if metal and r == rails then
				y = p.height - 0.1
			end
			local ra, rb = V.add(a, { 0, y, 0 }), V.add(b, { 0, y, 0 })
			if metal then
				local rod = Geometry.rod(ra, rb, 0.25)
				if rod then
					table.insert(out, piece(rod.shape, rod.size, rod.cf, st, "Bară"))
				end
			else
				local beam = Geometry.beam(ra, rb, 0.3, 0.45)
				if beam then
					table.insert(out, piece(beam.shape, beam.size, beam.cf, st, "Scândură"))
				end
			end
		end
		if p.style == "picket" then
			local d = V.dist(a, b)
			local k = floor(d / 0.9)
			local dir = V.unit(V.sub(b, a), { 1, 0, 0 }) :: any
			local r = M.lookAlong(dir, { 0, 1, 0 })
			for j = 1, k - 1 do
				local q = V.lerp(a, b, j / k)
				table.insert(out, piece("Block", { 0.4, p.height * 0.85, 0.15 }, { p = { q[1], q[2] + p.height * 0.425, q[3] }, r = r }, st, "Șipcă"))
			end
		end
	end
	if p.collision == "box" then
		-- the visible parts stop colliding; one invisible box per straight run blocks the way
		for _, pc in out do
			pc.canCollide = false
		end
		for i = 1, #pts - 1 do
			local a, b = pts[i], pts[i + 1]
			local beam = Geometry.beam(V.add(a, { 0, p.height / 2, 0 }), V.add(b, { 0, p.height / 2, 0 }), max(1, p.postSize), p.height)
			if beam then
				table.insert(out, piece(beam.shape, beam.size, beam.cf, { transparency = 1, castShadow = false, material = "SmoothPlastic" }, "Coliziune"))
			end
		end
	end
	return { pieces = out, info = { posts = #posts } }
end

-- ---------------------------------------------------------------------------------------------
-- bridge (along Z, from z = -length/2 to +length/2; the deck's top at y = height)
-- ---------------------------------------------------------------------------------------------
local function railingAlong(z0, z1, x, y, h, spacing, st)
	local out = {}
	local k = max(1, math.ceil((z1 - z0) / spacing - 1e-9))
	for j = 0, k do
		local z = z0 + (z1 - z0) * j / k
		table.insert(out, piece("Block", { 0.4, h, 0.4 }, at(x, y + h / 2, z), st, "Stâlp"))
	end
	table.insert(out, piece("Block", { 0.4, 0.3, z1 - z0 + 0.4 }, at(x, y + h - 0.15, (z0 + z1) / 2), st, "Balustradă"))
	table.insert(out, piece("Block", { 0.25, 0.25, z1 - z0 }, at(x, y + h * 0.5, (z0 + z1) / 2), st, "Balustradă"))
	return out
end

local function bridge(p)
	local L, Wd, H, dk = p.length, p.width, p.height, p.deck
	local st = style(p.color, p.material)
	local metal = style(p.cableColor, "Metal")
	local out = {}
	table.insert(out, piece("Block", { Wd, dk, L }, at(0, H - dk / 2, 0), st, "Tablier"))
	if p.kind == "beam" then
		for _, sx in { -1, 1 } do
			table.insert(out, piece("Block", { 1, 1.5, L }, at(sx * (Wd / 2 - 1), H - dk - 0.75, 0), st, "Grindă"))
		end
		local piers = max(1, math.ceil(L / p.pierSpacing - 1e-9))
		for j = 0, piers do
			local z = -L / 2 + 1 + (L - 2) * j / piers
			local ph = H - dk - 1.5
			if ph > Geometry.MIN_SIZE then
				table.insert(out, piece("Block", { Wd - 1, ph, 2 }, at(0, ph / 2, z), st, "Pilon"))
			end
		end
	elseif p.kind == "arch" then
		local rise = max(1, H - dk - 0.5)
		local half = L / 2
		local R = (half * half + rise * rise) / (2 * rise)
		local cy = rise - R -- circle centre (y), z = 0
		local a0 = atan2(-half, -cy) -- angle of the springing points from the vertical
		local segs = p.segments
		local pts = {}
		for j = 0, segs do
			local a = a0 + (-2 * a0) * j / segs
			table.insert(pts, { 0, cy + R * cos(a), R * sin(a) })
		end
		for j = 1, segs do
			local beam = Geometry.beam(pts[j], pts[j + 1], Wd, 1.5)
			if beam then
				beam.size[3] *= 1.04
				table.insert(out, piece(beam.shape, beam.size, beam.cf, st, "Arc"))
			end
		end
		-- spandrel posts between the arch and the deck
		local k = floor(L / 4)
		for j = 1, k - 1 do
			local z = -half + L * j / k
			local a = math.asin(max(-1, min(1, z / R)))
			local yArch = cy + R * cos(a)
			local ph = H - dk - yArch
			if ph > 0.3 then
				table.insert(out, piece("Block", { Wd, ph, 0.8 }, at(0, yArch + ph / 2, z), st, "Montant"))
			end
		end
	else -- suspension
		local tz = L / 2 - L * 0.2
		local towerH = H + p.towerHeight
		for _, sz in { -1, 1 } do
			for _, sx in { -1, 1 } do
				table.insert(out, piece("Block", { 1.5, towerH, 1.5 }, at(sx * (Wd / 2 + 0.75), towerH / 2, sz * tz), st, "Pilon"))
			end
			table.insert(out, piece("Block", { Wd + 3, 1.5, 1.5 }, at(0, towerH - 0.75, sz * tz), st, "Traversă"))
			table.insert(out, piece("Block", { Wd + 3, 1, 1.5 }, at(0, H - dk - 0.5, sz * tz), st, "Traversă"))
		end
		-- main cables: anchor -> tower top -> sag (parabola) -> tower top -> anchor
		local sagY = H + 1.5
		local function cableY(z)
			local az = abs(z)
			if az >= tz then -- side span: straight from the tower top down to the anchor at the deck end
				local t = (az - tz) / (L / 2 - tz)
				return towerH + (H + 0.5 - towerH) * t
			end
			local u = z / tz
			return sagY + (towerH - sagY) * u * u
		end
		local samples = {}
		local cableSeg = p.segments
		local zs = { -L / 2 }
		for j = 1, 3 do
			table.insert(zs, -L / 2 + (L / 2 - tz) * j / 3)
		end
		for j = 1, cableSeg - 1 do
			table.insert(zs, -tz + 2 * tz * j / cableSeg)
		end
		table.insert(zs, tz)
		for j = 1, 3 do
			table.insert(zs, tz + (L / 2 - tz) * j / 3)
		end
		for _, z in zs do
			table.insert(samples, z)
		end
		for _, sx in { -1, 1 } do
			local x = sx * (Wd / 2 + 0.75)
			for j = 1, #samples - 1 do
				local a = { x, cableY(samples[j]), samples[j] }
				local b = { x, cableY(samples[j + 1]), samples[j + 1] }
				local rod = Geometry.rod(a, b, 0.4)
				if rod then
					table.insert(out, piece(rod.shape, rod.size, rod.cf, metal, "Cablu"))
				end
			end
			-- hangers
			local k = floor(2 * tz / 3)
			for j = 1, k - 1 do
				local z = -tz + 2 * tz * j / k
				local top = cableY(z)
				local rod = Geometry.rod({ x, H, z }, { x, top, z }, 0.15)
				if rod and top - H > 0.3 then
					table.insert(out, piece(rod.shape, rod.size, rod.cf, metal, "Tirant"))
				end
			end
		end
	end
	if p.railings then
		for _, sx in { -1, 1 } do
			push(out, railingAlong(-L / 2 + 0.2, L / 2 - 0.2, sx * (Wd / 2 - 0.2), H, 4, 6, p.kind == "suspension" and metal or st))
		end
	end
	return { pieces = out, info = {} }
end

-- ---------------------------------------------------------------------------------------------
-- tower
-- ---------------------------------------------------------------------------------------------
local function tower(p)
	local R, H, T = p.radius, p.height, p.wall
	local st = style(p.color, p.material)
	local floorSt = style(p.floorColor, "WoodPlanks")
	local out = {}
	local doorW, doorH = S.DOOR_WIDTH, S.DOOR_HEIGHT
	local merlonH = p.crenellations and 3 or 0
	if p.shape == "round" then
		local n = p.segments
		local segW = 2 * R * tan(pi / n) + 0.05
		for k = 0, n - 1 do
			local a = 2 * pi * k / n
			local r = M.ry(-a)
			local dir = M.apply(r, { 0, 0, -1 }) -- the outward normal of segment k (k = 0 faces -Z)
			local c = V.scale(dir, R - T / 2)
			local frame = { p = c, r = r }
			if k == 0 and p.door then
				local holes = { { -min(doorW, segW - 0.6) / 2, min(doorW, segW - 0.6) / 2, 0, doorH } }
				push(out, moved(wallPieces(segW, H, T, holes, st, "Zid"), frame))
			else
				push(out, moved({ piece("Block", { segW, H, T }, at(0, H / 2, 0), st, "Zid") }, frame))
			end
			if p.crenellations and k % 2 == 0 then
				push(out, moved({ piece("Block", { segW * 0.9, merlonH, T }, at(0, H + merlonH / 2, 0), st, "Merlon") }, frame))
			end
		end
		table.insert(out, column(0, 0, 0, 1, 2 * (R - T / 2), floorSt, "Podea"))
		table.insert(out, column(0, H - 1, 0, 1, 2 * (R - T / 2), floorSt, "Platformă"))
		for f = 1, p.floors do
			local y = H * f / (p.floors + 1)
			table.insert(out, column(0, y - 0.5, 0, 1, 2 * (R - T / 2), floorSt, "Planșeu"))
		end
	else
		local W = 2 * R
		local sides = {
			{ L = W, cf = at(0, 0, -R + T / 2), front = true },
			{ L = W, cf = at(0, 0, R - T / 2, M.ry(pi)) },
			{ L = W - 2 * T, cf = at(-R + T / 2, 0, 0, M.ry(-pi / 2)) },
			{ L = W - 2 * T, cf = at(R - T / 2, 0, 0, M.ry(pi / 2)) },
		}
		for _, s in sides do
			local holes = {}
			if s.front and p.door then
				table.insert(holes, { -doorW / 2, doorW / 2, 0, doorH })
			end
			push(out, moved(wallPieces(s.L, H, T, holes, st, "Zid"), s.cf))
			if p.crenellations then
				local mw = 2 -- merlons 2 wide on a pitch of 4
				local k = max(1, floor(s.L / (2 * mw)))
				for j = 0, k - 1 do
					local x = -s.L / 2 + mw / 2 + (s.L - mw) * (k == 1 and 0.5 or j / (k - 1))
					push(out, moved({ piece("Block", { mw, merlonH, T }, at(x, H + merlonH / 2, 0), st, "Merlon") }, s.cf))
				end
			end
		end
		table.insert(out, piece("Block", { W - 2 * T, 1, W - 2 * T }, at(0, 0.5, 0), floorSt, "Podea"))
		table.insert(out, piece("Block", { W - 2 * T, 1, W - 2 * T }, at(0, H - 0.5, 0), floorSt, "Platformă"))
		for f = 1, p.floors do
			local y = H * f / (p.floors + 1)
			table.insert(out, piece("Block", { W - 2 * T, 1, W - 2 * T }, at(0, y, 0), floorSt, "Planșeu"))
		end
	end
	if p.roof == "pyramid" then
		local w = 2 * R + 1
		push(out, Geometry.pyramid({ 0, H + merlonH, 0 }, w, w, R * 1.2, style(p.roofColor, "Slate", { name = "Acoperiș" })))
	end
	return { pieces = out, info = {} }
end

-- ---------------------------------------------------------------------------------------------
-- arch, colonnade, wall with gate
-- ---------------------------------------------------------------------------------------------
-- semicircular arch ring (in the XY plane, depth along Z) springing at height y0 with inner radius r
local function archRing(r, thickness, depth, y0, segments, st)
	local out = {}
	local rm = r + thickness / 2
	local da = pi / segments
	for i = 0, segments - 1 do
		local a = da * (i + 0.5)
		local chord = 2 * (r + thickness) * sin(da / 2) + 0.02
		local pos = { -cos(a) * rm, y0 + sin(a) * rm, 0 }
		-- X tangent to the circle, Y radial
		local radial = { -cos(a), sin(a), 0 }
		local tangent = { sin(a), cos(a), 0 }
		local rot = M.fromColumns(tangent, radial, V.cross(tangent, radial))
		table.insert(out, piece("Block", { chord, thickness, depth }, { p = pos, r = rot }, st, i == floor(segments / 2) and "Cheie" or "Bolțar"))
	end
	return out
end

local function arch(p)
	local st = style(p.color, p.material)
	local out = {}
	local r = p.span / 2
	for _, sx in { -1, 1 } do
		table.insert(out, piece("Block", { p.pillarWidth, p.height, p.depth }, at(sx * (r + p.pillarWidth / 2), p.height / 2, 0), st, "Pilastru"))
	end
	push(out, archRing(r, p.thickness, p.depth, p.height, p.segments, st))
	return { pieces = out, info = {} }
end

local function colonnade(p)
	local st = style(p.color, p.material)
	local out = {}
	local n = p.count
	local dia = p.diameter
	local capH = 0.6
	local shaft = p.height - (p.base and capH or 0) - (p.capital and capH or 0)
	for i = 0, n - 1 do
		local x = (i - (n - 1) / 2) * p.spacing
		local y = 0
		if p.base then
			table.insert(out, piece("Block", { dia * 1.5, capH, dia * 1.5 }, at(x, capH / 2, 0), st, "Bază"))
			y = capH
		end
		table.insert(out, column(x, y, 0, shaft, dia, st, "Coloană"))
		if p.capital then
			table.insert(out, piece("Block", { dia * 1.5, capH, dia * 1.5 }, at(x, y + shaft + capH / 2, 0), st, "Capitel"))
		end
	end
	local span = (n - 1) * p.spacing + dia * 1.5
	if p.arches and n >= 2 then
		local r = (p.spacing - dia * 1.5) / 2
		for i = 0, n - 2 do
			local x = (i + 0.5 - (n - 1) / 2) * p.spacing
			push(out, moved(archRing(r, 1, dia * 1.5, p.height, 7, st), at(x, 0, 0)))
		end
	end
	if p.entablature then
		local top = p.height + (p.arches and (p.spacing / 2) or 0)
		table.insert(out, piece("Block", { span + 1, 1.5, dia * 1.5 + 0.5 }, at(0, top + 0.75, 0), st, "Antablament"))
	end
	return { pieces = out, info = { columns = n } }
end

local function gateWall(p)
	local st = style(p.color, p.material)
	local out = {}
	local L, H, T, gw, gh = p.length, p.height, p.thickness, p.gateWidth, min(p.gateHeight, p.height - 0.5)
	push(out, wallPieces(L, H, T, { { -gw / 2, gw / 2, 0, gh } }, st, "Zid"))
	if p.doors then
		for _, sx in { -1, 1 } do
			table.insert(out, piece("Block", { gw / 2 - 0.1, gh - 0.1, 0.6 }, at(sx * gw / 4, (gh - 0.1) / 2, 0), style(p.doorColor, "Wood"), "Poartă"))
		end
	end
	local towerW = p.towers and 6 or 0
	if p.crenellations then
		local mw = 2
		local usable = L - 2 * towerW
		local k = max(1, floor(usable / (2 * mw)))
		for j = 0, k - 1 do
			local x = -usable / 2 + mw / 2 + (usable - mw) * (k == 1 and 0.5 or j / (k - 1))
			table.insert(out, piece("Block", { mw, 2, T }, at(x, H + 1, 0), st, "Merlon"))
		end
	end
	if p.towers then
		local th = H + 4
		for _, sx in { -1, 1 } do
			local x = sx * (L / 2 - towerW / 2)
			table.insert(out, piece("Block", { towerW, th, towerW }, at(x, th / 2, 0), st, "Turn"))
			if p.crenellations then
				for _, cx in { -1, 1 } do
					for _, cz in { -1, 1 } do
						table.insert(out, piece("Block", { 1.5, 2, 1.5 }, at(x + cx * (towerW / 2 - 0.75), th + 1, cz * (towerW / 2 - 0.75)), st, "Merlon"))
					end
				end
			end
		end
	end
	return { pieces = out, info = {} }
end

-- ---------------------------------------------------------------------------------------------
-- roads (asphalt top at y = 1; sidewalks + curb above it)
-- ---------------------------------------------------------------------------------------------
local function roadArm(length, p, centerLine, asphalt, walk, paint, yellow)
	-- in the arm's frame: runs along Z from 0 to `length`... centred: z in [-length/2, length/2]
	local out = {}
	local w, sw = p.width, p.sidewalk
	table.insert(out, piece("Block", { w, 1, length }, at(0, 0.5, 0), asphalt, "Asfalt"))
	if sw > 0 then
		for _, sx in { -1, 1 } do
			table.insert(out, piece("Block", { sw, 1 + p.curb, length }, at(sx * (w / 2 + sw / 2), (1 + p.curb) / 2, 0), walk, "Trotuar"))
		end
	end
	if p.lines then
		local lineY = 1.025
		if centerLine then
			local period = p.dash + p.gap
			local k = floor((length + p.gap) / period)
			local used = k * period - p.gap
			for j = 0, k - 1 do
				local z = -used / 2 + j * period + p.dash / 2
				table.insert(out, piece("Block", { 0.5, 0.05, p.dash }, at(0, lineY, z), yellow, "Marcaj"))
			end
		end
		for _, sx in { -1, 1 } do
			table.insert(out, piece("Block", { 0.3, 0.05, length }, at(sx * (w / 2 - 0.6), lineY, 0), paint, "Marcaj"))
		end
	end
	return out
end

-- zebra stripes 1 wide, 8 long, every 2 studs across the road
local function crosswalk(w, z, paint)
	local out = {}
	local k = floor((w - 2) / 2) + 1
	for j = 0, k - 1 do
		local x = -(k - 1) + 2 * j
		table.insert(out, piece("Block", { 1, 0.05, 8 }, at(x, 1.025, z), paint, "Trecere"))
	end
	return out
end

local function road(p)
	local asphalt = style(p.color, "Asphalt")
	local walk = style(p.sidewalkColor, "Concrete")
	local paint = style("#f2f2f2", "SmoothPlastic", { canCollide = false, castShadow = false })
	local yellow = style("#f2c12e", "SmoothPlastic", { canCollide = false, castShadow = false })
	local out = {}
	local w, sw, L = p.width, p.sidewalk, p.length
	if p.kind == "straight" then
		push(out, roadArm(L, p, true, asphalt, walk, paint, yellow))
		return { pieces = out, info = {} }
	end
	-- intersection: a square of w x w + arms; "cross" = 4 arms, "T" = 3 (no arm toward +Z)
	local arm = (L - w) / 2
	if arm < 1 then
		arm = 1
	end
	table.insert(out, piece("Block", { w, 1, w }, at(0, 0.5, 0), asphalt, "Asfalt"))
	local dirs = { 0, pi / 2, pi, -pi / 2 } -- -Z, -X, +Z, +X
	for i, a in dirs do
		if not (p.kind == "T" and i == 3) then
			local frame = { p = M.apply(M.ry(a), { 0, 0, -(w / 2 + arm / 2) }), r = M.ry(a) }
			push(out, moved(roadArm(arm, p, true, asphalt, walk, paint, yellow), frame))
			if p.crosswalks and arm >= 10 then
				push(out, moved(crosswalk(w, arm / 2 - 5, paint), frame))
			end
		end
	end
	if sw > 0 then
		for _, sx in { -1, 1 } do
			for _, sz in { -1, 1 } do
				table.insert(out, piece("Block", { sw, 1 + p.curb, sw }, at(sx * (w / 2 + sw / 2), (1 + p.curb) / 2, sz * (w / 2 + sw / 2)), walk, "Trotuar"))
			end
		end
		if p.kind == "T" then -- the closed side: a sidewalk across the square
			table.insert(out, piece("Block", { w, 1 + p.curb, sw }, at(0, (1 + p.curb) / 2, w / 2 + sw / 2), walk, "Trotuar"))
		end
	end
	return { pieces = out, info = {} }
end

-- ---------------------------------------------------------------------------------------------
-- nature: trees, rocks, crystals
-- ---------------------------------------------------------------------------------------------
local function tree(p, rng)
	local bark = style(p.trunkColor, "Wood")
	local leaf = style(p.leafColor, "Grass")
	local out = {}
	local H = p.height
	if p.kind == "pine" then
		local trunkH = H * 0.3
		table.insert(out, column(0, 0, 0, trunkH + 1, p.trunk, bark, "Trunchi"))
		local tiers = p.crown
		local crownH = H - trunkH
		local tierH = tiers == 1 and crownH or crownH / tiers * 1.45 -- tiers overlap; the top one ends at H
		local width = max(2, H * 0.45)
		for k = 1, tiers do
			local y0 = tiers == 1 and trunkH or trunkH + (k - 1) * (crownH - tierH) / (tiers - 1)
			local w = width * (1 - (k - 1) / (tiers + 0.6))
			local yaw = rng.range(0, pi / 2)
			push(out, Geometry.pyramid({ 0, y0, 0 }, w, w, tierH, { color = p.leafColor, material = "Grass", name = "Coroană" }, M.ry(yaw)))
		end
	elseif p.kind == "round" then
		local trunkH = H * 0.5
		table.insert(out, column(0, 0, 0, trunkH + 1, p.trunk, bark, "Trunchi"))
		local cr = max(1.5, H * 0.28)
		local center = { 0, trunkH + cr * 0.55, 0 }
		for k = 1, p.crown do
			local dir = V.unit({ rng.range(-1, 1), rng.range(-0.4, 1), rng.range(-1, 1) }, { 0, 1, 0 }) :: any
			local off = V.scale(dir, k == 1 and 0 or cr * rng.range(0.35, 0.6))
			local s = cr * (k == 1 and 1.5 or rng.range(0.9, 1.3))
			local r = M.fromOrientation(rng.range(0, pi), rng.range(0, pi), rng.range(0, pi))
			table.insert(out, piece("Block", { s, s * rng.range(0.8, 1), s }, { p = V.add(center, off), r = r }, leaf, "Coroană"))
		end
	else -- palm
		local segs = 6
		local lean = math.rad(rng.range(12, 22))
		local heading = rng.range(0, 2 * pi)
		local dirH = { cos(heading), 0, sin(heading) }
		local pts = {}
		for i = 0, segs do
			local t = i / segs
			local y = H * 0.82 * t
			local off = H * 0.82 * sin(lean) * t * t
			table.insert(pts, { dirH[1] * off, y, dirH[3] * off })
		end
		for i = 1, segs do
			local d = p.trunk * (1 - 0.35 * (i - 1) / segs)
			local rod = Geometry.rod(pts[i], pts[i + 1], d)
			if rod then
				rod.size[1] += 0.2
				table.insert(out, piece(rod.shape, rod.size, rod.cf, bark, "Trunchi"))
			end
		end
		local top = pts[#pts]
		local fronds = p.crown
		for k = 1, fronds do
			local a = 2 * pi * k / fronds + rng.range(-0.2, 0.2)
			local out1 = { cos(a), 0, sin(a) }
			local l1, l2 = H * 0.22, H * 0.26
			local p1 = V.add(top, V.add(V.scale(out1, l1 * cos(0.25)), { 0, l1 * sin(0.25), 0 }))
			local droop = rng.range(0.45, 0.75)
			local p2 = V.add(p1, V.add(V.scale(out1, l2 * cos(droop)), { 0, -l2 * sin(droop), 0 }))
			for _, seg in { { top, p1, 1.4 }, { p1, p2, 1.1 } } do
				local b = Geometry.beam(seg[1], seg[2], seg[3], 0.2)
				if b then
					b.size[3] += 0.3
					table.insert(out, piece(b.shape, b.size, b.cf, leaf, "Frunză"))
				end
			end
		end
		for k = 1, 3 do
			local a = 2 * pi * k / 3 + rng.range(-0.3, 0.3)
			table.insert(out, piece("Ball", { 0.9, 0.9, 0.9 }, at(top[1] + cos(a) * 0.6, top[2] - 0.6, top[3] + sin(a) * 0.6), style("#5a3d1e", "Wood"), "Nucă de cocos"))
		end
	end
	return { pieces = out, info = {} }
end

-- random points of a low-poly rock (on a squashed ellipsoid), lowest point slightly under y = 0
function Generators.rockPoints(rng, size: number, detail: number, flatten: number): { Geometry.Vec }
	local count = 8 + 5 * detail
	local pts = {}
	local lowest = math.huge
	for i = 1, count do
		-- evenly spread directions (golden spiral) with jitter, so the hull never collapses
		local yv = 1 - 2 * (i - 0.5) / count
		local rr = sqrt(max(0, 1 - yv * yv))
		local a = i * 2.399963 + rng.range(-0.3, 0.3)
		local radius = size / 2 * rng.range(0.72, 1)
		local q: Geometry.Vec = { cos(a) * rr * radius, yv * radius * flatten, sin(a) * rr * radius }
		table.insert(pts, q)
		lowest = min(lowest, q[2])
	end
	-- about 20 % of the height under the ground: rocks look set, not dropped
	local highest = -math.huge
	for _, q in pts do
		highest = max(highest, q[2])
	end
	local sink = lowest + (highest - lowest) * 0.2
	for _, q in pts do
		q[2] -= sink
	end
	return pts
end

local function rock(p, rng)
	local st = style(p.color, p.material)
	local out = {}
	if p.style == "blocks" then
		local k = 3 + p.detail
		for i = 1, k do
			local s = p.size * (i == 1 and 0.75 or rng.range(0.35, 0.6))
			local off = i == 1 and { 0, 0, 0 } or { rng.range(-0.3, 0.3) * p.size, rng.range(-0.1, 0.15) * p.size, rng.range(-0.3, 0.3) * p.size }
			local r = M.fromOrientation(rng.range(-0.5, 0.5), rng.range(0, pi), rng.range(-0.5, 0.5))
			table.insert(out, piece("Block", { s, s * p.flatten, s * rng.range(0.8, 1.1) }, { p = V.add(off, { 0, s * p.flatten * 0.35, 0 }), r = r }, st, "Rocă"))
		end
		return { pieces = out, info = {} }
	end
	local pts = Generators.rockPoints(rng, p.size, p.detail, p.flatten)
	local faces = Geometry.convexHull(pts) or {}
	local thick = max(0.2, p.size * 0.12)
	for _, f in faces do
		local w = Geometry.triangleWedges(pts[f[1]], pts[f[2]], pts[f[3]], { thickness = thick, align = "front" })
		for _, pc in (w or {}) do
			for k, v in st do
				pc[k] = v
			end
			pc.name = "Rocă"
			table.insert(out, pc)
		end
	end
	return { pieces = out, info = { faces = #faces } }
end

local function crystals(p, rng)
	local st = style(p.color, p.material, { transparency = p.material == "Glass" and 0.2 or nil })
	local out = {}
	for i = 1, p.count do
		local main = i == 1
		local h = p.height * (main and 1 or rng.range(0.45, 0.8))
		local w = p.width * (main and 1 or rng.range(0.6, 0.9))
		local yaw = 2 * pi * (i - 1) / max(1, p.count - 1) + rng.range(-0.3, 0.3)
		local dist = main and 0 or p.width * rng.range(0.4, 0.9)
		local base = { cos(yaw) * dist, 0, sin(yaw) * dist }
		local tilt = main and math.rad(rng.range(0, 6)) or math.rad(rng.range(p.spread * 0.5, p.spread))
		local outward = { cos(yaw), 0, sin(yaw) }
		local axis = V.unit(V.cross({ 0, 1, 0 }, outward), { 1, 0, 0 }) :: any
		local r = M.mul(M.axisAngle(axis, tilt), M.ry(pi / 4 + rng.range(-0.2, 0.2)))
		local tipH = w * 1.3
		local bodyH = max(0.5, h - tipH)
		local bury = 0.3
		local frame = { p = base, r = r }
		local parts = { piece("Block", { w, bodyH, w }, at(0, bodyH / 2 - bury, 0), st, "Cristal") }
		push(parts, Geometry.pyramid({ 0, bodyH - bury, 0 }, w, w, tipH, { color = st.color, material = st.material, transparency = st.transparency, name = "Vârf" }))
		push(out, moved(parts, frame))
	end
	if p.base then
		local sub = rock({ style = "blocks", size = p.width * 2.2, detail = 0, flatten = 0.45, color = "#5b5560", material = "Slate" }, rng)
		push(out, sub.pieces)
	end
	return { pieces = out, info = {} }
end

-- ---------------------------------------------------------------------------------------------
-- furniture (character scale: seat at 2 studs, table top at 3)
-- ---------------------------------------------------------------------------------------------
local function tablePieces(wood, w, d)
	local out = {}
	local top = S.TABLE_HEIGHT
	table.insert(out, piece("Block", { w, 0.4, d }, at(0, top - 0.2, 0), wood, "Blat"))
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			table.insert(out, piece("Block", { 0.4, top - 0.4, 0.4 }, at(sx * (w / 2 - 0.4), (top - 0.4) / 2, sz * (d / 2 - 0.4)), wood, "Picior"))
		end
	end
	return out
end

-- chair 2 x 3.5 x 2, seat at 1.5 (a real Seat: characters can sit), back at +Z
local function chairPieces(wood, seat)
	local out = {}
	local sh = S.SEAT_HEIGHT
	table.insert(out, piece("Block", { 2, 0.3, 2 }, at(0, sh - 0.15, 0), seat, "Șezut"))
	out[#out].class = "Seat"
	table.insert(out, piece("Block", { 2, 2, 0.3 }, at(0, sh + 1, 0.85), wood, "Spătar"))
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			table.insert(out, piece("Block", { 0.3, sh - 0.3, 0.3 }, at(sx * 0.85, (sh - 0.3) / 2, sz * 0.85), wood, "Picior"))
		end
	end
	return out
end

local function furniture(p)
	local wood = style(p.color, "Wood")
	local fabric = style(p.fabricColor, "Fabric")
	local out = {}
	local kind = p.kind
	if kind == "table" then
		push(out, tablePieces(wood, 6, 3))
	elseif kind == "chair" then
		push(out, chairPieces(wood, wood))
	elseif kind == "bed" then
		local b = S.BED -- width, height, length; the head at +Z
		table.insert(out, piece("Block", { b[1], 0.9, b[3] }, at(0, 0.45, 0), wood, "Pat"))
		table.insert(out, piece("Block", { b[1] - 0.3, 0.7, b[3] - 0.4 }, at(0, 1.25, -0.1), style("#f2f2f5", "Fabric"), "Saltea"))
		table.insert(out, piece("Block", { b[1] - 1.6, 0.4, 1.2 }, at(0, 1.8, b[3] / 2 - 1.1), style("#ffffff", "Fabric"), "Pernă"))
		table.insert(out, piece("Block", { b[1] - 0.2, 0.15, b[3] * 0.55 }, at(0, 1.66, -b[3] * 0.2), fabric, "Pătură"))
		table.insert(out, piece("Block", { b[1], 3, 0.4 }, at(0, 1.5, b[3] / 2 + 0.2), wood, "Tăblie"))
	elseif kind == "shelf" then
		local w, h, d = 4, 6, 1.5
		for _, sx in { -1, 1 } do
			table.insert(out, piece("Block", { 0.3, h, d }, at(sx * (w / 2 - 0.15), h / 2, 0), wood, "Lateral"))
		end
		table.insert(out, piece("Block", { w - 0.6, h, 0.2 }, at(0, h / 2, d / 2 - 0.1), wood, "Spate"))
		for k = 0, 4 do
			local y = 0.2 + (h - 0.4) * k / 4
			table.insert(out, piece("Block", { w - 0.6, 0.25, d - 0.2 }, at(0, y, -0.1), wood, "Raft"))
		end
	elseif kind == "bench" then -- 6 x 3 x 2, seat at 1.5
		table.insert(out, piece("Block", { 6, 0.3, 2 }, at(0, S.SEAT_HEIGHT - 0.15, 0), wood, "Șezut"))
		out[#out].class = "Seat"
		table.insert(out, piece("Block", { 6, 1.5, 0.3 }, at(0, S.SEAT_HEIGHT + 0.75, 0.85), wood, "Spătar"))
		for _, sx in { -1, 1 } do
			table.insert(out, piece("Block", { 0.4, S.SEAT_HEIGHT - 0.3, 1.8 }, at(sx * 2.6, (S.SEAT_HEIGHT - 0.3) / 2, 0), style("#3a3a3a", "Metal"), "Picior"))
		end
	elseif kind == "crate" then
		table.insert(out, piece("Block", { 3, 3, 3 }, at(0, 1.5, 0), wood, "Ladă"))
		for _, sy in { 0.25, 2.75 } do
			table.insert(out, piece("Block", { 3.1, 0.4, 3.1 }, at(0, sy, 0), style("#5c3a1e", "WoodPlanks"), "Șipcă"))
		end
	elseif kind == "barrel" then
		table.insert(out, column(0, 0, 0, 4, 3, wood, "Butoi"))
		for _, y in { 0.6, 3.4 } do
			table.insert(out, column(0, y - 0.15, 0, 0.3, 3.1, style("#3a3a3a", "Metal"), "Cerc"))
		end
	elseif kind == "lamp" then -- street lamp: post 0.5 x 11, light range 24
		local metal = style("#2f2f2f", "Metal")
		table.insert(out, column(0, 0, 0, 0.6, 1.4, metal, "Bază"))
		table.insert(out, column(0, 0, 0, 11, 0.5, metal, "Stâlp"))
		table.insert(out, piece("Block", { 0.4, 0.4, 2 }, at(0, 11, -0.8), metal, "Braț"))
		table.insert(out, piece("Block", { 1.2, 0.6, 1.2 }, at(0, 10.6, -1.6), style("#fff2c8", "Neon", { castShadow = false }), "Lampă"))
		out[#out].light = { range = 24, brightness = 1.5, color = "#ffe6b0" }
	else -- set: a table with chairs around it
		push(out, tablePieces(wood, 6, 3))
		local seats = p.seats
		-- { x, z, side }: side = the direction the chair's back points to (away from the table)
		local places = {
			{ 0, -2.6, "-z" }, { 0, 2.6, "+z" }, { -4.1, 0, "-x" }, { 4.1, 0, "+x" },
			{ -1.6, -2.6, "-z" }, { 1.6, 2.6, "+z" }, { 1.6, -2.6, "-z" }, { -1.6, 2.6, "+z" },
		}
		if seats >= 6 then -- two per long side + the ends
			places = { { -1.6, -2.6, "-z" }, { 1.6, -2.6, "-z" }, { -1.6, 2.6, "+z" }, { 1.6, 2.6, "+z" }, { -4.1, 0, "-x" }, { 4.1, 0, "+x" },
				{ 0, -2.6, "-z" }, { 0, 2.6, "+z" } }
			if seats >= 7 then
				places[1], places[2], places[7] = { -2.2, -2.6, "-z" }, { 2.2, -2.6, "-z" }, { 0, -2.6, "-z" }
			end
			if seats >= 8 then
				places[3], places[4], places[8] = { -2.2, 2.6, "+z" }, { 2.2, 2.6, "+z" }, { 0, 2.6, "+z" }
			end
		end
		-- the chair's back is at its local +Z; Ry(a) * (0, 0, 1) = (sin a, 0, cos a)
		local YAW = { ["+z"] = 0, ["-z"] = pi, ["+x"] = pi / 2, ["-x"] = -pi / 2 }
		for i = 1, min(seats, #places) do
			local pl = places[i]
			push(out, moved(chairPieces(wood, wood), { p = { pl[1], 0, pl[2] }, r = M.ry(YAW[pl[3]]) }))
		end
	end
	return { pieces = out, info = {} }
end

-- ---------------------------------------------------------------------------------------------
-- terrain (Terrain:FillBall / FillBlock / FillWedge; material "Air" carves)
-- ---------------------------------------------------------------------------------------------
local function terrain(p, rng)
	local ops = {}
	local R = p.radius
	local mat = p.material
	if p.kind == "clear" then
		table.insert(ops, { op = "block", cf = at(0, R / 2, 0), size = { 2 * R, R, 2 * R }, material = "Air" })
		return { pieces = {}, terrain = ops, info = {} }
	elseif p.kind == "ramp" then
		-- a slope R wide and 2R long rising toward +Z (like a WedgePart) to R * flatten, on a 4-stud base
		local h = R * p.flatten
		table.insert(ops, { op = "wedge", cf = at(0, h / 2, 0), size = { R, h, 2 * R }, material = mat })
		table.insert(ops, { op = "block", cf = at(0, -2, 0), size = { R, 4, 2 * R }, material = mat })
		return { pieces = {}, terrain = ops, info = {} }
	end
	if p.kind == "hill" then
		local layers = 5
		for k = 0, layers - 1 do
			local t = k / layers
			local r = R * (1 - t * 0.75)
			table.insert(ops, { op = "ball", center = { 0, -r * 0.55 + R * p.flatten * t * 1.1, 0 }, radius = r, material = mat })
		end
	else -- blob / cave: a big ball and satellites
		table.insert(ops, { op = "ball", center = { 0, R * 0.35, 0 }, radius = R, material = mat })
		for _ = 1, p.lumps do
			local a = rng.range(0, 2 * pi)
			local d = R * rng.range(0.5, 0.85)
			local r = R * rng.range(0.4, 0.65)
			table.insert(ops, { op = "ball", center = { cos(a) * d, R * rng.range(0, 0.5), sin(a) * d }, radius = r, material = mat })
		end
		if p.kind == "cave" then
			-- a winding tunnel through the blob, entrance at -Z
			local pos = { 0, 2.5, -R * 1.4 }
			local heading = 0
			local steps = max(4, floor(R * 2.4 / 3))
			for _ = 1, steps do
				table.insert(ops, { op = "ball", center = V.copy(pos), radius = p.tunnel, material = "Air" })
				heading += rng.range(-0.35, 0.35)
				pos = V.add(pos, { sin(heading) * 3, rng.range(-0.3, 0.4), cos(heading) * 3 })
				pos[2] = max(p.tunnel * 0.6, pos[2])
			end
			table.insert(ops, { op = "ball", center = V.copy(pos), radius = p.tunnel * 1.8, material = "Air" })
		end
	end
	return { pieces = {}, terrain = ops, info = { ops = #ops } }
end

-- ---------------------------------------------------------------------------------------------
-- registry + parameter schemas
-- ---------------------------------------------------------------------------------------------
local function num(key, label, default, lo, hi)
	return { key = key, label = label, kind = "number", default = default, min = lo, max = hi }
end
local function int(key, label, default, lo, hi)
	return { key = key, label = label, kind = "int", default = default, min = lo, max = hi }
end
local function bool(key, label, default)
	return { key = key, label = label, kind = "bool", default = default }
end
local function choice(key, label, default, options)
	return { key = key, label = label, kind = "choice", default = default, options = options }
end
local function color(key, label, default)
	return { key = key, label = label, kind = "color", default = default }
end
local function material(key, label, default)
	return { key = key, label = label, kind = "material", default = default }
end
local SEED = int("seed", "Seed (variație)", 1, 0, 2147483646)

Generators.LIST = {
	{ key = "building", label = "Clădire", build = building, params = {
