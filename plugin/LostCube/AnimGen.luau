local BY_KEY = {}
for _, def in DEFS do
	BY_KEY[def.key] = def
end

-- ---------------------------------------------------------------------------------------------
-- resolve: DSL -> semantic frames { t, ease, name, markers, j, pos, crouch, feet, floor }
-- ---------------------------------------------------------------------------------------------
local function triple(v)
	return { v[1] or 0, v[2] or 0, v[3] or 0 }
end

local function restState()
	return { j = {}, pos = { 0, 0, 0 }, crouch = 0, feet = {}, floor = nil }
end

local function applyPose(state, src)
	for name, v in src.j or {} do
		assert(KIND[name], "articulație necunoscută: " .. tostring(name))
		state.j[name] = triple(v)
	end
	if src.pos then
		state.pos = triple(src.pos)
	end
	if src.crouch then
		state.crouch = src.crouch
	end
	for side, v in src.feet or {} do
		state.feet[side] = v and triple(v) or false
	end
	if src.floor ~= nil then
		state.floor = src.floor or nil
	end
end

local function copyState(s)
	local j = {}
	for k, v in s.j do
		j[k] = triple(v)
	end
	local feet = {}
	for k, v in s.feet do
		feet[k] = v and triple(v) or false
	end
	return { j = j, pos = triple(s.pos), crouch = s.crouch, feet = feet, floor = s.floor }
end

local function markerList(m)
	if m == nil then
		return {}
	end
	return type(m) == "table" and table.clone(m) or { m }
end

local function hasPose(key)
	return key.base ~= nil or key.reset ~= nil or key.j ~= nil or key.pos ~= nil or key.crouch ~= nil
		or key.feet ~= nil or key.floor ~= nil
end

local function mirrorState(s)
	local j = {}
	for name, v in s.j do
		if isMidline(name) then
			j[name] = { v[1], -v[2], -v[3] }
		else
			j[mirrorName(name)] = v
		end
	end
	s.j = j
	s.pos = { -s.pos[1], s.pos[2], s.pos[3] }
	s.feet = { R = s.feet.L, L = s.feet.R }
end

-- the result can exceed what was authored only up to 170 degrees (keeps strong intensities believable)
local function scaleAngle(a, k)
	local limit = math.max(math.abs(a), 170)
	return math.clamp(a * k, -limit, limit)
end

local function scaleState(s, k, fixedRoot)
	for name, v in s.j do
		if not (fixedRoot and name == "root") then
			s.j[name] = { scaleAngle(v[1], k), scaleAngle(v[2], k), scaleAngle(v[3], k) }
		end
	end
	if not fixedRoot then
		s.pos = { s.pos[1] * k, s.pos[2] * k, s.pos[3] * k }
	end
	s.crouch *= k
	for side, f in s.feet do
		if f then
			s.feet[side] = { f[1] * k, f[2] * k, f[3] * k }
		end
	end
end

-- the head keeps looking at the target: cancels the turn of root + waist and most of the forward bend
local function lookAt(s)
	local root, waist = s.j.root or { 0, 0, 0 }, s.j.waist or { 0, 0, 0 }
	local neck = s.j.neck or { 0, 0, 0 }
	s.j.neck = { neck[1] - waist[1] * 0.7, neck[2] - (root[2] + waist[2]), neck[3] - waist[3] * 0.5 }
end

function AnimGen.get(key)
	return BY_KEY[key]
end

local function options(opts)
	opts = opts or {}
	return {
		speed = math.clamp(tonumber(opts.speed) or 1, 0.1, 5),
		intensity = math.clamp(tonumber(opts.intensity) or 1, 0, 3),
		mirror = opts.mirror == true,
	}
end

function AnimGen.resolve(key, opts)
	local def = type(key) == "table" and key or BY_KEY[key]
	assert(def, "animație necunoscută: " .. tostring(key))
	local o = options(opts)
	local frames = {}
	local state = restState()
	for _, k in def.keys do
		if k.event == nil or hasPose(k) then -- a key with only a time holds the previous pose
			if k.base or k.reset then
				state = restState()
			end
			if k.base then
				applyPose(state, k.base)
			end
			applyPose(state, k)
			table.insert(frames, { t = k.t, ease = k.ease or "io", name = k.name, markers = markerList(k.marker),
				state = copyState(state) })
		else
			table.insert(frames, { t = k.t, markers = markerList(k.event), event = true })
		end
	end
	-- loops end on their first pose
	if def.looped and frames[#frames].t < def.length - 1e-6 then
		local first = frames[1]
		table.insert(frames, { t = def.length, ease = first.ease, name = first.name, markers = {}, state = copyState(first.state) })
	end
	for i, f in frames do
		assert(i == 1 or f.t >= frames[i - 1].t, "timpi descrescători în " .. def.key)
		f.t /= o.speed
		if f.state then
			if o.mirror then
				mirrorState(f.state)
			end
			scaleState(f.state, o.intensity, def.fixedRoot)
			if def.look then
				lookAt(f.state)
			end
		end
	end
	return {
		def = def,
		frames = frames,
		length = def.length / o.speed,
		options = o,
	}
end

-- ---------------------------------------------------------------------------------------------
-- compile: semantic frames -> per-part transforms for a rig (still plain data)
-- ---------------------------------------------------------------------------------------------
local ZERO = { 0, 0, 0 }

local function add(a, b)
	return { a[1] + b[1], a[2] + b[2], a[3] + b[3] }
end

-- R6 bends the whole torso for the waist (pivot at the torso bottom), which moves the hip joints a little
-- (roll lifts one hip, yaw swings them): returns how far this side's hip moved up and forward
local function r6HipShift(state, side)
	if not state.j.waist then
		return 0, 0
	end
	local s = side == "R" and 1 or -1
	local d = M.apply(AnimGen.jointRotation("waist", state.j.waist), { s, 0, 0 })
	return d[2], -d[3]
end

-- vertical reach of a leg spread sideways by `roll` degrees, relative to a straight one. R6 legs hang from the
-- outer top edge, so spreading them also drops the inner edge (half the leg width)
local function spreadFactor(rig, roll)
	local r = math.rad(roll)
	if rig.leg then
		return math.cos(r) + 0.25 * math.sin(math.abs(r))
	end
	return math.max(math.cos(r), 0.5)
end

-- vertical offset of the root joint for this frame on this rig (studs, + up)
local function rootUp(state, rig, info)
	if state.floor then
		return state.floor - info.rootHeight
	end
	local crouch = state.crouch * rig.crouch
	if rig.leg then
		-- straight legs (R6): crouch only as far as the planted feet can still reach the floor
		for side, foot in state.feet do
			if foot then
				local shiftUp, shiftFwd = r6HipShift(state, side)
				local fwd = math.min(math.abs(foot[1] - state.pos[3] - shiftFwd), rig.leg)
				local hip = state.j["hip" .. side]
				local need = math.sqrt(rig.leg * rig.leg - fwd * fwd) * spreadFactor(rig, hip and hip[3] or 0)
				crouch = math.min(crouch, rig.leg - need + state.pos[2] + shiftUp)
			end
		end
		crouch = math.max(crouch, -0.1) -- may lift the body a hair so a tilted leg does not sink
	end
	return state.pos[2] - crouch
end

-- IK legs: writes hip/knee/ankle pitch into j (keeps their yaw/roll)
local function solveLegs(state, rigType, rig, info, up)
	for _, side in { "R", "L" } do
		local foot = state.feet[side]
		if foot then
			local fwd = foot[1] - state.pos[3]
			local hipName, kneeName, ankleName = "hip" .. side, "knee" .. side, "ankle" .. side
			local hip = state.j[hipName] or { 0, 0, 0 }
			local spread = spreadFactor(rig, hip[3])
			if rigType == "R6" then
				local shiftUp, shiftFwd = r6HipShift(state, side)
				local down = (rig.leg + up + shiftUp - foot[2]) / spread
				state.j[hipName] = { math.deg(math.atan2(fwd - shiftFwd, math.max(down, 0.2))), hip[2], hip[3] }
				state.j[kneeName] = nil
			else
				local down = (info.thigh + info.shin + up - foot[2]) / spread
				local hipP, bend = AnimGen.legIK(fwd, down, info.thigh, info.shin)
				local ankle = state.j[ankleName] or { 0, 0, 0 }
				state.j[hipName] = { hipP, hip[2], hip[3] }
				state.j[kneeName] = { bend, 0, 0 }
				-- flat foot: undo the leg's pitch and roll
				state.j[ankleName] = { bend - hipP + foot[3], ankle[2], ankle[3] - hip[3] }
			end
		end
	end
end

local function half(v)
	return v and { v[1] / 2, v[2] / 2, v[3] / 2 } or nil
end

local function framePoses(state, rigType, info)
	local rig = AnimGen.RIGS[rigType]
	local up = rootUp(state, rig, info)
	solveLegs(state, rigType, rig, info, up)
	local j = state.j
	local rootPos = { state.pos[1], up, -state.pos[3] }
	local moved = rootPos[1] ~= 0 or rootPos[2] ~= 0 or rootPos[3] ~= 0
	local out = {}
	if rigType == "R15" then
		for name, v in j do
			out[rig.parts[name]] = { r = AnimGen.jointRotation(name, v), p = ZERO }
		end
		if j.root or moved then
			out.LowerTorso = { r = AnimGen.jointRotation("root", j.root), p = rootPos }
		end
	else
		local rr = AnimGen.jointRotation("root", j.root)
		local w = AnimGen.jointRotation("waist", j.waist)
		local c = rig.waistPivot
		local wc = M.apply(w, c)
		if j.root or j.waist or moved then
			out.Torso = { r = M.mul(rr, w), p = add(rootPos, M.apply(rr, { c[1] - wc[1], c[2] - wc[2], c[3] - wc[3] })) }
		end
		if j.neck then
			out.Head = { r = AnimGen.jointRotation("neck", j.neck), p = ZERO }
		end
		local wt = M.transpose(w)
		for _, side in { "R", "L" } do
			local arm, leg = side == "R" and "Right Arm" or "Left Arm", side == "R" and "Right Leg" or "Left Leg"
			if j["shoulder" .. side] or j["elbow" .. side] then
				out[arm] = { r = M.mul(AnimGen.jointRotation("shoulder" .. side, j["shoulder" .. side]),
					AnimGen.jointRotation("elbow" .. side, half(j["elbow" .. side]))), p = ZERO }
			end
			if j["hip" .. side] or j["knee" .. side] or j.waist then
				out[leg] = { r = M.mul(wt, M.mul(AnimGen.jointRotation("hip" .. side, j["hip" .. side]),
					AnimGen.jointRotation("knee" .. side, half(j["knee" .. side])))), p = ZERO }
			end
		end
		for part, t in out do
			out[part] = M.conjugate(rig.c0[part], t)
		end
	end
	return out
end

local function rigInfo(rigType, opts)
	local rig = AnimGen.RIGS[rigType]
	local info = { rootHeight = rig.rootHeight, thigh = rig.thigh, shin = rig.shin }
	opts = opts or {}
	if type(opts.rootHeight) == "number" and opts.rootHeight > 0.5 and opts.rootHeight < 20 then
		info.rootHeight = opts.rootHeight
	end
	if rigType == "R15" then
		if type(opts.thigh) == "number" and opts.thigh > 0.2 and opts.thigh < 10 then
			info.thigh = opts.thigh
		end
		if type(opts.shin) == "number" and opts.shin > 0.2 and opts.shin < 10 then
			info.shin = opts.shin
		end
	end
	return info
end

-- opts: speed, intensity, mirror; rootHeight / thigh / shin (from AnimGen.measure) fit the IK to a specific rig
function AnimGen.compile(key, rigType, opts)
	assert(AnimGen.RIGS[rigType], "rig necunoscut: " .. tostring(rigType) .. " (R6 sau R15)")
	local resolved = AnimGen.resolve(key, opts)
	local def = resolved.def
	local info = rigInfo(rigType, opts)
	local rig = AnimGen.RIGS[rigType]
	local keyframes = {}
	local animated = {}
	for _, f in resolved.frames do
		local kf = { time = f.t, name = f.name, markers = f.markers }
		if f.event then
			kf.poses = {}
		else
			local ease = AnimGen.EASES[f.ease]
			assert(ease, "easing necunoscut: " .. tostring(f.ease))
			kf.style, kf.direction = ease[1], ease[2]
			kf.poses = framePoses(copyState(f.state), rigType, info)
			for part in kf.poses do
				animated[part] = true
			end
		end
		-- events at the time of a pose keyframe go on that keyframe
		local last = keyframes[#keyframes]
		if last and math.abs(last.time - kf.time) < 1e-4 then
			for _, m in kf.markers do
				table.insert(last.markers, m)
			end
			if next(last.poses) == nil then
				last.poses, last.style, last.direction, last.name = kf.poses, kf.style, kf.direction, kf.name or last.name
			end
		else
			table.insert(keyframes, kf)
		end
	end
	-- every pose keyframe holds every animated part (rest when the part is not posed in that frame)
	for _, kf in keyframes do
		if kf.style then
			for part in animated do
				kf.poses[part] = kf.poses[part] or { r = M.IDENTITY, p = ZERO }
			end
		end
	end
	return {
		key = def.key,
		label = def.label,
		rig = rigType,
		length = resolved.length,
		looped = def.looped == true,
		priority = def.priority or "Action",
		parent = rig.parent,
		order = rig.order,
		keyframes = keyframes,
		options = resolved.options,
	}
end

-- ---------------------------------------------------------------------------------------------
-- public list (for the panel and for Claude)
-- ---------------------------------------------------------------------------------------------
AnimGen.LIST = {}
for _, def in DEFS do
	local markers = {}
	for _, k in def.keys do
		for _, m in markerList(k.marker or k.event) do
			table.insert(markers, { name = m, time = k.t })
		end
	end
	table.insert(AnimGen.LIST, {
		key = def.key,
		label = def.label,
		category = def.category,
		length = def.length,
		looped = def.looped == true,
		priority = def.priority or "Action",
		hint = def.hint,
		markers = markers,
	})
end

-- ---------------------------------------------------------------------------------------------
-- Roblox side
-- ---------------------------------------------------------------------------------------------
local function poseStyle(name)
	if name == "Cubic" then
		-- the legacy Cubic style runs In/Out reversed; CubicV2 is the corrected one
		local ok, v2 = pcall(function()
			return Enum.PoseEasingStyle.CubicV2
		end)
		if ok and v2 then
			return v2
		end
	end
	return Enum.PoseEasingStyle[name]
end

local function toCFrame(t)
	local r, p = t.r, t.p
	return CFrame.new(p[1], p[2], p[3], r[1], r[2], r[3], r[4], r[5], r[6], r[7], r[8], r[9])
end

-- builds the KeyframeSequence (not parented). rigType: "R6" | "R15"
-- opts: { speed, intensity, mirror, rootHeight?, thigh?, shin?, hipHeight? }
function AnimGen.generate(key, rigType, opts)
	local data = AnimGen.compile(key, rigType, opts)
	local kfs = Instance.new("KeyframeSequence")
	kfs.Name = data.label .. (data.options.mirror and " (oglindit)" or "")
	kfs.Loop = data.looped
	kfs.Priority = Enum.AnimationPriority[data.priority]
	if opts and type(opts.hipHeight) == "number" and opts.hipHeight > 0 then
		pcall(function() -- hidden property: R15 root offsets get scaled by HipHeight / AuthoredHipHeight
			(kfs :: any).AuthoredHipHeight = opts.hipHeight
		end)
	end
	kfs:SetAttribute("LC_Gen", data.key)
	kfs:SetAttribute("LC_GenRig", data.rig)
	kfs:SetAttribute("LC_GenSpeed", data.options.speed)
	kfs:SetAttribute("LC_GenIntensity", data.options.intensity)
	kfs:SetAttribute("LC_GenMirror", data.options.mirror)
	for i, k in data.keyframes do
		local kf = Instance.new("Keyframe")
		kf.Name = k.name or ("Cadru " .. i)
		kf.Time = k.time
		if k.style then
			local style = poseStyle(k.style)
			local direction = Enum.PoseEasingDirection[k.direction]
			-- the part's pose plus its parent chain (weight 0 = only holds the hierarchy)
			local made = {}
			local function poseFor(part)
				if made[part] then
					return made[part]
				end
				local p = Instance.new("Pose")
				p.Name = part
				p.EasingStyle = style
				p.EasingDirection = direction
				local t = k.poses[part]
				if t then
					p.CFrame = toCFrame(t)
					p.Weight = 1
				else
					p.Weight = 0
				end
				made[part] = p
				local parentName = data.parent[part]
				if parentName then
					p.Parent = poseFor(parentName)
				else
					p.Parent = kf
				end
				return p
			end
			poseFor("HumanoidRootPart")
			for _, part in data.order do
				if k.poses[part] then
					poseFor(part)
				end
			end
		end
		for _, name in k.markers do
			local m = Instance.new("KeyframeMarker")
			m.Name = name
			kf:AddMarker(m)
		end
		kf.Parent = kfs
	end
	return kfs
end

-- rig measurements that make the IK and lying-down poses fit this exact rig
function AnimGen.measure(rig)
	local info = {}
	if not rig then
		return info
	end
	pcall(function()
		local motors = {}
		for _, d in rig:GetDescendants() do
			if d:IsA("Motor6D") and d.Part1 then
				motors[d.Part1.Name] = d
			end
		end
		local hrp = rig:FindFirstChild("HumanoidRootPart")
		local humanoid = rig:FindFirstChildOfClass("Humanoid")
		local root = motors.LowerTorso or motors.Torso
		if not (hrp and root and root.Part0 == hrp) then
			return
		end
		local pivotY = (hrp.CFrame * root.C0).Position.Y
		local ground
		if motors.LowerTorso then
			info.rigType = "R15"
			ground = hrp.Position.Y - hrp.Size.Y / 2 - (humanoid and humanoid.HipHeight or 2)
			info.hipHeight = humanoid and humanoid.HipHeight or nil
			local hip, knee, ankle = motors.RightUpperLeg, motors.RightLowerLeg, motors.RightFoot
			if hip and knee and ankle then
				info.thigh = (knee.C0.Position - hip.C1.Position).Magnitude
				info.shin = (ankle.C0.Position - knee.C1.Position).Magnitude
			end
		else
			info.rigType = "R6"
			local leg = rig:FindFirstChild("Right Leg")
			ground = hrp.Position.Y - hrp.Size.Y / 2 - (leg and leg:IsA("BasePart") and leg.Size.Y or 2)
		end
		info.rootHeight = pivotY - ground
	end)
	return info
end

-- unique name inside a folder: "Nume", "Nume 2", "Nume 3"...
local function uniqueName(parent, name)
	if not parent:FindFirstChild(name) then
		return name
	end
	local i = 2
	while parent:FindFirstChild(name .. " " .. i) do
		i += 1
	end
	return name .. " " .. i
end

-- saves into ServerStorage.RBX_ANIMSAVES[<rig name or "LostCube">], where the Animation Editor finds it.
-- One undo step. Returns the KeyframeSequence.
function AnimGen.save(kfs, rig)
	local ServerStorage = game:GetService("ServerStorage")
	local ChangeHistoryService = game:GetService("ChangeHistoryService")
	local entryName = (rig and rig.Name ~= "" and rig.Name) or "LostCube"
	local began, recording = pcall(ChangeHistoryService.TryBeginRecording, ChangeHistoryService,
		"LostCube: salvează animația " .. kfs.Name)
	local ok, err = pcall(function()
		local saves = ServerStorage:FindFirstChild("RBX_ANIMSAVES")
		if not saves then
			saves = Instance.new("Model") -- same container the Animation Editor creates
			saves.Name = "RBX_ANIMSAVES"
			saves.Parent = ServerStorage
		end
		local entry = saves:FindFirstChild(entryName)
		if not entry then
			entry = Instance.new("ObjectValue")
			entry.Name = entryName
			if rig then
				entry.Value = rig
			end
			entry.Parent = saves
		end
		kfs.Name = uniqueName(entry, kfs.Name)
		kfs.Parent = entry
	end)
	if began and recording then
		ChangeHistoryService:FinishRecording(recording,
			ok and Enum.FinishRecordingOperation.Commit or Enum.FinishRecordingOperation.Cancel)
	end
	if not ok then
		error(err, 0)
	end
	return kfs
end

return AnimGen
