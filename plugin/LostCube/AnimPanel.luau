-- LostCube > Animations tab: preview any KeyframeSequence on a rig in Edit mode, Moon-style easing on
-- keyframes, effects played on animation markers, and animations generated by code (AnimGen) that the user owns.
local RunService = game:GetService("RunService")
local Selection = game:GetService("Selection")
local Players = game:GetService("Players")
local KeyframeSequenceProvider = game:GetService("KeyframeSequenceProvider")
local ChangeHistoryService = game:GetService("ChangeHistoryService")

local UI = require(script.Parent.UI)
local AnimGen = require(script.Parent.AnimGen)

local Panel = {}
Panel.__index = Panel

local STYLES = {
	{ value = "Linear", label = "Linear", tip = "Viteză constantă" },
	{ value = "Constant", label = "Constant", tip = "Ține poza, apoi sare la următoarea" },
	{ value = "Cubic", label = "Cubic", tip = "Accelerare / frânare lină" },
	{ value = "Bounce", label = "Bounce", tip = "Ricoșează la capăt" },
	{ value = "Elastic", label = "Elastic", tip = "Trece de țintă și revine, ca un arc" },
}
local DIRECTIONS = {
	{ value = "In", label = "In", tip = "Pornește încet" },
	{ value = "Out", label = "Out", tip = "Se oprește încet" },
	{ value = "InOut", label = "InOut", tip = "Încet la ambele capete" },
}
local SPEEDS = {
	{ value = 0.25, label = "0.25×" }, { value = 0.5, label = "0.5×" }, { value = 1, label = "1×" }, { value = 2, label = "2×" },
}
local SEARCH = { "Workspace", "ReplicatedStorage", "ServerStorage", "StarterPlayer", "StarterPack", "Lighting" }

function Panel.new(ctx)
	return setmetatable({ ctx = ctx, Editor = ctx.Editor, rig = nil, clip = nil, speed = 1, loop = true,
		picked = {}, style = "Cubic", direction = "Out", clips = nil, clipQuery = "",
		-- generator: category, chosen animation, options, rig type when no rig is chosen (also the kind of a new dummy),
		-- unsaved preview clip
		genCat = AnimGen.CATEGORIES[1], genKey = nil, genIntensity = 1, genSpeed = 1, genMirror = false, genRig = "R15",
		genTemp = nil }, Panel)
end

function Panel:refresh()
	if not self.dead then
		self.ctx.app:refresh()
	end
end

-- an action failed: a toast (the text also stays in self.error, the last failure)
function Panel:fail(text)
	self.error = text
	UI.toast(text, "error")
end

-- fn must not yield: the recording stays open meanwhile (and every edit of the user lands in it)
local function record(name, fn)
	local ok, id = pcall(ChangeHistoryService.TryBeginRecording, ChangeHistoryService, "LostCube: " .. name)
	local done, err = pcall(fn)
	if ok and id then
		pcall(ChangeHistoryService.FinishRecording, ChangeHistoryService, id,
			done and Enum.FinishRecordingOperation.Commit or Enum.FinishRecordingOperation.Cancel)
	end
	if done then
		pcall(function()
			require(script.Parent.Editor).log(name)
		end)
	end
	return done, err
end

-- error text without the "Plugin_123.LostCube.AnimPanel:45:" prefix
local function friendly(err)
	return (tostring(err):gsub("^[%w_%.%-%s]*:%d+:%s*", ""))
end

local function seconds(t)
	return string.format("%.2f s", t)
end

-- ---------------------------------------------------------------------------------------------
-- rig + clips
-- ---------------------------------------------------------------------------------------------
-- the effect played on a marker is kept on the clip as an attribute; attribute names only take letters, digits
-- and _ , so a marker called "Hit 1" or "Hit-1" would fail silently without this
local function fxAttr(marker)
	return "LC_FX_" .. (marker:gsub("[^%w_]", "_"))
end

-- the Animator of the rig; made when missing (the second value is true then: Panel:stop takes it away again)
local function animatorOf(rig)
	local owner = rig:FindFirstChildOfClass("Humanoid") or rig:FindFirstChildOfClass("AnimationController")
	if not owner then
		return nil
	end
	local animator = owner:FindFirstChildOfClass("Animator")
	if animator then
		return animator, false
	end
	animator = Instance.new("Animator")
	animator.Parent = owner
	return animator, true
end

local function rigType(rig)
	local h = rig and rig:FindFirstChildOfClass("Humanoid")
	if h then
		return h.RigType == Enum.HumanoidRigType.R15 and "R15" or "R6"
	end
	return rig and (rig:FindFirstChild("UpperTorso") and "R15" or "R6") or "-"
end

-- Every KeyframeSequence in the game. Walking a big game takes a while: with `slice` (a function that gives the frame
-- back when its time is used up) one child of a service is walked at a time, so Studio stays responsive.
function Panel:findClips(slice)
	local list = {}
	for _, name in SEARCH do
		local ok, service = pcall(game.GetService, game, name)
		if ok and service then
			local parts = slice and service:GetChildren() or { service }
			for _, part in parts do
				if part ~= service and part.ClassName == "KeyframeSequence" then
					table.insert(list, part)
				end
				for _, d in part:GetDescendants() do
					if d.ClassName == "KeyframeSequence" then -- (no subclasses; cheaper than IsA on every descendant)
						table.insert(list, d)
					end
				end
				if slice then
					slice()
				end
			end
		end
	end
	-- sort keys and what the list shows are computed once per clip (not in every comparison / on every redraw)
	local keys, info = {}, {}
	for i, clip in list do
		local parent = clip.Parent
		local path = parent and parent:GetFullName() or ""
		keys[clip] = { path, clip.Name:lower() }
		info[clip] = { group = (path:gsub("^Workspace%.", ""):gsub("^ReplicatedStorage%.", "")), length = self:clipLength(clip) }
		if slice and i % 100 == 0 then
			slice()
		end
	end
	table.sort(list, function(a, b)
		local ka, kb = keys[a], keys[b]
		if ka[1] ~= kb[1] then
			return ka[1] < kb[1]
		end
		return ka[2] < kb[2]
	end)
	self.clips, self.clipInfo = list, info
	return list
end

-- the first list of the clips is made in the background (the tab shows at once); the refresh button makes it again
function Panel:scanClips()
	if self.scanning then
		return
	end
	self.scanning = true
	local started = os.clock()
	task.spawn(function()
		local ok, err = pcall(self.findClips, self, function()
			if self.dead then
				error("stop", 0)
			elseif os.clock() - started > 0.008 then
				task.wait()
				started = os.clock()
			end
		end)
		self.scanning = false
		if not ok and not self.dead then
			warn("LostCube:", err)
			self.clips, self.clipInfo = self.clips or {}, self.clipInfo or {}
		end
		self:refresh()
	end)
end

function Panel:clipLength(clip)
	local length = 0
	for _, kf in clip:GetKeyframes() do
		length = math.max(length, kf.Time)
	end
	return length
end

-- A dummy rig, not in the place yet. Making it waits for the web (it yields), so it is built BEFORE anything is
-- recorded: a recording kept open across a yield would swallow whatever the user edits meanwhile.
function Panel:buildDummy(kind)
	local desc = Instance.new("HumanoidDescription")
	local light, dark = Color3.fromRGB(214, 216, 226), Color3.fromRGB(40, 40, 48)
	desc.HeadColor, desc.LeftArmColor, desc.RightArmColor = light, light, light
	desc.LeftLegColor, desc.RightLegColor, desc.TorsoColor = dark, dark, dark
	-- CreateHumanoidModelFromDescriptionAsync replaces the deprecated name
	local okMethod, method = pcall(function()
		return Players.CreateHumanoidModelFromDescriptionAsync
	end)
	local ok, result
	if okMethod and method then
		ok, result = pcall(method, Players, desc, Enum.HumanoidRigType[kind])
	else
		ok, result = pcall(Players.CreateHumanoidModelFromDescription, Players, desc, Enum.HumanoidRigType[kind])
	end
	desc:Destroy()
	if not (ok and result) then
		error("Nu am putut crea dummy-ul: " .. friendly(result), 0)
	end
	local model = result
	model.Name = "LostCube Dummy " .. kind
	local spot = self.Editor.previewTarget()
	local cf = typeof(spot) == "CFrame" and spot or CFrame.new(0, 0, 0)
	local root = model:FindFirstChild("HumanoidRootPart")
	local drop = kind == "R15" and (model.Humanoid.HipHeight + root.Size.Y / 2) or 3
	model:PivotTo(cf * CFrame.new(0, drop, 0))
	root.Anchored = true
	return model
end

function Panel:makeDummy(kind)
	if self.making then
		return -- one is already on its way
	end
	self:stop()
	self.making = true
	local built, model = pcall(self.buildDummy, self, kind)
	self.making = false
	if built and self.dead then
		model:Destroy()
		return
	end
	if not built then
		self:fail(tostring(model))
		self:refresh()
		return
	end
	local done, err = record("dummy " .. kind, function()
		model.Parent = workspace -- only this goes into the undo step
	end)
	if done then
		self.rig = model
	else
		model:Destroy()
		self:fail(friendly(err))
	end
	self:refresh()
end

-- the selected character (a Model with a Humanoid or an AnimationController) becomes the rig
function Panel:useSelection()
	local sel = Selection:Get()[1]
	local model = sel and (sel:IsA("Model") and sel or sel:FindFirstAncestorWhichIsA("Model"))
	if model and (model:FindFirstChildOfClass("Humanoid") or model:FindFirstChildOfClass("AnimationController")) then
		self:stop()
		self.rig = model
	else
		self:fail("Selectează un personaj: un Model cu Humanoid.")
	end
	self:refresh()
end

-- ---------------------------------------------------------------------------------------------
-- playback (Edit mode: Animator:StepAnimations)
-- ---------------------------------------------------------------------------------------------
function Panel:resetPose()
	if not self.rig then
		return
	end
	for _, m in self.rig:GetDescendants() do
		if m:IsA("Motor6D") then
			m.Transform = CFrame.new()
		end
	end
end

function Panel:stop()
	if self.conn then
		self.conn:Disconnect()
		self.conn = nil
	end
	for _, c in self.markerConns or {} do
		c:Disconnect()
	end
	self.markerConns = nil
	self.playing = false
	if self.track then
		pcall(function()
			self.track:Stop(0)
			self.track:Destroy()
		end)
		self.track = nil
	end
	if self.ownAnimator then -- the rig did not have one: leave it as it was
		pcall(self.ownAnimator.Destroy, self.ownAnimator)
		self.ownAnimator = nil
	end
	self:resetPose()
	self:showTime()
end

-- the time read-out and the timeline of the playback bar follow the track (called every frame while playing)
function Panel:showTime()
	local track = self.track
	local time, length = 0, self.clipLen or 0
	if track then
		time, length = track.TimePosition, track.Length
	end
	if self.timeLabel and self.timeLabel.Parent then
		self.timeLabel.Text = string.format("%.2f / %.2f s", time, length)
	end
	if self.timeSet then
		self.timeSet(length > 0 and time / length or 0)
	end
end

function Panel:load()
	if not (self.rig and self.clip) then
		if not self.rig then
			self:fail("Alege un rig: selecția sau un dummy.")
		end
		return nil
	end
	self:stop() -- (also takes away an Animator this panel made for the previous preview)
	local animator, created = animatorOf(self.rig)
	if not animator then
		self:fail("Rig-ul nu are Humanoid sau AnimationController.")
		return nil
	end
	self.ownAnimator = created and animator or nil
	-- a broken clip (or a rig it does not fit) shows a message instead of only an error in Output
	local okLoad, track = pcall(function()
		local anim = Instance.new("Animation")
		anim.AnimationId = KeyframeSequenceProvider:RegisterKeyframeSequence(self.clip) -- picks up the latest edits
		return animator:LoadAnimation(anim)
	end)
	if not okLoad or not track then
		self:fail("Nu am putut încărca animația: " .. friendly(track))
		self:stop()
		return nil
	end
	track.Looped = self.loop
	self.track, self.animator = track, animator
	-- effects on markers
	self.markerConns = {}
	for _, marker in self:markers() do
		local fxName = self.clip:GetAttribute(fxAttr(marker.name))
		if fxName then
			table.insert(self.markerConns, track:GetMarkerReachedSignal(marker.name):Connect(function()
				pcall(self.Editor.preview, fxName, { target = self.rig, speed = self.speed })
			end))
		end
	end
	self.conn = RunService.Heartbeat:Connect(function(dt)
		if self.track then
			-- the rig was deleted (undo) or the animator no longer works: stop instead of failing on every frame
			if not (self.rig and self.rig.Parent) or not pcall(self.animator.StepAnimations, self.animator, dt) then
				self:stop()
				self:refresh()
				return
			end
			self:showTime()
			if self.playing and not self.track.IsPlaying then -- a clip that ended on its own (not looped)
				self.playing = false
				self:refresh()
			end
		end
	end)
	return track
end

function Panel:play()
	local track = self.track or self:load()
	if not track then
		self:refresh()
		return
	end
	if not track.IsPlaying then
		track:Play(0, 1, self.speed)
	end
	track:AdjustSpeed(self.speed)
	self.playing = true
	self:refresh()
end

function Panel:pause()
	if self.track then
		self.track:AdjustSpeed(0)
	end
	self.playing = false
	self:refresh()
end

-- the track paused at `t` seconds (loads it first); `final` = false while the timeline is dragged (no redraw then)
function Panel:seek(t, final)
	local track = self.track
	if not track then
		if final == false and self.seekBlocked then
			return -- (a drag without a rig: one message, not one per mouse move)
		end
		track = self:load()
		self.seekBlocked = not track and final == false
	end
	if not track then
		if final ~= false then
			self.seekBlocked = false
			self:refresh()
		end
		return
	end
	if not track.IsPlaying then
		track:Play(0, 1, 0)
	end
	track:AdjustSpeed(0)
	self.playing = false
	track.TimePosition = math.clamp(t, 0, math.max(track.Length - 1e-3, 0))
	pcall(self.animator.StepAnimations, self.animator, 0)
	self:showTime()
	if final ~= false then
		self:refresh()
	end
end

function Panel:step(frames)
	local track = self.track or self:load()
	if not track then
		self:refresh()
		return
	end
	self:seek(track.TimePosition + frames / 60)
end

function Panel:destroy()
	self.dead = true
	self:stop() -- Heartbeat connection, marker connections, track, pose, the Animator made for the preview
end

-- ---------------------------------------------------------------------------------------------
-- generated animations (AnimGen): preview without saving, save into RBX_ANIMSAVES
-- ---------------------------------------------------------------------------------------------
function Panel:genItem()
	for _, item in AnimGen.LIST do
		if item.key == self.genKey then
			return item
		end
	end
	return nil
end

-- the rig type follows the chosen rig; without one (or for a rig without Humanoid) the R15/R6 choice
function Panel:genRigType()
	local kind = self.rig and rigType(self.rig)
	if kind == "R15" or kind == "R6" then
		return kind, true
	end
	return self.genRig, false
end

function Panel:genOptions()
	local opts = { speed = self.genSpeed, intensity = self.genIntensity, mirror = self.genMirror }
	if self.rig then
		-- hip height, leg lengths and root height of this rig: planted feet and lying poses fit it exactly
		for key, value in AnimGen.measure(self.rig) do
			opts[key] = value
		end
	end
	return opts
end

function Panel:genPreview()
	local item = self:genItem()
	if not item then
		self:fail("Alege o animație din listă.")
		self:refresh()
		return
	end
	if not self.rig then
		self:makeDummy(self.genRig)
		if not self.rig then
			return
		end
	end
	local kind = self:genRigType()
	local ok, kfs = pcall(AnimGen.generate, item.key, kind, self:genOptions())
	if not ok then
		self:fail("Nu am putut genera animația: " .. friendly(kfs))
		self:refresh()
		return
	end
	kfs.Name = "Previzualizare: " .. kfs.Name
	self:stop()
	self.genTemp = kfs -- not parented anywhere: nothing to undo, nothing left in the place
	self.genTempRig = self.rig
	self.clip = kfs
	self.picked = {}
	local played, err = pcall(self.play, self)
	if not played then
		self:fail("Previzualizarea nu a pornit: " .. friendly(err))
		self:refresh()
	end
end

-- options changed while a preview runs: show the new version right away
function Panel:genChanged()
	if self.genTemp and self.clip == self.genTemp and self.rig then
		self:genPreview()
	else
		self:refresh()
	end
end

function Panel:genSave()
	local item = self:genItem()
	if not item then
		self:fail("Alege o animație din listă.")
		self:refresh()
		return
	end
	local kind = self:genRigType()
	local ok, result = pcall(function()
		return AnimGen.save(AnimGen.generate(item.key, kind, self:genOptions()), self.rig)
	end)
	if not ok then
		self:fail("Nu am putut salva: " .. friendly(result))
		self:refresh()
		return
	end
	pcall(function()
		self.Editor.log("animație generată: " .. result:GetFullName())
	end)
	self:stop()
	self.genTemp = nil
	self:findClips() -- the list is cached
	self.clip = result -- easing, markers and effects on markers apply to it right away
	self.picked = {}
	local path = (result.Parent and result.Parent:GetFullName() or ""):gsub("%.", " › ")
	UI.toast(string.format("Salvată în %s și aleasă în listă.", path), "success", { action = { text = "Arată",
		onClick = function()
			if result.Parent then
				pcall(Selection.Set, Selection, { result })
			end
		end } })
	self:refresh()
end

-- ---------------------------------------------------------------------------------------------
-- keyframes / markers
-- ---------------------------------------------------------------------------------------------
function Panel:keyframes()
	local list = self.clip and self.clip:GetKeyframes() or {}
	table.sort(list, function(a, b)
		return a.Time < b.Time
	end)
	return list
end

function Panel:markers(kfs)
	local out = {}
	for _, kf in kfs or self:keyframes() do
		for _, m in kf:GetMarkers() do
			table.insert(out, { name = m.Name, time = kf.Time, marker = m })
		end
	end
	return out
end

local function firstPose(kf)
	for _, d in kf:GetDescendants() do
		if d:IsA("Pose") and d.Weight > 0 then
			return d
		end
	end
	return nil
end

-- the legacy Cubic pose style runs In / Out reversed; CubicV2 is the corrected one (what the curve preview draws)
local function poseStyle(name)
	if name == "Cubic" then
		local ok, v2 = pcall(function()
			return Enum.PoseEasingStyle.CubicV2
		end)
		if ok and v2 then
			return v2
		end
	end
	return Enum.PoseEasingStyle[name]
end

function Panel:applyEasing()
	local picked = {}
	for kf in self.picked do
		if kf.Parent == self.clip then
			table.insert(picked, kf)
		end
	end
	if #picked == 0 then
		self:fail("Alege întâi cadrele din listă.")
		self:refresh()
		return
	end
	local style, direction = poseStyle(self.style), Enum.PoseEasingDirection[self.direction]
	local done, err = record(string.format("easing %s %s pe %d cadre (%s)", self.style, self.direction, #picked, self.clip.Name), function()
		for _, kf in picked do
			for _, pose in kf:GetDescendants() do
				if pose:IsA("Pose") then
					pose.EasingStyle = style
					pose.EasingDirection = direction
				end
			end
		end
	end)
	if done then
		UI.toast(string.format("%s %s pe %d %s. Ctrl+Z anulează.", self.style, self.direction, #picked,
			#picked == 1 and "cadru" or "cadre"), "success")
	else
		self:fail(friendly(err))
	end
	self:stop() -- the next play re-registers the clip with the new easing
	self:refresh()
end

function Panel:addMarker(name)
	if not (self.clip and self.track) then
		self:fail("Pornește animația sau mut-o pe un cadru întâi.")
		self:refresh()
		return
	end
	local t = self.track.TimePosition
	local done, err = record("marker " .. name .. " pe " .. self.clip.Name, function()
		local target
		for _, kf in self:keyframes() do
			if math.abs(kf.Time - t) < 1 / 120 then
				target = kf
			end
		end
		if not target then
			target = Instance.new("Keyframe")
			target.Name = name
			target.Time = math.floor(t * 60 + 0.5) / 60
			target.Parent = self.clip
		end
		local m = Instance.new("KeyframeMarker")
		m.Name = name
		target:AddMarker(m)
	end)
	if done then
		UI.toast(string.format("Markerul „%s” a fost adăugat la %s.", name, seconds(t)), "success")
	else
		self:fail(friendly(err))
	end
	self:stop()
	self:refresh()
end

-- ---------------------------------------------------------------------------------------------
-- local components (rows with badges, checkbox, split button, transport bar, timeline, easing curve)
-- ---------------------------------------------------------------------------------------------
local PILL = { neutral = { "raised", "textDim" }, accent = { "accentSoft", "accent" }, success = { "successSoft", "success" },
	warning = { "warningSoft", "warning" }, danger = { "dangerSoft", "danger" } }

-- a small pill with an optional glyph: badges in rows (marker count, loop, rig type)
local function pill(parent, text, kind, glyph, tip)
	local colors = PILL[kind or "neutral"] or PILL.neutral
	local frame = UI.make("Frame", { Name = "Badge", Parent = parent, AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 16) }, { UI.corner(8), UI.pad(0, text == "" and 3 or 6, 0, glyph and 3 or 6), UI.hlist(2, false) })
	UI.skin(frame, { BackgroundColor3 = colors[1] })
	if glyph then
		UI.icon(frame, glyph, { size = 12, color = colors[2] })
	end
	if text ~= "" then
		local label = UI.make("TextLabel", UI.textStyle({ Parent = frame, Text = text, BackgroundTransparency = 1,
			AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 16) }, "meta", "Medium"))
		UI.skin(label, { TextColor3 = colors[2] })
	end
	if tip then
		UI.tip(frame, tip)
	end
	return frame
end

local function pillWidth(item)
	return (item.text ~= "" and UI.textWidth(item.text, "meta") + 14 or 6) + (item.glyph and 14 or 0)
end

-- a 14 px checkbox (the leading element of a selectable row)
local function checkbox(parent, on)
	local box = UI.make("Frame", { Name = "Checkbox", Parent = parent, Size = UDim2.fromOffset(14, 14) }, { UI.corner(3) })
	UI.skin(box, { BackgroundColor3 = on and "accent" or "field" })
	if on then
		UI.icon(box, "check", { size = 12, color = "accentText", anchor = Vector2.new(0.5, 0.5), position = UDim2.fromScale(0.5, 0.5) })
	else
		UI.stroke("textDisabled").Parent = box
	end
	box:SetAttribute("Checked", on)
	return box
end

-- A list row in the look of UI.item with room on the right for badges, a meta text and icon buttons.
-- opts: selected, onClick, height (24), indent, classIcon / icon (glyph) / lead(row) -> instance (16 px column), muted,
-- prefix + prefixWidth (dim text before the name), pills = { { text, kind, glyph, tip } }, meta + metaWidth (dim text on
-- the right), actions = { { icon, tip, onClick, danger, disabled } }, tip
local function listRow(parent, text, opts)
	opts = opts or {}
	local selected = opts.selected == true
	local height = opts.height or UI.H
	local row = UI.make("TextButton", { Name = "Item", Parent = parent, Text = "", AutoButtonColor = false,
		BackgroundTransparency = selected and 0 or 1, Size = UDim2.new(1, 0, 0, height) }, { UI.corner(UI.RADIUS.control) })
	UI.skin(row, { BackgroundColor3 = selected and "accentSoft" or "surfaceHover" })
	row:SetAttribute("Selected", selected)
	if selected then
		local bar = UI.make("Frame", { Name = "Indicator", Parent = row, AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.new(0, 2, 1, -8) }, { UI.corner(1) })
		UI.skin(bar, { BackgroundColor3 = "accent" })
	end
	local x = 8 + (opts.indent or 0)
	if opts.lead or opts.classIcon or opts.icon then
		local lead = opts.lead and opts.lead(row) or UI.icon(row, opts.classIcon or opts.icon, { class = opts.classIcon ~= nil,
			color = selected and "accent" or "textDim" })
		lead.AnchorPoint = Vector2.new(0, 0.5)
		lead.Position = UDim2.new(0, x + (16 - lead.Size.X.Offset) / 2, 0.5, 0)
		if opts.muted and lead:IsA("ImageLabel") then
			lead.ImageTransparency = 0.5
		end
		x += 16 + 8
	end
	if opts.prefix then
		local w = opts.prefixWidth or 40
		UI.label(row, opts.prefix, { role = "meta", dim = true, width = w, height = height }).Position = UDim2.fromOffset(x, 0)
		x += w + 4
	end
	-- the right side: pills, then the meta text, then the actions
	local pills, actions = opts.pills or {}, opts.actions or {}
	local metaW = opts.meta and (opts.metaWidth or 48) or 0
	local rightW, count = 0, 0
	for _, item in pills do
		rightW += pillWidth(item)
		count += 1
	end
	if opts.meta then
		rightW += metaW
		count += 1
	end
	rightW += #actions * UI.H
	count += #actions
	rightW += math.max(0, count - 1) * 6
	if count > 0 then
		local right = UI.make("Frame", { Name = "Right", Parent = row, BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -(#actions > 0 and 2 or 8), 0, 0), Size = UDim2.new(0, rightW, 1, 0) },
			{ UI.make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6),
				FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right,
				VerticalAlignment = Enum.VerticalAlignment.Center }) })
		for _, item in pills do
			pill(right, item.text, item.kind, item.glyph, item.tip)
		end
		if opts.meta then
			UI.label(right, opts.meta, { role = "meta", dim = true, width = metaW, height = height, align = Enum.TextXAlignment.Right })
		end
		for _, a in actions do
			UI.iconButton(right, a.icon, a.onClick, { tip = a.tip, danger = a.danger, disabled = a.disabled, active = a.active })
		end
	end
	local name = UI.label(row, text, { role = "body", medium = selected, color = opts.muted and "textDim" or "text", height = height })
	name.Position = UDim2.fromOffset(x, 0)
	name.Size = UDim2.new(1, -(x + rightW + (#actions > 0 and 6 or 12)), 1, 0)
	if opts.onClick then
		row.MouseEnter:Connect(function()
			if not selected then
				row.BackgroundTransparency = 0
			end
		end)
		row.MouseLeave:Connect(function()
			if not selected then
				row.BackgroundTransparency = 1
			end
		end)
		row.MouseButton1Click:Connect(opts.onClick)
	end
	if opts.tip then
		UI.tip(row, opts.tip)
	end
	return row
end

