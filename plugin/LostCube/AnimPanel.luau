function Panel:renderGenerator(parent)
	local body = UI.section(parent, "Generator", { key = "anim.gen", badge = #AnimGen.LIST })
	local cats = {}
	for _, c in AnimGen.CATEGORIES do
		table.insert(cats, { value = c, label = c })
	end
	UI.segmented(body, cats, self.genCat, function(v)
		self.genCat = v
		self:refresh()
	end)
	local list = UI.vstack(body, 0)
	for _, item in AnimGen.LIST do
		if item.category == self.genCat then
			local pills, times = {}, {}
			for _, m in item.markers do
				table.insert(times, string.format("%s la %s", m.name, seconds(m.time / self.genSpeed)))
			end
			if item.looped then
				table.insert(pills, { text = "", glyph = "refresh", tip = "În buclă" })
			end
			if #item.markers > 0 then
				table.insert(pills, { text = tostring(#item.markers), glyph = "bookmark",
					tip = (#item.markers == 1 and "1 marker: " or (#item.markers .. " markere: ")) .. table.concat(times, ", ") })
			end
			listRow(list, item.label, { selected = item.key == self.genKey, pills = pills,
				meta = seconds(item.length / self.genSpeed), tip = item.hint,
				onClick = function()
					self.genKey = item.key
					self:genChanged()
				end })
		end
	end
	UI.spacer(body, 2)
	local _, fromRig = self:genRigType()
	if not fromRig then
		UI.segmented(UI.row(body, "Tip rig"), { { value = "R15", label = "R15" }, { value = "R6", label = "R6" } }, self.genRig,
			function(v)
				self.genRig = v
				self:refresh()
			end)
	end
	UI.slider(UI.row(body, "Intensitate"), math.floor(self.genIntensity * 100 + 0.5), function(v)
		self.genIntensity = v / 100
		self:genChanged()
	end, { min = 30, max = 160, step = 5, decimals = 0, unit = "%", tip = "Cât de ample sunt mișcările (100 % = normal)" })
	UI.slider(UI.row(body, "Viteză"), math.floor(self.genSpeed * 100 + 0.5), function(v)
		self.genSpeed = v / 100
		self:genChanged()
	end, { min = 50, max = 200, step = 5, decimals = 0, unit = "%", tip = "200 % = de două ori mai rapidă" })
	UI.switch(UI.row(body, "Oglindită"), self.genMirror, function(v)
		self.genMirror = v
		self:genChanged()
	end, { tip = "Schimbă stânga cu dreapta" })
	UI.spacer(body, 4)
	local actions = UI.hstack(body, { height = UI.H_LARGE })
	local chosen = self:genItem() ~= nil
	UI.button(actions, "Previzualizează", function()
		self:genPreview()
	end, { style = chosen and "primary" or "normal", icon = "play", height = UI.H_LARGE, disabled = not chosen,
		tip = not chosen and "Alege întâi o animație din listă"
			or (self.rig and "O redă pe rig fără s-o salveze" or "Creează un dummy și o redă, fără s-o salveze") })
	UI.button(actions, "Salvează", function()
		self:genSave()
	end, { height = UI.H_LARGE, disabled = not chosen, tip = "În ServerStorage › RBX_ANIMSAVES › "
		.. (self.rig and self.rig.Name or "LostCube") .. ", unde o găsește Animation Editor" })
	helpLine(body, "Ca s-o folosești în joc, public-o din Animation Editor.", "Avatar › Animation Editor, alege rig-ul, "
		.. "meniul … › Load › animația, apoi … › Publish to Roblox (pe contul sau grupul care deține jocul). Pune ID-ul primit "
		.. "în Animation.AnimationId.")
end

-- the rows of the clip list; refill = rebuilt in place (the search changed while the user types)
function Panel:fillClips(list, clips, refill)
	if refill then
		for _, child in list:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
	end
	if self.scanning and #clips == 0 then
		UI.label(list, "Caut animațiile din joc…", { dim = true, height = UI.H }).TextXAlignment = Enum.TextXAlignment.Center
		return
	end
	local query = string.lower(self.clipQuery or "")
	local lastGroup, shown = nil, 0
	for _, clip in clips do
		if clip.Parent then
			-- group and length were read when the list was made (refresh reads them again); the chosen clip is always fresh
			local info = self.clipInfo and self.clipInfo[clip]
			local group = info and info.group or clip.Parent:GetFullName()
			if query == "" or string.find(string.lower(clip.Name), query, 1, true)
				or string.find(string.lower(group), query, 1, true) then
				if group ~= lastGroup then
					groupLabel(list, (group:gsub("%.", " › ")))
					lastGroup = group
				end
				local length = (info and clip ~= self.clip) and info.length or self:clipLength(clip)
				UI.item(list, clip.Name, { classIcon = "Animation", selected = clip == self.clip, height = UI.H,
					note = seconds(length), noteWidth = 48,
					onClick = function()
						self:stop()
						self.clip = clip
						self.picked = {}
						self:refresh()
					end })
				shown += 1
			end
		end
	end
	if shown == 0 and #clips > 0 then
		UI.label(list, "Nicio animație nu se potrivește.", { dim = true, height = UI.H }).TextXAlignment = Enum.TextXAlignment.Center
	end
end

function Panel:renderClips(parent)
	local clips = self.clips
	if not clips then
		self:scanClips()
		clips = {}
	end
	local body = UI.section(parent, "Animații din joc", { key = "anim.clips", badge = self.scanning and "…" or #clips,
		right = function(r)
			UI.iconButton(r, "refresh", function()
				self:findClips()
				self:refresh()
			end, { tip = "Caută din nou în joc" })
		end, rightWidth = UI.H })
	if #clips == 0 and not self.scanning then
		UI.empty(body, "Nicio animație (KeyframeSequence) în joc.", "Generează una", function()
			UI.collapsed["anim.gen"] = false
			self:refresh()
		end, { icon = "animation" })
		return
	end
	local list
	UI.search(body, self.clipQuery, function(text)
		self.clipQuery = text
		if list and list.Parent then
			self:fillClips(list, self.clips or {}, true)
		end
	end, { placeholder = "Caută animații" })
	list = UI.scrollList(body, self.clip and 200 or 360)
	self:fillClips(list, clips)
end

-- the transport: to start, frame back, play / pause, frame forward, stop; time on the right; the timeline under it
function Panel:renderPlayback(parent, clip, kfs)
	local body = UI.section(parent, "Redare", { key = "anim.play" })
	local length = 0
	local ticks = {}
	for _, kf in kfs do
		length = math.max(length, kf.Time)
		table.insert(ticks, kf.Time)
	end
	self.clipLen = length
	local marks = {}
	for _, m in self:markers(kfs) do
		table.insert(marks, m.time)
	end
	listRow(body, clip.Name, { classIcon = "Animation", height = UI.H,
		meta = #kfs .. (#kfs == 1 and " cadru" or " cadre"), metaWidth = 64 })
	if not self.rig then
		UI.note(body, "Alege un rig (selecția sau un dummy) ca să vezi animația.")
	end
	local bar = UI.make("Frame", { Name = "Transport", Parent = body, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, UI.H_LARGE) })
	local buttons = UI.make("Frame", { Parent = bar, BackgroundTransparency = 1, Size = UDim2.new(0, 140, 1, 0) }, { UI.hlist(2, false) })
	UI.iconButton(buttons, "toStart", function()
		self:seek(0)
	end, { tip = "La început" })
	local back = UI.iconButton(buttons, "chevronLeft", function()
		self:step(-1)
	end, { tip = "Un cadru înapoi (1/60 s)" })
	back.Name = "IconButton_stepBack"
	UI.button(buttons, "", function()
		if self.playing then
			self:pause()
		else
			self:play()
		end
	end, { style = "primary", icon = self.playing and "pause" or "play", width = 32, height = UI.H,
		tip = self.playing and "Pauză" or "Redă" }).Name = "PlayButton"
	local fwd = UI.iconButton(buttons, "chevronRight", function()
		self:step(1)
	end, { tip = "Un cadru înainte (1/60 s)" })
	fwd.Name = "IconButton_stepForward"
	UI.iconButton(buttons, "stop", function()
		self:stop()
		self.playing = false
		self:refresh()
	end, { tip = "Oprește și readu poza" })
	local time = self.track and self.track.TimePosition or 0
	local total = self.track and self.track.Length or length
	self.timeLabel = UI.label(bar, string.format("%.2f / %.2f s", time, total), { role = "code", dim = true, width = 110,
		height = UI.H_LARGE, align = Enum.TextXAlignment.Right })
	self.timeLabel.AnchorPoint = Vector2.new(1, 0)
	self.timeLabel.Position = UDim2.fromScale(1, 0)
	local _, set = timeline(body, total, total > 0 and time / total or 0, ticks, marks, function(t, final)
		self:seek(t, final)
	end)
	self.timeSet = set
	local options = UI.make("Frame", { Parent = body, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, UI.H) },
		{ UI.hlist(12, false) })
	local speeds = UI.segmented(options, SPEEDS, self.speed, function(v)
		self.speed = v
		if self.track and self.playing then
			self.track:AdjustSpeed(v)
		end
		self:refresh()
	end)
	speeds.Size = UDim2.new(1, -92, 0, UI.H)
	UI.toggle(options, self.loop, function(v)
		self.loop = v
		if self.track then
			self.track.Looped = v
		end
		self:refresh()
	end, "Buclă", { width = 80, tip = "Repetă animația" })
end

function Panel:renderEasing(parent, kfs)
	local body = UI.section(parent, "Cadre și easing", { key = "anim.ease", badge = #kfs })
	local count = 0
	for kf in self.picked do
		if kf.Parent == self.clip then
			count += 1
		end
	end
	local head = UI.make("Frame", { Parent = body, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, UI.H) })
	UI.label(head, count == 0 and "Alege cadrele" or string.format("%d din %d alese", count, #kfs), { role = "meta", dim = true,
		height = UI.H }).Position = UDim2.fromOffset(8, 0)
	local pick = UI.make("Frame", { Parent = head, BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0), Size = UDim2.new(0, 140, 1, 0) },
		{ UI.make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2),
			FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right,
			VerticalAlignment = Enum.VerticalAlignment.Center }) })
	UI.button(pick, "Toate", function()
		for _, kf in kfs do
			self.picked[kf] = true
		end
		self:refresh()
	end, { style = "ghost", autoWidth = true })
	UI.button(pick, "Niciunul", function()
		self.picked = {}
		self:refresh()
	end, { style = "ghost", autoWidth = true, disabled = count == 0 })
	local list = UI.vstack(body, 0)
	for _, kf in kfs do
		local pose = firstPose(kf)
		local styleName = pose and (pose.EasingStyle.Name:gsub("V2$", "")) or nil
		local markers = kf:GetMarkers()
		local pills = {}
		if #markers > 0 then
			local names = {}
			for _, m in markers do
				table.insert(names, m.Name)
			end
			table.insert(pills, { text = markers[1].Name .. (#markers > 1 and (" +" .. (#markers - 1)) or ""), glyph = "bookmark",
				tip = "Markere: " .. table.concat(names, ", ") })
		end
		local on = self.picked[kf] == true
		listRow(list, kf.Name, { lead = function(row)
			return checkbox(row, on)
		end, selected = on, prefix = seconds(kf.Time), prefixWidth = 44, pills = pills,
			meta = pose and (styleName .. " " .. pose.EasingDirection.Name) or "-", metaWidth = 76,
			tip = "Easing-ul unui cadru = mișcarea de la el spre următorul",
			onClick = function()
				self.picked[kf] = not self.picked[kf] or nil
				self:refresh()
			end })
	end
	UI.spacer(body, 4)
	UI.segmented(body, STYLES, self.style, function(v)
		self.style = v
		self:refresh()
	end)
	local easing = UI.make("Frame", { Name = "Easing", Parent = body, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 68) })
	local graph = curveGraph(easing, self.style, self.direction, 104, 68)
	UI.tip(graph, self.style .. " " .. self.direction .. ": poziția (sus) în timp (dreapta), între două cadre")
	local side = UI.make("Frame", { Parent = easing, BackgroundTransparency = 1, Position = UDim2.fromOffset(112, 0),
		Size = UDim2.new(1, -112, 1, 0) })
	UI.segmented(side, DIRECTIONS, self.direction, function(v)
		self.direction = v
		self:refresh()
	end)
	local apply = UI.button(side, count > 0 and string.format("Aplică pe %d %s", count, count == 1 and "cadru" or "cadre")
		or "Aplică", function()
		self:applyEasing()
	end, { height = UI.H_LARGE, disabled = count == 0, tip = count == 0 and "Alege întâi cadrele din listă"
		or "Un singur Ctrl+Z" })
	apply.AnchorPoint = Vector2.new(0, 1)
	apply.Position = UDim2.fromScale(0, 1)
end

function Panel:renderMarkers(parent, clip, kfs)
	local markers = self:markers(kfs)
	local body = UI.section(parent, "Efecte pe markere", { key = "anim.fx", badge = #markers, right = function(r)
		UI.iconButton(r, "info", nil, { tip = "În joc: VFX.bindMarkers(track, personaj, { Hit = \"NumeEfect\" })" })
	end, rightWidth = UI.H })
	local effectItems = { { value = "", label = "Niciun efect" }, { separator = true } }
	for _, fx in self.Editor.effects() do
		table.insert(effectItems, { value = fx.Name, label = fx.Name, icon = "effects" })
	end
	if #effectItems == 2 then
		effectItems[2] = { label = "Fă efecte în tab-ul Efecte", disabled = true }
	end
	if #markers == 0 then
		UI.label(body, "Niciun marker încă. Adaugă unul la momentul curent.", { role = "meta", dim = true, wrap = true })
	end
	for _, m in markers do
		local row = UI.make("Frame", { Name = "Marker", Parent = body, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, UI.H) })
		UI.icon(row, "bookmark", { anchor = Vector2.new(0, 0.5), position = UDim2.new(0, 8, 0.5, 0) })
		local name = UI.label(row, m.name, { height = UI.H })
		name.Position = UDim2.fromOffset(32, 0)
		name.Size = UDim2.new(0.45, -32 - 52, 1, 0)
		local at = UI.label(row, seconds(m.time), { role = "meta", dim = true, width = 44, height = UI.H, align = Enum.TextXAlignment.Right })
		at.AnchorPoint = Vector2.new(1, 0)
		at.Position = UDim2.new(0.45, -4, 0, 0)
		local current = clip:GetAttribute(fxAttr(m.name)) or ""
		local dropdown = UI.dropdown(row, effectItems, current, function(v)
			local done, err = record("efect " .. (v ~= "" and v or "-") .. " pe markerul " .. m.name, function()
				clip:SetAttribute(fxAttr(m.name), v ~= "" and v or nil)
			end)
			if not done then
				self:fail(friendly(err))
			end
			self:stop()
			self:refresh()
		end, { scale = 0.55, menuWidth = 200, tip = "Efectul pornit când animația ajunge la „" .. m.name .. "”" })
		dropdown.AnchorPoint = Vector2.new(1, 0)
		dropdown.Position = UDim2.fromScale(1, 0)
	end
	local add = UI.hstack(body)
	local box = UI.textbox(add, "", nil, { placeholder = "Nume marker, ex. Hit" })
	box.Text = self.markerDraft or "" -- what was typed survives a redraw
	box:GetPropertyChangedSignal("Text"):Connect(function()
		self.markerDraft = box.Text
	end)
	UI.button(add, "Adaugă", function()
		if box.Text ~= "" then
			self.markerDraft = nil
			self:addMarker(box.Text)
		end
	end, { icon = "plus", width = 92, tip = "Adaugă markerul la momentul curent al redării" })
end

function Panel:render(parent)
	if self.rig and not self.rig.Parent then
		self:stop()
		self.rig = nil
	end
	if self.genTemp and self.clip == self.genTemp and self.genTempRig ~= self.rig then
		-- an unsaved preview was made for the previous rig (maybe another rig type)
		self:stop()
		self.clip, self.genTemp = nil, nil
	end
	self.timeLabel, self.timeSet = nil, nil
	self:renderRig(parent)
	self:renderGenerator(parent)
	self:renderClips(parent)
	local clip = self.clip
	if not clip then
		return
	end
	local kfs = self:keyframes()
	self:renderPlayback(parent, clip, kfs)
	if clip == self.genTemp then
		UI.note(parent, "Previzualizare nesalvată. Salveaz-o din Generator ca să-i schimbi easing-ul și markerele.")
		return
	end
	self:renderEasing(parent, kfs)
	self:renderMarkers(parent, clip, kfs)
end

return Panel
