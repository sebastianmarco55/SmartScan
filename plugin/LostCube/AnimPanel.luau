-- A timeline: the part already played, a knob at the current time, ticks at the keyframes, small diamonds at the
-- markers. Click or drag to seek: onSeek(time, final) (final = false while dragging). Returns the frame and
-- set(fraction) for the per-frame update.
local function timeline(parent, length, fraction, ticks, marks, onSeek)
	local frame = UI.make("TextButton", { Name = "Timeline", Parent = parent, Text = "", AutoButtonColor = false,
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 20) })
	local rail = UI.make("Frame", { Name = "Rail", Parent = frame, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 6, 0.5, 2),
		Size = UDim2.new(1, -12, 0, 4) }, { UI.corner(2) })
	UI.skin(rail, { BackgroundColor3 = "switchOff" })
	local played = UI.make("Frame", { Name = "Fill", Parent = rail, Size = UDim2.fromScale(0, 1) }, { UI.corner(2) })
	UI.skin(played, { BackgroundColor3 = "accent" })
	if length > 0 then
		for _, t in ticks do
			local tick = UI.make("Frame", { Name = "Tick", Parent = rail, AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(math.clamp(t / length, 0, 1), 0.5), Size = UDim2.fromOffset(1, 8) })
			UI.skin(tick, { BackgroundColor3 = "textDisabled" })
		end
		for _, t in marks do
			local mark = UI.make("Frame", { Name = "Marker", Parent = rail, AnchorPoint = Vector2.new(0.5, 0.5), Rotation = 45,
				Position = UDim2.new(math.clamp(t / length, 0, 1), 0, 0, -6), Size = UDim2.fromOffset(5, 5) })
			UI.skin(mark, { BackgroundColor3 = "text" })
		end
	end
	local handle = UI.make("Frame", { Name = "Knob", Parent = rail, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(10, 10),
		ZIndex = 2 }, { UI.corner(5), UI.stroke("border") })
	UI.skin(handle, { BackgroundColor3 = "knob" })
	local function set(f)
		f = math.clamp(f or 0, 0, 1)
		played.Size = UDim2.fromScale(f, 1)
		handle.Position = UDim2.fromScale(f, 0.5)
	end
	set(fraction)
	local function at(position)
		local p, size = rail.AbsolutePosition, rail.AbsoluteSize
		return math.clamp((position.X - p.X) / math.max(1, size.X), 0, 1) * length
	end
	frame.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 or length <= 0 then
			return
		end
		local last = at(input.Position)
		set(last / length)
		onSeek(last, false)
		UI.beginDrag(function(position)
			last = at(position)
			set(last / length)
			onSeek(last, false)
		end, function(position)
			if position then
				last = at(position)
			end
			onSeek(last, true)
		end)
	end)
	UI.tip(frame, "Click sau trage ca să mergi la un moment")
	return frame, set
end

-- the easing curves as the preview draws them (value from 0 to 1 over t from 0 to 1)
local function bounceOut(t)
	local n, d = 7.5625, 2.75
	if t < 1 / d then
		return n * t * t
	elseif t < 2 / d then
		t -= 1.5 / d
		return n * t * t + 0.75
	elseif t < 2.5 / d then
		t -= 2.25 / d
		return n * t * t + 0.9375
	end
	t -= 2.625 / d
	return n * t * t + 0.984375
end

local function elasticOut(t)
	if t <= 0 or t >= 1 then
		return t <= 0 and 0 or 1
	end
	return 2 ^ (-10 * t) * math.sin((t * 10 - 0.75) * (2 * math.pi / 3)) + 1
end

local EASE_IN = {
	Linear = function(t)
		return t
	end,
	Cubic = function(t)
		return t * t * t
	end,
	Bounce = function(t)
		return 1 - bounceOut(1 - t)
	end,
	Elastic = function(t)
		return 1 - elasticOut(1 - t)
	end,
}

local function eased(style, direction, t)
	local easeIn = EASE_IN[style] or EASE_IN.Linear
	if direction == "In" then
		return easeIn(t)
	elseif direction == "Out" then
		return 1 - easeIn(1 - t)
	elseif t < 0.5 then
		return easeIn(2 * t) / 2
	end
	return 1 - easeIn(2 - 2 * t) / 2
end
Panel.eased = eased -- (tests)

-- points of the curve of a style / direction, t and value from 0 to 1
local function curvePoints(style, direction, samples)
	if style == "Constant" then
		return { { 0, 0 }, { 1, 0 }, { 1, 1 } }
	end
	local out = {}
	for i = 0, samples do
		local t = i / samples
		table.insert(out, { t, eased(style, direction, t) })
	end
	return out
end
Panel.curvePoints = curvePoints -- (tests)

-- a straight line between two points of `parent` (a rotated frame), in a token colour
local function segment(parent, x1, y1, x2, y2, width, token)
	local dx, dy = x2 - x1, y2 - y1
	local line = UI.make("Frame", { Name = "Line", Parent = parent, AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2), Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy) + width * 0.5, width),
		Rotation = math.deg(math.atan2(dy, dx)) })
	UI.skin(line, { BackgroundColor3 = token })
	return line
end

-- the graph of an easing: value over time, the 0 and 1 levels as guides
local function curveGraph(parent, style, direction, width, height)
	local frame = UI.make("Frame", { Name = "Curve", Parent = parent, Size = UDim2.fromOffset(width, height), ClipsDescendants = true },
		{ UI.corner(UI.RADIUS.control), UI.stroke("fieldBorder") })
	UI.skin(frame, { BackgroundColor3 = "field" })
	local pad = 8
	local lo, hi = -0.1, 1.1
	if style == "Elastic" then
		lo, hi = -0.32, 1.32
	end
	local w, h = width - pad * 2, height - pad * 2
	local function y(v)
		return pad + (hi - v) / (hi - lo) * h
	end
	for _, level in { 0, 1 } do
		local guide = UI.make("Frame", { Name = "Guide", Parent = frame, Position = UDim2.fromOffset(pad, math.floor(y(level))),
			Size = UDim2.fromOffset(w, 1) })
		UI.skin(guide, { BackgroundColor3 = "divider" })
	end
	local points = curvePoints(style, direction, 36)
	for i = 2, #points do
		local a, b = points[i - 1], points[i]
		segment(frame, pad + a[1] * w, y(a[2]), pad + b[1] * w, y(b[2]), 2, "accent")
	end
	for _, p in { points[1], points[#points] } do
		local dot = UI.make("Frame", { Name = "Dot", Parent = frame, AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(pad + p[1] * w, y(p[2])), Size = UDim2.fromOffset(5, 5) }, { UI.corner(3) })
		UI.skin(dot, { BackgroundColor3 = "accent" })
	end
	return frame
end

